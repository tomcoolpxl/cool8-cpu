; ---------------------------------------------------------------------
; io.act -- the I/O page for CoolAction!, generated by tools/ioregs.py.
;
; **Do not edit.** Same source as sw/io.asm: the Verilog localparams in
; rtl/soc/*.v that decode these addresses. `poe check` fails if stale.
;
; There is no INCLUDE, so this file goes first on the compiler's command
; line, ahead of sw/libaction.act. A BYTE is a register; a CARD is a
; _L/_H pair, so `VID_BASE = addr` is both bytes in one store.
; ---------------------------------------------------------------------

CONST IOBASE = $FF00

; ---- cool8_flash.v
BYTE FLS_ADDR_L  = IOBASE + $88   ; SPI flash address, low
BYTE FLS_ADDR_M  = IOBASE + $89   ; SPI flash address, middle
BYTE FLS_ADDR_H  = IOBASE + $8A   ; SPI flash address, high
BYTE FLS_DATA    = IOBASE + $8B   ; read the byte at that address
BYTE FLS_CTRL    = IOBASE + $8C   ; start a read, select the device
BYTE FLS_STAT    = IOBASE + $8D   ; busy and done
BYTE FLS_WDATA   = IOBASE + $8E   ; byte to program
BYTE FLS_WCTRL   = IOBASE + $8F   ; program and erase control

; ---- cool8_pixport.v
BYTE PIX_X_L     = IOBASE + $34   ; plot X, low
BYTE PIX_X_H     = IOBASE + $35   ; plot X, high
BYTE PIX_Y_L     = IOBASE + $36   ; plot Y, low
BYTE PIX_Y_H     = IOBASE + $37   ; plot Y, high
BYTE PIX_DATA    = IOBASE + $38   ; write plots the pixel at X,Y, then X advances
BYTE PIX_DATA_Y  = IOBASE + $39   ; write plots the pixel at X,Y, then Y advances
CARD PIX_X       = IOBASE + $34   ; PIX_X_L and PIX_X_H
CARD PIX_Y       = IOBASE + $36   ; PIX_Y_L and PIX_Y_H

; ---- cool8_ps2.v
BYTE KBD_STAT    = IOBASE + $40   ; PS/2 status: byte ready, error
BYTE KBD_DATA    = IOBASE + $41   ; the scancode; reading clears ready
BYTE KBD_CTRL    = IOBASE + $42   ; interrupt enable and reset
BYTE KBD_TX      = IOBASE + $43   ; byte to send to the keyboard
BYTE KBD_MOD     = IOBASE + $44   ; modifier state, decoded in hardware

; ---- cool8_snd.v
BYTE SND_IDX     = IOBASE + $50   ; voice to address
BYTE SND_DATA    = IOBASE + $51   ; that voice's registers

; ---- cool8_soc.v
BYTE SYS_CTRL    = IOBASE + $00   ; system control: reset and bank selects
BYTE SYS_STAT    = IOBASE + $02   ; system status, read-only
BYTE LED         = IOBASE + $03   ; the board's LEDs, one per bit
BYTE UART_STAT   = IOBASE + $70   ; transmit ready, receive ready
BYTE UART_DATA   = IOBASE + $71   ; read receives, write transmits
BYTE UART_DIV_L  = IOBASE + $72   ; baud divisor, low
BYTE UART_DIV_H  = IOBASE + $73   ; baud divisor, high
BYTE LDR_CTRL    = IOBASE + $80   ; boot loader control
BYTE LDR_STAT    = IOBASE + $81   ; boot loader status
CARD UART_DIV    = IOBASE + $72   ; UART_DIV_L and UART_DIV_H

; ---- cool8_sprite.v
BYTE SPR_IDX     = IOBASE + $2A   ; sprite to address
BYTE SPR_DATA    = IOBASE + $2B   ; that sprite's attribute bytes
BYTE SPR_CTRL    = IOBASE + $2C   ; per-sprite enable bits

; ---- cool8_vport.v
BYTE VRAM_ADDR_L = IOBASE + $26   ; indirect VRAM address, low
BYTE VRAM_ADDR_H = IOBASE + $27   ; indirect VRAM address, high
BYTE VRAM_STEP   = IOBASE + $28   ; added to the address after each access
BYTE VRAM_DATA   = IOBASE + $29   ; the byte at that address; access auto-steps
CARD VRAM_ADDR   = IOBASE + $26   ; VRAM_ADDR_L and VRAM_ADDR_H

; ---- cool8_vregs.v
BYTE VID_MODE    = IOBASE + $10   ; screen mode, low nibble
BYTE VID_CTRL    = IOBASE + $11   ; display enable, sprite enable, blanking
BYTE VID_BASE_L  = IOBASE + $12   ; character/bitmap base, low
BYTE VID_BASE_H  = IOBASE + $13   ; character/bitmap base, high
BYTE VID_STRIDE_L = IOBASE + $14   ; bytes per row, low
BYTE VID_STRIDE_H = IOBASE + $15   ; bytes per row, high
BYTE VID_SCX_L   = IOBASE + $16   ; horizontal scroll, low
BYTE VID_SCX_H   = IOBASE + $17   ; horizontal scroll, high
BYTE VID_SCY_L   = IOBASE + $18   ; vertical scroll, low
BYTE VID_SCY_H   = IOBASE + $19   ; vertical scroll, high
BYTE VID_BORDER  = IOBASE + $1A   ; border colour index
BYTE VID_RASTER  = IOBASE + $1B   ; current raster line, read-only
BYTE VID_RCMP    = IOBASE + $1C   ; raster line to compare against
BYTE VID_IRQ     = IOBASE + $1D   ; interrupt enable and acknowledge
BYTE PAL_IDX     = IOBASE + $1E   ; palette entry to address
BYTE PAL_DATA    = IOBASE + $1F   ; that entry's colour
BYTE VID_PAT_L   = IOBASE + $20   ; pattern/tile base, low
BYTE VID_PAT_H   = IOBASE + $21   ; pattern/tile base, high
BYTE CUR_X       = IOBASE + $22   ; text cursor column
BYTE CUR_Y       = IOBASE + $23   ; text cursor row
BYTE CUR_CTRL    = IOBASE + $24   ; cursor enable and blink
BYTE TMR_L       = IOBASE + $2D   ; frames since reset, low byte
BYTE TMR_M       = IOBASE + $2E   ; ...middle byte
BYTE TMR_H       = IOBASE + $2F   ; ...high byte
BYTE VID_DBASE_H = IOBASE + $30   ; display base override, high byte -- the fetch engine scans from {this,$00} while VID_CTRL bit 6 is set, so VID_BASE can point drawing at a hidden page (D92)
CARD VID_BASE    = IOBASE + $12   ; VID_BASE_L and VID_BASE_H
CARD VID_STRIDE  = IOBASE + $14   ; VID_STRIDE_L and VID_STRIDE_H
CARD VID_SCX     = IOBASE + $16   ; VID_SCX_L and VID_SCX_H
CARD VID_SCY     = IOBASE + $18   ; VID_SCY_L and VID_SCY_H
CARD VID_PAT     = IOBASE + $20   ; VID_PAT_L and VID_PAT_H

