; SLIDES -- the picture drive, a picture at a time, in mode 6
;
; Every file on the picture drive (tools/cool8disk.py's PICTURE_VOL)
; whose name ends in .PIC, in the order the catalogue holds them: the
; space bar for the next, round again after the last, Esc to reset the
; machine -- the way out of a program the loader put in charge (D102).
;
; **Mode 6 is the machine at its most colourful**: 256 x 240, a byte a
; pixel, and all 256 palette entries on the screen at once, each any of
; 4,096 colours. A picture is the hardware's own bytes (tools/mkpics.py,
; D103) -- an eight-byte header, the palette as PAL_DATA takes it, the
; pixels as VRAM holds them -- so showing one decodes nothing. The header
; and the palette come into memory; the palette goes black, so nothing
; is seen arriving; the 61,440 pixels go from the flash's data port to
; VRAM's, a byte a pass; and at the next frame the picture's own palette
; goes in, inside the vertical blank, so it appears whole.
;
; **And more than 256 of them (D104).** A version-2 picture's palette
; changes between rows. NAME.RPL beside it lists the entries to rewrite
; before each row, and Raster() rewrites them every frame, locked to
; VID_RASTER: two in the blanking before a row, to entries the row above
; used, and up to fourteen while a row is drawn, to entries that row does
; not use. No entry ever changes under a pixel that is showing it, and
; every row is drawn in a palette of its own.
;
; The pictures are the old image-processing test set -- the USC-SIPI
; Mandrill and Peppers, Kodak's parrots and painted face -- which
; `python tools/mkpics.py --fetch` downloads and converts. They are not
; in the repository (assets/pictures/README.md says why), so a drive
; with none on it is expected, and this says so on the text screen.

BYTE pic_vol = [10]                  ; cool8disk.PICTURE_VOL -- the gate holds the two together
CONST PIC_SIZE = 61960               ; mkpics.SIZE: 8 of header, 512 of palette, 61,440 of pixels
CONST MAX_PICS = 32
CONST KEY_SPACE = $29
CONST KEY_ESC = $76
; a change list, less its header, at an address of its own: 240 records
; of at most 2 + 1 + 14 three-byte slots, so $6000-$8DEF -- clear of
; this program and of the text map at $9800 that Nothing() writes
CONST RPL_AT = $6000
CONST RPL_MAX = 11768                ; 8 + 240 * (6 + 1 + 42)
CONST HOT = 2                        ; mkpics.HOT: Raster() writes exactly this many a row
CONST FREE = 14                      ; mkpics.FREE: the most Raster() has the clocks for

CARD ARRAY pic_page(32)              ; where each picture starts, in pages from the volume base
BYTE ARRAY pic_stem(256)             ; and its name, eight characters a picture, for its NAME.RPL
BYTE npics
BYTE ARRAY pic_head(8)
BYTE ARRAY pic_pal(512)
BYTE pic_raster                      ; the picture on the screen changes its palette by row
BYTE ARRAY rpl_head(8)
BYTE ARRAY rpl_name = "        RPL"  ; eleven characters: the stem goes in the first eight
BYTE POINTER rpl

; Scan() -- every file on the drive called *.PIC and long enough to be
; a picture, in catalogue order, with its name
PROC Scan()
  BYTE st, i
  npics = 0
  DiskDir(pic_vol)
  DO
    st = DiskEntry()
    IF st == $FF THEN EXIT FI
    IF st == 1 AND disk_ent(8) == 'P' AND disk_ent(9) == 'I' AND disk_ent(10) == 'C' AND disk_len >= PIC_SIZE AND npics < MAX_PICS THEN
      pic_page(npics) = disk_page
      FOR i = 0 TO 7 DO pic_stem(npics * 8 + i) = disk_ent(i) OD
      npics += 1
    FI
  OD
  FlashClose()
RETURN

; **The palette changes inside a vertical blank, both ways**: 45 lines,
; 11,970 clocks, before the raster wants an entry again. A palette half
; written while the raster runs is a frame whose top is one picture and
; whose bottom is another. The compiled FOR these were first took 53
; clocks a byte, 27,201 for Commit's 512, and the gate caught the top 57
; lines of a frame drawn under a palette being written; so the two
; loops are assembly, a pair of PAL_DATA stores and a count.

; Black() -- every palette entry black, the border's among them
PROC Black()
  WaitVBlank()
  PAL_IDX = 0
  ASM
    CLR  R0
    MOV  R3,#0
.blk: ST   [v_PAL_DATA],R0
    ST   [v_PAL_DATA],R0
    SUB  R3,#1
    BNE  .blk
  ENDASM
RETURN

; Commit() -- the picture's own palette, and its border; row 0's, for a
; picture whose palette changes by row, which is why Main calls it
; every frame for one
PROC Commit()
  WaitVBlank()
  VID_BORDER = pic_head(5)
  PAL_IDX = 0
  ASM
    LDW  X,#v_pic_pal
    MOV  R3,#0
.pal: LD   R0,[X]
    INCW X
    ST   [v_PAL_DATA],R0
    LD   R0,[X]
    INCW X
    ST   [v_PAL_DATA],R0
    SUB  R3,#1
    BNE  .pal
  ENDASM
RETURN

; LoadRpl(k) -- picture k's change list, NAME.RPL beside it, into
; memory: 1, or 0 if there is none or it asks for more than Raster()
; has the clocks to write
FUNC BYTE LoadRpl(BYTE k)
  BYTE i
  FOR i = 0 TO 7 DO rpl_name(i + 1) = pic_stem(k * 8 + i) OD
  IF NOT DiskFind(pic_vol, rpl_name) THEN RETURN (0) FI
  IF disk_len > RPL_MAX OR disk_len < 8 THEN RETURN (0) FI
  DiskOpen(pic_vol)
  FlashRead(rpl_head, 8)
  rpl = RPL_AT
  FlashRead(rpl, disk_len - 8)
  FlashClose()
  IF rpl_head(0) <> 'R' OR rpl_head(1) <> 'P' OR rpl_head(2) <> 'L' OR rpl_head(3) <> 1 OR rpl_head(4) <> 240 OR rpl_head(5) <> HOT OR rpl_head(6) > FREE THEN
    RETURN (0)
  FI
RETURN (1)

; Show(k) -- picture k on the screen: 1, or 0 if it is not one this
; knows how to show
FUNC BYTE Show(BYTE k)
  pic_raster = 0
  disk_page = pic_page(k)
  DiskOpen(pic_vol)
  FlashRead(pic_head, 8)
  FlashClose()
  IF pic_head(0) <> 'P' OR pic_head(1) <> 'I' OR pic_head(2) <> 'C' OR pic_head(4) <> 6 THEN
    RETURN (0)
  FI
  IF pic_head(3) == 2 THEN
    IF NOT LoadRpl(k) THEN RETURN (0) FI
  ELSEIF pic_head(3) <> 1 THEN
    RETURN (0)
  FI
  disk_page = pic_page(k)
  DiskOpen(pic_vol)
  FlashRead(pic_head, 8)
  FlashRead(pic_pal, 512)
  Black()
  ; the pixels, port to port: 240 rows of 256. A compiled WHILE took 37
  ; clocks a byte; the loop is 14, and FLS_DATA holds each read off
  ; until the flash has the byte, 34 clocks after the last
  VRAM_ADDR = VID_BASE
  VRAM_STEP = 1
  ASM
    MOV  R3,#240
.row: MOV  R2,#0
.px:  LD   R0,[v_FLS_DATA]
    ST   [v_VRAM_DATA],R0
    SUB  R2,#1
    BNE  .px
    SUB  R3,#1
    BNE  .row
  ENDASM
  FlashClose()
  Commit()
  pic_raster = pic_head(3) == 2
RETURN (1)

; Raster() -- one frame of a version-2 picture's palette, from the top.
;
; VID_RASTER is the low eight bits of the line *about* to be drawn, and
; it changes 71 clocks before the palette is read for that line's first
; picture pixel -- cool8_video's crossing puts the change at pixel 648
; to 650 of the line before, and cool8_pixel reads the palette a pixel
; ahead of the pins (04-system.md section 5.9). So each row's two slots
; go the moment its first line is named: the poll sees the change at
; most 8 clocks late, and the second slot commits 52 clocks after that
; read -- 60 of the 71 at worst. The next row's changes follow, written
; while this row is drawn: they are to entries this row does not use,
; so they may land anywhere in its two lines, and fourteen at 30 clocks
; leave 34 of the 532 to spare. Row 0's palette is Commit's, in the
; blank; the wait is for line 524, whose low byte is 12, and then line
; 0, because line 512's low byte is 0 as well.
PROC Raster()
  ASM
    LDW  X,#c_RPL_AT
    MOV  R3,#12
.wv: LD   R0,[v_VID_RASTER]
    CMP  R0,R3
    BNE  .wv
    CLR  R3
    MOV  R1,#240
.wr: LD   R0,[v_VID_RASTER]
    CMP  R0,R3
    BNE  .wr
    LD   R0,[X]
    INCW X
    ST   [v_PAL_IDX],R0
    LD   R0,[X]
    INCW X
    ST   [v_PAL_DATA],R0
    LD   R0,[X]
    INCW X
    ST   [v_PAL_DATA],R0
    LD   R0,[X]
    INCW X
    ST   [v_PAL_IDX],R0
    LD   R0,[X]
    INCW X
    ST   [v_PAL_DATA],R0
    LD   R0,[X]
    INCW X
    ST   [v_PAL_DATA],R0
    LD   R2,[X]
    INCW X
    CMP  R2,#0
    BEQ  .nf
.fr: LD   R0,[X]
    INCW X
    ST   [v_PAL_IDX],R0
    LD   R0,[X]
    INCW X
    ST   [v_PAL_DATA],R0
    LD   R0,[X]
    INCW X
    ST   [v_PAL_DATA],R0
    SUB  R2,#1
    BNE  .fr
.nf: ADD  R3,#2
    SUB  R1,#1
    BNE  .wr
  ENDASM
RETURN

; Advance(k) -- the first picture from k on, round the drive, that
; shows: its number, or $FF when none will
FUNC BYTE Advance(BYTE k)
  BYTE tries
  FOR tries = 1 TO npics DO
    IF k >= npics THEN k = 0 FI
    IF Show(k) THEN RETURN (k) FI
    k += 1
  OD
RETURN ($FF)

; Nothing() -- no picture on the drive: say so where a person is
; looking, in colours of its own, and restart the machine at a key
PROC Nothing()
  Graphics(0)
  SetColor(0, $000)
  SetColor(15, $FFF)
  Border(0)
  TextFill(' ', $0F)
  TextAt(2, 2, "SLIDES: NO PICTURES ON THE PICTURE DRIVE", $0F)
  TextAt(2, 4, "python tools/mkpics.py --fetch downloads them, poe demos puts them there", $0F)
  TextAt(2, 6, "PRESS A KEY", $0F)
  WHILE ReadKey() == 0 DO OD
  Reset()
RETURN

PROC Main()
  BYTE k
  ; the text cursor is its own overlay, drawn in every mode, and BASIC
  ; leaves it on through SYS and the loader: without this it blinks in
  ; the middle of the picture
  Cursor(0)
  Scan()
  IF npics == 0 THEN Nothing() FI
  Black()
  Graphics(6)
  k = Advance(0)
  IF k == $FF THEN Nothing() FI
  ; a frame: row 0's palette in the blank for a picture that changes it
  ; by row, the keys, and the rows
  DO
    IF pic_raster THEN Commit() ELSE WaitVBlank() FI
    KeyPoll()
    IF KeyHit(KEY_ESC) THEN Reset() FI
    IF KeyHit(KEY_SPACE) THEN k = Advance(k + 1) FI
    IF pic_raster THEN Raster() FI
  OD
RETURN
