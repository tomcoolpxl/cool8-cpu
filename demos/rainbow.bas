4 REM
5 REM RAINBOW BOUNCING LINE WITH 15-LINE TRAIL
6 REM
10 MODE 4
12 CURSOR 0
14 REM
15 REM BLACK BACKGROUND, 15-COLOR RAINBOW PALETTE.
16 REM PALETTE WAS A STATEMENT ONCE AND IS NOT ANY MORE:
17 REM IT IS PAL_IDX THEN PAL_DATA TWICE, HIGH BYTE
18 REM FIRST, WHICH IS WHAT THE DATA PAIRS BELOW ARE.
19 REM
20 FOR I=0 TO 15
30 POKE $FF1E,I:READ H,L:POKE $FF1F,H:POKE $FF1F,L
40 NEXT I
50 DATA 0,0,15,2,15,5,15,9
60 DATA 15,13,13,15,9,15,5,15
70 DATA 2,15,2,175,2,255,2,250
80 DATA 2,245,6,242,11,242,15,242
90 CLG 0
184 REM
185 REM RING BUFFER HOLDS THE ENDPOINTS OF 15 OLD LINES
186 REM
190 DIM A(14)
200 DIM B(14)
210 DIM C(14)
220 DIM D(14)
224 REM
225 REM TWO INDEPENDENT LINE ENDPOINTS: M,N AND O,P
226 REM
230 M=24
240 N=20
250 O=295
260 P=215
264 REM
265 REM VELOCITIES FOR EACH ENDPOINT
266 REM
270 Q=5
280 R=4
290 S=0-4
300 T=5
304 REM
305 REM J IS THE CURRENT SLOT IN THE 15-LINE TRAIL
306 REM
310 J=0
314 REM
315 REM INITIALISE TRAIL BUFFER AT THE START POSITION
316 REM
320 FOR I=0 TO 14
330 A(I)=M
340 B(I)=N
350 C(I)=O
360 D(I)=P
370 NEXT I
379 REM
380 REM EACH FRAME: ERASE OLDEST, MOVE, BOUNCE, DRAW NEWEST
381 REM
389 REM
390 REM COLOR J+1 MAKES THE TRAIL CYCLE THROUGH ALL 15 COLORS
391 REM
400 DO
410 VSYNC
420 LINE A(J),B(J),C(J),D(J),0
430 M=M+Q
440 IF M<4 THEN Q=0-Q
450 IF M<4 THEN M=4
460 IF M>315 THEN Q=0-Q
470 IF M>315 THEN M=315
480 N=N+R
490 IF N<4 THEN R=0-R
500 IF N<4 THEN N=4
510 IF N>235 THEN R=0-R
520 IF N>235 THEN N=235
530 O=O+S
540 IF O<4 THEN S=0-S
550 IF O<4 THEN O=4
560 IF O>315 THEN S=0-S
570 IF O>315 THEN O=315
580 P=P+T
590 IF P<4 THEN T=0-T
600 IF P<4 THEN P=4
610 IF P>235 THEN T=0-T
620 IF P>235 THEN P=235
630 A(J)=M
640 B(J)=N
650 C(J)=O
660 D(J)=P
670 LINE M,N,O,P,J+1
680 J=J+1
690 IF J>14 THEN J=0
700 LOOP
