  -71 -70 -69 -69 -68 -67 -67 -66 -65 -65 -64 -63 -63 -62 -61 -61
  -60 -59 -58 -58 -57 -56 -56 -55 -54 -54 -53 -52 -51 -51 -50 -49
  -49 -48 -47 -46 -46 -45 -44 -44 -43 -42 -41 -41 -40 -39 -38 -38
  -37 -36 -35 -35 -34 -33 -32 -32 -31 -30 -29 -29 -28 -27 -26 -26
  -25 -24 -23 -22 -22 -21 -20 -19 -19 -18 -17 -16 -16 -15 -14 -13
  -12 -12 -11 -10 -9 -9 -8 -7 -6 -5 -5 -4 -3 -2 -2 -1]
; 256 * FOCAL / depth, for bins two model units deep from DIST - 2 * ZBIAS
BYTE ARRAY rz(136) = [
  252 251 250 248 247 246 244 243 242 241 239 238 237 236 235 233 232
  231 230 229 228 226 225 224 223 222 221 220 219 218 217 216 215 214
  213 212 211 210 209 208 207 206 205 204 203 203 202 201 200 199 198
  197 197 196 195 194 193 192 192 191 190 189 188 188 187 186 185 185
  184 183 182 182 181 180 180 179 178 178 177 176 176 175 174 174 173
  172 172 171 170 170 169 168 168 167 167 166 165 165 164 164 163 163
  162 161 161 160 160 159 159 158 158 157 156 156 155 155 154 154 153
  153 152 152 151 151 150 150 149 149 148 148 147 147 147 146 146 145]
CONST DIST = 500                     ; the camera, model units from the ship's centre
CONST FOCAL = 360
CONST ZBIAS = 68                     ; Z's high byte plus this is the depth bin
CONST CX = 128
CONST CY = 120
CONST YAWR = $0180                  ; the angles' steps a frame
CONST PITCHR = $00D3
CONST ROLLR = $0111
; ---- end of the generated block ----

BYTE ARRAY pg(2) = [$00 $78]         ; the two pages' high bytes, 30,720 bytes apart
BYTE ARRAY sx(28), sy(28)            ; this frame's vertices on the screen
BYTE ARRAY fv(13) = [0]              ; the faces: 1 turned to the viewer, kept frame to frame
BYTE ARRAY mp(9)                     ; the rotation, 127 to a unit, every entry + 128
CARD ARRAY kr(3)                     ; a row's 128 * sum + 49152, which Transform takes off
BYTE ARRAY lst(304)                  ; each page's last frame: x0 y0 x1 y1 an edge
BYTE ARRAY nl(2)                     ; and how many edges it has
CARD yaw, pitch, roll                ; the angles: 256 steps a turn in the high byte
CARD frames                          ; passes of the loop -- one a frame while it keeps up
BYTE cur = [0]                       ; the page being drawn
BYTE clean = [0]                     ; the gate's: clear a page rather than redraw its frame black
CARD lp                              ; Lines(): the list,
BYTE ln, lc                          ;   how many edges, and their colour
BYTE tv, trr                         ; Transform(), Faces(): the vertex or face; a vertex's depth's reciprocal

; Row(r, m0, m1, m2) -- row r of the rotation as Transform wants it: the
; entries with 128 added, and 128 times their sum plus 49152
PROC Row(BYTE r, INT m0, INT m1, INT m2)
  BYTE k
  k = r * 3
  mp(k) = m0 + 128
  mp(k + 1) = m1 + 128
  mp(k + 2) = m2 + 128
  kr(r) = (m0 + m1 + m2) * 128 + 49152
RETURN

; Matrix() -- this frame's rotation: roll x pitch x yaw, from the sine
; table at 127 to a unit, every product of two brought back by seven
; bits, rounded (an INT shift floors; 64 first rounds). An angle's top
; ten bits index the table, so the three rates step it evenly: with 256
; steps, a yaw of 1.5 a frame went 1, 2, 1, 2 and the ship shivered.
; tools/mk3d.py runs the same arithmetic over every pose and checks each
; product stays inside an INT
PROC Matrix()
  INT sa, ca, sb, cb, sc, cc, t, u
  CARD a
  a = yaw >> 6
  sa = sn(a)
  a = (a + 256) & 1023
  ca = sn(a)
  a = pitch >> 6
  sb = sn(a)
  a = (a + 256) & 1023
  cb = sn(a)
  a = roll >> 6
  sc = sn(a)
  a = (a + 256) & 1023
  cc = sn(a)
  t = (sb * sa + 64) >> 7
  u = (sb * ca + 64) >> 7
  Row(0, (cc * ca - sc * t + 64) >> 7, -((sc * cb + 64) >> 7), (cc * sa + sc * u + 64) >> 7)
  Row(1, (sc * ca + cc * t + 64) >> 7, (cc * cb + 64) >> 7, (sc * sa - cc * u + 64) >> 7)
  Row(2, -((cb * sa + 64) >> 7), sb, (cb * ca + 64) >> 7)
RETURN

; Transform() -- the 28 vertices through this frame's rotation and the
; perspective, into sx() and sy().
;
; **No sign in a product.** MUL is unsigned and a coordinate and an
; entry are both signed, so each carries 128 (vb, mp): m.v is then
; sum(m'v') - 128 sum(m) - 128 sum(v) - 49152, and modulo 65,536 that is
; exactly right, because the answer is inside 16 bits. kr() holds the
; row's half of it and each vertex record its own, so a multiply-add is
; a MUL, two moves and an add with carry. Z goes first: its high byte is
; the depth bin, and the reciprocal there, times |X| >> 7, is how far
; from the centre the vertex lands -- a second MUL's high byte.
PROC Transform()
  ASM
    LDW  Y,#v_vb
    CLR  R0
    ST   [v_tv],R0
.v: CLR  R2
    CLR  R3
    LD   R0,[v_mp+6]
    LD   R1,[Y+0]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mp+7]
    LD   R1,[Y+1]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mp+8]
    LD   R1,[Y+2]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_kr+4]
    SUB  R2,R0
    LD   R0,[v_kr+5]
    SBC  R3,R0
    LD   R0,[Y+3]
    SUB  R2,R0
    LD   R0,[Y+4]
    SBC  R3,R0
    ADD  R3,#c_ZBIAS
    LDW  X,#v_rz
    LD   R0,[X+R3]
    ST   [v_trr],R0
    CLR  R2
    CLR  R3
    LD   R0,[v_mp+0]
    LD   R1,[Y+0]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mp+1]
    LD   R1,[Y+1]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mp+2]
    LD   R1,[Y+2]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_kr+0]
    SUB  R2,R0
    LD   R0,[v_kr+1]
    SBC  R3,R0
    LD   R0,[Y+3]
    SUB  R2,R0
    LD   R0,[Y+4]
    SBC  R3,R0
    CLR  R1
    TST  R3
    BPL  .xp
    NOT  R2
    NOT  R3
    ADD  R2,#1
    ADC  R3,#0
    MOV  R1,#1
.xp: ADD  R2,R2
    ADC  R3,R3
    LD   R0,[v_trr]
    MUL  R3,R0
    MOV  R0,XH
    TST  R1
    BNE  .xl
    ADD  R0,#c_CX
    BRA  .xs
.xl: MOV  R2,#c_CX
    SUB  R2,R0
    MOV  R0,R2
.xs: LD   R1,[v_tv]
    LDW  X,#v_sx
    ST   [X+R1],R0
    CLR  R2
    CLR  R3
    LD   R0,[v_mp+3]
    LD   R1,[Y+0]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mp+4]
    LD   R1,[Y+1]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mp+5]
    LD   R1,[Y+2]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_kr+2]
    SUB  R2,R0
    LD   R0,[v_kr+3]
    SBC  R3,R0
    LD   R0,[Y+3]
    SUB  R2,R0
    LD   R0,[Y+4]
    SBC  R3,R0
    CLR  R1
    TST  R3
    BPL  .yp
    NOT  R2
    NOT  R3
    ADD  R2,#1
    ADC  R3,#0
    MOV  R1,#1
.yp: ADD  R2,R2
    ADC  R3,R3
    LD   R0,[v_trr]
    MUL  R3,R0
    MOV  R0,XH
    TST  R1
    BNE  .yl
    MOV  R2,#c_CY
    SUB  R2,R0
    MOV  R0,R2
    BRA  .ys
.yl: ADD  R0,#c_CY
.ys: LD   R1,[v_tv]
    LDW  X,#v_sy
    ST   [X+R1],R0
    ADDW Y,#5
    LD   R0,[v_tv]
    ADD  R0,#1
    ST   [v_tv],R0
    CMP  R0,#28
    BNE  .v
  ENDASM
RETURN

; Faces() -- which faces are turned to the viewer: each normal through
; the rotation's Z row, less the face's threshold, into fv(); negative
; is turned to the viewer. A record in nb is a vertex's shape, so this
; is Transform's Z, the same biased multiply-add, and the sign of its
; high byte is the answer.
;
; **Not the area on the screen.** A face's triangle there has the right
; sign wherever it is open, but near edge-on its area is the rounding of
; its corners -- tens of units, either way, frame to frame, on a long
; thin face -- and an edge flicked off for one frame and on again; a
; margin flickered, and so did hysteresis on the area. The normal is
; the triangle's own (tools/mk3d.py), so where the area is decisive the
; two agree, and in 3D there is nothing to round but the matrix.
;
; **With 256 of hysteresis**, one in the high byte, 0.9 degrees: a face
; turned to the viewer stays so until it is 256 past, and one turned
; away turns in only 256 short. Without it the matrix's rounding still
; flicked a face crossing edge-on slowly, and an edge whose two faces
; are both within a degree of edge-on for a frame went out for it.
PROC Faces()
  ASM
    LDW  Y,#v_nb
    CLR  R0
    ST   [v_tv],R0
.f: CLR  R2
    CLR  R3
    LD   R0,[v_mp+6]
    LD   R1,[Y+0]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mp+7]
    LD   R1,[Y+1]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mp+8]
    LD   R1,[Y+2]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_kr+4]
    SUB  R2,R0
    LD   R0,[v_kr+5]
    SBC  R3,R0
    LD   R0,[Y+3]
    SUB  R2,R0
    LD   R0,[Y+4]
    SBC  R3,R0
    LD   R1,[v_tv]
    LDW  X,#v_fv
    LD   R0,[X+R1]
    TST  R0
    BEQ  .fo
    SUB  R3,#1
    BRA  .fs
.fo: ADD  R3,#1
.fs: CLR  R0
    TST  R3
    BPL  .fw
    MOV  R0,#1
.fw: ST   [X+R1],R0
    ADDW Y,#5
    ADD  R1,#1
    ST   [v_tv],R1
    CMP  R1,#13
    BNE  .f
  ENDASM
RETURN

; Visible() -- this frame's edges, those bordering a face turned to the
; viewer, into the page's list, four bytes an edge
PROC Visible()
  BYTE e, n, a, b
  BYTE POINTER w
  w = lst
  IF cur THEN w += 152 FI
  n = 0
  FOR e = 0 TO 37 DO
    IF fv(ef1(e)) OR fv(ef2(e)) THEN
      a = ea(e)
      b = eb(e)
      *w = sx(a)
      w += 1
      *w = sy(a)
      w += 1
      *w = sx(b)
      w += 1
      *w = sy(b)
      w += 1
      n += 1
    FI
  OD
  nl(cur) = n
RETURN

; Lines() -- ln edges from the list at lp, in colour lc.
;
; **The port only steps +1**, so every line runs the way it does: one
; along X is drawn left to right, PIX_DATA stepping X, and one along Y
; top to bottom, PIX_DATA_Y stepping Y. The other axis is a coordinate
; in X, stepped by INCW or DECW and written with one STW -- low byte the
; coordinate, high byte the port's zero -- when the error runs out; the
; count is in Y. R0 is the colour, R1 the error, R2 and R3 the two
; distances, all eight bits because nothing on this screen is wider. A
; pixel is 14 clocks; one where the other axis steps, 23.
PROC Lines()
  ASM
    CLR  R0
    ST   [v_PIX_X_H],R0
    ST   [v_PIX_Y_H],R0
.ln: LDW  Y,[v_lp]
    LD   R1,[Y+1]
    LD   R3,[Y+3]
    CMP  R1,R3
    BHI  .sw
    LD   R0,[Y+0]
    LD   R2,[Y+2]
    BRA  .go
.sw: LD   R0,[Y+2]
    LD   R2,[Y+0]
    LD   R1,[Y+3]
    LD   R3,[Y+1]
.go: ADDW Y,#4
    STW  [v_lp],Y
    ST   [v_PIX_X_L],R0
    ST   [v_PIX_Y_L],R1
    SUB  R3,R1
    SUB  R2,R0
    BCC  .lf
    CMP  R2,R3
    BCC  .ryd
    LDW  X,#0
    MOV  XL,R1
    LDW  Y,#1
    ADDW Y,R2
    MOV  R1,R2
    SHR  R1
    LD   R0,[v_lc]
.rx: ST   [v_PIX_DATA],R0
    SUB  R1,R3
    BCS  .rx1
    ADD  R1,R2
    INCW X
    STW  [v_PIX_Y_L],X
.rx1: DECW Y
    BNE  .rx
    BRA  .nx
.ryd: LDW  X,#0
    MOV  XL,R0
    LDW  Y,#1
    ADDW Y,R3
    MOV  R1,R3
    SHR  R1
    LD   R0,[v_lc]
.ry: ST   [v_PIX_DATA_Y],R0
    SUB  R1,R2
    BCS  .ry1
    ADD  R1,R3
    INCW X
    STW  [v_PIX_X_L],X
.ry1: DECW Y
    BNE  .ry
    BRA  .nx
.lf: NOT  R2
    ADD  R2,#1
    CMP  R2,R3
    BCC  .lyd
    SUB  R0,R2
    ST   [v_PIX_X_L],R0
    ADD  R1,R3
    ST   [v_PIX_Y_L],R1
    LDW  X,#0
    MOV  XL,R1
    LDW  Y,#1
    ADDW Y,R2
    MOV  R1,R2
    SHR  R1
    LD   R0,[v_lc]
.lx: ST   [v_PIX_DATA],R0
    SUB  R1,R3
    BCS  .lx1
    ADD  R1,R2
    DECW X
    STW  [v_PIX_Y_L],X
.lx1: DECW Y
    BNE  .lx
    BRA  .nx
.lyd: LDW  X,#0
    MOV  XL,R0
    LDW  Y,#1
    ADDW Y,R3
    MOV  R1,R3
    SHR  R1
    LD   R0,[v_lc]
.ly: ST   [v_PIX_DATA_Y],R0
    SUB  R1,R2
    BCS  .ly1
    ADD  R1,R3
    DECW X
    STW  [v_PIX_X_L],X
.ly1: DECW Y
    BNE  .ly
.nx: LD   R0,[v_ln]
    SUB  R0,#1
    ST   [v_ln],R0
    BNE  .ln
  ENDASM
RETURN

; Draw(p, c) -- page p's list in colour c: 0 erases the frame it holds
PROC Draw(BYTE p, BYTE c)
  lp = lst
  IF p THEN lp += 152 FI
  ln = nl(p)
  lc = c
  IF ln THEN Lines() FI
RETURN

PROC Main()
  Graphics(6)                        ; 256 x 240 on 480 lines ...
  VID_CTRL = $3A                     ; ... at 4 bits a pixel, doubled both ways
  VID_STRIDE = 128
  Cursor(0)
  Border(0)
  SetColor(0, $000)
  SetColor(1, $FFF)
  VID_BASE_H = $78
  Clg(0)
  VID_BASE_H = 0
  Clg(0)
  VID_DBASE_H = $78                  ; a cleared page on the glass, page 0 the pencil
  VID_CTRL = $7A                     ; the double buffer on: DBASE is the glass, BASE the pencil
  DO
    IF clean THEN Clg(0) ELSE Draw(cur, 0) FI
    yaw += YAWR
    pitch += PITCHR
    roll += ROLLR
    Matrix()
    Transform()
    Faces()
    Visible()
    Draw(cur, 1)
    frames += 1
    VID_DBASE_H = pg(cur)            ; the finished page, for the glass --
    WaitVBlank()                     ; which takes it at the frame start
    cur = cur XOR 1
    VID_BASE_H = pg(cur)             ; and the page that was on it is drawn on
  UNTIL Key() OD
  Graphics(0)
  Cursor(1)
RETURN
