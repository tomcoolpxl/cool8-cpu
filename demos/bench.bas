1144 PRINT "DRAGON 32/64  ";
1146 GOSUB 1400
1148 PRINT "ORIC ATMOS    ";
1150 GOSUB 1400
1152 PRINT "ZX SPECTRUM   ";
1154 GOSUB 1400
1156 PRINT "TI-99/4A      ";
1158 GOSUB 1400
1180 PRINT
1190 PRINT "BM8 AS 0 MEANS THE SOURCE DID NOT PUBLISH ONE."
1200 END
1400 FOR I=1 TO 8
1402 READ V
1403 V=V/10
1404 PRINT " ";
1406 GOSUB 9300
1408 NEXT I
1410 PRINT
1420 RETURN
9200 V=T(I)
9300 REM PRINT V IN SIX COLUMNS, TWO DECIMALS
9310 V=INT(V*100+0.5)/100
9320 A$=STR$(V)
9330 IF LEN(A$)>=6 THEN GOTO 9345
9335 A$=" "+A$
9340 GOTO 9330
9345 PRINT A$;
9350 RETURN
