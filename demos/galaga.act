; GALAGA -- the arcade Galaga (Namco, 1981) on COOL8, in CoolAction!
;
; The picture is the original's: the fighters, the bees, the butterflies,
; the bosses and the font are the arcade's own pixels, ripped from the
; sheets in assets/galaga/ by tools/mkgalaga.py, in the arcade's own
; fifteen colours. The sprite patterns are GALAGA.DAT, which this
; program finds on drive 11 and streams into VRAM; what the CPU reads as
; it plays is assets/galaga/galaga_art.act, compiled in front of this
; file (demos/galaga.parts names it).
;
; **Mode 4, a bitmap, because of the formation.** Forty characters in
; rows of ten cannot be sprites -- a sixteen-pixel character over a
; doubled mode is four of the thirty-two, and eight a line is two of them
; -- and the formation sways and breathes a pixel at a time in both
; axes, twelve pixels a row apart, which a tile map could only do with a
; tile for every way two characters overlap a cell. So a character at
; rest is drawn into the bitmap, and moving it a pixel writes only the
; pixels that change (fm_delta). Everything that flies is sprites.
;
; **The arcade's coordinates are kept.** The board positions a sprite by
; a nine-bit Y whose top is 40 above the screen's and an X 17 left of it
; (MAME's galaga_v.cpp: sx - 40, and 256 - sy + 1 on the other axis), on
; a 224 x 288 portrait screen whose playfield is rows 16-271. Here the
; field is 224 wide in the middle of the 320 and 240 tall, so a
; coordinate is mapped: X + 31 across, and down the screen rows 16-151
; one for one -- the formation, which never goes lower -- and the 120
; rows below them into 88, so the fighter's row lands on the bottom.
;
; Keys: the cursor keys or Z and X move the fighter, space fires, P
; pauses, Esc gives up the game.

; --------------------------------------------------------------- layout
CONST SPR_BASE = $9600               ; the sprite patterns, above the 38,400-byte bitmap
CONST DRIVE = 11                     ; the drive the demos disc keeps GALAGA.DAT on
CONST FX = 48                        ; the field's left edge on the screen
CONST FW = 224

; keys, as KeyHeld wants them: $80 + the $E0-prefixed code
CONST KEY_LEFT = $EB
CONST KEY_RIGHT = $F4
CONST KEY_Z = $1A
CONST KEY_X = $22
CONST KEY_SPACE = $29
CONST KEY_ESC = $76
CONST KEY_P = $4D

; colours: tools/mkgalaga.py's order -- 0-7 are the ones the bitmap uses
; low on the field, which a backdrop's raster split leaves alone
CONST C_WHITE = 1
CONST C_RED = 2
CONST C_YELLOW = 3
CONST C_CYAN = 4
CONST C_BEAM = 5
CONST C_BLUE = 6
CONST C_ORANGE = 7
CONST C_GREEN = 12

; sprite descriptors: a lower number is drawn over a higher one
CONST SP_FIGHTER = 0                 ; four
CONST SP_SHOT = 4                    ; two

; --------------------------------------------------------------- the game
CARD loops                           ; frames of play the loop has run, for the gate
BYTE level_bd                        ; the backdrop showing, 0-3
BYTE tx_y                            ; a text in the field the stars keep out of: its row, 0 none
INT fx                               ; the fighter's top-left on the field
CONST FIGHTER_Y = 224
BYTE quit

; ------------------------------------------------------------ data file
BYTE ARRAY dat_name = "GALAGA  DAT"
CARD dat_lo
BYTE dat_hi
CARD st_n

FUNC BYTE OpenData()
  IF DiskFind(DRIVE, dat_name) == 0 THEN RETURN (0) FI
  dat_lo = disk_page << 8
  dat_hi = disk_page >> 8
  dat_hi += $10 + DRIVE * 7
RETURN (1)

; Stream(off, hi, vaddr, n): n bytes of the data file from hi:off into
; VRAM at vaddr, at the flash's own rate
PROC Stream(CARD off, BYTE hi, CARD vaddr, CARD n)
  CARD a
  BYTE h
  a = dat_lo + off
  h = dat_hi + hi
  IF a < off THEN h += 1 FI
  FlashOpen(a, h)
  VRAM_ADDR = vaddr
  VRAM_STEP = 1
  st_n = n
  ASM
    LDW  X,[v_st_n]
    MOV  R0,XL
    MOV  R1,XH
    OR   R0,R1
    BEQ  .d
.l: LD   R0,[v_FLS_DATA]
    ST   [v_VRAM_DATA],R0
    DECW X
    BNE  .l
.d:
  ENDASM
  FlashClose()
RETURN

; Load(off, hi, dst, n): n bytes of the data file from hi:off into memory
; at dst -- a stage's waves, a level's tune
CARD ld_dst
PROC Load(CARD off, BYTE hi, CARD dst, CARD n)
  CARD a
  BYTE h
  a = dat_lo + off
  h = dat_hi + hi
  IF a < off THEN h += 1 FI
  FlashOpen(a, h)
  st_n = n
  ld_dst = dst
  ASM
    LDW  X,[v_st_n]
    LDW  Y,[v_ld_dst]
.l: LD   R0,[v_FLS_DATA]
    ST   [Y+],R0
    DECW X
    BNE  .l
  ENDASM
  FlashClose()
RETURN

; ---------------------------------------------------------------- music
; The level's own tune (tools/mkgalaga.py writes them out): eighths of a
; few frames each, three tone tracks and the drums. A note rises to its
; track's peak and falls to its sustain frame by frame, faster once let
; go -- a held lead with a vibrato once it has sounded a while, a bass
; that punches and fades, an arpeggio that is plucked -- and the drums
; are shaped noise and a falling kick on voice 7. The tone tracks give
; voices 0-2 to the arcade's tunes whenever one plays, and go on beneath.
BYTE mus_on, mus_step, mus_t
CARD mus_p, mus_loop
CARD ARRAY mv_inc(3)                 ; each track's note, and its voice now
BYTE ARRAY mv_vol(3), mv_gate(3), mv_age(3)
BYTE ARRAY mv_peak(3) = [9 10 7]
BYTE ARRAY mv_sus(3) = [7 5 0]
BYTE ARRAY mv_dec(3) = [4 3 1]       ; frames a volume step while held
BYTE ARRAY mv_rel(3) = [2 2 2]       ; volume a frame once let go
CARD ARRAY mv_out(3)                 ; the increment played, the vibrato in it
BYTE dr_k, dr_t, dr_cur
CARD dr_inc
; the drums, by number: 1 hat, 2 snare, 3 kick, 4 open hat, 5 crash
CARD ARRAY dr_pitch(6) = [0 12000 3000 420 12000 7000]
BYTE ARRAY dr_vol(6) = [0 6 10 12 7 10]
BYTE ARRAY dr_fall(6) = [0 3 2 2 1 1]

PROC MusicStop()
  BYTE c
  mus_on = 0
  FOR c = 0 TO 2 DO
    mv_vol(c) = 0
    mv_gate(c) = 0
  OD
  dr_k = 0
RETURN

BYTE ARRAY mus_data(MUS_MAX)          ; the level's tune, loaded from the MUSIC block
BYTE mus_level                       ; the tune loaded, 255 none
PROC MusicStart(BYTE n)
  MusicStop()
  IF n != mus_level THEN
    Load(D_MUSIC + mus_off(n), DH_MUSIC, mus_data, mus_off(n + 1) - mus_off(n))
    mus_level = n
  FI
  mus_p = 0
  mus_step = mus_data(mus_p)
  mus_p += 1
  mus_loop = mus_p
  mus_t = 1
  mus_on = 1
RETURN

PROC MusicEighth()
  BYTE m, c, b
  m = mus_data(mus_p)
  IF m & $80 THEN
    mus_p = mus_loop
    m = mus_data(mus_p)
  FI
  mus_p += 1
  FOR c = 0 TO 2 DO
    IF m & (1 << c) THEN
      b = mus_data(mus_p)
      mus_p += 1
      IF b THEN
        mv_inc(c) = note_inc(b - 1)
        mv_vol(c) = mv_peak(c)
        mv_gate(c) = 1
        mv_age(c) = 0
      ELSE
        mv_gate(c) = 0
      FI
    FI
  OD
  IF m & 8 THEN
    dr_k = mus_data(mus_p)
    mus_p += 1
    dr_t = 0
    dr_inc = dr_pitch(dr_k)
  FI
RETURN

; MusicFrame: a frame of the tune -- the eighth if it is due, the
; envelopes, the vibrato, the drum
PROC MusicFrame()
  BYTE c, v, ph
  CARD i, d
  INT dv
  IF mus_on == 0 THEN RETURN FI
  mus_t -= 1
  IF mus_t == 0 THEN
    MusicEighth()
    mus_t = mus_step
  FI
  FOR c = 0 TO 2 DO
    v = mv_vol(c)
    IF v THEN
      IF mv_age(c) < 255 THEN mv_age(c) += 1 FI
      IF mv_gate(c) THEN
        IF v > mv_sus(c) AND mv_age(c) % mv_dec(c) == 0 THEN v -= 1 FI
      ELSEIF v > mv_rel(c) THEN
        v -= mv_rel(c)
      ELSE
        v = 0
      FI
      mv_vol(c) = v
    FI
    i = mv_inc(c)
    IF c == 0 AND mv_age(0) > 12 THEN
      ph = (mv_age(0) >> 2) & 3
      d = i >> 7
      IF ph == 1 THEN i += d ELSEIF ph == 3 THEN i -= d FI
    FI
    mv_out(c) = i
  OD
  IF dr_k THEN
    dv = dr_vol(dr_k)
    dv = dv - dr_t * dr_fall(dr_k)
    IF dv <= 0 THEN
      dr_k = 0
    ELSE
      dr_cur = dv
      IF dr_k == 3 THEN dr_inc = dr_inc - (dr_inc >> 3) FI
      dr_t += 1
    FI
  FI
RETURN

; ---------------------------------------------------------------- sound
; The arcade's sounds are streams tools/galaga_sound.py rendered from its
; sound CPU's driver: each frame every sound playing moves on through its
; stream, then the voices are mixed the driver's way -- the sounds in its
; fixed order, a later one's voice winning, a silent one taking nothing --
; the tunes onto voices 0-2 and the effects onto 3-5, and a voice written
; only when it changes. Voice 6 is the fighter's explosion, noise, which
; the arcade's 54XX makes and no stream carries.
CONST S_PULSE = $00
CONST S_BOSS = $01
CONST S_GOEI = $02
CONST S_ZAKO = $03
CONST S_BOSSHIT = $04
CONST S_START = $0B
CONST S_CHALLENGE = $0D
CONST S_RESULTS = $0E
CONST S_SHOT = $0F
CONST S_DIVE = $13
CONST S_PERFECT = $14
CONST S_BADGE = $15
CONST S_EXTEND = $0A
CONST S_BEAM = $05
CONST S_TRACTOR = $06
CONST S_CAPTURED = $09

BYTE ARRAY snd_on(NSND), snd_wait(NSND)
CARD ARRAY snd_p(NSND)
CARD ARRAY snd_inc(69)               ; each sound's three voices as it holds them
BYTE ARRAY snd_vol(69)
CARD ARRAY mix_inc(6)
BYTE ARRAY mix_vol(6)
CARD ARRAY hw_inc(8)
BYTE ARRAY hw_vol(8)
BYTE boom_snd                        ; the fighter's explosion: frames of noise left

PROC PlaySound(BYTE id)
  BYTE v
  CARD b
  b = id
  b = b * 3
  snd_on(id) = 1
  snd_p(id) = snd_start(id)
  snd_wait(id) = 1
  FOR v = 0 TO 2 DO
    snd_inc(b + v) = 0
    snd_vol(b + v) = 0
  OD
RETURN

PROC StopSound(BYTE id)
  snd_on(id) = 0
RETURN

PROC SoundsOff()
  BYTE i
  FOR i = 0 TO NSND - 1 DO snd_on(i) = 0 OD
  boom_snd = 0
  MusicStop()
RETURN

; SndAdvance(id): a frame of one sound's stream
PROC SndAdvance(BYTE id)
  BYTE mask, v, n
  CARD p, w, b
  b = id
  b = b * 3
  snd_wait(id) -= 1
  n = 0
  WHILE snd_wait(id) == 0 DO
    p = snd_p(id)
    mask = snd_data(p)
    IF mask & $80 THEN
      n += 1
      IF snd_loops(id) == 0 OR n > 1 THEN
        snd_on(id) = 0
        RETURN
      FI
      p = snd_start(id)
      mask = snd_data(p)
    FI
    p += 1
    FOR v = 0 TO 2 DO
      IF mask & (1 << v) THEN
        w = snd_data(p + 1)
        snd_inc(b + v) = (w << 8) | snd_data(p)
        p += 2
      FI
    OD
    FOR v = 0 TO 2 DO
      IF mask & (16 << v) THEN
        snd_vol(b + v) = snd_data(p)
        p += 1
      FI
    OD
    snd_wait(id) = snd_data(p)
    snd_p(id) = p + 1
  OD
RETURN

PROC Voice(BYTE hv, CARD inc, BYTE vol, BYTE noise)
  IF inc != hw_inc(hv) OR vol != hw_vol(hv) THEN
    hw_inc(hv) = inc
    hw_vol(hv) = vol
    IF vol THEN Sound(hv, inc, vol, noise) ELSE Silence(hv) FI
  FI
RETURN

PROC SoundFrame()
  BYTE i, id, v, g, last
  CARD b
  FOR v = 0 TO 5 DO
    mix_inc(v) = 0
    mix_vol(v) = 0
  OD
  FOR i = 0 TO 19 DO
    id = snd_order(i)
    IF snd_on(id) THEN
      SndAdvance(id)
      IF snd_on(id) THEN
        IF snd_tune(id) THEN g = 0 ELSE g = 3 FI
        b = id
        b = b * 3
        last = snd_v0(id) + snd_nv(id) - 1
        FOR v = snd_v0(id) TO last DO
          IF snd_vol(b + v) THEN
            mix_inc(g + v) = snd_inc(b + v)
            mix_vol(g + v) = snd_vol(b + v)
          FI
        OD
      FI
    FI
  OD
  MusicFrame()
  IF TuneOn() == 0 AND mus_on THEN
    FOR v = 0 TO 2 DO
      mix_inc(v) = mv_out(v)
      mix_vol(v) = mv_vol(v)
    OD
  FI
  FOR v = 0 TO 5 DO Voice(v, mix_inc(v), mix_vol(v), 0) OD
  IF dr_k AND mus_on THEN
    IF dr_k == 3 THEN Voice(7, dr_inc, dr_cur, 0) ELSE Voice(7, dr_inc, dr_cur, 1) FI
  ELSE
    Voice(7, 0, 0, 0)
  FI
  IF boom_snd THEN
    boom_snd -= 1
    Voice(6, 180 + boom_snd * 6, boom_snd / 6, 1)
  ELSE
    Voice(6, 0, 0, 1)
  FI
RETURN

; TuneOn: whether a tune is playing, which what waits for one asks
FUNC BYTE TuneOn()
  BYTE i
  FOR i = 0 TO NSND - 1 DO
    IF snd_on(i) AND snd_tune(i) THEN RETURN (1) FI
  OD
RETURN (0)

; ------------------------------------------------------------ the bitmap
; DrawDelta: one of fm_delta's lists, a run being y + 2, x + 1, n and n
; colours, and 0 the end, drawn from the screen's (dd_x, dd_y) -- which
; FmDraw sets two rows up and a column left of the character's top-left
; -- or, with dd_erase, the same pixels written 0. PIX_X's high byte is
; written once, where no run can carry into it, so a run costs 28 clocks
; and a pixel 11. **The port's X is one ten-bit counter**: a pixel
; written at x 255 leaves it at 256, high byte and all, so the next run's
; low byte alone would land 256 further on -- which a 320-wide row wraps
; to 64 pixels left of where it was meant. So the fast way is taken only
; when no pixel of the list can reach x 255, dd_lim being 255 less the
; list's widest reach; the rest take the slow way, which writes both
; bytes run by run.
CARD dd_ptr, dd_x
BYTE dd_y, dd_erase, dd_fx, dd_lim, rs_row, rs_fx

PROC DrawDelta()
  ASM
        LDW  Y,[v_dd_ptr]
        LDW  X,#v_PIX_DATA           ; the port in X: a pixel's store is two clocks
        CLR  R0
        ST   [v_PIX_Y_H],R0
        LD   R1,[v_dd_y]
        LD   R0,[v_dd_erase]
        CMP  R0,#2
        BEQ  .rest
        LD   R3,[v_dd_x]
        LD   R0,[v_dd_lim]
        CMP  R3,R0
        BCS  .slow                   ; a run could reach x 255
        LD   R0,[v_dd_x+1]
        ST   [v_PIX_X_H],R0
        LD   R0,[v_dd_erase]
        BNE  .erase
.run:   LD   R0,[Y+]
        BEQ  .done
        ADD  R0,R1
        ST   [v_PIX_Y_L],R0
        LD   R0,[Y+]
        ADD  R0,R3
        ST   [v_PIX_X_L],R0
        LD   R2,[Y+]
.pix:   LD   R0,[Y+]
        ST   [X],R0
        SUB  R2,#1
        BNE  .pix
        BRA  .run
.erase: LD   R0,[Y+]
        BEQ  .done
        ADD  R0,R1
        ST   [v_PIX_Y_L],R0
        LD   R0,[Y+]
        ADD  R0,R3
        ST   [v_PIX_X_L],R0
        LD   R2,[Y+]
        CLR  R0
.epix:  ST   [X],R0
        INCW Y
        SUB  R2,#1
        BNE  .epix
        BRA  .erase
.slow:  LD   R0,[Y+]
        BEQ  .done
        ADD  R0,R1
        ST   [v_PIX_Y_L],R0
        LD   R0,[Y+]
        ADD  R0,R3
        ST   [v_PIX_X_L],R0
        LD   R0,[v_dd_x+1]
        ADC  R0,#0
        ST   [v_PIX_X_H],R0
        LD   R2,[Y+]
.spix:  LD   R0,[v_dd_erase]
        BEQ  .sdraw
        INCW Y
        CLR  R0
        BRA  .sput
.sdraw: LD   R0,[Y+]
.sput:  ST   [X],R0
        SUB  R2,#1
        BNE  .spix
        BRA  .slow
; putting back: every pixel of the list gets what is under it -- black
; above the band, the backdrop's copy in it, read through the VRAM port
.rest:  LD   R0,[Y+]
        BEQ  .done
        ADD  R0,R1
        ST   [v_PIX_Y_L],R0
        ST   [v_rs_row],R0
        LD   R0,[Y+]
        LD   R2,[v_dd_fx]
        ADD  R0,R2
        ST   [v_rs_fx],R0            ; the field's x
        ADD  R0,#c_FX
        ST   [v_PIX_X_L],R0
        MOV  R0,#0                   ; not CLR, which is SUB and sets the carry
        ADC  R0,#0
        ST   [v_PIX_X_H],R0
        LD   R2,[Y+]
        ADDW Y,R2                    ; its colours are not wanted
        LD   R0,[v_rs_row]
        CMP  R0,#c_BAND_Y
        BCS  .rband
        CLR  R0
.rz:    ST   [X],R0
        SUB  R2,#1
        BNE  .rz
        BRA  .rest
.rband: PUSH R1
        SUB  R0,#c_BAND_Y
        MOV  R3,#112
        MUL  R0,R3                   ; X: the band row's first byte in the copy
        ADDW X,#c_BD_VRAM
        LD   R0,[v_rs_fx]
        MOV  R3,R0
        SHR  R3
        ADDW X,R3
        MOV  R3,XL
        ST   [v_VRAM_ADDR_L],R3
        MOV  R3,XH
        ST   [v_VRAM_ADDR_H],R3
        AND  R0,#1                   ; R0 1 on a pixel in a byte's low nibble
        LD   R3,[v_VRAM_DATA]        ; the byte, and the port on to the next
.rb:    MOV  R1,R3
        TST  R0
        BNE  .rlo
        SWAP R1
        AND  R1,#$0F
        ST   [v_PIX_DATA],R1
        MOV  R0,#1
        SUB  R2,#1
        BNE  .rb
        BRA  .rend
.rlo:   AND  R1,#$0F
        ST   [v_PIX_DATA],R1
        CLR  R0
        SUB  R2,#1
        BEQ  .rend
        LD   R3,[v_VRAM_DATA]
        BRA  .rb
.rend:  POP  R1
        LDW  X,#v_PIX_DATA
        BRA  .rest
.done:
  ENDASM
RETURN

; FmDraw(frame, move, x, y, erase): a formation frame's list with its
; top-left at the field's (x, y) -- move 0 draws or erases it, 1-4 bring
; it there from a pixel left, right, up or down, 5 flaps it
PROC FmDraw(BYTE fr, BYTE mv, BYTE x, BYTE y, BYTE erase)
  CARD i
  i = fr
  i = (i << 2) + (i << 1) + mv
  dd_ptr = fm_delta + fm_off(i)
  dd_x = x
  dd_x = dd_x + FX - 1
  dd_y = y - 2
  dd_erase = erase
  dd_lim = 255 - 17                  ; a character's list reaches x + 17
  DrawDelta()
RETURN

; ArtDraw(k, x, y, mode): bitmap art k with its box's top-left at the
; field's (x, y) -- mode 0 draws it, 2 puts back what was under it
PROC ArtDraw(BYTE k, BYTE x, BYTE y, BYTE mode)
  dd_ptr = art_delta + art_off(k)
  dd_x = x
  dd_x = dd_x + FX - 1
  dd_fx = x - 1
  dd_y = y - 2
  dd_erase = mode
  dd_lim = 255 - 32                  ; an explosion's reaches x + 32
  DrawDelta()
RETURN

; Glyph(ch) -- a character's place in glyphs
FUNC BYTE Glyph(BYTE c)
  IF c >= '0' AND c <= '9' THEN RETURN (c - '0') FI
  IF c >= 'A' AND c <= 'Z' THEN RETURN (c - 'A' + 10) FI
  IF c == '-' THEN RETURN (36) FI
  IF c == '%' THEN RETURN (37) FI
  IF c == '.' THEN RETURN (38) FI
  IF c == '!' THEN RETURN (39) FI
  IF c == '@' THEN RETURN (40) FI
  IF c == '#' THEN RETURN (41) FI
RETURN (42)

; Text(x, y, s, colour): a string in the font, on the screen's pixels
PROC Text(CARD x, BYTE y, BYTE POINTER s, BYTE c)
  BYTE i, n, r, b, k
  CARD g
  n = *s
  FOR i = 1 TO n DO
    s += 1
    g = Glyph(*s)
    g = g * 8
    FOR r = 0 TO 7 DO
      PIX_X = x
      PIX_Y = y + r
      b = glyphs(g + r)
      FOR k = 0 TO 7 DO
        IF b & $80 THEN PIX_DATA = c ELSE PIX_DATA = 0 FI
        b = b << 1
      OD
    OD
    x += 8
  OD
RETURN

; Number(x, y, v, digits, colour): right-aligned, the leading zeros blank
BYTE ARRAY numbuf(8)
PROC Number(CARD x, BYTE y, CARD v, BYTE digits, BYTE c)
  BYTE i
  numbuf(0) = digits
  FOR i = 0 TO digits - 1 DO numbuf(digits - i) = ' ' OD
  i = digits
  DO
    numbuf(i) = '0' + v % 10
    v = v / 10
    i -= 1
  UNTIL v == 0 OR i == 0 OD
  Text(x, y, numbuf, c)
RETURN

; ------------------------------------------------------------- sprites
; ShowChar(sp, frame, h, v, x, y): a sprite frame as the four sprites
; from descriptor sp, its 16 x 16 box's top-left at the screen's (x, y)
; logical, mirrored left-right by h and top-bottom by v
PROC ShowChar(BYTE sp, BYTE fr, BYTE fh, BYTE fv, INT x, INT y)
  BYTE q, p, f, ox, oy
  CARD i, pat
  i = fr
  i = i << 2
  FOR q = 0 TO 3 DO
    p = spr_qp(i)
    IF p == 255 OR y < -16 OR y > 239 THEN
      SpriteHide(sp + q)
    ELSE
      f = spr_qf(i)
      ox = spr_qx(i)
      oy = spr_qy(i)
      IF fh THEN
        ox = 8 - ox
        f = f ^ $40
      FI
      IF fv THEN
        oy = 8 - oy
        f = f ^ $80
      FI
      pat = p
      pat = SPR_BASE + (pat << 7)
      SetSprite(sp + q, (x + ox) << 1, (y + oy) << 1, pat, 1, f)
    FI
    i += 1
  OD
RETURN

PROC HideChar(BYTE sp)
  BYTE q
  FOR q = 0 TO 3 DO SpriteHide(sp + q) OD
RETURN

; Heading(h, fr0): a heading in 24ths of a turn clockwise from up as the
; frame and mirrors for a character whose first frame is fr0 -- the
; sheet's seven go from facing left (0) to facing up (6), and the other
; three quarters are those mirrored
BYTE hd_fr, hd_h, hd_v
PROC Heading(BYTE h, BYTE fr0)
  h = h % 24
  hd_h = 0
  hd_v = 0
  IF h >= 18 THEN
    hd_fr = h - 18
  ELSEIF h <= 6 THEN
    hd_fr = 6 - h
    hd_h = 1
  ELSEIF h >= 12 THEN
    hd_fr = h - 12
    hd_fr = 6 - hd_fr
    hd_v = 1
  ELSE
    hd_fr = h - 6
    hd_h = 1
    hd_v = 1
  FI
  hd_fr += fr0
RETURN

; --------------------------------------------------------- the formation
; Ten columns and six rows of arcade coordinates -- db_fmtn_hpos_orig in
; the disassembly: the columns' X, and the rows' Y as the board stores
; them, which is $160 less twice the byte (c_12C3) -- here as the field's
; top-left of each: X - 17 - 8 across... the X is the sprite's left edge
; already, so X - 17; the rows' tops are Y - 40 - 16 on the field.
BYTE ARRAY col_x0(10) = [32 48 64 80 96 112 128 144 160 176]
BYTE ARRAY row_y0(6) = [4 20 36 48 60 72]
BYTE ARRAY col_x(10)
BYTE ARRAY row_y(6)
INT sway                             ; the columns' offset while the waves come in
BYTE sway_dir

; the breathing: f_1DE6 and d_1E64_bitmap_tables. Every fourth frame a
; counter steps, out 32 times and back 32; every eighth step a table of
; sixteen bitmaps is copied in -- five columns left, five right, six rows
; -- and each step rotates each bitmap right, moving its coordinate a
; pixel (outwards, or down) when the bit that falls out is set. The
; outer columns and the bottom row move every step, the middle columns
; one in eight, the top row never.
BYTE ARRAY br_tab(64) = [
  $FF $77 $55 $14 $10 $10 $14 $55 $77 $FF $00 $10 $14 $55 $77 $FF
  $FF $77 $55 $51 $10 $10 $51 $55 $77 $FF $00 $10 $51 $55 $77 $FF
  $FF $77 $57 $15 $10 $10 $15 $57 $77 $FF $00 $10 $15 $57 $77 $FF
  $FF $F7 $D5 $91 $10 $10 $91 $D5 $F7 $FF $00 $10 $91 $D5 $F7 $FF]
BYTE ARRAY br_work(16)
BYTE br_cnt, breathing
BYTE ARRAY col_off(10)
BYTE ARRAY row_off(6)

PROC Breathe()
  BYTE prev, c, i, b, sgn, t
  prev = br_cnt
  IF prev & $80 THEN br_cnt -= 1 ELSE br_cnt += 1 FI
  IF prev == $1F THEN br_cnt = br_cnt | $80 FI
  IF prev == $81 THEN br_cnt = br_cnt & $7F FI
  c = br_cnt
  IF prev & 7 == 0 THEN
    t = (c & $18) << 1
    FOR i = 0 TO 15 DO br_work(i) = br_tab(t + i) OD
  FI
  FOR i = 0 TO 15 DO
    b = br_work(i)
    br_work(i) = (b >> 1) | ((b & 1) << 7)
    IF b & 1 THEN
      ; expanding: the left five out to the left, the rest out and down
      sgn = 1
      IF i < 5 THEN sgn = 0 FI
      IF prev & $80 THEN sgn = 1 - sgn FI
      IF i < 10 THEN
        IF sgn THEN col_off(i) += 1 ELSE col_off(i) -= 1 FI
      ELSE
        IF sgn THEN row_off(i - 10) += 1 ELSE row_off(i - 10) -= 1 FI
      FI
    FI
  OD
RETURN

; f_2A90: while the waves come in, every fourth frame the columns step a
; pixel, turning at 32 either side of the centre
PROC Sway()
  IF sway_dir THEN sway -= 1 ELSE sway += 1 FI
  IF nest_inh AND sway == 0 THEN
    ; the last wave is home and the columns are back: the breathing takes over
    sway_on = 0
    sway_dir = 0
    breathing = 1
    br_cnt = 0
    PlaySound(S_PULSE)
    RETURN
  FI
  IF sway == 32 THEN sway_dir = 1 FI
  IF sway == -32 THEN sway_dir = 0 FI
RETURN

; the slots: row 0 is the captured fighters' four, row 1 the bosses',
; rows 2-3 the butterflies' eight, rows 4-5 the bees' ten
CONST NSLOT = 44
BYTE ARRAY sl_row(NSLOT), sl_col(NSLOT), sl_kind(NSLOT)
BYTE ARRAY sl_on(NSLOT)              ; drawn in the bitmap
BYTE ARRAY sl_fr(NSLOT)              ; the frame drawn: a formation frame
BYTE ARRAY sl_x(NSLOT), sl_y(NSLOT)  ; where it is drawn, the field's top-left
BYTE ARRAY sl_wait(NSLOT)            ; visits left of a turn upright the bitmap took over (Settle)
BYTE flap                            ; 0 or 1: the wing frame everyone shows

PROC SlotsInit()
  BYTE i, c, r
  i = 0
  FOR c = 3 TO 6 DO
    sl_row(i) = 0
    sl_col(i) = c
    sl_kind(i) = FM_CAPTURED6
    sl_row(i + 4) = 1
    sl_col(i + 4) = c
    sl_kind(i + 4) = FM_BOSS6
    i += 1
  OD
  i = 8
  FOR r = 2 TO 3 DO
    FOR c = 1 TO 8 DO
      sl_row(i) = r
      sl_col(i) = c
      sl_kind(i) = FM_GOEI6
      i += 1
    OD
  OD
  FOR r = 4 TO 5 DO
    FOR c = 0 TO 9 DO
      sl_row(i) = r
      sl_col(i) = c
      sl_kind(i) = FM_ZAKO6
      i += 1
    OD
  OD
  FOR i = 0 TO 59 DO slot_at(i) = 255 OD
  FOR i = 0 TO NSLOT - 1 DO
    sl_on(i) = 0
    sl_wait(i) = 0
    slot_at(sl_row(i) * 10 + sl_col(i)) = i
  OD
RETURN

PROC Positions()
  BYTE i
  FOR i = 0 TO 9 DO col_x(i) = col_x0(i) + sway + col_off(i) OD
  FOR i = 0 TO 5 DO row_y(i) = row_y0(i) + row_off(i) OD
RETURN

; the explosions in the bitmap, below
CONST NBOOM = 4
BYTE ARRAY bm_on(NBOOM), bm_art(NBOOM), bm_n(NBOOM), bm_f(NBOOM), bm_t(NBOOM), bm_x(NBOOM), bm_y(NBOOM)
BYTE ARRAY bm_len(NBOOM)             ; frames each picture holds: 4 for an explosion, 60 for a score
BYTE booms                           ; how many are on, so the stars and the formation need ask only then

; NearBoom(x, y): whether a character's box at the field's (x, y) meets an
; explosion's 32 x 32
FUNC BYTE NearBoom(BYTE x, BYTE y)
  BYTE i
  INT dx, dy
  FOR i = 0 TO NBOOM - 1 DO
    IF bm_on(i) THEN
      dx = x
      dx = dx - bm_x(i)
      dy = y
      dy = dy - bm_y(i)
      IF dx > -16 AND dx < 32 AND dy > -16 AND dy < 32 THEN RETURN (1) FI
    FI
  OD
RETURN (0)

; FmStep(part): every slot drawn in a column of that number mod 4 caught
; up with where its column and row are, a pixel a list at a time, and
; flapped to the wing frame everyone shows. The breathing steps every
; fourth frame, so the four halves of the columns take the four frames
; between: a column is at most three frames behind its neighbour, and a
; step is never one frame's whole work.
PROC FmStep(BYTE part)
  BYTE i, tx, ty, fr, want
  FOR i = 0 TO NSLOT - 1 DO
    IF sl_on(i) AND (sl_col(i) & 3) == part THEN
      tx = col_x(sl_col(i))
      ty = row_y(sl_row(i))
      fr = sl_fr(i)
      want = sl_kind(i)
      IF want != FM_CAPTURED6 THEN want += flap FI
      IF booms AND NearBoom(sl_x(i), sl_y(i)) THEN
        ; an explosion may have drawn over it, so its picture is not the
        ; one its lists assume: erased where it was and drawn whole where
        ; it goes, which is right whatever the explosion did
        IF tx != sl_x(i) OR ty != sl_y(i) OR want != fr THEN
          FmDraw(fr, 0, sl_x(i), sl_y(i), 1)
          sl_x(i) = tx
          sl_y(i) = ty
          sl_fr(i) = want
          FmDraw(want, 0, tx, ty, 0)
        FI
      ELSE
        WHILE sl_x(i) != tx DO
          IF sl_x(i) < tx THEN
            sl_x(i) += 1
            FmDraw(fr, 1, sl_x(i), sl_y(i), 0)
          ELSE
            sl_x(i) -= 1
            FmDraw(fr, 2, sl_x(i), sl_y(i), 0)
          FI
        OD
        WHILE sl_y(i) != ty DO
          IF sl_y(i) < ty THEN
            sl_y(i) += 1
            FmDraw(fr, 3, sl_x(i), sl_y(i), 0)
          ELSE
            sl_y(i) -= 1
            FmDraw(fr, 4, sl_x(i), sl_y(i), 0)
          FI
        OD
        IF want != fr THEN
          FmDraw(fr, 5, sl_x(i), sl_y(i), 0)
          sl_fr(i) = want
        FI
      FI
    FI
  OD
RETURN

PROC SlotShow(BYTE i)
  sl_fr(i) = sl_kind(i)
  sl_x(i) = col_x(sl_col(i))
  sl_y(i) = row_y(sl_row(i))
  FmDraw(sl_fr(i), 0, sl_x(i), sl_y(i), 0)
  sl_on(i) = 1
RETURN

PROC SlotHide(BYTE i)
  IF sl_on(i) THEN
    FmDraw(sl_fr(i), 0, sl_x(i), sl_y(i), 1)
    sl_on(i) = 0
  FI
RETURN

; ------------------------------------------------------------- the stars
; Two banks of stars scrolling down the field, the arcade's 05XX in kind:
; each has its place and colour, and the banks take turns to show
CONST NSTAR = 48
BYTE ARRAY st_x(NSTAR), st_y(NSTAR), st_c(NSTAR), st_on(NSTAR)
BYTE st_speed, st_bank

; Covered(x, y): whether a character at rest in the formation owns that
; pixel of the field, so that a star neither draws over it nor erases it
; -- asked twice a star a frame, so it answers most of them with one
; compare: the formation's band, then its column, then at most two rows
BYTE ARRAY slot_at(60)               ; row * 10 + column: the slot, 255 none

FUNC BYTE Owns(BYTE i, BYTE x, BYTE y)
  BYTE dx, dy
  CARD m, bit
  IF i == 255 THEN RETURN (0) FI
  IF sl_on(i) == 0 THEN RETURN (0) FI
  dx = x - sl_x(i)
  dy = y - sl_y(i)
  IF dx >= 16 OR dy >= 16 THEN RETURN (0) FI
  m = sl_fr(i)
  m = (m << 5) + (dy << 1)
  bit = fm_mask(m)
  bit = (bit << 8) | fm_mask(m + 1)
  IF bit & ($8000 >> dx) THEN RETURN (1) FI
RETURN (0)

; SlotAt(x, y): the slot whose character at rest owns that pixel, 255
; none. The column and row are found from where the formation is going,
; and a character may be drawn a pixel behind that -- a quarter of the
; columns step each frame -- so the rows are taken LAG pixels wider either
; way, and the column either side is asked too when the pixel is within
; LAG of the edge; Owns answers from where each is drawn.
CONST LAG = 2
FUNC BYTE SlotAt(BYTE x, BYTE y)
  BYTE r, c, i, left, right
  INT xi, yi, e
  xi = x + LAG                       ; the margin added to this side: a byte less LAG would wrap
  yi = y + LAG
  e = row_y(0)
  IF yi < e THEN RETURN (255) FI
  e = row_y(5)
  IF y >= e + 16 + LAG THEN RETURN (255) FI
  e = col_x(0)
  IF xi < e THEN RETURN (255) FI
  c = 0
  WHILE c < 9 AND x >= col_x(c) + 16 DO c += 1 OD
  ; c is the first column whose box ends right of x: the one before it
  ; can still reach x if x is within LAG of that box's end, and the one
  ; after if x is within LAG of its start
  left = 0
  IF c > 0 THEN
    IF x < col_x(c - 1) + 16 + LAG THEN left = 1 FI
  FI
  right = 0
  IF c < 9 THEN
    IF xi >= col_x(c + 1) THEN right = 1 FI
  FI
  FOR r = 0 TO 5 DO
    e = row_y(r)
    IF yi >= e AND y < e + 16 + LAG THEN
      i = slot_at(r * 10 + c)
      IF Owns(i, x, y) THEN RETURN (i) FI
      IF left THEN
        i = slot_at(r * 10 + c - 1)
        IF Owns(i, x, y) THEN RETURN (i) FI
      FI
      IF right THEN
        i = slot_at(r * 10 + c + 1)
        IF Owns(i, x, y) THEN RETURN (i) FI
      FI
    FI
  OD
RETURN (255)

FUNC BYTE Covered(BYTE x, BYTE y)
RETURN (SlotAt(x, y) != 255)

BYTE ARRAY st_cols(7) = [C_WHITE C_RED C_YELLOW C_CYAN C_BEAM C_BLUE C_ORANGE]

PROC StarsInit()
  BYTE i
  FOR i = 0 TO NSTAR - 1 DO
    st_x(i) = Rnd(FW)
    st_y(i) = Rnd(240)
    st_c(i) = st_cols(Rnd(7))
    st_on(i) = 0
  OD
  st_speed = 1
RETURN

; The stars are all erased before the formation draws and all drawn after
; it, so an erase never needs asking whether a character has moved onto
; its pixel since -- none has -- and only a draw asks Covered, and only
; inside the formation's band.
PROC StarsErase()
  BYTE i
  CARD px
  FOR i = 0 TO NSTAR - 1 DO
    IF st_on(i) THEN
      px = st_x(i)                   ; a byte plus a constant is a byte: widen first
      PIX_X = px + FX
      PIX_Y = st_y(i)
      PIX_DATA = 0
      st_on(i) = 0
    FI
  OD
RETURN

PROC StarsDraw()
  BYTE i, x, y, top, bot, phase, show
  CARD px
  st_bank += 1
  phase = (st_bank >> 5) & 1
  top = row_y(0)
  bot = row_y(5) + 16 + LAG
  FOR i = 0 TO NSTAR - 1 DO
    y = st_y(i) + st_speed
    IF y >= 240 THEN
      y -= 240
      st_x(i) = Rnd(FW)
    FI
    st_y(i) = y
    IF (i & 1) == phase THEN
      x = st_x(i)
      IF y >= BAND_Y THEN
        show = BandPixel(x, y) == 0      ; behind the horizon
      ELSE
        show = y + LAG < top OR y >= bot OR Covered(x, y) == 0
      FI
      IF show AND booms THEN show = InBoom(x, y) == 0 FI
      IF show AND cap_ph == 2 AND y >= BEAM_Y AND y < BEAM_Y + BEAM_H THEN
        show = x < cap_x - 32 OR x >= cap_x + 14
      FI
      IF show AND tx_y THEN
        IF y >= tx_y AND y < tx_y + 8 THEN show = 0 FI
      FI
      IF show THEN
        px = x
        PIX_X = px + FX
        PIX_Y = y
        PIX_DATA = st_c(i)
        st_on(i) = 1
      FI
    FI
  OD
RETURN

; ---------------------------------------------------------- the backdrop
; A level's horizon is a band of BAND_H rows along the bottom of the
; field, in sixteen colours whose first SAFE are the arcade's and whose
; last eight are the band's own. The raster interrupt writes those eight
; a row above the band and the vertical blank puts the arcade's back, so
; the formation above keeps its colours and the band has its own; nothing
; the bitmap draws low on the field uses the last eight. The band's
; pixels are also kept in RAM, two to a byte as the bitmap holds them,
; for what draws over it to ask and to put back.
CARD ARRAY bd_d(4) = [D_BD0 D_BD1 D_BD2 D_BD3]
BYTE ARRAY bd_dh(4) = [DH_BD0 DH_BD1 DH_BD2 DH_BD3]
BYTE ARRAY isr_top(16), isr_band(16) ; entries SAFE-15, as PAL_DATA takes them: high, low
BYTE isr_seen

; BandPixel(x, y): the backdrop's colour at the field's (x, y), y in the band
FUNC BYTE BandPixel(BYTE x, BYTE y)
  CARD a
  BYTE b
  a = y - BAND_Y
  a = (a << 7) - (a << 4) + (x >> 1)   ; 112 a row
  VRAM_ADDR = BD_VRAM + a
  b = VRAM_DATA
  IF x & 1 THEN RETURN (b & $0F) FI
RETURN (b >> 4)

; Irq: the vector's handler. The raster compare matches the line counter's
; low byte, so it fires twice a frame -- at the raw line 256 above the
; band's too -- and the first is let go.
PROC Irq()
  ASM
        PUSH R0
        PUSH R1
        PUSHW Y
        LD   R0,[v_VID_IRQ]
        BTST R0,#$02
        BEQ  .rast
        MOV  R1,#$32                 ; the blank acknowledged, both kept enabled
        ST   [v_VID_IRQ],R1
        CLR  R1
        ST   [v_isr_seen],R1
        LDW  Y,#v_isr_top
        BRA  .pal
.rast:  BTST R0,#$01
        BEQ  .out
        MOV  R1,#$31
        ST   [v_VID_IRQ],R1
        LD   R1,[v_isr_seen]
        BNE  .band
        MOV  R1,#1
        ST   [v_isr_seen],R1
        BRA  .out
.band:  LDW  Y,#v_isr_band
.pal:   MOV  R0,#c_SAFE
        ST   [v_PAL_IDX],R0
        MOV  R1,#16
.l:     LD   R0,[Y+]
        ST   [v_PAL_DATA],R0
        SUB  R1,#1
        BNE  .l
.out:   POPW Y
        POP  R1
        POP  R0
        RETI
  ENDASM
RETURN

PROC IrqOn()
  BYTE i, j
  CARD v
  ; both halves the arcade's until a backdrop is loaded: the title has none
  j = 0
  FOR i = SAFE TO 15 DO
    v = gal_pal(i)
    isr_top(j) = v >> 8
    isr_top(j + 1) = v
    isr_band(j) = v >> 8
    isr_band(j + 1) = v
    j += 2
  OD
  TakeKeys()                         ; its DI, once, before this
  ASM
        DI
        LDW  X,#Irq
        STW  [$FFFC],X
  ENDASM
  VID_RCMP = ((BAND_Y - 1) << 1) & 255
  VID_IRQ = $33
  ASM
        EI
  ENDASM
RETURN

; PalSplit(k): the two halves the handler writes -- the arcade's last
; eight, and level k's
PROC PalSplit(BYTE k)
  BYTE i, j
  CARD v, a
  j = 0
  FOR i = SAFE TO 15 DO
    v = gal_pal(i)
    isr_top(j) = v >> 8
    isr_top(j + 1) = v
    j += 2
  OD
  a = k
  a = a << 4
  FOR i = 0 TO 15 DO isr_band(i) = bd_pal(a + i) OD
RETURN

; LoadBackdrop(k): level k's band from the data file into RAM, then into
; the bitmap row by row, and its colours to the handler
PROC LoadBackdrop(BYTE k)
  BYTE r
  CARD off, v
  VRAM_STEP = 1
  Stream(bd_d(k), bd_dh(k), BD_VRAM, BAND_H * 112)
  off = bd_d(k)
  FOR r = 0 TO BAND_H - 1 DO
    v = BAND_Y + r
    Stream(off, bd_dh(k), (v << 7) + (v << 5) + (FX >> 1), 112)
    off += 112
  OD
  PalSplit(k)
RETURN

; --------------------------------------------------------------- flights
; What flies is the arcade's own motion, ported from the sub CPU's
; f_08D3 as tools/galaga_paths.py states it (the gate holds the two to
; the same positions frame by frame). A slot is the arcade's twenty-byte
; one, field by field: Y and X in 2-pixel units with a byte of fraction,
; Y growing upward; a ten-bit angle, 0 right and 256 up; a path pointer;
; the speed's two nibbles, odd frames' and even frames'; the turn a frame
; and the frames left of a segment. A segment moves `v` pixels along its
; main axis and v * L / 128 along the other, L the angle's distance from
; that axis -- linear, not trigonometric, which is the arcade's rule too.
;
; The arcade runs twelve slots; here six, because a flyer is four of the
; thirty-two sprites. A wave of eight waits for a slot when six are up.
CONST NFLY = 6
CONST SP_FLY = 6                     ; descriptors 6-29, four a flyer
BYTE frm                             ; the arcade's frame counter: its parity and its fours drive everything

BYTE ARRAY fl_on(NFLY)               ; moving under a path (the arcade's b13 bit 0)
BYTE ARRAY fl_state(NFLY)            ; the object's state: 7 launched, 3 cullable, 9 homing, 2 arrived, 0 none
BYTE ARRAY fl_obj(NFLY)              ; the arcade's object id
CARD ARRAY fl_y(NFLY), fl_x(NFLY)    ; b01:b00 and b03:b02
BYTE ARRAY fl_a4(NFLY), fl_a5(NFLY)  ; the angle: b05 (bits 1:0 used) and b04
BYTE ARRAY fl_t6(NFLY), fl_t7(NFLY)  ; the target: home's row and column, or FC's line
CARD ARRAY fl_p(NFLY)                ; into fl_rom
BYTE ARRAY fl_vo(NFLY), fl_ve(NFLY), fl_dl(NFLY), fl_n(NFLY)
BYTE ARRAY fl_ox(NFLY), fl_oy(NFLY)  ; b11, b12: the formation's offset added while homing
BYTE ARRAY fl_fl(NFLY)               ; b13: bit 5 FC's line armed, 6 homing, 7 mirrored
BYTE ARRAY fl_code(NFLY), fl_ctrl(NFLY) ; the tile, 0 facing left to 6 facing up, and ctrl: bit 1 mirrors across, bit 0 down
BYTE ARRAY fl_char(NFLY)             ; the character's first sprite frame
BYTE ARRAY fl_x8(NFLY)               ; the arcade's sprite X and Y, as displayed
CARD ARRAY fl_y9(NFLY)
INT ARRAY fl_sx(NFLY), fl_sy(NFLY)   ; where that is on this screen, the box's top-left
BYTE flying, flying_nbr              ; slots moving this frame, and last frame
BYTE cont_bomb                       ; FA's continuous bombing: divers loop instead of going home
BYTE stage                           ; 1 up
BYTE ARRAY fl_be(NFLY), fl_bf(NFLY)  ; b0E and b0F: steps to the next bomb chance, and the chances' mask
BYTE ARRAY sp(10)                    ; the stage's ten parameter nibbles
BYTE ARRAY gt(4)                     ; the arcade's game timers, counted down every 32nd frame
BYTE en_cnt, en_nbr                  ; the enemies being counted, and those last counted
BYTE ftr_on                          ; the fighter in play: it fires, it is hit, the enemies dive and bomb
BYTE hdr0                            ; the stage's steps between a flyer's bomb chances
; the capture sortie: its boss, and the beam's course -- 1 turning to face
; down, 2 the beam out (f_2222); the beam's X, its counters as the arcade's
; ds5_928A_captr_status keeps them, the step period, whether the fighter
; reached the boss
BYTE cobj, cap_ob, cap_ph, cap_k, cap_x, cap_s1, cap_s2, cap_fl, cap_pull, cap_con, cap_home, cap_n, bm_ph
CARD cap_t
; the fighter's life, as the arcade's restart runs it: 0 in play, 1 its
; explosion's four counts, 2 READY until nothing flies, 3 back on the
; field for three counts before it may fire, 4 GAME OVER's counts, 5 in
; the beam; and, while it is pulled up, its sprite Y, tile and flips
BYTE ftr_dead
CARD ftr_y9
BYTE ftr_code, ftr_ctrl
BYTE bomb_flags                      ; the mask a sortie is given, by the stage and the enemies left

; the launcher, f_2916, on the stage's waves loaded from the WAVES block
BYTE ARRAY st_wv(WAVES_MAX)
CARD wv_p
BYTE launching
BYTE wave_no                         ; the wave launching, 0-4
BYTE ARRAY fl_wave(NFLY)
; a challenging stage's tally: hits, and each wave's
BYTE ch_hits
BYTE ARRAY ch_kills(5)
; the sway, f_2A90, before the breathing takes over
BYTE sway_on, nest_inh

; Div(hl, c): the arcade's c_0EAA, HL / C by seventeen restoring steps,
; bit for bit -- including what it does with a zero
FUNC CARD Div(CARD hl, BYTE c)
  CARD acc, nx
  BYTE cy, i
  acc = 0
  cy = 0
  FOR i = 1 TO 17 DO
    acc = (acc << 1) | cy
    IF acc > 255 THEN
      acc = (acc - c) & 255
      cy = 1
    ELSEIF acc < c THEN
      cy = 0
    ELSE
      acc = acc - c
      cy = 1
    FI
    nx = (hl << 1) | cy
    cy = hl >> 15
    hl = nx
  OD
RETURN (hl)

; AngleTo(ty, tx, y, x): c_0E5B, the ten-bit angle from (y, x) to (ty, tx),
; all in 2-pixel units -- the exact inverse of the linear motion
FUNC CARD AngleTo(BYTE ty, BYTE tx, BYTE y, BYTE x)
  INT dx, dy
  BYTE b, c, a, cy1, t, cy, lo
  CARD q
  dx = tx
  dx = dx - x
  b = 0
  IF dx < 0 THEN
    b = 1
    dx = -dx
  FI
  c = dx
  dy = ty
  dy = dy - y
  IF dy < 0 THEN
    b = (b ^ 1) | 2
    dy = -dy
  FI
  a = dy
  IF a < c THEN cy1 = 1 ELSE cy1 = 0 FI
  t = (a << 1) | cy1
  t = t ^ b
  cy = (t & 1) ^ 1
  b = (b << 1) | cy
  IF cy1 THEN
    q = a
    q = Div(q << 8, c)
  ELSE
    q = c
    q = Div(q << 8, a)
  FI
  lo = q
  IF ((q >> 8) ^ b) & 1 THEN lo = lo ^ $FF FI
  q = b
  q = (q << 8) | lo
RETURN (q >> 1)

FUNC BYTE Near(BYTE a, BYTE b)
  BYTE d
  d = a - b
  IF d == 0 OR d == 1 OR d == $FF THEN RETURN (1) FI
RETURN (0)

; MapY(y9): the arcade's sprite Y as this screen's row of the box's top:
; its rows 16-151 one for one, the 120 below them into 88
FUNC INT MapY(CARD y9)
  INT ay
  CARD c
  ay = y9
  ay = ay - 56
  IF ay > 136 THEN
    IF ay > 290 THEN RETURN (300) FI
    c = ay - 136
    c = (c * 215) >> 8
    ay = c
    ay = ay + 136
  FI
RETURN (ay)

PROC FlyPosn(BYTE k)
  BYTE xh, xl, x8, yh, yl, a
  CARD y9, w
  w = fl_x(k)
  xh = w >> 8
  xl = w
  x8 = xh << 1
  IF xl > $7F THEN x8 += 1 FI
  IF fl_fl(k) & $40 THEN x8 += fl_ox(k) FI
  w = fl_y(k)
  yh = w >> 8
  yl = w
  a = (yh + $4F) ^ $FF
  y9 = a
  y9 = y9 << 1
  IF yl <= $7F THEN y9 += 1 FI
  IF fl_fl(k) & $40 THEN
    a = fl_oy(k)
    y9 = y9 + a
    IF a & $80 THEN y9 = y9 - 256 FI
  FI
  y9 = y9 & $1FF
  fl_x8(k) = x8
  fl_y9(k) = y9
  fl_sx(k) = x8
  fl_sx(k) = fl_sx(k) - 17
  fl_sy(k) = MapY(y9)
RETURN

PROC FlyFree(BYTE k)
  fl_on(k) = 0
  fl_state(k) = 0
  HideChar(SP_FLY + (k << 2))
RETURN

; FlyHome(k): FB -- into the formation's zero-offset frame, where the slot
; is still, aimed at it once
PROC FlyHome(BYTE k)
  BYTE obj, r, c, ox, oy, e
  CARD w
  obj = fl_obj(k) >> 1
  r = obj_row(obj)
  c = obj_col(obj)
  fl_state(k) = 9
  ox = col_x(c) - col_x0(c)
  oy = row_off(r)
  fl_ox(k) = ox
  fl_oy(k) = oy
  w = oy
  IF oy & $80 THEN w = w - 256 FI
  fl_y(k) = fl_y(k) + (w << 7)
  w = ox
  IF ox & $80 THEN w = w - 256 FI
  fl_x(k) = fl_x(k) - (w << 7)
  e = fm_orig(c) >> 1
  w = AngleTo(fm_orig(10 + r), e, fl_y(k) >> 8, fl_x(k) >> 8)
  fl_a4(k) = w
  fl_a5(k) = w >> 8
  fl_t6(k) = fm_orig(10 + r)
  fl_t7(k) = e
  fl_fl(k) = fl_fl(k) | $40
RETURN

; ------------------------------------------------------------- the bombs
; The arcade's eight (f_1EA4, and f_08D3's l_0D8D): a flyer has a chance
; at every so many steps, and its mask says which chances drop one --
; while it is high enough, the fighter is in play and no flying boss has
; just been shot. A bomb is aimed at where the fighter is when it drops,
; falls two and a half pixels a frame, and moves across by a fraction a
; frame of up to a pixel and a half. Its sprite is 31 or 30, or one of
; the four of a flyer's slot that is free -- the slot then not a flyer's
; again until its bombs are gone.
CONST NBOMB = 8
BYTE ARRAY bo_on(NBOMB), bo_x(NBOMB), bo_rate(NBOMB), bo_rem(NBOMB), bo_sp(NBOMB)
CARD ARRAY bo_y(NBOMB)
BYTE ARRAY fl_bm(NFLY)               ; which of a slot's four sprites bombs have, a bit each
BYTE bo_own                          ; 31 and 30 taken: bits 0 and 1

; Settle(k): flyer k, turning upright at its slot, given to the bitmap
; now because its sprites are wanted -- the arcade's own has left its
; motion slot already. The visits its turn had left are counted down
; there, so it is at rest when the arcade's would be.
PROC Settle(BYTE k)
  BYTE slot, w
  slot = obj_slot(fl_obj(k) >> 1)
  IF fl_ctrl(k) & 1 THEN w = fl_code(k) + 8 ELSE w = 7 - fl_code(k) FI
  FlyFree(k)
  SlotShow(slot)
  sl_wait(slot) = w
RETURN

; BombSprite: a sprite for a bomb -- 31, 30, or a slot's from the last
; slot back, one only settling giving its sprites up -- or 255
FUNC BYTE BombSprite()
  BYTE k, q
  IF (bo_own & 1) == 0 THEN
    bo_own = bo_own | 1
    RETURN (31)
  FI
  IF (bo_own & 2) == 0 THEN
    bo_own = bo_own | 2
    RETURN (30)
  FI
  k = NFLY
  WHILE k DO
    k -= 1
    IF (fl_state(k) == 0 OR fl_state(k) == 2) AND fl_bm(k) != 15 THEN
      IF fl_state(k) == 2 THEN Settle(k) FI
      q = 0
      WHILE fl_bm(k) & (1 << q) DO q += 1 OD
      fl_bm(k) = fl_bm(k) | (1 << q)
      RETURN (SP_FLY + (k << 2) + q)
    FI
  OD
RETURN (255)

; BombOff(n): bomb n gone, its sprite given back
PROC BombOff(BYTE n)
  BYTE d
  d = bo_sp(n)
  bo_on(n) = 0
  SpriteHide(d)
  IF d >= 30 THEN
    bo_own = bo_own & ~(1 << (31 - d))
  ELSE
    d = d - SP_FLY
    fl_bm(d >> 2) = fl_bm(d >> 2) & ~(1 << (d & 3))
  FI
RETURN

; Drop(k): a bomb from flyer k, aimed as l_0D8D aims it -- the fighter's
; distance over the height, by the arcade's own division
PROC Drop(BYTE k)
  BYTE n, x, f, d, sgn, yy, dy
  CARD q
  FOR n = 0 TO NBOMB - 1 DO
    IF bo_on(n) == 0 THEN
      d = BombSprite()
      IF d == 255 THEN RETURN FI
      bo_sp(n) = d
      x = fl_x8(k)
      bo_on(n) = 1
      bo_x(n) = x
      bo_y(n) = fl_y9(k)
      f = fx + 17
      sgn = 0
      IF f < x THEN
        sgn = $80
        d = x - f
      ELSE
        d = f - x
      FI
      yy = fl_y9(k) >> 1
      IF yy > $95 THEN dy = yy - $95 ELSE dy = $95 - yy FI
      q = d
      q = Div((q << 8) | ($69 + (n << 1)), dy)
      q = (q + (q >> 2)) >> 2
      IF q > $60 THEN q = $60 FI
      bo_rate(n) = sgn | (q >> 1)
      bo_rem(n) = 0
      RETURN
    FI
  OD
RETURN

; Chance(k): the countdown to flyer k's next chance, after every step
PROC Chance(BYTE k)
  BYTE b
  fl_be(k) -= 1
  IF fl_be(k) THEN RETURN FI
  b = fl_bf(k)
  fl_bf(k) = b >> 1
  IF b & 1 AND ftr_on AND gt(1) == 0 THEN
    IF (fl_y(k) >> 8) >= $4C THEN Drop(k) FI
  FI
  fl_be(k) = hdr0
RETURN

FUNC CARD Word(CARD p)
  CARD w
  w = fl_rom(p + 1)
RETURN ((w << 8) | fl_rom(p))

; FlyStep(k): f_08D3 for one slot, a frame of its path
PROC FlyStep(BYTE k)
  BYTE t, st, consume, a, e, d, dl, v, q, o, l, obj
  CARD p, pv, sw, w
  obj = fl_obj(k)
  flying += 1
  st = fl_state(k)
  IF st != 3 AND st != 7 AND st != 9 THEN
    FlyFree(k)
    RETURN
  FI
  fl_n(k) -= 1
  IF fl_n(k) == 0 THEN
    p = fl_p(k)
    consume = 0
    DO
      t = fl_rom(p)
      IF t < $EF THEN
        fl_vo(k) = t & $0F
        fl_ve(k) = t >> 4
        dl = fl_rom(p + 1)
        IF fl_fl(k) & $80 THEN dl = 0 - dl FI
        fl_dl(k) = dl
        fl_n(k) = fl_rom(p + 2)
        p += 3
        EXIT
      FI
      IF t == $FF THEN
        FlyFree(k)
        RETURN
      ELSEIF t == $FE THEN
        a = fx + 17
        IF a == 0 THEN a = $80 FI
        IF (fl_fl(k) & $80) == 0 THEN a = $F2 - a FI
        a += $0E
        fl_n(k) = fl_rom(p + a / 30)
        p += 9
        EXIT
      ELSEIF t == $FD THEN
        p = Word(p + 1)
      ELSEIF t == $FC THEN
        fl_t6(k) = fl_rom(p + 1)
        fl_t7(k) = 0
        fl_fl(k) = fl_fl(k) | $20
        p += 2
        EXIT
      ELSEIF t == $FB THEN
        FlyHome(k)
        p += 1
      ELSEIF t == $FA THEN
        IF cont_bomb == 0 THEN p = Word(p + 1) ELSE p += 3 FI
      ELSEIF t == $F9 THEN
        a = col_x(obj_col(obj >> 1)) + 17
        w = a >> 1
        fl_x(k) = (fl_x(k) & $FF) | (w << 8)
        IF cont_bomb THEN PlaySound(S_DIVE) FI
        p += 1
        consume = 1
        EXIT
      ELSEIF t == $F8 THEN
        fl_y(k) = (fl_y(k) & $FF) | $9C00
        p += 1
        consume = 1
        EXIT
      ELSEIF t == $F7 THEN
        IF obj & $38 == $38 THEN p = Word(p + 1) ELSE p += 3 FI
      ELSEIF t == $F6 THEN
        a = fl_rom(p + 1)
        IF fl_fl(k) & $80 THEN a = 0 - (a + $80) FI
        fl_a4(k) = a << 2
        fl_a5(k) = a >> 6
        fl_be(k) = $1E
        fl_bf(k) = bomb_flags
        p += 2
        consume = 1
        EXIT
      ELSEIF t == $F5 THEN
        fl_state(k) = 3
        p += 1
      ELSEIF t == $F4 THEN
        a = ((fx + 17 + 3) & $F8) + 1
        IF a < $29 THEN a = $29 FI
        IF a >= $CA THEN a = $C9 FI
        w = AngleTo($48, a >> 1, fl_y(k) >> 8, fl_x(k) >> 8)
        fl_a4(k) = w
        fl_a5(k) = w >> 8
        IF obj == cobj THEN
          cap_ph = 1                 ; f_21CB takes the capture boss over
          cap_k = k
          cap_x = a
        FI
        p += 1
      ELSEIF t == $F3 THEN
        a = fx + 17
        IF a < $1E THEN a = $1E FI
        IF a > $D1 THEN a = $D1 FI
        a = a >> 1
        e = fl_x(k) >> 8
        d = a - e
        IF a < e THEN a = (d >> 1) | $80 ELSE a = d >> 1 FI
        IF fl_fl(k) & $80 THEN a = 0 - a FI
        a += $18
        IF a & $80 THEN a = 0 FI
        IF a >= $30 THEN a = $2F FI
        fl_n(k) = fl_rom(p + a / 6 + 1)
        p += 9
        EXIT
      ELSEIF t == $F2 THEN
        p += 3                       ; the clone: not yet
      ELSEIF t == $F1 THEN
        a = fm_orig(10 + obj_row(obj >> 1)) + $20
        w = a
        fl_y(k) = (fl_y(k) & $FF) | (w << 8)
        p += 1
        consume = 1
        EXIT
      ELSE
        IF t == $F0 THEN a = sp(8) ELSE a = sp(9) FI
        IF a THEN p = Word(p + 1) ELSE p += 3 FI
        consume = 1
        EXIT
      FI
    OD
    fl_p(k) = p
    IF consume THEN
      fl_n(k) += 1
      RETURN
    FI
  FI
  ; the step
  IF fl_fl(k) & $40 THEN
    IF Near(fl_y(k) >> 8, fl_t6(k)) AND Near(fl_x(k) >> 8, fl_t7(k)) THEN
      fl_on(k) = 0
      fl_state(k) = 2
      w = fl_t6(k)
      fl_y(k) = w << 8
      w = fl_t7(k)
      fl_x(k) = w << 8
      FlyPosn(k)
      Chance(k)
      RETURN
    FI
  FI
  IF fl_fl(k) & $20 THEN
    a = (fl_y(k) >> 8) - fl_t6(k)
    IF a == 0 OR a == $FF THEN
      fl_n(k) = 1
      fl_fl(k) = fl_fl(k) & $DF
    FI
  FI
  e = fl_a4(k)
  d = fl_a5(k)
  dl = fl_dl(k)
  w = e
  w = w + dl
  fl_a4(k) = w
  IF ((w >> 8) ^ (dl >> 7)) & 1 THEN
    IF dl < $80 THEN fl_a5(k) = d + 1 ELSE fl_a5(k) = d - 1 FI
  FI
  a = e
  IF d & 1 THEN a = a ^ $FF FI
  IF a > 234 THEN
    fl_code(k) = 6
  ELSE
    v = a + 21
    fl_code(k) = (((v >> 1) + (v >> 2)) >> 5) & 7
  FI
  q = (d >> 1) & 1
  fl_ctrl(k) = (((d & 1) ^ q ^ 1) << 1) | q
  IF frm & 1 THEN v = fl_vo(k) ELSE v = fl_ve(k) FI
  IF v THEN
    q = d & 3
    o = (q << 1) | (e >> 7)
    pv = v
    pv = pv << 7
    IF (o + 1) & 4 THEN pv = 0 - pv FI
    l = e & $7F
    IF e & $80 THEN l = l ^ $7F FI
    sw = l * v
    t = (o ^ 2) - 1
    IF t & 4 THEN sw = 0 - sw FI
    IF (q ^ o) & 1 THEN
      fl_y(k) = fl_y(k) + pv
      fl_x(k) = fl_x(k) + sw
    ELSE
      fl_x(k) = fl_x(k) + pv
      fl_y(k) = fl_y(k) + sw
    FI
  FI
  FlyPosn(k)
  Chance(k)
RETURN

; FlyStates: c_23E0, which visits each object every fourth frame -- the
; odd frames, half the ids at a time
BYTE ARRAY sl_ax(44), sl_ay(44)      ; a character at rest's arcade sprite X and Y, refreshed as c_23E0 does
PROC FlyStates()
  BYTE k, obj, st, r, c, slot, h, cnt
  IF frm & 1 == 0 THEN
    IF frm & 2 THEN
      en_nbr = en_cnt
      en_cnt = 0
    FI
    RETURN
  FI
  h = (frm & 2) >> 1
  cnt = en_cnt
  FOR k = 0 TO NFLY - 1 DO
    st = fl_state(k)
    obj = fl_obj(k)
    IF st AND (obj & 2) == (frm & 2) THEN
      r = obj_row(obj >> 1)
      c = obj_col(obj >> 1)
      IF st == 9 THEN
        fl_ox(k) = col_x(c) - col_x0(c)
        fl_oy(k) = row_off(r)
        cnt += 1
      ELSEIF st == 7 THEN
        fl_state(k) = 3
        cnt += 1
      ELSEIF st == 3 THEN
        IF fl_x8(k) >= $F4 OR (fl_y9(k) >> 1) < $0B OR (fl_y9(k) >> 1) >= $A5 THEN FlyFree(k) ELSE cnt += 1 FI
      ELSEIF st == 2 THEN
        ; arrived: the tile turned upright a step at a time, on the slot
        IF fl_ctrl(k) & 1 THEN
          IF fl_code(k) == 0 THEN fl_ctrl(k) = fl_ctrl(k) & $FE ELSE fl_code(k) -= 1 FI
        ELSEIF fl_code(k) == 6 THEN
          slot = obj_slot(obj >> 1)
          FlyFree(k)
          IF slot != 255 THEN SlotShow(slot) FI
        ELSE
          fl_code(k) += 1
        FI
        IF fl_state(k) == 2 THEN
          fl_sx(k) = col_x(c)
          fl_sy(k) = row_y(r)
          cnt += 1                   ; once it is at rest, it is counted below
        FI
      FI
    FI
  OD
  ; the characters at rest in this half: counted, their sprites where
  ; their slots are
  k = h
  WHILE k < 48 DO
    slot = obj_slot(k)
    IF slot != 255 THEN
      IF sl_on(slot) THEN
        sl_ax(slot) = col_x(sl_col(slot)) + 17
        sl_ay(slot) = row_y(sl_row(slot)) + 56
        IF sl_wait(slot) THEN sl_wait(slot) -= 1 FI
        cnt += 1
      FI
    FI
    k += 2
  OD
  ; the bombs in this half gone off the field
  k = h
  WHILE k < NBOMB DO
    IF bo_on(k) THEN
      r = bo_y(k) >> 1
      IF bo_x(k) >= $F4 OR r < $0B OR bo_y(k) >= $14A THEN BombOff(k) FI
    FI
    k += 2
  OD
  en_cnt = cnt
RETURN

; Bombs: f_1EA4, a frame of every bomb's fall
PROC Bombs()
  BYTE n, a, dx
  FOR n = 0 TO NBOMB - 1 DO
    IF bo_on(n) THEN
      a = (bo_rate(n) & $7E) + bo_rem(n)
      bo_rem(n) = a & $1F
      dx = (a >> 5) & 7
      IF bo_rate(n) & $80 THEN bo_x(n) -= dx ELSE bo_x(n) += dx FI
      bo_y(n) = (bo_y(n) + 2 + (frm & 1)) & $1FF
    FI
  OD
RETURN

PROC BombsDraw()
  BYTE n
  INT y
  CARD x
  FOR n = 0 TO NBOMB - 1 DO
    IF bo_on(n) THEN
      y = MapY(bo_y(n)) + 4
      x = bo_x(n)
      x = x + FX - 13
      SetSprite(bo_sp(n), x << 1, y << 1, SPR_BASE + (P_BOMB << 7), 1, 0)
    FI
  OD
RETURN

PROC FlyDraw()
  BYTE k
  FOR k = 0 TO NFLY - 1 DO
    IF fl_state(k) THEN
      ShowChar(SP_FLY + (k << 2), fl_char(k) + fl_code(k), fl_ctrl(k) & 2, fl_ctrl(k) & 1, fl_sx(k) + FX, fl_sy(k))
    FI
  OD
RETURN

; Launch(k, obj, raw, tok): f_2916's l_2974 -- an object onto its path at
; its start, mirrored and from the second start by the token's bit 6
; the creature of each challenging stage: bees, butterflies, and the two
; whose patterns are streamed over the butterfly's for the stage
BYTE ARRAY ch_char(4) = [F_ZAKO F_GOEI F_DRAGONFLY F_SCORPION]

PROC Launch(BYTE k, BYTE obj, BYTE raw, BYTE tok)
  BYTE i, d
  CARD w
  d = tok << 1
  i = fl_sel(tok & $3F) * 6
  IF d & $80 THEN i += 3 FI
  w = fl_start(i)
  fl_y(k) = w << 8
  w = fl_start(i + 1)
  fl_x(k) = w << 8
  fl_a5(k) = fl_start(i + 2)
  fl_a4(k) = 0
  fl_p(k) = fl_path(tok & $3F)
  fl_n(k) = 1
  fl_fl(k) = d & $80
  fl_on(k) = 1
  fl_state(k) = 7
  fl_obj(k) = obj
  fl_code(k) = 6
  fl_ctrl(k) = 0
  ; the side entries' first chance comes later; d_2908 says which ids bomb
  IF tok & 1 THEN fl_be(k) = $44 ELSE fl_be(k) = $08 FI
  fl_bf(k) = 0
  IF obj >= $08 AND (obj & $38) != $38 THEN
    i = (obj - 8) >> 1
    IF dv_bombs(i >> 3) & ($80 >> (i & 7)) THEN fl_bf(k) = st_hdr((((stage - 1) % STAGES) << 1) + 1) FI
  FI
  IF obj < $08 THEN
    fl_char(k) = F_CAPTURED
  ELSEIF st_kind((stage - 1) % STAGES) AND (obj < $30 OR obj >= $40) THEN
    ; a challenging stage's own creature, in every place but the bosses'
    fl_char(k) = ch_char(((stage - 1) >> 2) & 3)
  ELSEIF obj < $30 THEN
    fl_char(k) = F_ZAKO
  ELSEIF obj < $38 THEN
    fl_char(k) = F_BOSS
  ELSEIF (obj & $38) == $38 AND (raw & $40) == 0 THEN
    fl_char(k) = F_ZAKO              ; a transient bee
  ELSE
    fl_char(k) = F_GOEI
  FI
  FlyPosn(k)
RETURN

; ------------------------------------------------------------ the dives
; f_1B65: three timers -- the boss's, the red butterflies', the bees' --
; counted down in that order every sixteenth frame, the first to run out
; sending the first at rest of its kind down its path, unless as many as
; the stage allows are already flying. The reloads come from f_0857's
; tables by the enemies left and the stage's time. Every other boss sortie
; is a capture; the rest take up to two escorts from the butterflies under
; the boss, the three launched a frame apart from a pool of four.
BYTE dv_on, dv_max, cflag, wingm
CARD pool_path, cap_len
BYTE ARRAY dv_tm(3), dv_rl(3), pool_o(4)
BYTE ARRAY boss_sc(4)                ; each boss's worth shot flying, in tens: 40, 80 or 160 by its escorts
BYTE ARRAY boss_b(4) = [$32 $36 $34 $30]

; Params: f_0857, every frame
PROC Params()
  BYTE tens, i
  IF gt(2) < $3C THEN dv_max = sp(5) FI
  tens = en_nbr / 10
  bomb_flags = dv_tab((sp(0) << 2) + tens)
  IF cont_bomb THEN
    FOR i = 0 TO 2 DO dv_rl(i) = 2 OD
    RETURN
  FI
  dv_rl(0) = dv_tab(32 + (sp(1) << 2) + tens)
  i = 0
  IF gt(2) < $28 THEN i = 1 FI
  IF gt(2) == 0 THEN i = 2 FI
  dv_rl(1) = dv_red(sp(2) * 3 + i)
  dv_rl(2) = dv_bee(sp(3) * 3 + i)
RETURN

FUNC BYTE Resting(BYTE obj)
  BYTE slot
  slot = obj_slot(obj >> 1)
  IF slot == 255 THEN RETURN (0) FI
  IF sl_wait(slot) THEN RETURN (0) FI
RETURN (sl_on(slot))

; FreeFlyer: the first slot not flying and whose sprites no bomb has
FUNC BYTE FreeFlyer()
  BYTE k, want
  ; first a slot not flying; then one only settling, which gives it up
  FOR want = 0 TO 2 STEP 2 DO
    FOR k = 0 TO NFLY - 1 DO
      IF fl_state(k) == want AND fl_bm(k) == 0 THEN
        IF want THEN Settle(k) FI
        RETURN (k)
      FI
    OD
  OD
RETURN (255)

; Dive(obj, path, mirror): j_108A -- a character at rest out of the bitmap
; and onto a path, from where its sprite last was, heading up
PROC Dive(BYTE obj, CARD path, BYTE mirror)
  BYTE k, slot, a, kind
  CARD w
  k = FreeFlyer()
  IF k == 255 THEN RETURN FI
  slot = obj_slot(obj >> 1)
  a = sl_ay(slot) >> 1
  a = 0 - (a + $50)
  w = a
  w = w << 8
  IF (sl_ay(slot) & 1) == 0 THEN w += $80 FI
  fl_y(k) = w
  a = sl_ax(slot)
  w = a >> 1
  w = w << 8
  IF a & 1 THEN w += $80 FI
  fl_x(k) = w
  fl_a4(k) = 0
  fl_a5(k) = 1
  fl_p(k) = path
  fl_n(k) = 1
  fl_fl(k) = mirror
  fl_on(k) = 1
  fl_state(k) = 9
  fl_obj(k) = obj
  fl_code(k) = 6
  fl_ctrl(k) = 0
  fl_be(k) = $1E
  fl_bf(k) = bomb_flags
  kind = sl_kind(slot)
  IF kind == FM_ZAKO6 THEN
    fl_char(k) = F_ZAKO
  ELSEIF kind == FM_GOEI6 THEN
    fl_char(k) = F_GOEI
  ELSEIF kind == FM_BOSS6 THEN
    fl_char(k) = F_BOSS
  ELSEIF kind == FM_CAPTURED6 THEN
    fl_char(k) = F_CAPTURED
  ELSE
    fl_char(k) = F_BOSS_HIT
  FI
  SlotHide(slot)
RETURN

; FirstDive(obj, last, path): the first of those ids at rest, down the path
PROC FirstDive(BYTE obj, BYTE last, CARD path)
  WHILE obj <= last DO
    IF Resting(obj) THEN
      PlaySound(S_DIVE)
      Dive(obj, path, (obj & 2) << 6)
      RETURN
    FI
    obj += 2
  OD
RETURN

; Pool(boss, ixl, b, cc, path): j_1CAE -- the boss and 2 - ixl escorts (none
; when ixl is 2) from the butterflies either side of b, in c_1D03's order,
; queued to launch a frame apart with the boss's mirror
PROC Pool(BYTE e, BYTE ixl, BYTE b, BYTE cc, CARD path)
  BYTE m, k, cy
  m = (e & 2) << 6
  pool_o(0) = e | m
  pool_path = path
  k = (e & 6) >> 1
  IF ixl == 0 THEN
    boss_sc(k) = 160
  ELSEIF ixl == 1 THEN
    boss_sc(k) = 80
  ELSE
    boss_sc(k) = 40
    IF Resting(e & 7) THEN pool_o(1) = (e & 7) | m FI
    RETURN
  FI
  b += 1
  k = 1
  WHILE k < 3 - ixl DO
    cy = cc & 1
    cc = (cc >> 1) | (cy << 7)
    IF cy == 0 THEN
      b -= 1
      cy = cc & 1
      cc = (cc >> 1) | (cy << 7)
      IF cy == 0 THEN b -= 1 FI
    FI
    pool_o(k) = dv_wing(b) | m
    b -= 1
    k += 1
  OD
  ; l_1CE3: the boss's captured fighter, at rest, goes with it
  IF Resting(e & 7) THEN pool_o(k) = (e & 7) | m FI
RETURN

; BossSortie: case_bmbr_boss
PROC BossSortie()
  BYTE o, c, i, ixl, cc, b, a, ok
  IF cflag == 0 THEN
    wingm += 1
    IF (wingm & 1) == 0 THEN
      FOR o = $30 TO $36 DO
        IF (o & 1) == 0 AND Resting(o) THEN
          cflag = 1
          cobj = o
          Pool(o, 2, 0, 0, FL_ATK_CAPTURE)
          RETURN
        FI
      OD
      RETURN
    FI
  FI
  c = 0
  FOR i = 0 TO 5 DO c = (c << 1) | Resting(dv_wing(i)) OD
  FOR ixl = 0 TO 1 DO
    cc = c
    FOR b = 4 TO 7 DO
      ; B counts 4 down to 1: its boss is boss_b(B - 1)
      i = 8 - b
      a = cc & 7
      IF ixl == 0 THEN ok = a == 3 OR a >= 5 ELSE ok = a FI
      IF ok AND Resting(boss_b(i - 1)) THEN
        Pool(boss_b(i - 1), ixl, i, cc, FL_ATK_BOSS)
        RETURN
      FI
      cc = cc >> 1
    OD
  OD
  FOR o = $30 TO $36 DO
    IF (o & 1) == 0 AND Resting(o) THEN
      Pool(o, 2, 0, 0, FL_ATK_BOSS)
      RETURN
    FI
  OD
  FirstDive(0, 6, FL_ROGUE)
RETURN

; Sorties: f_1B65
PROC Sorties()
  BYTE i, e, n
  IF ftr_on == 0 THEN RETURN FI
  FOR i = 0 TO 3 DO
    e = pool_o(i)
    IF e != 255 THEN
      pool_o(i) = 255
      IF Resting(e & $7F) THEN
        Dive(e & $7F, pool_path, e & $80)
        PlaySound(S_DIVE)
      FI
      RETURN
    FI
  OD
  IF frm & 15 THEN RETURN FI
  n = 0
  DO
    dv_tm(n) -= 1
    IF dv_tm(n) == 0 THEN EXIT FI
    n += 1
    IF n == 3 THEN RETURN FI
  OD
  IF flying_nbr >= dv_max THEN
    dv_tm(n) = 1
    RETURN
  FI
  dv_tm(n) = dv_rl(n)
  IF n == 2 THEN
    FirstDive($08, $2E, FL_ATK_YLLW)
  ELSEIF n == 1 THEN
    FirstDive($40, $5E, FL_ATK_RED)
  ELSE
    BossSortie()
  FI
RETURN

; BeamRow(i, draw): tile row i of the beam (0-9) drawn in its blues turned
; by bm_ph, or put back to what is under it
PROC BeamRow(BYTE i, BYTE draw)
  BYTE r, n, j, b, c, y, x, m
  CARD p, sx
  FOR r = bm_step(i) TO bm_step(i + 1) - 1 DO
    p = bm_roff(r)
    n = bm_rows(p)
    y = BEAM_Y + r
    FOR j = 1 TO n DO
      x = cap_x - 32 + bm_rows(p + 1)
      b = bm_rows(p + 2)
      p += 2
      sx = x
      PIX_X = sx + FX
      PIX_Y = y
      c = ((b >> 6) + bm_ph) % 3 + BEAM_C
      FOR m = 1 TO b & $3F DO
        IF draw THEN
          PIX_DATA = c
        ELSEIF y >= BAND_Y THEN
          PIX_DATA = BandPixel(x, y)
        ELSE
          PIX_DATA = 0
        FI
        x += 1
      OD
    OD
  OD
RETURN

; Caught: the fighter under the beam taken -- no longer steered, nor hit,
; and pulled up (Pull) -- its own routine, so that the gate can spare it
PROC Caught()
  ftr_dead = 5
  ftr_y9 = $129
  ftr_code = 6
  ftr_ctrl = 0
  cap_pull = 1
  cap_fl = $0A
  StopSound(S_BEAM)
  PlaySound(S_TRACTOR)
RETURN

; Capture: f_21CB, the capture boss turned to face down once its path has
; slowed it; then f_2222, the beam -- a tile row every so many frames, ten,
; held 64 frames while it takes a fighter under it, taken back a row at a
; time -- and after it the boss goes on, or home with the fighter
PROC Capture()
  BYTE k, a, low
  IF cap_ph == 0 THEN RETURN FI
  k = cap_k
  IF cap_ph == 1 THEN
    IF fl_state(k) != 9 OR fl_obj(k) != cobj THEN
      cflag = 0
      cap_ph = 0
      RETURN
    FI
    IF fl_vo(k) THEN RETURN FI
    IF fl_a5(k) & 1 THEN fl_dl(k) = $F4 ELSE fl_dl(k) = $0C FI
    a = ((fl_a5(k) & 1) << 7) | (fl_a4(k) >> 1)
    a = a - $78
    IF a < $10 THEN
      fl_dl(k) = 0
      cap_ph = 2
      cap_fl = sp(6)
      cap_s1 = 0
      cap_s2 = 1
      cap_con = 0
    FI
    RETURN
  FI
  ; the beam's blues turn every fourth frame, a tile row a frame redrawn
  IF frm & 3 == 0 THEN bm_ph += 1 FI
  low = cap_s1 & $0F
  IF (cap_s1 & $C0) == 0 AND low THEN BeamRow(frm % low, 1) FI
  IF cap_s1 == $40 THEN BeamRow(frm % 10, 1) FI
  ; its boss shot while it is out: taken back quickly
  IF (cap_s1 & $80) == 0 AND (fl_state(k) != 9 OR fl_obj(k) != cobj) THEN
    cap_fl = 3
    cap_s1 = $80
    cap_s2 = 1
    IF cap_pull THEN cap_pull = 2 FI
    StopSound(S_BEAM)
  FI
  cap_s2 -= 1
  IF cap_s2 THEN
    IF cap_s1 == $40 AND ftr_dead == 0 THEN
      a = cap_x - fx - 17 + $1B
      IF a < $36 THEN Caught() FI
    FI
    RETURN
  FI
  cap_s2 = cap_fl
  IF cap_s1 & $80 THEN
    cap_s1 += 1
    low = cap_s1 & $0F
    IF low == $0B THEN
      cap_ph = 0
      cflag = 0
      StopSound(S_TRACTOR)
    ELSE
      BeamRow(low - 1, 0)
    FI
    RETURN
  FI
  IF snd_on(S_BEAM) == 0 AND ftr_dead != 5 THEN PlaySound(S_BEAM) FI
  fl_n(k) = $FF
  cap_s1 += 1
  low = cap_s1 & $0F
  IF low == $0B THEN
    IF cap_s1 & $40 THEN
      IF cap_con AND (cap_s1 & $20) == 0 THEN
        cap_s1 = $68
        RETURN
      FI
      cap_ph = 0
      StopSound(S_BEAM)
      StopSound(S_TRACTOR)
      IF cap_con THEN
        fl_p(k) = FL_CBOSS           ; home, the fighter with it
        cap_home = 1
        cap_n = 0
        cap_ob = cobj
      ELSE
        cflag = 0
        cobj = 1
        fl_n(k) = 1
      FI
    ELSE
      cap_s1 = $40
      cap_s2 = $40
    FI
    RETURN
  FI
  IF cap_s1 & $40 THEN BeamRow(10 - low, 0) ELSE BeamRow(low - 1, 1) FI
RETURN

PROC Launcher()
  BYTE tok, raw, obj, k
  IF launching == 0 THEN RETURN FI
  tok = st_wv(wv_p)
  IF tok == $7F THEN
    IF flying_nbr == 0 THEN
      launching = 0
      nest_inh = 1
      dv_on = 1
    FI
    RETURN
  FI
  IF tok == $7E THEN
    IF ftr_on == 0 THEN RETURN FI
    IF flying_nbr THEN
      gt(0) = 2
      RETURN
    FI
    IF st_kind((stage - 1) % STAGES) AND gt(0) THEN RETURN FI
    IF wv_p THEN wave_no += 1 FI
    wv_p += 1
    RETURN
  FI
  IF (tok & $80) == 0 AND (frm & 7) != 0 THEN RETURN FI
  k = FreeFlyer()
  IF k == 255 THEN RETURN FI
  raw = st_wv(wv_p + 1)
  obj = raw
  IF raw & $78 == $78 THEN obj = raw & $BF FI
  wv_p += 2
  Launch(k, obj, raw, tok)
  fl_wave(k) = wave_no
RETURN

; FlyFrame: a frame of the arcade's order -- the launcher, the breathing,
; the sway, the objects' states, then every slot's motion
PROC FlyFrame()
  BYTE k
  frm += 1
  Params()
  Launcher()
  IF breathing AND frm & 3 == 0 THEN
    Breathe()
    IF br_cnt & 7 == 0 THEN flap = 1 - flap FI
  FI
  IF sway_on AND (frm - 1) & 3 == 0 THEN Sway() FI
  Positions()
  FlyStates()
  Bombs()
  IF dv_on THEN Sorties() FI
  IF frm & 31 == 0 THEN
    FOR k = 0 TO 3 DO
      IF gt(k) THEN gt(k) -= 1 FI
    OD
  FI
  Capture()
  cont_bomb = 0
  IF en_nbr < sp(7) THEN cont_bomb = ftr_on FI
  flying_nbr = flying
  flying = 0
  FOR k = 0 TO NFLY - 1 DO
    IF fl_on(k) THEN FlyStep(k) FI
  OD
  FlyDraw()
  BombsDraw()
RETURN

; ------------------------------------------------------------ explosions
; An explosion is the arcade's double-size frames drawn into the bitmap,
; a frame every four; going on to the next puts back what was under the
; last, and draws again any character at rest it went over.

FUNC BYTE Clamp(INT v, BYTE hi)
  IF v < 0 THEN RETURN (0) FI
  IF v > hi THEN RETURN (hi) FI
RETURN (v)

; Boom(first, n, cx, cy): n frames from art first, centred on the field's (cx, cy)
BYTE boom_len
PROC Boom(BYTE first, BYTE n, INT cx, INT cy)
  BYTE i
  FOR i = 0 TO NBOOM - 1 DO
    IF bm_on(i) == 0 THEN
      bm_on(i) = 1
      IF boom_len THEN bm_len(i) = boom_len ELSE bm_len(i) = 4 FI
      boom_len = 0
      bm_art(i) = first
      bm_n(i) = n
      bm_f(i) = 0
      bm_t(i) = 0
      bm_x(i) = Clamp(cx - 16, FW - 32)
      bm_y(i) = Clamp(cy - 16, 240 - 32)
      ArtDraw(first, bm_x(i), bm_y(i), 0)
      booms += 1
      RETURN
    FI
  OD
RETURN

; FmRedraw(x, y): every character at rest whose box meets the 32 x 32 at
; (x, y) drawn again
PROC FmRedraw(BYTE x, BYTE y)
  BYTE i
  INT dx, dy
  FOR i = 0 TO NSLOT - 1 DO
    IF sl_on(i) THEN
      dx = sl_x(i)
      dx = dx - x
      dy = sl_y(i)
      dy = dy - y
      IF dx > -16 AND dx < 32 AND dy > -16 AND dy < 32 THEN
        FmDraw(sl_fr(i), 0, sl_x(i), sl_y(i), 0)
      FI
    FI
  OD
RETURN

PROC Booms()
  BYTE i, k
  FOR i = 0 TO NBOOM - 1 DO
    IF bm_on(i) THEN
      bm_t(i) += 1
      IF bm_t(i) == bm_len(i) THEN
        bm_t(i) = 0
        k = bm_art(i) + bm_f(i)
        ArtDraw(k, bm_x(i), bm_y(i), 2)
        FmRedraw(bm_x(i), bm_y(i))
        bm_f(i) += 1
        IF bm_f(i) == bm_n(i) THEN
          bm_on(i) = 0
          booms -= 1
        ELSE
          ArtDraw(k + 1, bm_x(i), bm_y(i), 0)
        FI
      FI
    FI
  OD
RETURN

; Popup(art, cx, cy): a score shown where it was won, for a second
PROC Popup(BYTE art, INT cx, INT cy)
  boom_len = 60
  Boom(art, 1, cx, cy)
RETURN

; InBoom(x, y): whether an explosion's box holds that pixel
FUNC BYTE InBoom(BYTE x, BYTE y)
  BYTE i
  FOR i = 0 TO NBOOM - 1 DO
    IF bm_on(i) THEN
      IF x >= bm_x(i) AND x < bm_x(i) + 32 AND y >= bm_y(i) AND y < bm_y(i) + 32 THEN RETURN (1) FI
    FI
  OD
RETURN (0)

; ---------------------------------------------------------------- scoring
; the arcade's scores are all tens, so the score is kept in tens
CARD score10, hi10
BYTE lives                           ; fighters in hand, the one in play not counted
BYTE xtra                            ; a fighter was added: the panel to redraw
BYTE score_shown

; points in tens for a character at rest: bee 50, butterfly 80, boss 150
FUNC BYTE RestPoints(BYTE kind)
  IF kind == FM_ZAKO6 THEN RETURN (5) FI
  IF kind == FM_GOEI6 THEN RETURN (8) FI
  IF kind == FM_CAPTURED6 THEN RETURN (50) FI
RETURN (15)

CARD ext10                            ; the next extra fighter's score, in tens: 20,000, then 70,000 and every 70,000
PROC AddScore(CARD tens)
  score10 += tens
  IF score10 > hi10 THEN hi10 = score10 FI
  score_shown = 0
  IF score10 >= ext10 THEN
    IF ext10 == 2000 THEN ext10 = 7000 ELSE ext10 += 7000 FI
    lives += 1
    xtra = 1
  FI
RETURN

PROC ShowScore()
  IF score_shown == 0 THEN
    Number(0, 20, score10, 5, C_WHITE)
    Text(40, 20, "0", C_WHITE)
    Number(0, 66, hi10, 5, C_WHITE)
    Text(40, 66, "0", C_WHITE)
    score_shown = 1
  FI
RETURN

; ShootSlot(i): a character at rest hit. A boss takes two: the first turns
; it blue.
PROC ShootSlot(BYTE i)
  BYTE fr
  fr = sl_fr(i)
  FmDraw(fr, 0, sl_x(i), sl_y(i), 1)
  IF sl_kind(i) == FM_BOSS6 THEN
    sl_kind(i) = FM_BOSS_HIT6
    sl_fr(i) = FM_BOSS_HIT6 + flap
    FmDraw(sl_fr(i), 0, sl_x(i), sl_y(i), 0)
    PlaySound(S_BOSSHIT)
    RETURN
  FI
  IF sl_kind(i) == FM_ZAKO6 THEN
    PlaySound(S_ZAKO)
  ELSEIF sl_kind(i) == FM_GOEI6 THEN
    PlaySound(S_GOEI)
  ELSE
    PlaySound(S_BOSS)
  FI
  sl_on(i) = 0
  AddScore(RestPoints(sl_kind(i)))
  Boom(A_EBOOM0, N_EBOOM, sl_x(i) + 8, sl_y(i) + 8)
RETURN

; FlyAt(x, y9): hitd_det_rckt -- the flyer a rocket at the arcade's (x, y9)
; hits: five pixels either way across, and Y's halves three below to two above
FUNC BYTE FlyAt(BYTE x, CARD y9)
  BYTE k, d, ry
  ry = y9 >> 1
  FOR k = 0 TO NFLY - 1 DO
    IF fl_state(k) THEN
      d = fl_y9(k) >> 1
      d = d - ry + 3
      IF d < 6 THEN
        d = fl_x8(k) - x + 5
        IF d < 11 THEN RETURN (k) FI
      FI
    FI
  OD
RETURN (255)

; ShootFlyer(k): a flyer hit -- a boss the first time only turns blue, and
; stays so in the formation; otherwise the points for it in the air, an
; explosion, and its place in the formation stays empty
PROC ShootFlyer(BYTE k)
  BYTE slot, w, obj
  CARD pts
  obj = fl_obj(k)
  slot = obj_slot(obj >> 1)
  IF fl_char(k) == F_BOSS THEN
    fl_char(k) = F_BOSS_HIT
    IF slot != 255 THEN sl_kind(slot) = FM_BOSS_HIT6 FI
    PlaySound(S_BOSSHIT)
    RETURN
  FI
  IF obj == cobj THEN
    cflag = 0
    cobj = 1
  FI
  IF fl_char(k) == F_ZAKO THEN
    pts = 5
    PlaySound(S_ZAKO)
  ELSEIF fl_char(k) == F_BOSS_HIT THEN
    pts = 15
    PlaySound(S_BOSS)
  ELSEIF fl_char(k) == F_CAPTURED THEN
    pts = 50
    PlaySound(S_BOSS)
  ELSE
    pts = 8
    PlaySound(S_GOEI)
  FI
  ; flying, twice as much; a boss that is not a transient, its escorts' worth
  IF fl_state(k) != 2 THEN
    pts = pts << 1
    IF pts == 30 AND (obj & $38) != $38 THEN
      pts = boss_sc((obj & 6) >> 1)
      gt(1) = 6
      w = A_P400
      IF pts == 80 THEN w = A_P800 FI
      IF pts == 160 THEN w = A_P1600 FI
      Popup(w, fl_sx(k) + 8, fl_sy(k) + 8)
    FI
  FI
  AddScore(pts)
  Boom(A_EBOOM0, N_EBOOM, fl_sx(k) + 8, fl_sy(k) + 8)
  IF st_kind((stage - 1) % STAGES) THEN
    ch_hits += 1
    w = fl_wave(k)
    ch_kills(w) += 1
    IF ch_kills(w) == 8 THEN
      ; the arcade's d_stage_chllg_rnd_attrib: 1000 on the first two
      ; challenging stages, 1500 on the next two
      IF stage < 9 THEN
        AddScore(100)
        Popup(A_P1000, fl_sx(k) + 8, fl_sy(k) + 8)
      ELSE
        AddScore(150)
        Popup(A_P1500, fl_sx(k) + 8, fl_sy(k) + 8)
      FI
    FI
  FI
  FlyFree(k)
RETURN

; ------------------------------------------------------------- the shots
; Two at most, as the arcade's, six pixels a frame; each tests the column
; of pixels its head has passed through since the last frame
CONST NSHOT = 2
CARD shots, hits                     ; the game's rockets fired and those that hit, for the results
BYTE ARRAY sh_on(NSHOT), sh_x(NSHOT) ; the arcade's sprite X of the rocket -- the fighter's when it was fired
CARD ARRAY sh_y(NSHOT)               ; and its Y, six less a frame

PROC Fire()
  BYTE i
  FOR i = 0 TO NSHOT - 1 DO
    IF sh_on(i) == 0 THEN
      PlaySound(S_SHOT)
      shots += 1
      sh_on(i) = 1
      sh_x(i) = fx + 17
      sh_y(i) = $129
      RETURN
    FI
  OD
RETURN

PROC Shots()
  BYTE i, k, j, x
  INT y
  CARD pat, y9, sx
  pat = SPR_BASE + (P_SHOT << 7)
  FOR i = 0 TO NSHOT - 1 DO
    IF sh_on(i) THEN
      y9 = sh_y(i) - 6
      sh_y(i) = y9
      y = MapY(y9) + 4
      x = sh_x(i) - 10               ; the field's column of the rocket's middle
      IF y9 < 40 THEN
        sh_on(i) = 0
        SpriteHide(SP_SHOT + i)
      ELSE
        j = FlyAt(sh_x(i), y9)
        IF j != 255 THEN
          hits += 1
          ShootFlyer(j)
          sh_on(i) = 0
          SpriteHide(SP_SHOT + i)
        FI
        IF sh_on(i) THEN
          FOR k = 0 TO 5 DO
            IF y + k >= 0 THEN j = SlotAt(x, y + k) ELSE j = 255 FI
            IF j != 255 THEN
              hits += 1
              ShootSlot(j)
              sh_on(i) = 0
              SpriteHide(SP_SHOT + i)
              EXIT
            FI
          OD
        FI
        IF sh_on(i) THEN
          sx = x
          SetSprite(SP_SHOT + i, (sx - 3 + FX) << 1, y << 1, pat, 1, 0)
        FI
      FI
    FI
  OD
RETURN

; ----------------------------------------------------------- the fighter

BYTE game_over

PROC Fighter()
  BYTE fr
  IF ftr_dead == 5 THEN
    IF ftr_on AND KeyHit(KEY_SPACE) THEN Fire() FI
    IF cap_home THEN RETURN FI
    fr = F_FIGHTER
    IF cap_con OR ftr_y9 <= $E0 THEN fr = F_CAPTURED FI
    ShowChar(SP_FIGHTER, fr + ftr_code, ftr_ctrl & 2, ftr_ctrl & 1, fx + FX, MapY(ftr_y9))
    RETURN
  FI
  IF ftr_dead AND ftr_dead != 3 THEN RETURN FI
  IF KeyHeld(KEY_LEFT) OR KeyHeld(KEY_Z) THEN fx -= 2 FI
  IF KeyHeld(KEY_RIGHT) OR KeyHeld(KEY_X) THEN fx += 2 FI
  IF fx < 1 THEN fx = 1 FI
  IF fx > 191 + 16 THEN fx = 191 + 16 FI
  IF ftr_on AND KeyHit(KEY_SPACE) THEN Fire() FI
  ShowChar(SP_FIGHTER, F_FIGHTER + 6, 0, 0, fx + FX, FIGHTER_Y)
RETURN

; FighterHit: the fighter gone in its explosion, the noise of it; the
; waves stop, the divers go home, nothing more is dropped
PROC FighterHit()
  IF ftr_dead THEN RETURN FI
  ftr_dead = 1
  ftr_on = 0
  gt(3) = 4
  HideChar(SP_FIGHTER)
  Boom(A_PBOOM0, N_PBOOM, fx + 8, FIGHTER_Y + 8)
  boom_snd = 90
RETURN

; Touch(x, y9): hitd_det_fghtr -- whether a sprite at the arcade's (x, y9)
; meets the fighter: six pixels either way across, three halves up or down
FUNC BYTE Touch(BYTE x, CARD y9)
  BYTE d
  d = x - fx - 17 + 6
  IF d > 12 THEN RETURN (0) FI
  d = y9 >> 1
  d = d - $91
RETURN (d < 7)

; Collide: f_05EE -- whatever flies into the fighter is destroyed with it,
; but a green boss only turns blue; while the waves come in, only their
; transients can. The first bomb that touches it is gone with it.
PROC Collide()
  BYTE k, hit, obj
  IF ftr_on == 0 OR ftr_dead THEN RETURN FI
  hit = 0
  FOR k = 0 TO NFLY - 1 DO
    IF fl_state(k) == 3 OR fl_state(k) == 7 OR fl_state(k) == 9 THEN
      obj = fl_obj(k)
      IF launching == 0 OR (obj & $38) == $38 THEN
        IF Touch(fl_x8(k), fl_y9(k)) THEN
          hit = 1
          ShootFlyer(k)
        FI
      FI
    FI
  OD
  FOR k = 0 TO NBOMB - 1 DO
    IF bo_on(k) THEN
      IF Touch(bo_x(k), bo_y(k)) THEN
        BombOff(k)
        hit = 1
        EXIT
      FI
    FI
  OD
  IF hit THEN FighterHit() FI
RETURN

; ------------------------------------------------------------ the screen
CARD stage_frames                    ; frames since the stage's first, for the gate
BYTE ARRAY txtbuf(24)

PROC Hud()
  Text(4, 8, "1UP", C_RED)
  Text(4, 44, "HIGH", C_RED)
  Text(4, 54, "SCORE", C_RED)
  score_shown = 0
  ShowScore()
RETURN

; Fill(x, y, w, h): a rectangle of the screen to black
PROC Fill(CARD x, BYTE y, BYTE w, BYTE h)
  BYTE r, k
  FOR r = 0 TO h - 1 DO
    PIX_X = x
    PIX_Y = y + r
    FOR k = 1 TO w DO PIX_DATA = 0 OD
  OD
RETURN

; Panel: the right-hand panel -- the fighters in hand, three to a row,
; and the stage's badges as the arcade adds them up: 50s, 30s, 20s, 10s,
; 5s and 1s, a row of them from the right
BYTE ARRAY bdg_val(6) = [50 30 20 10 5 1]
BYTE ARRAY bdg_art(6) = [A_B50 A_B30 A_B20 A_B10 A_B5 A_B1]
BYTE ARRAY bdg_w(6) = [15 15 15 13 7 7]

; PanelArt(k, x, y): bitmap art k with its box's top-left at the screen's
; (x, y) -- the panel is past the field, where its x no longer fits a byte
PROC PanelArt(BYTE k, CARD x, BYTE y)
  dd_ptr = art_delta + art_off(k)
  dd_x = x - 1
  dd_y = y - 2
  dd_erase = 0
  dd_lim = 255 - 32
  DrawDelta()
RETURN

; Lives: the fighters in hand, their rows cleared first
PROC Lives()
  BYTE i, y
  CARD x
  Fill(272, 0, 48, 40)
  y = 8
  x = 275
  FOR i = 1 TO lives DO
    IF i <= 6 THEN
      PanelArt(A_LIFE, x, y)
      x += 15
      IF x > 305 THEN
        x = 275
        y += 16
      FI
    FI
  OD
RETURN

PROC Panel()
  BYTE n, k, y
  CARD x
  Fill(272, 40, 48, 120)
  Lives()
  n = stage
  x = 319
  y = 48
  FOR k = 0 TO 5 DO
    WHILE n >= bdg_val(k) DO
      n -= bdg_val(k)
      IF x < 273 + bdg_w(k) THEN
        x = 319
        y += 18
      FI
      x = x - bdg_w(k) - 1
      PanelArt(bdg_art(k), x, y)
    OD
  OD
RETURN

; FieldText(s, n, c): "STAGE 12" and the like -- n left off when 0 --
; centred in the field at row 120
PROC FieldText(BYTE POINTER s, CARD n, BYTE c)
  BYTE i, len, d
  CARD v
  len = *s
  FOR i = 1 TO len DO
    s += 1
    txtbuf(i) = *s
  OD
  IF n THEN
    len += 1
    txtbuf(len) = ' '
    v = n
    d = 1
    IF v >= 10 THEN d = 2 FI
    IF v >= 100 THEN d = 3 FI
    FOR i = 1 TO d DO
      txtbuf(len + d + 1 - i) = '0' + v % 10
      v = v / 10
    OD
    len += d
  FI
  txtbuf(0) = len
  tx_y = 120
  Text(FX + 112 - (len << 2), tx_y, txtbuf, c)
RETURN

PROC FieldTextOff()
  IF tx_y THEN
    Fill(FX, tx_y, FW, 8)
    tx_y = 0
  FI
RETURN

; Spin: c_2188 -- a tile a frame round towards upright and over, the flips
; following; 1 once it is upright again with nothing left to pull
FUNC BYTE Spin()
  BYTE c, a
  c = ftr_ctrl ^ (ftr_ctrl >> 1)
  a = ftr_code
  IF a == 6 AND c == 0 AND cap_pull == 2 THEN RETURN (1) FI
  DO
    IF c & 1 THEN
      IF a THEN
        ftr_code = a - 1
        EXIT
      FI
    ELSEIF a != 6 THEN
      ftr_code = a + 1
      EXIT
    FI
    IF c == 0 THEN c = 3 ELSE c -= 1 FI
  OD
  IF c & 2 THEN c = c ^ 1 FI
  ftr_ctrl = c
RETURN (0)

; Pull: f_20F2 -- the fighter taken up spinning a pixel a frame towards the
; boss above it, its rockets gone at 230 and red and the boss's at 224; if
; the boss is shot first, dropped back to its row and given back
PROC Pull()
  BYTE d, k
  IF cap_pull == 0 THEN RETURN FI
  k = cap_k
  IF Spin() THEN
    IF ftr_on THEN
      ; the boss was shot: down to the fighter's row, then given back
      IF ftr_y9 == $129 THEN
        cap_pull = 0
        ftr_dead = 0
      ELSE
        ftr_y9 += 1
      FI
    ELSE
      cap_con = 1
      cap_pull = 0
    FI
    RETURN
  FI
  IF cap_s1 & $80 THEN
    ; the boss shot: back down
    IF ftr_y9 != $129 THEN ftr_y9 += 1 FI
    RETURN
  FI
  IF cap_pull == 2 THEN RETURN FI
  d = fl_x8(k) - fx - 17
  IF d THEN
    IF d & $80 THEN fx -= 1 ELSE fx += 1 FI
  FI
  ftr_y9 -= 1
  IF ftr_y9 == $E6 THEN ftr_on = 0 FI
  IF ftr_y9 == $E0 THEN cap_pull = 2 FI
RETURN

; CapturedHome: f_19B2 -- FIGHTER CAPTURED, the boss held while it shows;
; then the red fighter below the boss all the way home, and up into the
; place above it; then the player's fighter is lost
PROC CapturedHome()
  BYTE slot
  IF cap_home == 0 THEN RETURN FI
  IF cap_home == 1 THEN
    FieldText("FIGHTER CAPTURED", 0, C_RED)
    gt(1) = 6
    cap_home = 2
    RETURN
  FI
  IF gt(1) THEN
    IF gt(1) == 4 THEN
      gt(1) = 3
      PlaySound(S_CAPTURED)
    FI
    fl_n(cap_k) = 4
  ELSEIF tx_y THEN
    FieldTextOff()
  FI
  IF cobj != cap_ob THEN
    ; its boss shot on the way home: the rescue is not here yet, so the
    ; red fighter is simply gone, and with it the player's
    cap_home = 0
    HideChar(SP_FIGHTER)
    FieldTextOff()
    ftr_dead = 1
    gt(3) = 2
    RETURN
  FI
  IF fl_state(cap_k) == 9 AND fl_obj(cap_k) == cobj THEN
    fx = fl_x8(cap_k) - 17
    ftr_y9 = fl_y9(cap_k) + 16
  ELSE
    ftr_code = 6
    cap_n += 1
    IF cap_n > $24 THEN
      cap_home = 0
      HideChar(SP_FIGHTER)
      slot = obj_slot(cap_ob >> 1) - 4
      SlotShow(slot)
      cobj = 1
      cflag = 0
      ftr_dead = 1
      gt(3) = 2
      RETURN
    FI
    ftr_y9 -= 1
  FI
  ShowChar(SP_FIGHTER, F_CAPTURED + 6, 0, 0, fx + FX, MapY(ftr_y9))
RETURN

PROC Frame1()
  WaitVBlank()
  KeyPoll()
  SoundFrame()
  loops += 1
RETURN

; StageStart: the formation empty, the columns at rest, the launcher on
; the stage's waves and the sway on until the last is home
PROC StageStart()
  BYTE i, k
  CARD w
  FOR i = 0 TO NSLOT - 1 DO SlotHide(i) OD
  SlotsInit()
  FOR i = 0 TO 9 DO col_off(i) = 0 OD
  FOR i = 0 TO 5 DO row_off(i) = 0 OD
  FOR i = 0 TO NFLY - 1 DO FlyFree(i) OD
  sway = 0
  sway_dir = 0
  sway_on = 1
  nest_inh = 0
  breathing = 0
  br_cnt = 0
  flap = 0
  frm = 0
  stage_frames = 0
  flying = 0
  flying_nbr = 0
  k = (stage - 1) % STAGES
  Load(D_WAVES + st_woff(k), DH_WAVES, st_wv, st_woff(k + 1) - st_woff(k))
  wv_p = 0
  launching = 1
  ; stg_init_env and c_2C00: the stage's parameters, its timers, no dives
  ; until the waves are in
  k = (stage - 1) % STAGES
  hdr0 = st_hdr(k << 1)
  w = k
  w = (w << 3) + (w << 1)
  FOR i = 0 TO 9 DO sp(i) = st_parm(w + i) OD
  dv_max = sp(4)
  cap_len = sp(6)
  cap_len = cap_len * 20 + 65
  gt(0) = 2
  gt(1) = 0
  gt(2) = 120
  gt(3) = 0
  dv_tm(0) = 22
  dv_tm(1) = 2
  dv_tm(2) = 2
  FOR i = 0 TO 3 DO
    pool_o(i) = 255
    boss_sc(i) = 40
  OD
  dv_on = 0
  cflag = 0
  cobj = 1
  wingm = 0
  cap_ph = 0
  cap_pull = 0
  cap_home = 0
  en_cnt = 0
  en_nbr = 0
  cont_bomb = 0
  FOR i = 0 TO NBOMB - 1 DO
    IF bo_on(i) THEN BombOff(i) FI
  OD
  wave_no = 0
  ch_hits = 0
  FOR i = 0 TO 4 DO ch_kills(i) = 0 OD
  Positions()
  MusicStart(level_bd)
RETURN

; StageDone: nothing left of the stage -- the launcher finished, nothing
; in the formation, in the air or exploding
FUNC BYTE StageDone()
  BYTE i
  IF launching OR booms THEN RETURN (0) FI
  FOR i = 0 TO NBOMB - 1 DO
    IF bo_on(i) THEN RETURN (0) FI
  OD
  FOR i = 0 TO NSLOT - 1 DO
    IF sl_on(i) THEN RETURN (0) FI
  OD
  FOR i = 0 TO NFLY - 1 DO
    IF fl_state(i) THEN RETURN (0) FI
  OD
RETURN (1)

; a frame of the stars and the fighter, with nothing else to do
PROC Idle()
  Frame1()
  StarsErase()
  StarsDraw()
  Fighter()
  Shots()
RETURN

; StageIntro: the stage's backdrop if the level has turned, its badges,
; "STAGE n" for two seconds
PROC StageIntro()
  BYTE i, lv
  lv = ((stage - 1) / 4) % 4
  IF lv != level_bd THEN
    level_bd = lv
    LoadBackdrop(level_bd)
  FI
  Panel()
  StopSound(S_PULSE)
  MusicStop()
  IF stage == 1 THEN
    ; a new game: the start theme under PLAYER 1, then the stage
    PlaySound(S_START)
    FieldText("PLAYER 1", 0, C_CYAN)
    WHILE TuneOn() DO Idle() OD
    FieldTextOff()
  FI
  IF st_kind((stage - 1) % STAGES) THEN
    i = ((stage - 1) >> 2) & 3
    IF i == 2 THEN Stream(D_SW_DRAGONFLY, DH_SW_DRAGONFLY, SPR_BASE + (P_SWAP << 7), N_SW_DRAGONFLY) FI
    IF i == 3 THEN Stream(D_SW_SCORPION, DH_SW_SCORPION, SPR_BASE + (P_SWAP << 7), N_SW_SCORPION) FI
    PlaySound(S_CHALLENGE)
    FieldText("CHALLENGING STAGE", 0, C_CYAN)
  ELSE
    FieldText("STAGE", stage, C_CYAN)
  FI
  FOR i = 1 TO 120 DO Idle() OD
  FieldTextOff()
RETURN

; Afterlife: gctl_stg_restart_hdlr -- four counts for the explosion, then
; READY and, once nothing is flying, a fighter from the panel in the
; middle; three counts more and it is in play, the stage's time thirty
; longer. With the panel empty, GAME OVER.
PROC Afterlife()
  IF ftr_dead == 0 OR ftr_dead == 5 OR gt(3) THEN RETURN FI
  IF ftr_dead == 1 THEN
    IF lives == 0 THEN
      FieldText("GAME OVER", 0, C_RED)
      ftr_dead = 4
      gt(3) = 6
    ELSE
      lives -= 1
      Lives()
      FieldText("READY", 0, C_RED)
      ftr_dead = 2
    FI
  ELSEIF ftr_dead == 2 THEN
    IF flying_nbr == 0 THEN
      fx = $7A - 17
      IF gt(2) < 90 THEN gt(2) += 30 ELSE gt(2) = 120 FI
      gt(3) = 3
      ftr_dead = 3
    FI
  ELSEIF ftr_dead == 3 THEN
    FieldTextOff()
    ftr_dead = 0
    ftr_on = 1
  ELSE
    FieldTextOff()
    game_over = 1
  FI
RETURN

; Results: a challenging stage's tally -- the hits, and a hundred for
; each, or for all forty the PERFECT and ten thousand
PROC Results()
  BYTE i
  CARD bonus
  MusicStop()
  StopSound(S_PULSE)
  FieldText("NUMBER OF HITS", ch_hits, C_CYAN)
  FOR i = 1 TO 90 DO Idle() OD
  FieldTextOff()
  IF ch_hits == 40 THEN
    PlaySound(S_PERFECT)
    FieldText("PERFECT !", 0, C_RED)
    FOR i = 1 TO 90 DO Idle() OD
    FieldTextOff()
    FieldText("SPECIAL BONUS 10000", 0, C_YELLOW)
    AddScore(1000)
  ELSE
    PlaySound(S_RESULTS)
    bonus = ch_hits
    FieldText("BONUS", bonus * 100, C_YELLOW)
    AddScore(bonus * 10)
  FI
  ShowScore()
  FOR i = 1 TO 150 DO Idle() OD
  FieldTextOff()
RETURN

; Finale: the arcade's results after GAME OVER -- the field emptied, the
; rockets fired, the hits and the ratio of the two to a tenth of a percent
PROC Finale()
  BYTE i
  CARD r, q
  FOR i = SP_FIGHTER TO 31 DO SpriteHide(i) OD
  FieldTextOff()
  Fill(FX, 0, FW, 240)
  Text(FX + 76, 104, "-RESULTS-", C_RED)
  Text(FX + 24, 128, "SHOTS FIRED", C_YELLOW)
  Number(FX + 152, 128, shots, 5, C_YELLOW)
  Text(FX + 24, 152, "NUMBER OF HITS", C_YELLOW)
  Number(FX + 152, 152, hits, 5, C_YELLOW)
  Text(FX + 24, 176, "HIT-MISS RATIO", C_WHITE)
  r = 0
  IF shots THEN
    ; hits * 1000 / shots, a digit at a time so that nothing overflows
    q = hits
    FOR i = 1 TO 3 DO
      r = r * 10 + (q * 10) / shots
      q = (q * 10) % shots
    OD
  FI
  Number(FX + 144, 176, r / 10, 3, C_WHITE)
  Text(FX + 168, 176, ".", C_WHITE)
  Number(FX + 176, 176, r % 10, 1, C_WHITE)
  Text(FX + 192, 176, "%", C_WHITE)
  FOR r = 1 TO 300 DO Frame1() OD
RETURN

PROC Play()
  BYTE i
  Clg(0)
  Hud()
  level_bd = 0
  LoadBackdrop(0)
  StarsInit()
  fx = 104
  stage = 1
  lives = 2
  ftr_dead = 0
  ftr_on = 1
  shots = 0
  hits = 0
  game_over = 0
  score10 = 0
  ext10 = 2000
  score_shown = 0
  ShowScore()
  StageIntro()
  StageStart()
  DO
    Frame1()
    IF KeyHit(KEY_ESC) THEN EXIT FI
    IF KeyHit(KEY_P) THEN
      ; paused: the voices silenced, frames waited out until P again
      FOR i = 0 TO 7 DO Voice(i, 0, 0, 0) OD
      DO
        WaitVBlank()
        KeyPoll()
        IF KeyHit(KEY_P) THEN EXIT FI
      OD
    FI
    stage_frames += 1
    StarsErase()
    FlyFrame()
    CapturedHome()
    Pull()
    FmStep(frm & 3)
    Booms()
    StarsDraw()
    Fighter()
    Shots()
    Collide()
    Afterlife()
    ShowScore()
    IF xtra THEN
      xtra = 0
      Lives()
      PlaySound(S_EXTEND)
    FI
    IF game_over THEN
      Finale()
      EXIT
    FI
    IF StageDone() AND ftr_dead == 0 THEN
      IF st_kind((stage - 1) % STAGES) THEN
        Results()
        ; the butterfly's and the captured fighter's patterns back
        Stream(D_SPR + (P_SWAP << 7), DH_SPR, SPR_BASE + (P_SWAP << 7), N_SWAP << 7)
      FI
      stage += 1
      StageIntro()
      StageStart()
    FI
  OD
  SoundsOff()
RETURN

; Title: the arcade's attract words and its score table, the backdrops'
; credits their licences ask for, and the space bar to start
PROC Title()
  BYTE t
  Clg(0)
  SpritesOff()
  Hud()
  Text(FX + 88, 24, "GALAGA", C_CYAN)
  Text(FX + 56, 48, "-- SCORE --", C_CYAN)
  Text(FX + 8, 72, "BEE", C_YELLOW)
  Text(FX + 104, 72, "50   100", C_CYAN)
  Text(FX + 8, 92, "BUTTERFLY", C_RED)
  Text(FX + 104, 92, "80   160", C_CYAN)
  Text(FX + 8, 112, "BOSS", C_GREEN)
  Text(FX + 104, 112, "150  400", C_CYAN)
  Text(FX + 72, 132, "IN FORMATION", C_WHITE)
  Text(FX + 72, 142, "AND DIVING", C_WHITE)
  Text(FX + 48, 156, "PUSH SPACE KEY", C_WHITE)
  Text(0, 184, "@ 1981 NAMCO LTD.", C_WHITE)
  Text(0, 200, "BACKDROPS ARTHCARVALHO OGA-BY", C_BLUE)
  Text(0, 210, "EMCEE FLESHER CC-BY. PLANET G. FISET", C_BLUE)
  Text(0, 220, "NASA-JPL-CALTECH-SWRI-MSSS. ZWONKY CC0", C_BLUE)
  Text(0, 230, "QUANTISET CC0. D. COOK CC-BY", C_BLUE)
  SoundsOff()
  DO
    WaitVBlank()
    KeyPoll()
    SoundFrame()
    IF KeyHit(KEY_SPACE) THEN EXIT FI
    IF KeyHit(KEY_ESC) THEN
      quit = 1
      EXIT
    FI
  OD
  SpritesOn(15)
RETURN

PROC Main()
  BYTE i
  Graphics(4)
  Cursor(0)
  VID_BORDER = 0
  SpritesOff()
  IF OpenData() == 0 THEN
    Graphics(0)
    PrintE("GALAGA.DAT is not on drive 11")
    RETURN
  FI
  Stream(D_SPR, DH_SPR, SPR_BASE, N_SPR)
  mus_level = 255
  SetPalette(gal_pal, 0, 16)
  SetPalette(gal_pal, 240, 16)
  FOR i = 0 TO 31 DO SpriteHide(i) OD
  SpritesOn(15)
  IrqOn()
  hi10 = 2000
  DO
    Title()
    IF quit THEN EXIT FI
    Play()
  OD
  SpritesOff()
  Reset()
RETURN
