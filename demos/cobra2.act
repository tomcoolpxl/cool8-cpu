; Row(r, m0, m1, m2) -- row r of the rotation as Transform wants it: the
; entries with 128 added, and 128 times their sum plus 49152
PROC Row(BYTE r, INT m0, INT m1, INT m2)
  BYTE k
  k = r * 3
  mp(k) = m0 + 128
  mp(k + 1) = m1 + 128
  mp(k + 2) = m2 + 128
  kr(r) = (m0 + m1 + m2) * 128 + 49152
RETURN

; Matrix() -- this frame's rotation: roll x pitch x yaw, from the sine
; table at 127 to a unit, every product of two brought back by seven
; bits, rounded (an INT shift floors; 64 first rounds). An angle's top
; ten bits index the table, so the three rates step it evenly: with 256
; steps, a yaw of 1.5 a frame went 1, 2, 1, 2 and the ship shivered.
; tools/mk3d.py runs the same arithmetic over every pose and checks each
; product stays inside an INT
PROC Matrix()
  INT sa, ca, sb, cb, sc, cc, t, u
  CARD a
  a = yaw >> 6
  sa = sn(a)
  a = (a + 256) & 1023
  ca = sn(a)
  a = pitch >> 6
  sb = sn(a)
  a = (a + 256) & 1023
  cb = sn(a)
  a = roll >> 6
  sc = sn(a)
  a = (a + 256) & 1023
  cc = sn(a)
  t = (sb * sa + 64) >> 7
  u = (sb * ca + 64) >> 7
  Row(0, (cc * ca - sc * t + 64) >> 7, -((sc * cb + 64) >> 7), (cc * sa + sc * u + 64) >> 7)
  Row(1, (sc * ca + cc * t + 64) >> 7, (cc * cb + 64) >> 7, (sc * sa - cc * u + 64) >> 7)
  Row(2, -((cb * sa + 64) >> 7), sb, (cb * ca + 64) >> 7)
RETURN

; Transform() -- the 28 vertices through this frame's rotation and the
; perspective, into sx() and sy().
;
; **No sign in a product.** MUL is unsigned and a coordinate and an
; entry are both signed, so each carries 128 (vb, mp): m.v is then
; sum(m'v') - 128 sum(m) - 128 sum(v) - 49152, and modulo 65,536 that is
; exactly right, because the answer is inside 16 bits. kr() holds the
; row's half of it and each vertex record its own, so a multiply-add is
; a MUL, two moves and an add with carry. Z goes first: its high byte is
; the depth bin, and the reciprocal there, times |X| >> 7, is how far
; from the centre the vertex lands -- a second MUL's high byte.
;
; **The stern's panels only while the stern is shown.** Fourteen of the
; 28 vertices are the stern's panel details (vd), and no other edge uses
; them, so with the stern turned away they are skipped -- Faces() goes
; first -- and 6,800 clocks go to the sky instead.
PROC Transform()
  ASM
    LDW  Y,#v_vb
    CLR  R0
    ST   [v_tv],R0
.v: LD   R1,[v_tv]
    LDW  X,#v_vd
    LD   R0,[X+R1]
    TST  R0
    BEQ  .vg
    LD   R0,[v_fv+c_STERN]
    TST  R0
    BEQ  .vn
.vg: CLR  R2
    CLR  R3
    LD   R0,[v_mp+6]
    LD   R1,[Y+0]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mp+7]
    LD   R1,[Y+1]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mp+8]
    LD   R1,[Y+2]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_kr+4]
    SUB  R2,R0
    LD   R0,[v_kr+5]
    SBC  R3,R0
    LD   R0,[Y+3]
    SUB  R2,R0
    LD   R0,[Y+4]
    SBC  R3,R0
    ADD  R3,#c_ZBIAS
    LDW  X,#v_rz
    LD   R0,[X+R3]
    ST   [v_trr],R0
    CLR  R2
    CLR  R3
    LD   R0,[v_mp+0]
    LD   R1,[Y+0]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mp+1]
    LD   R1,[Y+1]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mp+2]
    LD   R1,[Y+2]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_kr+0]
    SUB  R2,R0
    LD   R0,[v_kr+1]
    SBC  R3,R0
    LD   R0,[Y+3]
    SUB  R2,R0
    LD   R0,[Y+4]
    SBC  R3,R0
    CLR  R1
    TST  R3
    BPL  .xp
    NOT  R2
    NOT  R3
    ADD  R2,#1
    ADC  R3,#0
    MOV  R1,#1
.xp: ADD  R2,R2
    ADC  R3,R3
    LD   R0,[v_trr]
    MUL  R3,R0
    MOV  R0,XH
    TST  R1
    BNE  .xl
    ADD  R0,#c_CX
    BRA  .xs
.xl: MOV  R2,#c_CX
    SUB  R2,R0
    MOV  R0,R2
.xs: LD   R1,[v_tv]
    LDW  X,#v_sx
    ST   [X+R1],R0
    CLR  R2
    CLR  R3
    LD   R0,[v_mp+3]
    LD   R1,[Y+0]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mp+4]
    LD   R1,[Y+1]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mp+5]
    LD   R1,[Y+2]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_kr+2]
    SUB  R2,R0
    LD   R0,[v_kr+3]
    SBC  R3,R0
    LD   R0,[Y+3]
    SUB  R2,R0
    LD   R0,[Y+4]
    SBC  R3,R0
    CLR  R1
    TST  R3
    BPL  .yp
    NOT  R2
    NOT  R3
    ADD  R2,#1
    ADC  R3,#0
    MOV  R1,#1
.yp: ADD  R2,R2
    ADC  R3,R3
    LD   R0,[v_trr]
    MUL  R3,R0
    MOV  R0,XH
    TST  R1
    BNE  .yl
    MOV  R2,#c_CY
    SUB  R2,R0
    MOV  R0,R2
    BRA  .ys
.yl: ADD  R0,#c_CY
.ys: LD   R1,[v_tv]
    LDW  X,#v_sy
    ST   [X+R1],R0
.vn: ADDW Y,#5
    LD   R0,[v_tv]
    ADD  R0,#1
    ST   [v_tv],R0
    CMP  R0,#28
    BNE  .v
  ENDASM
RETURN

; Faces() -- which faces are turned to the viewer: each normal through
; the rotation's Z row, less the face's threshold, into fv(); negative
; is turned to the viewer. A record in nb is a vertex's shape, so this
; is Transform's Z, the same biased multiply-add, and the sign of its
; high byte is the answer.
;
; **Not the area on the screen.** A face's triangle there has the right
; sign wherever it is open, but near edge-on its area is the rounding of
; its corners -- tens of units, either way, frame to frame, on a long
; thin face -- and an edge flicked off for one frame and on again; a
; margin flickered, and so did hysteresis on the area. The normal is
; the triangle's own (tools/mk3d.py), so where the area is decisive the
; two agree, and in 3D there is nothing to round but the matrix.
;
; **With 256 of hysteresis on the way out**, one in the high byte, 0.9
; degrees: a face turned to the viewer stays so until it is 256 past, and
; one turned away turns in as soon as it faces the camera. COBRA holds
; it both ways; at half its rates that left a gap -- one face 256 past
; and turned away, its neighbour not yet 256 in -- and the edge between
; them went out for a frame. One way, rounding still cannot flick a
; face, and a handover overlaps instead.
PROC Faces()
  ASM
    LDW  Y,#v_nb
    CLR  R0
    ST   [v_tv],R0
.f: CLR  R2
    CLR  R3
    LD   R0,[v_mp+6]
    LD   R1,[Y+0]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mp+7]
    LD   R1,[Y+1]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mp+8]
    LD   R1,[Y+2]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_kr+4]
    SUB  R2,R0
    LD   R0,[v_kr+5]
    SBC  R3,R0
    LD   R0,[Y+3]
    SUB  R2,R0
    LD   R0,[Y+4]
    SBC  R3,R0
    LD   R1,[v_tv]
    LDW  X,#v_fv
    LD   R0,[X+R1]
    TST  R0
    BEQ  .fs
    SUB  R3,#1
.fs: CLR  R0
    TST  R3
    BPL  .fw
    MOV  R0,#1
.fw: ST   [X+R1],R0
    ADDW Y,#5
    ADD  R1,#1
    ST   [v_tv],R1
    CMP  R1,#13
    BNE  .f
  ENDASM
RETURN

; Visible() -- this frame's edges, those bordering a face turned to the
; viewer, into the page's list, four bytes an edge; and the ship's
; outline -- a rim edge with one face turned to the viewer and the other
; away -- into sl, for Sky() to hide the sky behind. In assembly here:
; compiled, with the outline, it was 9,500 clocks of a frame COBRA 2
; could not spare
PROC Visible()
  ASM
    LDW  X,#v_lst
    LD   R0,[v_cur]
    TST  R0
    BEQ  .v0
    ADDW X,#152
.v0: STW  [v_vw],X
    LDW  X,#v_sl
    STW  [v_vs],X
    CLR  R0
    ST   [v_vn],R0
    ST   [v_sln],R0
    ST   [v_ve],R0
.ve: LD   R1,[v_ve]
    LDW  X,#v_ef1
    LD   R2,[X+R1]
    LDW  X,#v_ef2
    LD   R3,[X+R1]
    LDW  X,#v_fv
    LD   R2,[X+R2]
    LD   R3,[X+R3]
    MOV  R0,R2
    ADD  R0,R3
    BEQ  .vx
    XOR  R2,R3
    ST   [v_vx],R2
    LDW  Y,[v_vw]
    LDW  X,#v_ea
    LD   R0,[X+R1]
    LDW  X,#v_sx
    LD   R2,[X+R0]
    ST   [Y+0],R2
    LDW  X,#v_sy
    LD   R2,[X+R0]
    ST   [Y+1],R2
    LDW  X,#v_eb
    LD   R0,[X+R1]
    LDW  X,#v_sx
    LD   R2,[X+R0]
    ST   [Y+2],R2
    LDW  X,#v_sy
    LD   R2,[X+R0]
    ST   [Y+3],R2
    LD   R0,[v_vn]
    ADD  R0,#1
    ST   [v_vn],R0
    LD   R0,[v_vx]
    TST  R0
    BEQ  .vy
    LDW  X,#v_rim
    LD   R0,[X+R1]
    TST  R0
    BEQ  .vy
    LDW  X,[v_vs]
    LD   R0,[Y+0]
    ST   [X+0],R0
    LD   R0,[Y+1]
    ST   [X+1],R0
    LD   R0,[Y+2]
    ST   [X+2],R0
    LD   R0,[Y+3]
    ST   [X+3],R0
    ADDW X,#4
    STW  [v_vs],X
    LD   R0,[v_sln]
    ADD  R0,#1
    ST   [v_sln],R0
.vy: ADDW Y,#4
    STW  [v_vw],Y
.vx: LD   R1,[v_ve]
    ADD  R1,#1
    ST   [v_ve],R1
    CMP  R1,#38
    BNE  .ve
    LD   R0,[v_vn]
    LD   R1,[v_cur]
    LDW  X,#v_nl
    ST   [X+R1],R0
  ENDASM
RETURN

; Lines() -- ln edges from the list at lp, in colour lc.
;
; **The port only steps +1**, so every line runs the way it does: one
; along X is drawn left to right, PIX_DATA stepping X, and one along Y
; top to bottom, PIX_DATA_Y stepping Y. The other axis is a coordinate
; in X, stepped by INCW or DECW and written with one STW -- low byte the
; coordinate, high byte the port's zero -- when the error runs out; the
; count is in Y. R0 is the colour, R1 the error, R2 and R3 the two
; distances, all eight bits because nothing on this screen is wider. A
; pixel is 14 clocks; one where the other axis steps, 23.
PROC Lines()
  ASM
    CLR  R0
    ST   [v_PIX_X_H],R0
    ST   [v_PIX_Y_H],R0
.ln: LDW  Y,[v_lp]
    LD   R1,[Y+1]
    LD   R3,[Y+3]
    CMP  R1,R3
    BHI  .sw
    LD   R0,[Y+0]
    LD   R2,[Y+2]
    BRA  .go
.sw: LD   R0,[Y+2]
    LD   R2,[Y+0]
    LD   R1,[Y+3]
    LD   R3,[Y+1]
.go: ADDW Y,#4
    STW  [v_lp],Y
    ST   [v_PIX_X_L],R0
    ST   [v_PIX_Y_L],R1
    SUB  R3,R1
    SUB  R2,R0
    BCC  .lf
    CMP  R2,R3
    BCC  .ryd
    LDW  X,#0
    MOV  XL,R1
    LDW  Y,#1
    ADDW Y,R2
    MOV  R1,R2
    SHR  R1
    LD   R0,[v_lc]
.rx: ST   [v_PIX_DATA],R0
    SUB  R1,R3
    BCS  .rx1
    ADD  R1,R2
    INCW X
    STW  [v_PIX_Y_L],X
.rx1: DECW Y
    BNE  .rx
    BRA  .nx
.ryd: LDW  X,#0
    MOV  XL,R0
    LDW  Y,#1
    ADDW Y,R3
    MOV  R1,R3
    SHR  R1
    LD   R0,[v_lc]
.ry: ST   [v_PIX_DATA_Y],R0
    SUB  R1,R2
    BCS  .ry1
    ADD  R1,R3
    INCW X
    STW  [v_PIX_X_L],X
.ry1: DECW Y
    BNE  .ry
    BRA  .nx
.lf: NOT  R2
    ADD  R2,#1
    CMP  R2,R3
    BCC  .lyd
    SUB  R0,R2
    ST   [v_PIX_X_L],R0
    ADD  R1,R3
    ST   [v_PIX_Y_L],R1
    LDW  X,#0
    MOV  XL,R1
    LDW  Y,#1
    ADDW Y,R2
    MOV  R1,R2
    SHR  R1
    LD   R0,[v_lc]
.lx: ST   [v_PIX_DATA],R0
    SUB  R1,R3
    BCS  .lx1
    ADD  R1,R2
    DECW X
    STW  [v_PIX_Y_L],X
.lx1: DECW Y
    BNE  .lx
    BRA  .nx
.lyd: LDW  X,#0
    MOV  XL,R0
    LDW  Y,#1
    ADDW Y,R3
    MOV  R1,R3
    SHR  R1
    LD   R0,[v_lc]
.ly: ST   [v_PIX_DATA_Y],R0
    SUB  R1,R2
    BCS  .ly1
    ADD  R1,R3
    DECW X
    STW  [v_PIX_X_L],X
.ly1: DECW Y
    BNE  .ly
.nx: LD   R0,[v_ln]
    SUB  R0,#1
    ST   [v_ln],R0
    BNE  .ln
  ENDASM
RETURN

; Draw(p, c) -- page p's list in colour c: 0 erases the frame it holds
PROC Draw(BYTE p, BYTE c)
  lp = lst
  IF p THEN lp += 152 FI
  ln = nl(p)
  lc = c
  IF ln THEN Lines() FI
RETURN

; Sky() -- the stars and the dust through this frame's rotation, into
; the page's dot list, stars first.
;
; A point is a record in a vertex's shape -- three coordinates with 128
; added, and 128 times their sum -- so .rows is Transform's three rows,
; once a point. A star is a direction: it lands at FOCAL * X / Z, its
; Z >> 6 indexing a reciprocal (srz). A speck's record (qd) is built each
; frame from its place in the world less the ship's (.rel), in the
; dust's units of two, and past the dust's reach of 127 it is off; its
; Z >> 7 indexes 128 * FOCAL / depth (drz). Either
; offset is |X| >> s, nine or ten bits, times that byte: a MUL and at
; most three adds (.off). Past an edge, or outside the table's depths,
; the point is marked off (sv, dv) and Respawn() puts it back. On the
; screen but behind the ship (.hid) it is not drawn, and stays.
;
; First the ship's outline, from Visible()'s list: each edge top to
; bottom with its slope in 8.8 -- |dx| times 65,536 / dy, from a table,
; not a division -- and the box around them.
PROC Sky()
  ASM
    MOV  R0,#255
    ST   [v_hx0],R0
    ST   [v_hy0],R0
    CLR  R0
    ST   [v_hx1],R0
    ST   [v_hy1],R0
    ST   [v_hn],R0
    LD   R0,[v_sln]
    ST   [v_hk],R0
    TST  R0
    BEQ  .h9
    LDW  Y,#v_sl
    LDW  X,#v_hr
    STW  [v_hw],X
.h1: LD   R1,[Y+1]
    LD   R3,[Y+3]
    CMP  R3,R1
    BEQ  .h8
    BCS  .h2
    LD   R0,[Y+2]
    LD   R2,[Y+0]
    ST   [v_ht],R1
    MOV  R1,R3
    LD   R3,[v_ht]
    BRA  .h3
.h2: LD   R0,[Y+0]
    LD   R2,[Y+2]
.h3: LDW  X,[v_hw]
    ST   [X+0],R1
    ST   [X+1],R3
    ST   [X+2],R0
    ST   [X+3],R2
    LD   R0,[v_hy0]
    CMP  R1,R0
    BCS  .b1
    ST   [v_hy0],R1
.b1: LD   R0,[v_hy1]
    CMP  R0,R3
    BCS  .b2
    ST   [v_hy1],R3
.b2: LD   R1,[X+2]
    CALL .bx
    LD   R1,[X+3]
    CALL .bx
    LD   R1,[X+0]
    SUB  R3,R1
    LD   R2,[X+3]
    LD   R0,[X+2]
    CLR  R1
    SUB  R2,R0
    BCS  .h4
    NEG  R2
    MOV  R1,#1
.h4: ST   [X+4],R1
    LDW  X,#v_rlo
    LD   R0,[X+R3]
    MUL  R2,R0
    MOV  R0,XH
    ST   [v_ht],R0
    LDW  X,#v_rhi
    LD   R0,[X+R3]
    MUL  R2,R0
    LD   R0,[v_ht]
    MOV  R1,XL
    ADD  R1,R0
    MOV  R0,XH
    ADC  R0,#0
    LDW  X,[v_hw]
    ST   [X+5],R1
    ST   [X+6],R0
    ADDW X,#7
    STW  [v_hw],X
    LD   R0,[v_hn]
    ADD  R0,#1
    ST   [v_hn],R0
.h8: ADDW Y,#4
    LD   R0,[v_hk]
    SUB  R0,#1
    ST   [v_hk],R0
    BNE  .h1
.h9: LDW  X,#v_dl
    LD   R0,[v_cur]
    TST  R0
    BEQ  .p0
    ADDW X,#c_DLP
.p0: STW  [v_qp],X
    CLR  R0
    ST   [v_qn],R0
    ST   [v_qo],R0
    LDW  Y,#v_sd
    ST   [v_qi],R0
.st: CALL .rows
    LD   R3,[v_qz+1]
    TST  R3
    BMI  .so
    LD   R2,[v_qz]
    ADD  R2,R2
    ADC  R3,R3
    ADD  R2,R2
    ADC  R3,R3
    LDW  X,#v_srz
    LD   R0,[X+R3]
    TST  R0
    BEQ  .so
    ST   [v_qr],R0
    LD   R2,[v_qx]
    LD   R3,[v_qx+1]
    CALL .offs
    TST  R1
    BNE  .so
    SHR  R3
    LD   R1,[v_qg]
    TST  R1
    BNE  .s1
    ADD  R3,#c_CX
    BRA  .s2
.s1: MOV  R0,#c_CX
    SUB  R0,R3
    MOV  R3,R0
.s2: ST   [v_qa],R3
    LD   R2,[v_qy]
    LD   R3,[v_qy+1]
    CALL .offs
    TST  R1
    BNE  .so
    CMP  R3,#240
    BCS  .so
    SHR  R3
    LD   R1,[v_qg]
    TST  R1
    BNE  .s3
    MOV  R0,#c_CY
    SUB  R0,R3
    MOV  R3,R0
    BRA  .s4
.s3: ADD  R3,#c_CY
.s4: LD   R1,[v_qi]
    LDW  X,#v_ssy
    ST   [X+R1],R3
    LD   R0,[v_qa]
    LDW  X,#v_ssx
    ST   [X+R1],R0
    CALL .hid
    TST  R1
    BNE  .sk
    LD   R1,[v_qi]
    LDW  X,#v_sc
    LD   R0,[X+R1]
    CALL .dot
.sk: MOV  R0,#1
    BRA  .sf
.so: LD   R1,[v_qi]
    LD   R2,[v_qo]
    LDW  X,#v_sq
    ST   [X+R2],R1
    ADD  R2,#1
    ST   [v_qo],R2
    CLR  R0
.sf: LD   R1,[v_qi]
    LDW  X,#v_sv
    ST   [X+R1],R0
    ADDW Y,#5
    ADD  R1,#1
    ST   [v_qi],R1
    CMP  R1,#c_NS
    BNE  .st
    LDW  X,#v_dw
    STW  [v_qw],X
    CLR  R0
    ST   [v_qi],R0
.du: LDW  X,[v_qw]
    LD   R2,[X+0]
    LD   R3,[X+1]
    LD   R0,[v_sh+0]
    SUB  R2,R0
    LD   R0,[v_sh+1]
    SBC  R3,R0
    CALL .rel
    TST  R1
    BNE  .do
    ST   [v_qd+0],R0
    LD   R2,[X+2]
    LD   R3,[X+3]
    LD   R0,[v_sh+2]
    SUB  R2,R0
    LD   R0,[v_sh+3]
    SBC  R3,R0
    CALL .rel
    TST  R1
    BNE  .do
    ST   [v_qd+1],R0
    LD   R2,[X+4]
    LD   R3,[X+5]
    LD   R0,[v_sh+4]
    SUB  R2,R0
    LD   R0,[v_sh+5]
    SBC  R3,R0
    CALL .rel
    TST  R1
    BNE  .do
    ST   [v_qd+2],R0
    CLR  R3
    LD   R2,[v_qd+0]
    LD   R0,[v_qd+1]
    ADD  R2,R0
    ADC  R3,#0
    LD   R0,[v_qd+2]
    ADD  R2,R0
    ADC  R3,#0
    SHR  R3
    ROR  R2
    BCS  .l1
    CLR  R0
    BRA  .l2
.l1: MOV  R0,#128
.l2: ST   [v_qd+3],R0
    SUB  R2,#192
    ST   [v_qd+4],R2
    LDW  Y,#v_qd
    CALL .rows
    LD   R2,[v_qz]
    LD   R3,[v_qz+1]
    XOR  R3,#$80
    ADD  R2,R2
    ADC  R3,R3
    BCS  .d1
    LDW  X,#v_drz
    BRA  .d2
.d1: LDW  X,#v_drz+256
.d2: LD   R0,[X+R3]
    TST  R0
    BEQ  .do
    ST   [v_qr],R0
    MOV  R1,#c_DUSTFAR
    CMP  R0,#c_DBRIGHT
    BCC  .d3
    MOV  R1,#c_DUSTNEAR
.d3: ST   [v_qc],R1
    LD   R2,[v_qx]
    LD   R3,[v_qx+1]
    CALL .offd
    TST  R1
    BNE  .do
    CMP  R3,#128
    BCS  .do
    LD   R1,[v_qg]
    TST  R1
    BNE  .d4
    ADD  R3,#c_CX
    BRA  .d5
.d4: MOV  R0,#c_CX
    SUB  R0,R3
    MOV  R3,R0
.d5: ST   [v_qa],R3
    LD   R2,[v_qy]
    LD   R3,[v_qy+1]
    CALL .offd
    TST  R1
    BNE  .do
    CMP  R3,#120
    BCS  .do
    LD   R1,[v_qg]
    TST  R1
    BNE  .d6
    MOV  R0,#c_CY
    SUB  R0,R3
    MOV  R3,R0
    BRA  .d7
.d6: ADD  R3,#c_CY
.d7: LD   R0,[v_qz+1]
    TST  R0
    BMI  .d8
    CALL .hid
    TST  R1
    BNE  .d9
.d8: LD   R0,[v_qc]
    CALL .dot
.d9: MOV  R0,#1
    BRA  .df
.do: LD   R1,[v_qi]
    ADD  R1,#128
    LD   R2,[v_qo]
    LDW  X,#v_sq
    ST   [X+R2],R1
    ADD  R2,#1
    ST   [v_qo],R2
    CLR  R0
.df: LD   R1,[v_qi]
    LDW  X,#v_dv
    ST   [X+R1],R0
    LDW  X,[v_qw]
    ADDW X,#6
    STW  [v_qw],X
    ADD  R1,#1
    ST   [v_qi],R1
    CMP  R1,#c_ND
    BNE  .du
    LD   R0,[v_qn]
    LD   R1,[v_cur]
    LDW  X,#v_dn
    ST   [X+R1],R0
    BRA  .end
; .rows -- the record at Y through the matrix into qx, qy, qz
.rows: CLR  R2
    CLR  R3
    LD   R0,[v_mp+0]
    LD   R1,[Y+0]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mp+1]
    LD   R1,[Y+1]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mp+2]
    LD   R1,[Y+2]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_kr+0]
    SUB  R2,R0
    LD   R0,[v_kr+1]
    SBC  R3,R0
    LD   R0,[Y+3]
    SUB  R2,R0
    LD   R0,[Y+4]
    SBC  R3,R0
    ST   [v_qx],R2
    ST   [v_qx+1],R3
    CLR  R2
    CLR  R3
    LD   R0,[v_mp+3]
    LD   R1,[Y+0]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mp+4]
    LD   R1,[Y+1]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mp+5]
    LD   R1,[Y+2]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_kr+2]
    SUB  R2,R0
    LD   R0,[v_kr+3]
    SBC  R3,R0
    LD   R0,[Y+3]
    SUB  R2,R0
    LD   R0,[Y+4]
    SBC  R3,R0
    ST   [v_qy],R2
    ST   [v_qy+1],R3
    CLR  R2
    CLR  R3
    LD   R0,[v_mp+6]
    LD   R1,[Y+0]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mp+7]
    LD   R1,[Y+1]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mp+8]
    LD   R1,[Y+2]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_kr+4]
    SUB  R2,R0
    LD   R0,[v_kr+5]
    SBC  R3,R0
    LD   R0,[Y+3]
    SUB  R2,R0
    LD   R0,[Y+4]
    SBC  R3,R0
    ST   [v_qz],R2
    ST   [v_qz+1],R3
    RET
; .offs, .offd -- R3:R2 a coordinate: qg 1 when it is negative, and R3
; the high byte of (|v| >> 4) * qr for a star, (|v| >> 5) * qr for a
; speck, with R1 zero -- or R1 1 when that product is past 16 bits, off
; the screen whatever the limit. |v| >> s is shifted into R3 and what is
; past its byte is added in qh times, at most three
.offs: CLR  R1
    TST  R3
    BPL  .t1
    NOT  R2
    NOT  R3
    ADD  R2,#1
    ADC  R3,#0
    MOV  R1,#1
.t1: ST   [v_qg],R1
    MOV  R0,R3
    SHR  R0
    SHR  R0
    SHR  R0
    SHR  R0
    ST   [v_qh],R0
    ADD  R2,R2
    ADC  R3,R3
    ADD  R2,R2
    ADC  R3,R3
    ADD  R2,R2
    ADC  R3,R3
    ADD  R2,R2
    ADC  R3,R3
    BRA  .t3
.offd: CLR  R1
    TST  R3
    BPL  .t2
    NOT  R2
    NOT  R3
    ADD  R2,#1
    ADC  R3,#0
    MOV  R1,#1
.t2: ST   [v_qg],R1
    MOV  R0,R3
    SHR  R0
    SHR  R0
    SHR  R0
    SHR  R0
    SHR  R0
    ST   [v_qh],R0
    ADD  R2,R2
    ADC  R3,R3
    ADD  R2,R2
    ADC  R3,R3
    ADD  R2,R2
    ADC  R3,R3
.t3: LD   R0,[v_qr]
    MUL  R3,R0
    MOV  R3,XH
    LD   R1,[v_qh]
.t4: TST  R1
    BEQ  .t5
    ADD  R3,R0
    BCS  .t6
    SUB  R1,#1
    BRA  .t4
.t5: RET
.t6: MOV  R1,#1
    RET
; .rel -- R3:R2 a speck's place from the ship on one axis, in the dust's
; units: R0 that + 128 with R1 zero, or R1 1 past the reach of 127.
; X is kept
.rel: MOV  R0,R2
    ADD  R0,#127
    MOV  R1,R3
    ADC  R1,#0
    BNE  .r9
    CMP  R0,#255
    BEQ  .r9
    ADD  R0,#1
    CLR  R1
    RET
.r9: MOV  R1,#1
    RET
; .dot -- a dot at qa, R3 in colour R0, onto the list
.dot: LDW  X,[v_qp]
    LD   R1,[v_qa]
    ST   [X+0],R1
    ST   [X+1],R3
    ST   [X+2],R0
    ADDW X,#3
    STW  [v_qp],X
    LD   R0,[v_qn]
    ADD  R0,#1
    ST   [v_qn],R0
    RET
; .bx -- widen the outline's box across x = R1
.bx: LD   R0,[v_hx0]
    CMP  R1,R0
    BCS  .b3
    ST   [v_hx0],R1
.b3: LD   R0,[v_hx1]
    CMP  R0,R1
    BCS  .b4
    ST   [v_hx1],R1
.b4: RET
; .hid -- R1 1 when the point at qa, R3 is inside the ship's outline: in
; its box, and between the outline's crossings of its row, xt + or -
; (k * slope) >> 8. An edge has its rows from its top to just above its
; bottom, so a convex outline crosses a row twice and no more, and the
; search stops there. Y and R3 are kept
.hid: ST   [v_hpy],R3
    CLR  R1
    LD   R2,[v_hn]
    TST  R2
    BEQ  .i9
    LD   R0,[v_qa]
    LD   R1,[v_hx0]
    CMP  R0,R1
    BCC  .i8
    LD   R1,[v_hx1]
    CMP  R1,R0
    BCC  .i8
    LD   R1,[v_hy0]
    CMP  R3,R1
    BCC  .i8
    LD   R1,[v_hy1]
    CMP  R1,R3
    BCC  .i8
    ST   [v_hk],R2
    MOV  R0,#255
    ST   [v_hlo],R0
    CLR  R0
    ST   [v_hhi],R0
    ST   [v_hf],R0
    PUSHW Y
    LDW  Y,#v_hr
.i1: LD   R0,[v_hpy]
    LD   R1,[Y+0]
    CMP  R0,R1
    BCC  .i6
    LD   R1,[Y+1]
    CMP  R0,R1
    BCS  .i6
    LD   R1,[Y+0]
    SUB  R0,R1
    MOV  R3,R0
    LD   R1,[Y+5]
    MUL  R0,R1
    MOV  R2,XH
    MOV  R0,R3
    LD   R1,[Y+6]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R0,R2
    LD   R1,[Y+4]
    TST  R1
    BNE  .i3
    LD   R1,[Y+2]
    ADD  R0,R1
    BRA  .i5
.i3: LD   R1,[Y+2]
    SUB  R1,R0
    MOV  R0,R1
.i5: LD   R1,[v_hlo]
    CMP  R0,R1
    BCS  .i4
    ST   [v_hlo],R0
.i4: LD   R1,[v_hhi]
    CMP  R1,R0
    BCS  .i7
    ST   [v_hhi],R0
.i7: LD   R1,[v_hf]
    ADD  R1,#1
    ST   [v_hf],R1
    CMP  R1,#2
    BEQ  .i0
.i6: ADDW Y,#7
    LD   R1,[v_hk]
    SUB  R1,#1
    ST   [v_hk],R1
    BNE  .i1
.i0: POPW Y
    LD   R0,[v_hf]
    TST  R0
    BEQ  .i8
    LD   R0,[v_qa]
    LD   R1,[v_hlo]
    CMP  R0,R1
    BCC  .i8
    LD   R1,[v_hhi]
    CMP  R1,R0
    BCC  .i8
    LD   R3,[v_hpy]
    MOV  R1,#1
    RET
.i8: CLR  R1
.i9: LD   R3,[v_hpy]
    RET
.end:
  ENDASM
RETURN

; Dots(p, on) -- page p's dots, each in its colour, or erased. A dot's x
; goes in with its high byte, since one at 255 leaves the port at 256
PROC DotsAsm()
  ASM
    CLR  R3
    ST   [v_PIX_Y_H],R3
    LDW  Y,[v_dq]
    LD   R2,[v_dk]
    LD   R1,[v_dc]
    TST  R1
    BEQ  .e
.d: LD   R0,[Y+0]
    ST   [v_PIX_X_L],R0
    ST   [v_PIX_X_H],R3
    LD   R0,[Y+1]
    ST   [v_PIX_Y_L],R0
    LD   R0,[Y+2]
    ST   [v_PIX_DATA],R0
    ADDW Y,#3
    SUB  R2,#1
    BNE  .d
    BRA  .x
.e: LD   R0,[Y+0]
    ST   [v_PIX_X_L],R0
    ST   [v_PIX_X_H],R3
    LD   R0,[Y+1]
    ST   [v_PIX_Y_L],R0
    ST   [v_PIX_DATA],R3
    ADDW Y,#3
    SUB  R2,#1
    BNE  .e
.x:
  ENDASM
RETURN

PROC Dots(BYTE p, BYTE on)
  dq = dl
  IF p THEN dq += DLP FI
  dk = dn(p)
  dc = on
  IF dk THEN DotsAsm() FI
RETURN

; PlaceAsm() -- the view vector in pv back into the world, into pa():
; Transform's rows over the matrix's transpose -- the same biased bytes
; in another order, a column's constant 128 times its sum -- each sum
; brought back by seven bits; pok 0 when one leaves a byte. In assembly:
; compiled, a speck put back cost 2,000 clocks
PROC PlaceAsm()
  ASM
    LDW  Y,#v_pv
    MOV  R0,#1
    ST   [v_pok],R0
    CLR  R2
    CLR  R3
    LD   R0,[v_mpt+0]
    LD   R1,[Y+0]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mpt+1]
    LD   R1,[Y+1]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mpt+2]
    LD   R1,[Y+2]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_krt+0]
    SUB  R2,R0
    LD   R0,[v_krt+1]
    SBC  R3,R0
    LD   R0,[Y+3]
    SUB  R2,R0
    LD   R0,[Y+4]
    SBC  R3,R0
    LDW  X,#v_pa
    CALL .pd
    CLR  R2
    CLR  R3
    LD   R0,[v_mpt+3]
    LD   R1,[Y+0]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mpt+4]
    LD   R1,[Y+1]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mpt+5]
    LD   R1,[Y+2]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_krt+2]
    SUB  R2,R0
    LD   R0,[v_krt+3]
    SBC  R3,R0
    LD   R0,[Y+3]
    SUB  R2,R0
    LD   R0,[Y+4]
    SBC  R3,R0
    LDW  X,#v_pa+2
    CALL .pd
    CLR  R2
    CLR  R3
    LD   R0,[v_mpt+6]
    LD   R1,[Y+0]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mpt+7]
    LD   R1,[Y+1]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_mpt+8]
    LD   R1,[Y+2]
    MUL  R0,R1
    MOV  R0,XL
    ADD  R2,R0
    MOV  R0,XH
    ADC  R3,R0
    LD   R0,[v_krt+4]
    SUB  R2,R0
    LD   R0,[v_krt+5]
    SBC  R3,R0
    LD   R0,[Y+3]
    SUB  R2,R0
    LD   R0,[Y+4]
    SBC  R3,R0
    LDW  X,#v_pa+4
    CALL .pd
    BRA  .pz
; .pd -- the sum in R3:R2, >> 7, an INT at X; pok 0 when it is past a
; byte's 127: the sum + $3F80 must be under $7F80
.pd: MOV  R0,R2
    ADD  R0,#$80
    MOV  R1,R3
    ADC  R1,#$3F
    CMP  R1,#$7F
    BCC  .p1
    BNE  .p8
    CMP  R0,#$80
    BCS  .p8
.p1: ADD  R2,R2
    ADC  R3,R3
    ST   [X+0],R3
    CLR  R0
    TST  R3
    BPL  .p2
    MOV  R0,#$FF
.p2: ST   [X+1],R0
    RET
.p8: CLR  R0
    ST   [v_pok],R0
    RET
.pz:
  ENDASM
RETURN

; Place(vx, vy, vz) -- the view vector, bytes, as a record for PlaceAsm
FUNC BYTE Place(INT vx, INT vy, INT vz)
  INT l
  pv(0) = vx + 128
  pv(1) = vy + 128
  pv(2) = vz + 128
  l = (vx + vy + vz) * 128
  pv(3) = l & 255
  pv(4) = l >> 8
  PlaceAsm()
RETURN (pok)

; Store(w) -- Place()'s point as a record at w: the three coordinates
; with 128 added, and 128 times their sum
PROC Store(BYTE POINTER w)
  INT l
  *w = pa(0) + 128
  w += 1
  *w = pa(1) + 128
  w += 1
  *w = pa(2) + 128
  w += 1
  l = (pa(0) + pa(1) + pa(2)) * 128
  *w = l & 255
  w += 1
  *w = l >> 8
RETURN

; Transpose() -- the rotation's transpose for Place(): mp's biased bytes
; column by column, and a column's constant, 128 times its sum -- the
; sum's low bit the low byte's top, the rest the high byte
PROC Transpose()
  ASM
    LD   R0,[v_mp+0]
    ST   [v_mpt+0],R0
    LD   R0,[v_mp+3]
    ST   [v_mpt+1],R0
    LD   R0,[v_mp+6]
    ST   [v_mpt+2],R0
    LD   R0,[v_mp+1]
    ST   [v_mpt+3],R0
    LD   R0,[v_mp+4]
    ST   [v_mpt+4],R0
    LD   R0,[v_mp+7]
    ST   [v_mpt+5],R0
    LD   R0,[v_mp+2]
    ST   [v_mpt+6],R0
    LD   R0,[v_mp+5]
    ST   [v_mpt+7],R0
    LD   R0,[v_mp+8]
    ST   [v_mpt+8],R0
    LDW  Y,#v_mpt
    LDW  X,#v_krt
    MOV  R1,#3
.c: CLR  R3
    LD   R2,[Y+0]
    LD   R0,[Y+1]
    ADD  R2,R0
    ADC  R3,#0
    LD   R0,[Y+2]
    ADD  R2,R0
    ADC  R3,#0
    SHR  R3
    ROR  R2
    BCS  .c1
    CLR  R0
    BRA  .c2
.c1: MOV  R0,#128
.c2: ST   [X+0],R0
    ST   [X+1],R2
    ADDW X,#2
    ADDW Y,#3
    SUB  R1,#1
    BNE  .c
  ENDASM
RETURN

; StarAt(i, px, py) -- star i where the screen point (px, py) from the
; centre, y up, looks, a little inside the edges: the direction
; (px, py, FOCAL) at about a third of its length, 110. A brightness of
; two, and the point noted as its last place on the screen
PROC StarAt(BYTE i, INT px, INT py)
  IF px > 124 THEN px = 124 ELSEIF px < -124 THEN px = -124 FI
  IF py > 116 THEN py = 116 ELSEIF py < -116 THEN py = -116 FI
  IF Place((px * 77) >> 8, (py * 77) >> 8, 108) THEN Store(sd + i * 5) FI
  sc(i) = 2 + (Rnd(0) & 1)
  ssx(i) = CX + px
  ssy(i) = CY - py
RETURN

; DustAt(i) -- speck i somewhere in view ahead of the ship, so it
; streams past it: a random depth on the side of the ship its nose points
; -- beyond it when the nose points away from the camera, nearer when it
; points this way -- and a random point across the view at that depth,
; the random word masked and scaled, not divided, in the dust's units of
; two, carried back into the ship's frame. One still behind the ship's
; centre is mirrored through it, which puts it ahead; then it is placed
; in the world, the ship's place plus that. Past the dust's reach it is
; parked far behind the ship, where the next frame retires it again
PROC DustAt(BYTE i)
  CARD d
  INT hx, hy, x, y, z
  BYTE k
  k = i * 3
  d = Rnd(0) & 255
  IF mp(8) >= 128 THEN d += DIST ELSE d += DSPAWN FI
  hx = d * 45 >> 7
  hy = d * 21 >> 6
  x = Rnd(0) & 255
  x -= 128
  x = x * hx >> 8
  IF x > 127 THEN x = 127 ELSEIF x < -127 THEN x = -127 FI
  y = Rnd(0) & 255
  y -= 128
  y = y * hy >> 8
  z = d
  z -= DIST
  z = z >> 1
  IF z > 127 THEN z = 127 FI
  IF Place(x, y, z) THEN
    IF pa(2) < 0 THEN
      pa(0) = -pa(0)
      pa(1) = -pa(1)
      pa(2) = -pa(2)
    FI
    dw(k) = sh(0) + pa(0)
    dw(k + 1) = sh(1) + pa(1)
    dw(k + 2) = sh(2) + pa(2)
  ELSE
    dw(k) = sh(0)
    dw(k + 1) = sh(1)
    dw(k + 2) = sh(2) - 1000
  FI
RETURN

; Scatter() -- the sky's first frame: every star and speck anywhere in view
PROC Scatter()
  BYTE i
  INT px, py
  Transpose()
  FOR i = 0 TO NS - 1 DO
    px = Rnd(0) & 255
    px -= 128
    py = Rnd(0) & 255
    py -= 128
    StarAt(i, px, py)
  OD
  FOR i = 0 TO ND - 1 DO
    DustAt(i)
  OD
RETURN

; Respawn() -- every star and speck Sky() queued off the screen (sq),
; back into view for the next frame. A star comes back across the edge
; opposite the one it left by -- its last place on the screen mirrored
; through the centre, a sixteenth inside, a few pixels either way --
; which is where the sky is coming from; a speck comes back anywhere in
; view
PROC Respawn()
  BYTE k, i
  INT px, py
  IF qo THEN Transpose() FI
  FOR k = 1 TO qo DO
    i = sq(k - 1)
    IF i & 128 THEN
      DustAt(i & 127)
    ELSE
      px = ssx(i)
      px = CX - px
      py = ssy(i)
      py -= CY
      px -= px >> 4
      py -= py >> 4
      px += Rnd(0) & 7
      px -= 4
      py += Rnd(0) & 7
      py -= 4
      StarAt(i, px, py)
    FI
  OD
RETURN

PROC Main()
  Graphics(6)                        ; 256 x 240 on 480 lines ...
  VID_CTRL = $3A                     ; ... at 4 bits a pixel, doubled both ways
  VID_STRIDE = 128
  Cursor(0)
  Border(0)
  SetColor(0, $000)
  SetColor(1, $FFF)                  ; the ship
  SetColor(2, $557)                  ; a dim star
  SetColor(3, $AAC)                  ; a bright one
  SetColor(DUSTNEAR, $DDD)           ; a near speck
  SetColor(DUSTFAR, $777)            ; a far one
  VID_BASE_H = $78
  Clg(0)
  VID_BASE_H = 0
  Clg(0)
  VID_DBASE_H = $78                  ; a cleared page on the glass, page 0 the pencil
  VID_CTRL = $7A                     ; the double buffer on: DBASE is the glass, BASE the pencil
  Matrix()
  Scatter()
  DO
    IF clean THEN
      Clg(0)
    ELSE
      Dots(cur, 0)
      Draw(cur, 0)
    FI
    yaw += YAWR
    pitch += PITCHR
    roll += ROLLR
    sh(2) += SPEED                   ; the ship flies along its nose; the camera follows it
    Matrix()
    Faces()                          ; first: Transform skips the stern's panels while it is away
    Transform()
    Visible()
    Sky()
    Respawn()
    Dots(cur, 1)
    Draw(cur, 1)
    frames += 1
    VID_DBASE_H = pg(cur)            ; the finished page, for the glass --
    WaitVBlank()                     ; which takes it at the frame start
    cur = cur XOR 1
    VID_BASE_H = pg(cur)             ; and the page that was on it is drawn on
  UNTIL Key() OD
  Graphics(0)
  Cursor(1)
RETURN
