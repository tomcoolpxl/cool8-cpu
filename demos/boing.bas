1 GOTO 100
2 REM ---- THE BALL COLOURS FOR PHASE T, AT THE FRONT SO
3 REM GOSUB FINDS IT WITHOUT WALKING THE PROGRAM.
4 REM RED IFF ((K+T)/2 + BAND) IS EVEN, AND THE INDEX
5 REM CARRIES K MOD 4 IN 0-3 AND THE BAND'S PARITY IN 4.
6 FOR N=0 TO 7
7 U=((N AND 3)+T) AND 3:Z=(U/2+N/4) AND 1
8 H=11:L=$22
9 IF Z=1 THEN H=15:L=$FF
10 POKE $FF1E,4+N:POKE $FF1F,H:POKE $FF1F,L
11 NEXT
12 RETURN
100 REM BOING -- THE AMIGA'S BOUNCING BALL, 1984
110 REM
120 REM NOTHING IS REDRAWN. THE BALL, ITS SHADOW AND THE
130 REM GRID ARE PAINTED ONCE INTO A CANVAS 416X288, AND
140 REM THE DISPLAY'S 256X192 WINDOW IS WALKED OVER IT --
150 REM VID_SCX FOR X, VID_BASE FOR Y, FOUR POKES A FRAME.
160 REM THE BALL NEVER MOVES; THE VIEW DOES.
170 REM
180 REM THE GRID REPEATS EVERY 8 PIXELS AND THE WINDOW
190 REM STEPS BY 8, SO THE ROOM STANDS STILL WHILE THE
200 REM BALL CROSSES IT. THE FLIGHT IS COMPUTED IN
210 REM SIXTEENTHS OF A PIXEL AND ONLY SNAPPED TO 8 AT
220 REM THE POKE, SO GRAVITY IS IN THE TIMING: THE BALL
230 REM HANGS AT THE TOP AND FLIES AT THE FLOOR.
240 REM
250 REM THE SPIN IS THE PALETTE, WHICH IS HOW THE ORIGINAL
260 REM DID IT TOO. EIGHT ENTRIES CARRY THE CHECKS AND
270 REM ROTATING THEM WALKS THE PATTERN ROUND THE BALL --
280 REM FOUR PHASES, 24 POKES, NO PIXELS TOUCHED.
290 REM
300 MODE 5
310 CURSOR 0
320 POKE $FF14,208:POKE $FF15,0
330 POKE $FF1A,0
340 DIM W(48):DIM C(8):DIM E(6)
350 FOR I=0 TO 48:READ V:W(I)=V:NEXT
360 DATA 48,47,47,47,47,47,47,47,47,47,46,46,46,46,45,45
370 DATA 45,44,44,44,43,43,42,42,41,40,40,39,38,38,37,36
380 DATA 35,34,33,32,31,30,29,27,26,24,23,21,19,16,13,9,0
390 FOR I=0 TO 8:READ V:C(I)=V:NEXT
400 DATA 128,118,91,49,0,-49,-91,-118,-128
410 FOR I=0 TO 6:READ V:E(I)=V:NEXT
420 DATA -48,-42,-24,0,24,42,48
430 REM THE ROOM: BLACK PAPER, PURPLE LINES, AND A GRID
440 REM THAT REPEATS EVERY 8 SO THE WINDOW CAN WALK IT.
450 POKE $FF1E,0:POKE $FF1F,0:POKE $FF1F,0
460 POKE $FF1E,1:POKE $FF1F,7:POKE $FF1F,$2C
470 POKE $FF1E,2:POKE $FF1F,2:POKE $FF1F,$11
480 T=0:GOSUB 6
490 FOR Y=0 TO 287:LINE 0,Y,415,Y,0:NEXT
500 FOR Y=0 TO 287 STEP 8:LINE 0,Y,415,Y,1:NEXT
510 FOR X=0 TO 415 STEP 8:LINE X,0,X,287,1:NEXT
520 REM THE SHADOW FIRST, SO THE BALL SITS ON TOP OF IT.
530 FOR D=-48 TO 48
540 V=W(ABS(D))
550 LINE 232-V,168+D,232+V,168+D,2
560 NEXT
570 REM THE BALL. ONE HORIZONTAL SPAN A CHECK, WHICH IS
580 REM THE ONLY SHAPE THIS MACHINE DRAWS CHEAPLY: A FLAT
590 REM LINE IS 22 CYCLES A PIXEL AND ANY OTHER IS 209.
600 REM THE MERIDIANS ARE COSINE-SPACED, SO THEY CROWD AT
610 REM THE EDGE THE WAY A SPHERE'S DO.
620 B=0
630 FOR D=-48 TO 48
640 IF D>=E(B+1) THEN B=B+1
650 V=W(ABS(D))
660 A=208-V
670 FOR K=0 TO 7
680 X=208-V*C(K+1)/128
690 LINE A,144+D,X,144+D,4+(K AND 3)+4*(B AND 1)
700 A=X+1
710 NEXT
720 NEXT
730 REM THE FLIGHT. X AND Y ARE SIXTEENTHS OF A PIXEL;
740 REM THE WINDOW IS THE TOP LEFT OF A 256X192 VIEW INTO
750 REM THE 416X288 CANVAS, SO IT RUNS 0-160 BY 0-96 AND
760 REM THE BALL TOUCHES ALL FOUR EDGES AT THE ENDS.
770 P=0:Q=0:S=44:G=3:R=0:T=0:F=0
780 P=P+S
790 IF P<0 THEN P=0:S=-S
800 IF P>2560 THEN P=2560:S=-S
810 R=R+G:Q=Q+R
820 IF Q>1536 THEN Q=1536:R=-R
830 IF Q<0 THEN Q=0:R=-R
840 X=P/128*8:Y=Q/128*8
850 A=Y*208
860 POKE $FF12,A AND 255:POKE $FF13,A/256
870 POKE $FF16,X AND 255:POKE $FF17,X/256
880 VSYNC
890 F=F+1
900 IF F<3 THEN GOTO 780
910 F=0:T=(T+1) AND 3:GOSUB 6
920 GOTO 780
