10 REM 10 PRINT -- COOL8 EDITION
20 REM AFTER THE C64 ONE-LINER:
30 REM 10 PRINT CHR$(205.5+RND(1)); : GOTO 10
40 REM
50 REM THE C64 HAD TWO PETSCII DIAGONALS AND TWO COLOURS.
60 REM COOL8 HAS NEITHER -- THE FONT IS CP437 -- SO THE
70 REM DIAGONAL IS DRAWN AS A TILE INSTEAD: 8X8 AT 4BPP,
80 REM SIXTEEN COLOURS A CELL, AND THE ATTRIBUTE PICKS
90 REM WHICH OF THE SIXTEEN PALETTES IT USES.
100 REM ONE TILE SERVES BOTH DIAGONALS: BIT 6 FLIPS IT.
110 MODE 2
120 POKE $FF20,0:POKE $FF21,$40
130 POKE $FF26,$20:POKE $FF27,$40:POKE $FF28,1
140 FOR I=1 TO 32:READ D:POKE $FF29,D:NEXT
150 DATA 0,0,0,17,0,0,1,112
160 DATA 0,0,18,0,0,1,112,0
170 DATA 0,18,0,0,1,112,0,0
180 DATA 18,0,0,0,112,0,0,0
190 B=0
200 FOR R=0 TO 29
210 FOR C=0 TO 39
220 A=R*128+C*2
230 POKE $FF26,A AND 255
240 POKE $FF27,A/256
250 POKE $FF29,1
260 POKE $FF29,RND(2)*64+B
270 NEXT
280 B=B+1:IF B=16 THEN B=0
290 NEXT
300 GOTO 190
