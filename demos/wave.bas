1 GOTO 100
10 A=A+1:IF A>255 THEN A=A-256
11 C=C+1:IF C>250 THEN C=0
12 K=9+S(C)*2/100
13 Y=120+S(A)*K/10
14 Q=R(J):R(J)=Y:J=J+1:IF J>63 THEN J=0
15 LINE 0,Q,255,Q,0
16 LINE 0,O,255,O,E
17 LINE 0,Y,255,Y,255
18 O=Y:E=E+4:IF E>247 THEN E=E-247
19 VSYNC
20 IF INKEY=0 THEN GOTO 10
21 MODE 0
22 CURSOR 1
23 END
100 MODE 6
101 CURSOR 0
102 P#=ATN(1)*8/256
103 DIM S(255)
104 DIM R(63)
105 FOR I=0 TO 64
106 S(I)=100*SIN(I*P#)
107 NEXT I
108 FOR I=1 TO 63
109 S(128-I)=S(I)
110 S(128+I)=0-S(I)
111 S(256-I)=0-S(I)
112 NEXT I
113 S(128)=0:S(192)=0-100
120 FOR I=1 TO 247
121 T=I
122 IF I>124 THEN T=248-I
123 POKE $FF1E,I
124 POKE $FF1F,1+T*14/124
125 POKE $FF1F,(T*6/124)*16+15-T*4/124
126 NEXT I
127 POKE $FF1E,0:POKE $FF1F,0:POKE $FF1F,2
128 POKE $FF1E,255:POKE $FF1F,12:POKE $FF1F,255
129 CLG 0
133 A=0:C=0:E=1:J=0:O=120
134 GOTO 10
