; YENDOR -- a descent after NetHack, for COOL8, in CoolAction!
;
; The Amulet of Yendor lies twelve levels down. Fetch it, and climb back
; to the sun. The game is Rogue's and NetHack's -- rooms on a three by
; three grid joined by corridors, a map remembered as it is seen, levels
; that stay as they were left, monsters by NetHack's own numbers and a pet
; at your side -- drawn in DawnLike's tiles, by DragonDePlatino on
; DawnBringer's palette (CC-BY 4.0), which tools/mkyendor.py cuts from
; assets/dawnlike/ into assets/yendor/.
;
; **A cell of the dungeon is 16 x 16, four tiles**, so the screen shows
; twenty cells by thirteen of a level forty by twenty-four, and follows
; the hero across it. Mode 2's tiles have no transparency, so a creature
; or an item is drawn onto the floor by the generator, and each band of
; the dungeon -- its floor, its walls, its stairs -- is a file of four
; pattern banks on YENDOR's drive, streamed into VRAM on the stairs.
;
; **What is in view is in DawnBringer's sixteen; what is remembered is in
; the same sixteen dimmed** -- palette bank 0 and 1 -- so the map fades as
; the hero leaves it, and no tile is drawn twice for it.
;
; **Levels persist.** The current one is in memory; the others are parked
; in VRAM above the pattern banks, a slot each, monsters and all, and come
; back as they were.
;
; **The fighting is NetHack's**: a blow lands when 1 + the hero's bonus +
; the target's armour class + the hero's level + the weapon's enchantment
; beats a twenty-sided die, and a monster's when 10 + the hero's armour
; class + its level does; its attacks, its speed, how often it appears and
; how deep are monst.c's. Experience is NetHack's doubling ladder.
;
; **The things are NetHack's too**: its weapons, armour, potions, scrolls,
; wands, rings and amulets by objects.c's numbers, blessed, uncursed or
; cursed as mksobj() makes them, and the potions, scrolls, wands and rings
; under appearances each game shuffles -- a pink potion, a scroll labeled
; ZELGO MER -- until they are used or identified.
;
; Milestones 1 to 3: the dungeon, walking, doors, stairs, what is seen and
; remembered; the monsters, the fighting, the three heroes, their levels,
; the pet; the things and what they do. docs/14-demos.md has the plan.
;
; Keys: the cursor keys, the keypad or h j k l y u b n move -- two cursor
; keys held together go diagonally -- and moving into a monster attacks
; it, into the pet changes places; walking into a door opens it; > and <
; take the stairs, and Enter the stairs you stand on; s or . waits. As in
; NetHack: i the pack, , picks up, d drops, w wields, W wears, T takes
; off, P puts on, R removes, q drinks, r reads, z zaps, t throws, f fires
; daggers, : looks here, \ lists what is known, Z casts the Wizard's force
; bolt. Ctrl+R draws the screen again; Esc asks to quit.

CONST YDRIVE = 9                     ; YENDOR's drive: its program and its themes
CONST PAT_BASE = $1000               ; the four pattern banks, $1000-$8FFF of VRAM
CONST SLOT_BASE = $9000              ; a parked level a slot, above them
CONST SLOT_SIZE = 1536

; the level, and the window on it
CONST LW = 40
CONST LH = 24
CONST NCELL = 960
CONST VW = 20
CONST VH = 13
CONST VTOP = 2                       ; the tile row the window starts on
CONST MAXDEPTH = 12
CONST MAXMON = 20                    ; monsters on a level at once, the pet among them

; a cell's byte: what is there in the low five bits, and three flags
CONST K_ROCK = 0
CONST K_WALL = 1
CONST K_FLOOR = 2
CONST K_CORR = 3
CONST K_DOORC = 4
CONST K_DOORO = 5
CONST K_DOORWAY = 6
CONST K_UP = 7
CONST K_DOWN = 8
CONST F_LIT = 32                     ; a floor lit, so its room is seen whole
CONST F_SEEN = 64                    ; seen once, and remembered
CONST F_VIS = 128                    ; in view now

; a monster's state bits
CONST S_LIVE = 1
CONST S_PET = 2
CONST S_ANGRY = 4                    ; bitten by the pet: it bites back

; the objects
CONST MAXOBJ = 32                    ; things on a level's floor
CONST MAXINV = 18                    ; the pack, a to r
CONST OF_BLESS = 1
CONST OF_CURSE = 2
CONST OF_BKNOWN = 4                  ; its blessing known
CONST OF_EKNOWN = 8                  ; its enchantment or charges known

; the palette banks: tools/mkyendor.py's
CONST B_VIEW = 0
CONST B_DIM = 1
CONST B_WHITE = 2
CONST B_YELLOW = 3
CONST B_RED = 4
CONST B_GREEN = 5
CONST B_GREY = 6
CONST B_CYAN = 7

; keys: Set 2 make codes, an E0-prefixed one at $80 + code
CONST KEY_UP = $F5
CONST KEY_DOWN = $F2
CONST KEY_LEFT = $EB
CONST KEY_RIGHT = $F4
CONST KP1 = $69
CONST KP2 = $72
CONST KP3 = $7A
CONST KP4 = $6B
CONST KP5 = $73
CONST KP6 = $74
CONST KP7 = $6C
CONST KP8 = $75
CONST KP9 = $7D
CONST KEY_H = $33
CONST KEY_J = $3B
CONST KEY_K = $42
CONST KEY_L = $4B
CONST KEY_Y = $35
CONST KEY_U = $3C
CONST KEY_B = $32
CONST KEY_N = $31
CONST KEY_R = $2D
CONST KEY_S = $1B
CONST KEY_Z = $1A
CONST KEY_DOT = $49
CONST KEY_COMMA = $41
CONST KEY_LSHIFT = $12
CONST KEY_RSHIFT = $59
CONST KEY_CTRL = $14
CONST KEY_SPACE = $29
CONST KEY_ENTER = $5A
CONST KEY_ESC = $76
CONST KEY_A = $1C
CONST KEY_D = $23
CONST KEY_F = $2B
CONST KEY_I = $43
CONST KEY_P = $4D
CONST KEY_Q = $15
CONST KEY_T = $2C
CONST KEY_W = $1D
CONST KEY_SEMI = $4C
CONST KEY_BSLASH = $5D

; the eight directions, 1 north and on clockwise
BYTE ARRAY dir_dx(9) = [0 0 1 1 1 0 255 255 255]
BYTE ARRAY dir_dy(9) = [0 255 255 0 1 1 1 0 255]
; the pack's letters, a to r, as the keys that type them
BYTE ARRAY letter_sc(18) = [$1C $32 $21 $23 $24 $2B $34 $33 $43 $3B $42 $4B $3A $31 $44 $4D $15 $2D]

; the heroes: Valkyrie, Wizard, Rogue -- NetHack's starting hit points and
; power (the role's and a human's), the to-hit and damage bonuses of their
; strength and dexterity, and the pet each brings; their things are
; InitHero's
BYTE ARRAY r_hp(3) = [16 12 12]
BYTE ARRAY r_pw(3) = [1 7 2]
BYTE ARRAY r_abon(3) = [1 0 2]
BYTE ARRAY r_dbon(3) = [2 0 0]
BYTE ARRAY r_pet(3) = [M_KITTEN M_KITTEN M_LITTLEDOG]

; the three cell maps live below the program, in the loader's low RAM
; ($0800-$13FF, D109): not in the PRG, and garbage until MakeLevel or
; LoadLevel clears them
BYTE ARRAY lv(960) = $0800
BYTE ARRAY rx1(9), ry1(9), rx2(9), ry2(9), rgone(9)
BYTE upx, upy, dnx, dny
BYTE ARRAY made(13)                  ; levels already made, by depth
CARD ARRAY vis(160)                  ; the cells in view, to fade when they leave it
BYTE nvis

; the monsters of the level: parallel arrays, parked with it
BYTE ARRAY mtype(20), mx(20), my(20), mhp(20), mhpmax(20), mlev(20), mstat(20), mmove(20)
BYTE ARRAY mat(960) = $0BC0          ; the monster on a cell, plus one; rebuilt, not parked
BYTE ARRAY msl(20)                   ; a monster's turns of sleep, parked with it

; the things on the floor, parked with the level: kind (255 none), place,
; quantity, flags, and enchantment or charges
BYTE ARRAY ot(32), ox(32), oy(32), oq(32), of(32), oe(32)
BYTE ARRAY oat(960) = $0F80          ; the top thing on a cell, plus one; rebuilt
; the hero's pack, and what of it is in use
BYTE ARRAY it(18), iq(18), ifl(18), ie(18)
BYTE ARRAY worn(7)                   ; the letter worn in each armour slot, 255 none
BYTE uwep, uleft, uright, uamul
BYTE ARRAY known(48), ap(48)         ; each kind identified, and its appearance this game
CARD ugold
BYTE nf, ne                          ; a new thing's flags and enchantment
BYTE wantport                        ; the ring of teleportation's pull, taken after the turn

BYTE depth, theme, role
BYTE px, py                          ; the hero
BYTE ulev, uhp, uhpmax, upw, upwmax, upara
INT uac
CARD uxp
BYTE dead, killer                    ; and what did it
BYTE vx, vy                          ; the window's corner on the level
CARD turns
BYTE anim, animt                     ; the creatures' frame, and the frames to the next
BYTE esc, phase                      ; 0 the title, 1 play, 2 the grave
BYTE rep_c, rep_t
CARD st_n
CARD loops                           ; frames of play, for the gate

; the message lines: a line built in mb, then printed on the next of the
; two rows, with --More-- when both are full
BYTE ARRAY mb(81)
BYTE mbl, msgrow

; ------------------------------------------------------------- the screen
PROC Tile(BYTE col, BYTE row, BYTE t, BYTE attr)
  CARD a
  a = row
  VRAM_ADDR = (a << 7) + (col << 1)
  VRAM_STEP = 1
  VRAM_DATA = t
  VRAM_DATA = attr
RETURN

; a 16 x 16 picture: the four tiles from t
PROC Pic(BYTE col, BYTE row, BYTE t, BYTE attr)
  CARD a
  a = row
  a = (a << 7) + (col << 1)
  VRAM_STEP = 1
  VRAM_ADDR = a
  VRAM_DATA = t
  VRAM_DATA = attr
  VRAM_DATA = t + 1
  VRAM_DATA = attr
  VRAM_ADDR = a + 128
  VRAM_DATA = t + 2
  VRAM_DATA = attr
  VRAM_DATA = t + 3
  VRAM_DATA = attr
RETURN

; a cell never seen: the space glyph, which is empty in every theme
PROC Blank(BYTE col, BYTE row)
  CARD a
  a = row
  a = (a << 7) + (col << 1)
  VRAM_STEP = 1
  VRAM_ADDR = a
  VRAM_DATA = 0
  VRAM_DATA = 0
  VRAM_DATA = 0
  VRAM_DATA = 0
  VRAM_ADDR = a + 128
  VRAM_DATA = 0
  VRAM_DATA = 0
  VRAM_DATA = 0
  VRAM_DATA = 0
RETURN

PROC Text(BYTE col, BYTE row, BYTE POINTER s, BYTE bank)
  BYTE n
  CARD a
  a = row
  VRAM_ADDR = (a << 7) + (col << 1)
  VRAM_STEP = 1
  n = *s
  WHILE n > 0 DO
    s += 1
    VRAM_DATA = *s - FONT_FIRST
    VRAM_DATA = bank
    n -= 1
  OD
RETURN

PROC ClearRow(BYTE row)
  BYTE i
  CARD a
  a = row
  VRAM_ADDR = a << 7
  VRAM_STEP = 1
  FOR i = 0 TO 39 DO
    VRAM_DATA = 0
    VRAM_DATA = 0
  OD
RETURN

; a number right-aligned in n places, blank to its left
PROC Num(BYTE col, BYTE row, CARD v, BYTE n, BYTE bank)
  BYTE i
  CARD a
  a = row
  i = n
  WHILE i > 0 DO
    i -= 1
    VRAM_ADDR = (a << 7) + ((col + i) << 1)
    VRAM_STEP = 1
    IF v > 0 OR i == n - 1 THEN
      VRAM_DATA = '0' - FONT_FIRST + v % 10
    ELSE
      VRAM_DATA = 0
    FI
    VRAM_DATA = bank
    v = v / 10
  OD
RETURN

PROC ClearScreen()
  BYTE r
  FOR r = 0 TO 29 DO ClearRow(r) OD
RETURN

PROC Palette()
  BYTE b
  FOR b = 0 TO N_PAL - 1 DO SetPalette(yendor_pal + (b << 5), b << 4, 16) OD
RETURN

; ------------------------------------------------------------- a frame
PROC Tick()
  WaitVBlank()
  KeyPoll()
  IF KeyHit(KEY_ESC) THEN esc = 1 FI
  IF animt THEN animt -= 1 FI
RETURN

; ------------------------------------------------------------- messages
PROC MsgClear()
  ClearRow(0)
  ClearRow(1)
  msgrow = 0
  mbl = 0
RETURN

PROC MsgC(BYTE ch)
  IF mbl < 80 THEN
    mb(mbl) = ch
    mbl += 1
  FI
RETURN

PROC MsgS(BYTE POINTER s)
  BYTE n
  n = *s
  WHILE n > 0 DO
    s += 1
    MsgC(*s)
    n -= 1
  OD
RETURN

PROC MsgN(CARD v)
  BYTE ARRAY dg(5)
  BYTE n
  n = 0
  DO
    dg(n) = v % 10
    v = v / 10
    n += 1
  UNTIL v == 0 OD
  WHILE n > 0 DO
    n -= 1
    MsgC('0' + dg(n))
  OD
RETURN

; both rows used: --More--, and a key before the next
PROC More()
  BYTE k
  Text(32, 1, "--More--", B_YELLOW)
  k = KeyHit(KEY_SPACE)
  k = KeyHit(KEY_ENTER)
  esc = 0
  DO
    Tick()
  UNTIL KeyHit(KEY_SPACE) OR KeyHit(KEY_ENTER) OR esc OD
  esc = 0
  ClearRow(0)
  ClearRow(1)
  msgrow = 0
RETURN

; the line built so far onto the next row, broken at a space onto the
; one after if it is longer than forty
PROC MsgEnd()
  BYTE i, n, cut, start
  CARD a
  start = 0
  WHILE start < mbl DO
    n = mbl - start
    cut = n
    IF n > 40 THEN
      cut = 40
      i = 40
      WHILE i > 20 DO
        IF mb(start + i) == ' ' THEN
          cut = i
          EXIT
        FI
        i -= 1
      OD
    FI
    IF msgrow >= 2 THEN More() FI
    ClearRow(msgrow)
    a = msgrow
    VRAM_ADDR = a << 7
    VRAM_STEP = 1
    FOR i = 1 TO cut DO
      VRAM_DATA = mb(start + i - 1) - FONT_FIRST
      VRAM_DATA = B_WHITE
    OD
    msgrow += 1
    start += cut
    IF start < mbl THEN
      IF mb(start) == ' ' THEN start += 1 FI
    FI
  OD
  mbl = 0
RETURN

PROC Msg(BYTE POINTER s)
  mbl = 0
  MsgS(s)
  MsgEnd()
RETURN

; ------------------------------------------------------------ the dice
; NetHack's rnd(n): one to n
FUNC BYTE Roll(BYTE n)
  IF n == 0 THEN RETURN (0) FI
RETURN (Rnd(n) + 1)

FUNC BYTE Dice(BYTE n, BYTE s)
  BYTE t, i
  t = 0
  FOR i = 1 TO n DO t += Roll(s) OD
RETURN (t)

; ------------------------------------------------------------ the themes
FUNC BYTE ThemeOf(BYTE d)
  IF d <= 4 THEN RETURN (0) FI
  IF d <= 8 THEN RETURN (1) FI
RETURN (2)

; a theme's four pattern banks from YENDOR's drive into VRAM, at the
; flash's own rate: 32,768 bytes in about eight frames. The font is the
; same bytes in every theme, so the words on the screen do not flicker
FUNC BYTE LoadTheme(BYTE t)
  CARD o
  o = t
  IF DiskFind(YDRIVE, theme_names + o * 11) == 0 THEN RETURN (0) FI
  DiskOpen(YDRIVE)
  VRAM_ADDR = PAT_BASE
  VRAM_STEP = 1
  st_n = 32768
  ASM
    LDW  X,[v_st_n]
.l: LD   R0,[v_FLS_DATA]
    ST   [v_VRAM_DATA],R0
    DECW X
    BNE  .l
  ENDASM
  FlashClose()
  theme = t
RETURN (1)

; ------------------------------------------------------------- the level
FUNC CARD Idx(BYTE x, BYTE y)
  CARD i
  i = y
RETURN ((i << 5) + (i << 3) + x)

FUNC BYTE Kind(BYTE x, BYTE y)
  IF x >= LW OR y >= LH THEN RETURN (K_ROCK) FI
RETURN (lv(Idx(x, y)) & 31)

PROC SetKind(BYTE x, BYTE y, BYTE k)
  CARD i
  i = Idx(x, y)
  lv(i) = (lv(i) & 224) | k
RETURN

; a wall joins to a wall, and to a door in one
FUNC BYTE WallLike(BYTE x, BYTE y)
  BYTE k
  k = Kind(x, y)
  IF k == K_WALL OR k == K_DOORC OR k == K_DOORO OR k == K_DOORWAY THEN RETURN (1) FI
RETURN (0)

; what a foot can stand on; a shut door is not that
FUNC BYTE Open(BYTE k)
  IF k == K_ROCK OR k == K_WALL OR k == K_DOORC THEN RETURN (0) FI
RETURN (1)

; a door is never entered or left on the diagonal, as NetHack has it;
; an empty doorway is no bar
FUNC BYTE Diagonal(BYTE x, BYTE y, BYTE nx, BYTE ny)
  BYTE a, b
  IF x == nx OR y == ny THEN RETURN (1) FI
  a = Kind(x, y)
  b = Kind(nx, ny)
  IF a == K_DOORO OR a == K_DOORC OR b == K_DOORO OR b == K_DOORC THEN RETURN (0) FI
RETURN (1)

; a door where a corridor meets a room's wall: half of them an empty
; doorway, a third shut, the rest standing open
PROC Door(BYTE x, BYTE y)
  BYTE r
  r = Rnd(6)
  IF r < 3 THEN
    SetKind(x, y, K_DOORWAY)
  ELSEIF r < 5 THEN
    SetKind(x, y, K_DOORC)
  ELSE
    SetKind(x, y, K_DOORO)
  FI
RETURN

PROC Dig(BYTE x, BYTE y)
  IF Kind(x, y) == K_ROCK THEN SetKind(x, y, K_CORR) FI
RETURN

; a corridor from a's east side to b's west, b the grid cell to its right:
; along a's row to a column between them, down or up to b's, and along
PROC JoinAcross(BYTE a, BYTE b)
  BYTE ax, ay, bx, by, m, x, y
  IF rgone(a) THEN
    ax = rx1(a)
    ay = ry1(a)
  ELSE
    ax = rx2(a)
    ay = ry1(a) + 1 + Rnd(ry2(a) - ry1(a) - 1)
    Door(ax, ay)
    ax += 1
  FI
  IF rgone(b) THEN
    bx = rx1(b)
    by = ry1(b)
  ELSE
    bx = rx1(b)
    by = ry1(b) + 1 + Rnd(ry2(b) - ry1(b) - 1)
    Door(bx, by)
    bx -= 1
  FI
  m = ax + Rnd(bx - ax + 1)
  FOR x = ax TO m DO Dig(x, ay) OD
  IF ay < by THEN
    FOR y = ay TO by DO Dig(m, y) OD
  ELSE
    FOR y = by TO ay DO Dig(m, y) OD
  FI
  FOR x = m TO bx DO Dig(x, by) OD
RETURN

; the same, a above b
PROC JoinDown(BYTE a, BYTE b)
  BYTE ax, ay, bx, by, m, x, y
  IF rgone(a) THEN
    ax = rx1(a)
    ay = ry1(a)
  ELSE
    ay = ry2(a)
    ax = rx1(a) + 1 + Rnd(rx2(a) - rx1(a) - 1)
    Door(ax, ay)
    ay += 1
  FI
  IF rgone(b) THEN
    bx = rx1(b)
    by = ry1(b)
  ELSE
    by = ry1(b)
    bx = rx1(b) + 1 + Rnd(rx2(b) - rx1(b) - 1)
    Door(bx, by)
    by -= 1
  FI
  m = ay + Rnd(by - ay + 1)
  FOR y = ay TO m DO Dig(ax, y) OD
  IF ax < bx THEN
    FOR x = ax TO bx DO Dig(x, m) OD
  ELSE
    FOR x = bx TO ax DO Dig(x, m) OD
  FI
  FOR y = m TO by DO Dig(bx, y) OD
RETURN

; the grid cell next to g in direction d -- 0 east, 1 south, 2 west,
; 3 north -- or 255 off the grid
FUNC BYTE Beside(BYTE g, BYTE d)
  IF d == 0 THEN
    IF g % 3 < 2 THEN RETURN (g + 1) FI
  ELSEIF d == 1 THEN
    IF g < 6 THEN RETURN (g + 3) FI
  ELSEIF d == 2 THEN
    IF g % 3 > 0 THEN RETURN (g - 1) FI
  ELSEIF g >= 3 THEN
    RETURN (g - 3)
  FI
RETURN (255)

BYTE ARRAY joined(9)                 ; a bit for each cell a cell is joined to
BYTE ARRAY conn(9)                   ; the cells the walk has reached

PROC Join(BYTE a, BYTE b)
  BYTE t
  IF b < a THEN
    t = a
    a = b
    b = t
  FI
  IF joined(a) & (1 << (b - a)) THEN RETURN FI
  joined(a) = joined(a) | (1 << (b - a))
  IF b == a + 1 THEN JoinAcross(a, b) ELSE JoinDown(a, b) FI
RETURN

; a cell somewhere inside a room that is a room, on its floor
FUNC CARD RoomSpot(BYTE r)
  BYTE x, y, tries
  CARD s
  FOR tries = 1 TO 40 DO
    x = rx1(r) + 1 + Rnd(rx2(r) - rx1(r) - 1)
    y = ry1(r) + 1 + Rnd(ry2(r) - ry1(r) - 1)
    IF Kind(x, y) == K_FLOOR AND mat(Idx(x, y)) == 0 THEN
      s = x                          ; a shift keeps its left side's width: widen first
      RETURN ((s << 8) | y)
    FI
  OD
RETURN ($FFFF)

PROC Stair(BYTE r, BYTE k)
  BYTE x, y
  CARD s
  s = RoomSpot(r)
  x = s >> 8
  y = s
  SetKind(x, y, k)
  IF k == K_UP THEN
    upx = x
    upy = y
  ELSE
    dnx = x
    dny = y
  FI
RETURN

; ------------------------------------------------------------- the objects
; an enchantment or a charge count is a byte; enchantments go below zero
FUNC INT Signed(BYTE v)
  INT e
  e = v
  IF e > 127 THEN e = e - 256 FI
RETURN (e)

; the top thing on a cell is the highest-numbered one there
PROC TopObj(BYTE x, BYTE y)
  BYTE i, top
  top = 0
  FOR i = 0 TO MAXOBJ - 1 DO
    IF ot(i) <> 255 AND ox(i) == x AND oy(i) == y THEN top = i + 1 FI
  OD
  oat(Idx(x, y)) = top
RETURN

; a thing onto the floor, on top of what is there; 255 if the level has
; no room for more
FUNC BYTE PutObj(BYTE t, BYTE q, BYTE f, BYTE e, BYTE x, BYTE y)
  BYTE i
  FOR i = 0 TO MAXOBJ - 1 DO
    IF ot(i) == 255 THEN
      ot(i) = t
      oq(i) = q
      of(i) = f
      oe(i) = e
      ox(i) = x
      oy(i) = y
      oat(Idx(x, y)) = i + 1
      RETURN (i)
    FI
  OD
RETURN (255)

PROC TakeObj(BYTE i)
  ot(i) = 255
  TopObj(ox(i), oy(i))
RETURN

; a kind of a class, as often as objects.c's probabilities say
FUNC BYTE PickKind(BYTE cls)
  BYTE t
  CARD total, r
  total = 0
  FOR t = 0 TO N_OBJ - 1 DO
    IF o_class(t) == cls THEN total += o_prob(t) FI
  OD
  r = Rnd(total)
  FOR t = 0 TO N_OBJ - 1 DO
    IF o_class(t) == cls THEN
      IF r < o_prob(t) THEN RETURN (t) FI
      r -= o_prob(t)
    FI
  OD
RETURN (0)

; NetHack's mkobj() odds among the classes the game has -- weapons 10,
; armour 10, potions 16, scrolls 16, wands 4, rings 3, amulets 1
FUNC BYTE MkKind()
  BYTE r
  r = Rnd(60)
  IF r < 10 THEN RETURN (PickKind(C_WEAPON)) FI
  IF r < 20 THEN RETURN (PickKind(C_ARMOR)) FI
  IF r < 36 THEN RETURN (PickKind(C_POTION)) FI
  IF r < 52 THEN RETURN (PickKind(C_SCROLL)) FI
  IF r < 56 THEN RETURN (PickKind(C_WAND)) FI
  IF r < 59 THEN RETURN (PickKind(C_RING)) FI
RETURN (O_LIFESAVING)

; mksobj()'s blessings, curses, enchantments and charges for a new thing
; of kind t, into nf and ne: a weapon or armour one in eleven enchanted
; and half of those blessed, else one in ten cursed and enchanted down; a
; potion, scroll or amulet one in four blessed or cursed; a wand 4-8
; charges, 11-15 if it needs no direction; a ring of protection or
; increase damage +1 to +3, one in four of them cursed and negative
PROC Bless(BYTE t)
  BYTE c
  c = o_class(t)
  nf = 0
  ne = 0
  IF c == C_WEAPON OR c == C_ARMOR THEN
    IF Rnd(11) == 0 THEN
      ne = Roll(3)
      IF Rnd(2) THEN nf = OF_BLESS FI
    ELSEIF Rnd(10) == 0 THEN
      nf = OF_CURSE
      ne = 256 - Roll(3)
    FI
  ELSEIF c == C_POTION OR c == C_SCROLL OR c == C_AMULET THEN
    IF Rnd(4) == 0 THEN
      IF Rnd(2) THEN nf = OF_BLESS ELSE nf = OF_CURSE FI
    FI
  ELSEIF c == C_WAND THEN
    IF o_slot(t) == D_NODIR THEN ne = 11 + Rnd(5) ELSE ne = 4 + Rnd(5) FI
  ELSEIF c == C_RING THEN
    IF t == O_RPROTECTION OR t == O_RDAMAGE THEN
      ne = Roll(3)
      IF Rnd(4) == 0 THEN
        nf = OF_CURSE
        ne = 256 - ne
      FI
    ELSEIF t == O_RTELEPORT AND Rnd(3) == 0 THEN
      nf = OF_CURSE
    FI
  FI
RETURN

PROC MkObj(BYTE x, BYTE y)
  BYTE t, i
  t = MkKind()
  Bless(t)
  i = PutObj(t, 1, nf, ne, x, y)
RETURN

; NetHack's mkgold(): a d(depth+2) times a d30 pile, kept to a byte
PROC MkGold(BYTE x, BYTE y)
  BYTE i
  CARD q
  q = Roll(depth + 2)
  q = q * Roll(30)
  IF q > 250 THEN q = 250 FI
  i = PutObj(O_GOLD, q, 0, 0, x, y)
RETURN

FUNC BYTE Wearing(BYTE t)
  IF uleft <> 255 THEN
    IF it(uleft) == t THEN RETURN (1) FI
  FI
  IF uright <> 255 THEN
    IF it(uright) == t THEN RETURN (1) FI
  FI
RETURN (0)

; what the rings of a kind worn add up to
FUNC INT RingEnch(BYTE t)
  INT e
  e = 0
  IF uleft <> 255 THEN
    IF it(uleft) == t THEN e = e + Signed(ie(uleft)) FI
  FI
  IF uright <> 255 THEN
    IF it(uright) == t THEN e = e + Signed(ie(uright)) FI
  FI
RETURN (e)

; NetHack's armour class: ten, less each piece worn and its enchantment,
; less the rings of protection
PROC CalcAC()
  BYTE s, k
  INT a
  a = 10
  FOR s = 1 TO 6 DO
    k = worn(s)
    IF k <> 255 THEN a = a - o_arg(it(k)) - Signed(ie(k)) FI
  OD
  uac = a - RingEnch(O_RPROTECTION)
RETURN

; q of the pack's letter k gone; when none is left, it is no longer worn
PROC InvDel(BYTE k, BYTE q)
  BYTE s
  IF iq(k) > q THEN
    iq(k) -= q
    RETURN
  FI
  it(k) = 255
  IF uwep == k THEN uwep = 255 FI
  IF uleft == k THEN uleft = 255 FI
  IF uright == k THEN uright = 255 FI
  IF uamul == k THEN uamul = 255 FI
  FOR s = 1 TO 6 DO
    IF worn(s) == k THEN worn(s) = 255 FI
  OD
  CalcAC()
RETURN

; a thing into the pack: daggers, potions and scrolls onto a stack of
; their own like, else the first free letter; 255 if the pack is full
FUNC BYTE InvAdd(BYTE t, BYTE q, BYTE f, BYTE e)
  BYTE k, c
  c = o_class(t)
  IF t == O_DAGGER OR c == C_POTION OR c == C_SCROLL THEN
    FOR k = 0 TO MAXINV - 1 DO
      IF it(k) == t AND ifl(k) == f AND ie(k) == e AND uwep <> k AND iq(k) < 240 THEN
        iq(k) += q
        RETURN (k)
      FI
    OD
  FI
  FOR k = 0 TO MAXINV - 1 DO
    IF it(k) == 255 THEN
      it(k) = t
      iq(k) = q
      ifl(k) = f
      ie(k) = e
      RETURN (k)
    FI
  OD
RETURN (255)

; ----------------------------------------------------------- the monsters
; a name from YNAMES.DAT, into nbuf: record k, NAME_REC bytes each, from
; the page Title found the file on. One buffer, so a name is used before
; the next is asked for
CARD names_page
BYTE ARRAY nbuf(NAME_REC)

FUNC BYTE POINTER NameRec(CARD k)
  CARD lo, at
  BYTE hi
  lo = names_page & 255
  lo = lo << 8
  at = lo + k * NAME_REC
  hi = $10 + YDRIVE * 7 + (names_page >> 8)
  IF at < lo THEN hi += 1 FI
  FlashOpen(at, hi)
  nbuf(0) = FlashByte()
  FlashRead(nbuf + 1, nbuf(0))
  FlashClose()
RETURN (nbuf)

FUNC BYTE POINTER MonName(BYTE t)
RETURN (NameRec(NAME_MON + t))

PROC Place(BYTE i)
  mat(Idx(mx(i), my(i))) = i + 1
RETURN

PROC Unplace(BYTE i)
  mat(Idx(mx(i), my(i))) = 0
RETURN

FUNC BYTE MonAt(BYTE x, BYTE y)
  IF x >= LW OR y >= LH THEN RETURN (0) FI
RETURN (mat(Idx(x, y)))

; a new monster of type t at (x, y): NetHack's hit points, a level's
; worth of eight-sided dice, or up to four at level 0; 255 if the level
; is full
FUNC BYTE NewMon(BYTE t, BYTE x, BYTE y)
  BYTE i, l
  FOR i = 0 TO MAXMON - 1 DO
    IF mstat(i) == 0 THEN
      mtype(i) = t
      l = m_lvl(t)
      mlev(i) = l
      IF l == 0 THEN mhp(i) = Roll(4) ELSE mhp(i) = Dice(l, 8) FI
      mhpmax(i) = mhp(i)
      mstat(i) = S_LIVE
      mmove(i) = Rnd(12)
      msl(i) = 0
      mx(i) = x
      my(i) = y
      Place(i)
      RETURN (i)
    FI
  OD
RETURN (255)

; which kind of monster: NetHack's choice by difficulty -- no harder than
; half the depth and the hero's level together, no easier than a sixth
; of the depth -- each as likely as its frequency says
FUNC BYTE PickType()
  BYTE t, lo, hi
  CARD total, r
  hi = (depth + ulev) / 2
  IF hi < 1 THEN hi = 1 FI
  lo = depth / 6
  total = 0
  FOR t = 0 TO N_MON - 1 DO
    IF m_flag(t) & MF_NOGEN == 0 AND m_diff(t) >= lo AND m_diff(t) <= hi THEN total += m_freq(t) FI
  OD
  IF total == 0 THEN RETURN (M_NEWT) FI
  r = Rnd(total)
  FOR t = 0 TO N_MON - 1 DO
    IF m_flag(t) & MF_NOGEN == 0 AND m_diff(t) >= lo AND m_diff(t) <= hi THEN
      IF r < m_freq(t) THEN RETURN (t) FI
      r -= m_freq(t)
    FI
  OD
RETURN (M_NEWT)

; a free open cell next to (x, y), as dir 1-8, or 0
FUNC BYTE FreeNear(BYTE x, BYTE y)
  BYTE d, k, nx, ny
  k = Rnd(8)
  FOR d = 1 TO 8 DO
    k = (k % 8) + 1
    nx = x + dir_dx(k)
    ny = y + dir_dy(k)
    IF nx < LW AND ny < LH THEN
      IF Open(Kind(nx, ny)) AND MonAt(nx, ny) == 0 AND (nx <> px OR ny <> py) THEN RETURN (k) FI
    FI
  OD
RETURN (0)

; a monster, and its fellows round it if it comes in a group -- smaller
; groups while the hero is new, as NetHack does
PROC Spawn(BYTE x, BYTE y)
  BYTE t, i, n, d
  t = PickType()
  i = NewMon(t, x, y)
  IF i == 255 THEN RETURN FI
  n = 0
  IF m_flag(t) & MF_SGROUP THEN n = Rnd(3) FI
  IF m_flag(t) & MF_LGROUP THEN n = Rnd(6) FI
  IF ulev < 3 THEN n = n / 2 FI
  WHILE n > 0 DO
    n -= 1
    d = FreeNear(x, y)
    IF d THEN i = NewMon(t, x + dir_dx(d), y + dir_dy(d)) FI
  OD
RETURN

; a monster arriving out of sight, one turn in seventy
PROC SpawnSomewhere()
  BYTE r, tries, x, y
  CARD s
  FOR tries = 1 TO 20 DO
    r = Rnd(9)
    IF rgone(r) == 0 THEN
      s = RoomSpot(r)
      IF s <> $FFFF THEN
        x = s >> 8
        y = s
        IF lv(Idx(x, y)) & F_VIS == 0 AND (x <> px OR y <> py) THEN
          Spawn(x, y)
          RETURN
        FI
      FI
    FI
  OD
RETURN

FUNC BYTE FindPet()
  BYTE i
  FOR i = 0 TO MAXMON - 1 DO
    IF mstat(i) & S_PET THEN RETURN (i) FI
  OD
RETURN (255)

; Rogue's level: nine cells of a three by three grid, most of them a room
; and a few only a turn in a corridor; every cell joined to the rest by a
; walk from one to a neighbour not yet joined, then a few loops more;
; then its monsters, one in three rooms, never in the room of the stairs
; the hero comes down
PROC MakeLevel()
  BYTE g, x0, y0, w, h, x, y, gone, lit, a, b, d, n, u, k
  CARD i, s
  FOR i = 0 TO NCELL - 1 DO
    lv(i) = 0
    mat(i) = 0
    oat(i) = 0
  OD
  FOR g = 0 TO MAXMON - 1 DO mstat(g) = 0 OD
  FOR g = 0 TO MAXOBJ - 1 DO ot(g) = 255 OD
  lit = 9
  IF depth > 4 THEN lit = 7 FI
  IF depth > 8 THEN lit = 5 FI
  gone = 0
  FOR g = 0 TO 8 DO
    x0 = (g % 3) * 13 + 1
    y0 = (g / 3) * 8
    joined(g) = 0
    rgone(g) = 0
    IF gone < 2 AND Rnd(5) == 0 THEN
      gone += 1
      rgone(g) = 1
      rx1(g) = x0 + 1 + Rnd(10)
      ry1(g) = y0 + 1 + Rnd(5)
      rx2(g) = rx1(g)
      ry2(g) = ry1(g)
      SetKind(rx1(g), ry1(g), K_CORR)
    ELSE
      w = 5 + Rnd(8)
      h = 4 + Rnd(4)
      rx1(g) = x0 + Rnd(13 - w)
      ry1(g) = y0 + Rnd(8 - h)
      rx2(g) = rx1(g) + w - 1
      ry2(g) = ry1(g) + h - 1
      k = K_FLOOR
      IF Rnd(10) < lit THEN k = K_FLOOR | F_LIT FI
      FOR y = ry1(g) TO ry2(g) DO
        FOR x = rx1(g) TO rx2(g) DO
          IF x == rx1(g) OR x == rx2(g) OR y == ry1(g) OR y == ry2(g) THEN
            SetKind(x, y, K_WALL)
          ELSE
            lv(Idx(x, y)) = k
          FI
        OD
      OD
    FI
  OD
  FOR g = 0 TO 8 DO conn(g) = 0 OD
  g = Rnd(9)
  conn(g) = 1
  n = 1
  WHILE n < 9 DO
    a = Rnd(9)
    IF conn(a) THEN
      b = Beside(a, Rnd(4))
      IF b <> 255 THEN
        IF conn(b) == 0 THEN
          Join(a, b)
          conn(b) = 1
          n += 1
        FI
      FI
    FI
  OD
  FOR n = 0 TO Rnd(3) DO
    a = Rnd(9)
    b = Beside(a, Rnd(4))
    IF b <> 255 THEN Join(a, b) FI
  OD
  DO
    u = Rnd(9)
  UNTIL rgone(u) == 0 OD
  Stair(u, K_UP)
  IF depth < MAXDEPTH THEN
    DO
      d = Rnd(9)
    UNTIL rgone(d) == 0 AND d <> u OD
    Stair(d, K_DOWN)
  FI
  FOR g = 0 TO 8 DO
    IF rgone(g) == 0 AND g <> u AND Rnd(3) == 0 THEN
      s = RoomSpot(g)
      IF s <> $FFFF THEN Spawn(s >> 8, s) FI
    FI
  OD
  ; NetHack's room filling: gold one room in three, and a thing one room
  ; in three with a one in five chance of another after each
  FOR g = 0 TO 8 DO
    IF rgone(g) == 0 THEN
      IF Rnd(3) == 0 THEN
        s = RoomSpot(g)
        IF s <> $FFFF THEN MkGold(s >> 8, s) FI
      FI
      IF Rnd(3) == 0 THEN
        DO
          s = RoomSpot(g)
          IF s <> $FFFF THEN MkObj(s >> 8, s) FI
        UNTIL Rnd(5) <> 0 OD
      FI
    FI
  OD
RETURN

; the level parked in its VRAM slot, or brought back from it
FUNC CARD Slot(BYTE d)
  CARD s
  s = d - 1
RETURN (SLOT_BASE + (s << 10) + (s << 9))

PROC ForgetView()
  BYTE k
  CARD i
  k = 0
  WHILE k < nvis DO                  ; not FOR k = 0 TO nvis - 1: with none, that is 256
    i = vis(k)
    lv(i) = lv(i) & 127
    k += 1
  OD
  nvis = 0
RETURN

PROC SaveLevel()
  CARD s
  IF nvis THEN ForgetView() FI
  s = Slot(depth)
  VWrite(s, lv, NCELL)
  VWrite(s + 960, rx1, 9)
  VWrite(s + 969, ry1, 9)
  VWrite(s + 978, rx2, 9)
  VWrite(s + 987, ry2, 9)
  VWrite(s + 996, rgone, 9)
  VWrite(s + 1005, &upx, 4)
  VWrite(s + 1009, mtype, MAXMON)
  VWrite(s + 1029, mx, MAXMON)
  VWrite(s + 1049, my, MAXMON)
  VWrite(s + 1069, mhp, MAXMON)
  VWrite(s + 1089, mhpmax, MAXMON)
  VWrite(s + 1109, mlev, MAXMON)
  VWrite(s + 1129, mstat, MAXMON)
  VWrite(s + 1149, mmove, MAXMON)
  VWrite(s + 1169, ot, MAXOBJ)
  VWrite(s + 1201, ox, MAXOBJ)
  VWrite(s + 1233, oy, MAXOBJ)
  VWrite(s + 1265, oq, MAXOBJ)
  VWrite(s + 1297, of, MAXOBJ)
  VWrite(s + 1329, oe, MAXOBJ)
  VWrite(s + 1361, msl, MAXMON)
RETURN

PROC LoadLevel()
  CARD s, i
  BYTE m
  s = Slot(depth)
  VRead(s, lv, NCELL)
  VRead(s + 960, rx1, 9)
  VRead(s + 969, ry1, 9)
  VRead(s + 978, rx2, 9)
  VRead(s + 987, ry2, 9)
  VRead(s + 996, rgone, 9)
  VRead(s + 1005, &upx, 4)
  VRead(s + 1009, mtype, MAXMON)
  VRead(s + 1029, mx, MAXMON)
  VRead(s + 1049, my, MAXMON)
  VRead(s + 1069, mhp, MAXMON)
  VRead(s + 1089, mhpmax, MAXMON)
  VRead(s + 1109, mlev, MAXMON)
  VRead(s + 1129, mstat, MAXMON)
  VRead(s + 1149, mmove, MAXMON)
  VRead(s + 1169, ot, MAXOBJ)
  VRead(s + 1201, ox, MAXOBJ)
  VRead(s + 1233, oy, MAXOBJ)
  VRead(s + 1265, oq, MAXOBJ)
  VRead(s + 1297, of, MAXOBJ)
  VRead(s + 1329, oe, MAXOBJ)
  VRead(s + 1361, msl, MAXMON)
  FOR i = 0 TO NCELL - 1 DO
    mat(i) = 0
    oat(i) = 0
  OD
  FOR m = 0 TO MAXMON - 1 DO
    IF mstat(m) THEN Place(m) FI
  OD
  FOR m = 0 TO MAXOBJ - 1 DO
    IF ot(m) <> 255 THEN oat(Idx(ox(m), oy(m))) = m + 1 FI
  OD
RETURN

; --------------------------------------------------------------- the view
PROC DrawCell(BYTE x, BYTE y)
  BYTE c, k, t, a, col, row, m
  CARD i
  IF x < vx OR x >= vx + VW OR y < vy OR y >= vy + VH THEN RETURN FI
  col = (x - vx) << 1
  row = VTOP + ((y - vy) << 1)
  IF x == px AND y == py THEN
    Pic(col, row, role << 2, (2 + anim) << 4)
    RETURN
  FI
  i = Idx(x, y)
  c = lv(i)
  IF c & F_SEEN == 0 THEN
    Blank(col, row)
    RETURN
  FI
  IF c & F_VIS THEN
    m = mat(i)
    IF m THEN
      Pic(col, row, (3 + mtype(m - 1)) << 2, (2 + anim) << 4)
      RETURN
    FI
    a = B_VIEW
  ELSE
    a = B_DIM
  FI
  m = oat(i)
  IF m THEN
    t = ot(m - 1)
    Pic(col, row, (o_pic(t) + ap(t)) << 2, 16 | a)
    RETURN
  FI
  k = c & 31
  IF k == K_WALL THEN
    m = (WallLike(x, y - 1) << 3) | (WallLike(x, y + 1) << 2) | (WallLike(x - 1, y) << 1) | WallLike(x + 1, y)
    t = T_WALL + (m << 2)
  ELSEIF k == K_FLOOR THEN
    t = T_FLOOR
  ELSEIF k == K_CORR THEN
    t = T_CORR
  ELSEIF k == K_DOORWAY THEN
    t = T_DOORWAY
  ELSEIF k == K_UP THEN
    t = T_UP
  ELSEIF k == K_DOWN THEN
    t = T_DOWN
  ELSEIF Kind(x - 1, y) == K_WALL OR Kind(x + 1, y) == K_WALL THEN
    t = T_DOOR_CLOSED_H
    IF k == K_DOORO THEN t = T_DOOR_OPEN_H FI
  ELSE
    t = T_DOOR_CLOSED_V
    IF k == K_DOORO THEN t = T_DOOR_OPEN_V FI
  FI
  Pic(col, row, t, a)
RETURN

PROC DrawView()
  BYTE x, y
  FOR y = vy TO vy + VH - 1 DO
    FOR x = vx TO vx + VW - 1 DO DrawCell(x, y) OD
  OD
RETURN

; the window moved to keep the hero four cells from its sides and three
; from its top and bottom; 1 when it moved
FUNC BYTE Aim()
  INT nx, ny, v
  nx = vx
  ny = vy
  v = px
  IF v < nx + 4 OR v >= nx + VW - 4 THEN
    nx = v - 10
    IF nx < 0 THEN nx = 0 FI
    IF nx > LW - VW THEN nx = LW - VW FI
  FI
  v = py
  IF v < ny + 3 OR v >= ny + VH - 3 THEN
    ny = v - 6
    IF ny < 0 THEN ny = 0 FI
    IF ny > LH - VH THEN ny = LH - VH FI
  FI
  IF nx == vx AND ny == vy THEN RETURN (0) FI
  vx = nx
  vy = ny
RETURN (1)

FUNC BYTE RoomAt(BYTE x, BYTE y)
  BYTE r
  FOR r = 0 TO 8 DO
    IF rgone(r) == 0 AND x >= rx1(r) AND x <= rx2(r) AND y >= ry1(r) AND y <= ry2(r) THEN RETURN (r) FI
  OD
RETURN (255)

PROC Show(CARD i)
  IF lv(i) & F_VIS THEN RETURN FI
  lv(i) = lv(i) | F_VIS | F_SEEN
  IF nvis < 160 THEN
    vis(nvis) = i
    nvis += 1
  FI
RETURN

CARD ARRAY was(160)

; what the hero sees: the whole of a lit room from inside it or its door,
; and anywhere the eight cells round. Whatever left the view is drawn
; again dimmed, whatever came into it drawn bright
PROC See()
  BYTE r, x, y, n, k, dx, dy
  CARD i
  n = nvis
  k = 0
  WHILE k < n DO                     ; a FOR to n - 1 runs 256 times when n is 0
    i = vis(k)
    was(k) = i
    lv(i) = lv(i) & 127
    k += 1
  OD
  nvis = 0
  r = RoomAt(px, py)
  IF r <> 255 THEN
    IF lv(Idx(rx1(r) + 1, ry1(r) + 1)) & F_LIT THEN
      FOR y = ry1(r) TO ry2(r) DO
        FOR x = rx1(r) TO rx2(r) DO Show(Idx(x, y)) OD
      OD
    FI
  FI
  FOR dy = 0 TO 2 DO
    y = py + dy - 1
    IF y < LH THEN
      FOR dx = 0 TO 2 DO
        x = px + dx - 1
        IF x < LW THEN
          IF Kind(x, y) <> K_ROCK THEN Show(Idx(x, y)) FI
        FI
      OD
    FI
  OD
  k = 0
  WHILE k < n DO
    i = was(k)
    IF lv(i) & F_VIS == 0 THEN DrawCell(i % LW, i / LW) FI
    k += 1
  OD
  k = 0
  WHILE k < nvis DO
    i = vis(k)
    DrawCell(i % LW, i / LW)
    k += 1
  OD
RETURN

; the creatures' other frame: the hero and every monster in view
PROC Animate()
  BYTE i
  anim = anim ^ 1
  DrawCell(px, py)
  FOR i = 0 TO MAXMON - 1 DO
    IF mstat(i) THEN
      IF lv(Idx(mx(i), my(i))) & F_VIS THEN DrawCell(mx(i), my(i)) FI
    FI
  OD
RETURN

; ---------------------------------------------------------------- status
PROC RoleName(BYTE col, BYTE row, BYTE r, BYTE bank)
  IF r == 0 THEN
    Text(col, row, "Valkyrie", bank)
  ELSEIF r == 1 THEN
    Text(col, row, "Wizard  ", bank)
  ELSE
    Text(col, row, "Rogue   ", bank)
  FI
RETURN

; the line built in mb printed at a column in one ink; the column after it
FUNC BYTE Put(BYTE col, BYTE row, BYTE bank)
  BYTE i
  CARD a
  a = row
  VRAM_ADDR = (a << 7) + (col << 1)
  VRAM_STEP = 1
  FOR i = 1 TO mbl DO
    VRAM_DATA = mb(i - 1) - FONT_FIRST
    VRAM_DATA = bank
  OD
  col += mbl
  mbl = 0
RETURN (col)

; NetHack's two status lines: who, where, experience and time; hit
; points -- in yellow below half and red below a third -- power and
; armour class
PROC Status()
  BYTE bank, c, save
  INT a
  save = mbl
  ClearRow(28)
  ClearRow(29)
  RoleName(0, 28, role, B_WHITE)
  mbl = 0
  MsgS("Dlvl:")
  MsgN(depth)
  MsgS("  Xp:")
  MsgN(ulev)
  MsgC('/')
  MsgN(uxp)
  MsgS("  T:")
  MsgN(turns)
  c = Put(10, 28, B_WHITE)
  bank = B_GREEN
  IF uhp < uhpmax / 2 THEN bank = B_YELLOW FI
  IF uhp < uhpmax / 3 OR uhp < 6 THEN bank = B_RED FI
  MsgS("HP:")
  c = Put(0, 29, B_GREY)
  MsgN(uhp)
  c = Put(c, 29, bank)
  MsgC('(')
  MsgN(uhpmax)
  MsgS(")  Pw:")
  MsgN(upw)
  MsgC('(')
  MsgN(upwmax)
  MsgS(")  AC:")
  a = uac
  IF a < 0 THEN
    MsgC('-')
    a = -a
  FI
  MsgN(a)
  MsgS("  $:")
  MsgN(ugold)
  c = Put(c, 29, B_WHITE)
  mbl = save
RETURN

; ------------------------------------------------------- the reckoning
FUNC CARD NeedXP(BYTE l)
  CARD v
  IF l < 10 THEN
    v = 10
    RETURN (v << l)
  FI
  v = 10000
RETURN (v << (l - 10))

; NetHack's hit points for a level: a d8 for the role and a d2 for being
; human, and the Valkyrie's constitution one more; the Wizard's power
; grows faster than the others'
PROC LevelUp()
  BYTE g
  ulev += 1
  g = Roll(8) + Roll(2)
  IF role == 0 THEN g += 1 FI
  IF uhpmax > 250 - g THEN g = 0 FI  ; a byte of hit points: room for twelve levels, not for more
  uhpmax += g
  uhp += g
  IF role == 1 THEN g = Roll(3) + 1 ELSE g = Roll(2) FI
  upwmax += g
  upw += g
  mbl = 0
  MsgS("Welcome to experience level ")
  MsgN(ulev)
  MsgC('.')
  MsgEnd()
RETURN

PROC GainXP(CARD x)
  uxp += x
  WHILE ulev < 12 AND uxp >= NeedXP(ulev) DO LevelUp() OD
RETURN

PROC LoseLevel()
  BYTE g
  IF ulev <= 1 THEN RETURN FI
  mbl = 0
  MsgS("Goodbye level ")
  MsgN(ulev)
  MsgC('.')
  MsgEnd()
  ulev -= 1
  uxp = NeedXP(ulev - 1)
  IF ulev == 1 THEN uxp = 0 FI
  g = Roll(8)
  IF uhpmax > g + 1 THEN uhpmax -= g FI
  IF uhp > uhpmax THEN uhp = uhpmax FI
RETURN

PROC MonTeleport(BYTE i)
  BYTE r, x, y
  CARD s
  r = Rnd(9)
  IF rgone(r) THEN RETURN FI
  s = RoomSpot(r)
  IF s == $FFFF THEN RETURN FI
  x = mx(i)
  y = my(i)
  Unplace(i)
  mx(i) = s >> 8
  my(i) = s
  Place(i)
  DrawCell(x, y)
  DrawCell(mx(i), my(i))
RETURN

; the hero hurt by a monster of type t; the amulet of life saving takes
; the death, as NetHack's does, and crumbles
PROC HurtHero(BYTE d, BYTE t)
  IF d < uhp THEN
    uhp -= d
    RETURN
  FI
  IF uamul <> 255 THEN
    IF it(uamul) == O_LIFESAVING THEN
      Msg("But wait... Your medallion begins to glow!")
      Msg("You feel much better!")
      Msg("The medallion crumbles to dust!")
      known(O_LIFESAVING) = 1
      InvDel(uamul, 1)
      uhp = uhpmax
      RETURN
    FI
  FI
  uhp = 0
  dead = 1
  killer = t
RETURN

; the hero hurt by its own doing, which does not kill
PROC HurtSelf(BYTE d)
  IF d >= uhp THEN uhp = 1 ELSE uhp -= d FI
RETURN

; "The jackal", "the jackal", or "It" and "it" for one out of sight
PROC MsgMon(BYTE i, BYTE cap)
  IF lv(Idx(mx(i), my(i))) & F_VIS THEN
    IF cap THEN MsgS("The ") ELSE MsgS("the ") FI
    MsgS(MonName(mtype(i)))
  ELSEIF cap THEN
    MsgS("It")
  ELSE
    MsgS("it")
  FI
RETURN

PROC Remove(BYTE i)
  Unplace(i)
  mstat(i) = 0
  DrawCell(mx(i), my(i))
RETURN

; a monster's kill makes its pet grow as NetHack's grow_up() does: its
; hit points by up to the victim's level and one, a level whenever they
; pass eight a level, and a kitten or a little dog a new form at level
; four, a housecat or a dog at six
PROC PetGrow(BYTE p, BYTE vl)
  BYTE g, t
  g = Roll(vl + 1)
  IF mhpmax(p) < 250 THEN
    mhpmax(p) += g
    mhp(p) += g
  FI
  IF mhpmax(p) >= (mlev(p) + 1) * 8 AND mlev(p) < 12 THEN mlev(p) += 1 FI
  t = mtype(p)
  IF ((t == M_KITTEN OR t == M_LITTLEDOG) AND mlev(p) >= 4) OR ((t == M_HOUSECAT OR t == M_DOG) AND mlev(p) >= 6) THEN
    mbl = 0
    MsgS("Your ")
    MsgS(MonName(t))
    MsgS(" grows up into a ")
    mtype(p) = t + 1
    MsgS(MonName(t + 1))
    MsgC('.')
    MsgEnd()
    DrawCell(mx(p), my(p))
  FI
RETURN

; damage dealt to a monster by the hero; 1 if it died of it
FUNC BYTE HurtMon(BYTE i, BYTE d)
  BYTE t
  msl(i) = 0
  IF d < mhp(i) THEN
    mhp(i) -= d
    RETURN (0)
  FI
  t = mtype(i)
  mbl = 0
  MsgS("You kill ")
  MsgMon(i, 0)
  MsgC('!')
  MsgEnd()
  Remove(i)
  IF Rnd(6) == 0 THEN
    MkObj(mx(i), my(i))
    DrawCell(mx(i), my(i))
  FI
  GainXP(m_xp(t))
RETURN (1)

; what a monster does back when it is struck: the floating eye's gaze, the
; acid blob's acid, the yellow mold's sting
PROC Passive(BYTE i)
  BYTE t, fx, n, s
  CARD o
  t = mtype(i)
  o = t
  o = o * 9
  IF m_att(o) >> 4 <> A_PASV THEN RETURN FI
  fx = m_att(o) & 15
  s = m_att(o + 2)
  IF fx == E_PLYS THEN
    IF Wearing(O_RFREEACTION) THEN
      Msg("You momentarily stiffen.")
    ELSEIF upara == 0 THEN
      Msg("You are frozen by its gaze!")
      upara = Dice(mlev(i) + 1, 10)
    FI
  ELSEIF fx == E_ACID THEN
    IF Rnd(2) == 0 THEN
      Msg("You are splashed by acid!")
      HurtHero(Dice(mlev(i) + 1, s), t)
    FI
  ELSEIF fx == E_STUN THEN
    Msg("You are stung!")
    HurtHero(Dice(mlev(i) + 1, s), t)
  FI
RETURN

; the hero strikes: NetHack's find_roll_to_hit(), then the weapon's die,
; its enchantment and strength's bonus
PROC HeroAttack(BYTE i)
  INT tmp, en, d
  BYTE t, sides
  t = mtype(i)
  sides = 2                          ; bare hands
  en = 0
  IF uwep <> 255 THEN
    sides = o_arg(it(uwep))
    en = Signed(ie(uwep))
  FI
  tmp = m_ac(t)
  tmp = tmp - 10 + 1 + r_abon(role) + ulev + en
  IF msl(i) THEN tmp += 2 FI         ; a sleeping monster is easier to hit
  mbl = 0
  IF tmp > Roll(20) THEN
    d = Roll(sides) + en + r_dbon(role) + RingEnch(O_RDAMAGE)
    IF d < 1 THEN d = 1 FI
    MsgS("You hit ")
    MsgMon(i, 0)
    MsgC('.')
    MsgEnd()
    IF HurtMon(i, d) == 0 THEN Passive(i) FI
  ELSE
    MsgS("You miss ")
    MsgMon(i, 0)
    MsgC('.')
    MsgEnd()
  FI
RETURN

PROC Verb(BYTE kind)
  IF kind == A_BITE THEN
    MsgS(" bites!")
  ELSEIF kind == A_STNG THEN
    MsgS(" stings!")
  ELSEIF kind == A_TUCH THEN
    MsgS(" touches you!")
  ELSEIF kind == A_BUTT THEN
    MsgS(" butts!")
  ELSEIF kind == A_HUGS THEN
    MsgS(" squeezes you!")
  ELSEIF kind == A_KICK THEN
    MsgS(" kicks!")
  ELSE
    MsgS(" hits!")
  FI
RETURN

; a monster strikes the hero: NetHack's mattacku(), each attack in turn
PROC MonAttack(BYTE i)
  BYTE t, a, kind, fx, n, s, d
  INT tmp
  CARD o
  t = mtype(i)
  FOR a = 0 TO 2 DO
    o = t
    o = o * 9 + a * 3
    kind = m_att(o) >> 4
    IF kind <> 0 AND kind <> A_PASV AND dead == 0 THEN
      fx = m_att(o) & 15
      n = m_att(o + 1)
      s = m_att(o + 2)
      tmp = uac + 10 + mlev(i)
      mbl = 0
      MsgMon(i, 1)
      IF tmp > Roll(20 + a) THEN
        Verb(kind)
        MsgEnd()
        d = Dice(n, s)
        IF fx == E_POIS AND Rnd(8) == 0 THEN
          IF Wearing(O_RPOISONRES) THEN
            Msg("The poison doesn't seem to affect you.")
          ELSE
            Msg("It was poisoned!")
            d += Roll(6)
          FI
        ELSEIF fx == E_SLEE AND Rnd(3) == 0 AND upara == 0 AND Wearing(O_RFREEACTION) == 0 THEN
          Msg("You are put to sleep!")
          upara = Roll(10)
        ELSEIF fx == E_DRLI AND Rnd(3) == 0 THEN
          LoseLevel()
        ELSEIF fx == E_SGLD AND ugold > 0 THEN
          ugold = ugold / 2
          Msg("Your purse feels lighter.")
          MonTeleport(i)
          HurtHero(d, t)
          RETURN
        FI
        HurtHero(d, t)
      ELSE
        MsgS(" misses!")
        MsgEnd()
      FI
    FI
  OD
RETURN

; one monster strikes another -- the pet and what it fights: NetHack's
; mattackm(), the defender's armour class and the attacker's level
; against a twenty-sided die
PROC MonHitsMon(BYTE ag, BYTE df)
  BYTE a, kind, n, s, d, t, seen
  INT tmp
  CARD o
  t = mtype(ag)
  seen = lv(Idx(mx(ag), my(ag))) & F_VIS
  IF mstat(ag) & S_PET == 0 THEN mstat(ag) = mstat(ag) | S_ANGRY FI
  IF mstat(df) & S_PET == 0 THEN mstat(df) = mstat(df) | S_ANGRY FI
  FOR a = 0 TO 2 DO
    o = t
    o = o * 9 + a * 3
    kind = m_att(o) >> 4
    IF kind <> 0 AND kind <> A_PASV AND mstat(df) AND mstat(ag) THEN
      tmp = m_ac(mtype(df))
      tmp = tmp - 10 + mlev(ag)
      n = m_att(o + 1)
      s = m_att(o + 2)
      mbl = 0
      IF tmp > Roll(20 + a) THEN
        d = Dice(n, s)
        IF seen THEN
          MsgMon(ag, 1)
          MsgS(" hits ")
          MsgMon(df, 0)
          MsgC('.')
          MsgEnd()
        FI
        msl(df) = 0
        IF d >= mhp(df) THEN
          IF seen THEN
            MsgMon(df, 1)
            MsgS(" is killed!")
            MsgEnd()
          FI
          Remove(df)
          IF Rnd(6) == 0 THEN
            MkObj(mx(df), my(df))
            DrawCell(mx(df), my(df))
          FI
          IF mstat(ag) & S_PET THEN PetGrow(ag, mlev(df)) FI
        ELSE
          mhp(df) -= d
        FI
      ELSEIF seen THEN
        MsgMon(ag, 1)
        MsgS(" misses ")
        MsgMon(df, 0)
        MsgC('.')
        MsgEnd()
      FI
    FI
  OD
RETURN

; ------------------------------------------------------- monsters moving
FUNC BYTE Dist(BYTE ax, BYTE ay, BYTE bx, BYTE by)
  BYTE dx, dy
  IF ax > bx THEN dx = ax - bx ELSE dx = bx - ax FI
  IF ay > by THEN dy = ay - by ELSE dy = by - ay FI
  IF dx > dy THEN RETURN (dx) FI
RETURN (dy)

; a monster's step towards (tx, ty): of the eight cells, the free one
; nearest, if it is nearer than where it stands; a shut door opened by a
; monster with hands, which is its move
PROC StepToward(BYTE i, BYTE tx, BYTE ty)
  BYTE d, k, nx, ny, best, bx, by, kind, x, y
  INT dx, dy, bd, dd
  x = mx(i)
  y = my(i)
  dx = x
  dx = dx - tx
  dy = y
  dy = dy - ty
  bd = dx * dx + dy * dy
  best = 0
  k = Rnd(8)
  FOR d = 1 TO 8 DO
    k = (k % 8) + 1
    nx = x + dir_dx(k)
    ny = y + dir_dy(k)
    IF nx < LW AND ny < LH THEN
      kind = Kind(nx, ny)
      IF (Open(kind) OR kind == K_DOORC) AND MonAt(nx, ny) == 0 AND (nx <> px OR ny <> py) AND Diagonal(x, y, nx, ny) THEN
        dx = nx
        dx = dx - tx
        dy = ny
        dy = dy - ty
        dd = dx * dx + dy * dy
        IF dd < bd THEN
          bd = dd
          best = k
          bx = nx
          by = ny
        FI
      FI
    FI
  OD
  IF best == 0 THEN RETURN FI
  IF Kind(bx, by) == K_DOORC THEN
    IF m_flag(mtype(i)) & MF_NOHANDS THEN RETURN FI
    SetKind(bx, by, K_DOORO)
    DrawCell(bx, by)
    RETURN
  FI
  Unplace(i)
  mx(i) = bx
  my(i) = by
  Place(i)
  DrawCell(x, y)
  DrawCell(bx, by)
RETURN

; the pet: at a hostile beside it that it is not afraid of -- nothing two
; levels above it -- else back to the hero, and about the hero when near
PROC PetAct(BYTE i)
  BYTE j
  FOR j = 0 TO MAXMON - 1 DO
    IF mstat(j) AND j <> i THEN
      IF Dist(mx(i), my(i), mx(j), my(j)) == 1 AND mlev(j) < mlev(i) + 2 THEN
        IF m_flag(mtype(j)) & MF_PEACE == 0 AND Diagonal(mx(i), my(i), mx(j), my(j)) THEN
          MonHitsMon(i, j)
          RETURN
        FI
      FI
    FI
  OD
  IF Dist(mx(i), my(i), px, py) > 2 OR Rnd(3) == 0 THEN
    IF Dist(mx(i), my(i), px, py) <= 2 THEN
      StepToward(i, mx(i) + Rnd(3) - 1, my(i) + Rnd(3) - 1)
    ELSE
      StepToward(i, px, py)
    FI
  FI
RETURN

; a hostile: at the hero if beside it, at the pet if the pet has bitten
; it, towards the hero if it sees it -- anything the hero sees, sees the
; hero -- and otherwise wandering
PROC MonAct(BYTE i)
  BYTE t, p
  IF msl(i) THEN
    msl(i) -= 1
    RETURN
  FI
  t = mtype(i)
  IF mstat(i) & S_PET THEN
    PetAct(i)
    RETURN
  FI
  IF m_spd(t) == 0 OR m_flag(t) & MF_PEACE THEN RETURN FI
  IF Dist(mx(i), my(i), px, py) == 1 AND Diagonal(mx(i), my(i), px, py) THEN
    MonAttack(i)
    RETURN
  FI
  IF mstat(i) & S_ANGRY THEN
    p = FindPet()
    IF p <> 255 THEN
      IF Dist(mx(i), my(i), mx(p), my(p)) == 1 AND Diagonal(mx(i), my(i), mx(p), my(p)) THEN
        MonHitsMon(i, p)
        RETURN
      FI
    FI
  FI
  IF lv(Idx(mx(i), my(i))) & F_VIS THEN
    StepToward(i, px, py)
  ELSEIF Rnd(2) == 0 THEN
    StepToward(i, mx(i) + Rnd(5) - 2, my(i) + Rnd(5) - 2)
  FI
RETURN

; the rest of the turn: every monster's speed added to its movement, and a
; move for every twelve -- the hero's speed -- it has; the regenerating
; ones mend; now and then a new one arrives
PROC MonTurns()
  BYTE i, t
  FOR i = 0 TO MAXMON - 1 DO
    IF mstat(i) AND dead == 0 THEN
      t = mtype(i)
      IF m_flag(t) & MF_REGEN AND mhp(i) < mhpmax(i) THEN mhp(i) += 1 FI
      mmove(i) += m_spd(t)
      WHILE mmove(i) >= 12 AND mstat(i) AND dead == 0 DO
        mmove(i) -= 12
        MonAct(i)
      OD
    FI
  OD
  IF Rnd(70) == 0 THEN SpawnSomewhere() FI
RETURN

; NetHack's slow mending below level ten: a hit point every so many turns,
; fewer as the hero rises; power by its own clock, the Wizard's quicker
PROC Mend()
  BYTE n
  IF uhp < uhpmax THEN
    n = 3
    IF ulev < 10 THEN n = 42 / (ulev + 2) + 1 FI
    IF turns % n == 0 THEN uhp += 1 FI
  FI
  IF upw < upwmax THEN
    n = (38 - ulev) * 4 / 6
    IF role == 1 THEN n = (38 - ulev) * 3 / 6 FI
    IF turns % n == 0 THEN upw += 1 FI
  FI
  IF Wearing(O_RREGEN) AND uhp < uhpmax THEN uhp += 1 FI
  IF Wearing(O_RTELEPORT) AND Rnd(85) == 0 THEN wantport = 1 FI
RETURN

; a turn has passed: the hero mends, the monsters move, and while the
; hero is frozen they go on moving
PROC EndTurn()
  BYTE f
  turns += 1
  Mend()
  MonTurns()
  Status()
  WHILE upara AND dead == 0 DO
    upara -= 1
    turns += 1
    MonTurns()
    Status()
    FOR f = 1 TO 6 DO Tick() OD
    IF upara == 0 THEN Msg("You can move again.") FI
  OD
RETURN

; ------------------------------------------------------------ the dungeon
BYTE ARRAY carry(4)                  ; the pet on the stairs: type, hit points, most, level

PROC EnterLevel(BYTE down)
  BYTE t, r, i, d
  CARD s
  t = ThemeOf(depth)
  IF t <> theme THEN
    FOR r = VTOP TO VTOP + 25 DO ClearRow(r) OD
    IF LoadTheme(t) == 0 THEN
      Msg("The theme file is not on drive 9.")
      RETURN
    FI
  FI
  IF made(depth) THEN
    LoadLevel()
  ELSE
    MakeLevel()
    made(depth) = 1
  FI
  nvis = 0
  IF down == 1 THEN
    px = upx
    py = upy
  ELSEIF down == 0 THEN
    px = dnx
    py = dny
  ELSE
    DO
      r = Rnd(9)
    UNTIL rgone(r) == 0 OD
    px = upx
    py = upy
    s = RoomSpot(r)
    IF s <> $FFFF THEN
      px = s >> 8
      py = s
    FI
  FI
  i = MonAt(px, py)                  ; something on the stairs moves aside
  IF i THEN
    d = FreeNear(px, py)
    Unplace(i - 1)
    IF d THEN
      mx(i - 1) = px + dir_dx(d)
      my(i - 1) = py + dir_dy(d)
      Place(i - 1)
    ELSE
      mstat(i - 1) = 0
    FI
  FI
  IF carry(0) <> 255 THEN
    d = FreeNear(px, py)
    IF d THEN
      i = NewMon(carry(0), px + dir_dx(d), py + dir_dy(d))
      IF i <> 255 THEN
        mhp(i) = carry(1)
        mhpmax(i) = carry(2)
        mlev(i) = carry(3)
        mstat(i) = S_LIVE | S_PET
      FI
    FI
    carry(0) = 255
  FI
  vx = 255
  t = Aim()
  See()
  DrawView()
  Status()
RETURN

; the pet comes along if it is beside the hero, as in NetHack
PROC TakePet()
  BYTE p
  carry(0) = 255
  p = FindPet()
  IF p == 255 THEN RETURN FI
  IF Dist(mx(p), my(p), px, py) > 1 THEN RETURN FI
  carry(0) = mtype(p)
  carry(1) = mhp(p)
  carry(2) = mhpmax(p)
  carry(3) = mlev(p)
  Unplace(p)
  mstat(p) = 0
RETURN

PROC Descend()
  IF Kind(px, py) <> K_DOWN THEN
    Msg("You can't go down here.")
    RETURN
  FI
  TakePet()
  SaveLevel()
  depth += 1
  EnterLevel(1)
RETURN

PROC Ascend()
  IF Kind(px, py) <> K_UP THEN
    Msg("You can't go up here.")
    RETURN
  FI
  IF depth == 1 THEN
    Msg("The way out. You have no Amulet yet.")
    RETURN
  FI
  TakePet()
  SaveLevel()
  depth -= 1
  EnterLevel(0)
RETURN

; ------------------------------------------------------- names of things
FUNC BYTE POINTER ObjName(BYTE t)
RETURN (NameRec(NAME_OBJ + t))

PROC Know(BYTE t)
  known(t) = 1
RETURN

; words put in front of what mb holds from `at`
PROC MsgIns(BYTE at, BYTE POINTER s)
  BYTE n, i
  BYTE POINTER q
  n = *s
  IF mbl + n > 80 THEN RETURN FI
  i = mbl
  WHILE i > at DO
    i -= 1
    mb(i + n) = mb(i)
  OD
  q = s + 1
  FOR i = 1 TO n DO
    mb(at + i - 1) = *q
    q += 1
  OD
  mbl += n
RETURN

; a thing's name as NetHack's doname() gives it, onto mb: the count, or
; "a" or "an"; its blessing and enchantment if they are known; and the
; name of its kind if that is known, else its appearance this game
PROC Name(BYTE t, BYTE q, BYTE f, BYTE e, BYTE art)
  BYTE at, c, ch
  INT en
  at = mbl
  c = o_class(t)
  IF c == C_GOLD THEN
    MsgN(q)
    MsgS(" gold piece")
    IF q <> 1 THEN MsgC('s') FI
    RETURN
  FI
  IF q > 1 THEN
    MsgN(q)
    MsgC(' ')
  FI
  IF f & OF_BKNOWN THEN               ; NetHack's implicit_uncursed: not said of a kind that is known
    IF f & OF_BLESS THEN
      MsgS("blessed ")
    ELSEIF f & OF_CURSE THEN
      MsgS("cursed ")
    ELSEIF known(t) == 0 THEN
      MsgS("uncursed ")
    FI
  FI
  IF f & OF_EKNOWN AND (c == C_WEAPON OR c == C_ARMOR OR t == O_RPROTECTION OR t == O_RDAMAGE) THEN
    en = Signed(e)
    IF en < 0 THEN
      MsgC('-')
      en = -en
    ELSE
      MsgC('+')
    FI
    MsgN(en)
    MsgC(' ')
  FI
  IF c == C_WEAPON OR c == C_ARMOR THEN
    MsgS(ObjName(t))
    IF q > 1 THEN MsgC('s') FI
  ELSEIF c == C_POTION THEN
    IF known(t) THEN
      MsgS("potion")
      IF q > 1 THEN MsgC('s') FI
      MsgS(" of ")
      IF t == O_WATER AND f & OF_BKNOWN THEN
        IF f & OF_BLESS THEN
          MsgS("holy ")
        ELSEIF f & OF_CURSE THEN
          MsgS("unholy ")
        FI
      FI
      MsgS(ObjName(t))
    ELSE
      MsgS(NameRec(NAME_POTION + ap(t)))
      MsgS(" potion")
      IF q > 1 THEN MsgC('s') FI
    FI
  ELSEIF c == C_SCROLL THEN
    MsgS("scroll")
    IF q > 1 THEN MsgC('s') FI
    IF known(t) THEN
      MsgS(" of ")
      MsgS(ObjName(t))
    ELSE
      MsgS(" labeled ")
      MsgS(NameRec(NAME_SCROLL + ap(t)))
    FI
  ELSEIF c == C_WAND THEN
    IF known(t) THEN
      MsgS("wand of ")
      MsgS(ObjName(t))
    ELSE
      MsgS(NameRec(NAME_WAND + ap(t)))
      MsgS(" wand")
    FI
    IF f & OF_EKNOWN THEN
      MsgS(" (0:")
      MsgN(e)
      MsgC(')')
    FI
  ELSEIF c == C_RING THEN
    IF known(t) THEN
      MsgS("ring of ")
      MsgS(ObjName(t))
    ELSE
      MsgS(NameRec(NAME_RING + ap(t)))
      MsgS(" ring")
    FI
  ELSEIF t == O_LIFESAVING THEN
    IF known(t) THEN MsgS("amulet of life saving") ELSE MsgS("spherical amulet") FI
  ELSE
    IF t == O_FAKEYENDOR AND known(t) THEN
      MsgS("plastic imitation Amulet")
    ELSE
      MsgS("Amulet of Yendor")
    FI
    IF art AND q == 1 THEN MsgIns(at, "the ") FI
    RETURN
  FI
  IF art AND q == 1 THEN
    ch = mb(at)
    IF ch == 'a' OR ch == 'e' OR ch == 'i' OR ch == 'o' OR ch == 'u' THEN
      MsgIns(at, "an ")
    ELSE
      MsgIns(at, "a ")
    FI
  FI
RETURN

FUNC BYTE IsWorn(BYTE k)
  BYTE s
  IF uleft == k OR uright == k OR uamul == k THEN RETURN (1) FI
  FOR s = 1 TO 6 DO
    IF worn(s) == k THEN RETURN (1) FI
  OD
RETURN (0)

; a pack letter's name, and what is being done with it
PROC InvName(BYTE k)
  Name(it(k), iq(k), ifl(k), ie(k), 1)
  IF uwep == k THEN MsgS(" (wielded)") FI
  IF uleft == k THEN
    MsgS(" (left hand)")
  ELSEIF uright == k THEN
    MsgS(" (right hand)")
  ELSEIF IsWorn(k) THEN
    MsgS(" (worn)")
  FI
RETURN

; the hero set down somewhere on the level, at random
PROC Teleport()
  BYTE r
  CARD s
  DO
    r = Rnd(9)
  UNTIL rgone(r) == 0 OD
  s = RoomSpot(r)
  IF s == $FFFF THEN RETURN FI
  px = s >> 8
  py = s
  vx = 255
  r = Aim()
  See()
  DrawView()
RETURN

; what is here: gold is taken up as it is walked over, as NetHack's
; autopickup does, and the rest is said
PROC LookHere()
  BYTE i, n, k
  CARD c
  c = Idx(px, py)
  i = oat(c)
  WHILE i DO
    IF ot(i - 1) <> O_GOLD THEN EXIT FI
    ugold += oq(i - 1)
    mbl = 0
    MsgN(oq(i - 1))
    MsgS(" gold pieces.")
    MsgEnd()
    TakeObj(i - 1)
    i = oat(c)
  OD
  n = 0
  FOR k = 0 TO MAXOBJ - 1 DO
    IF ot(k) <> 255 AND ox(k) == px AND oy(k) == py THEN n += 1 FI
  OD
  IF n == 1 THEN
    k = oat(c) - 1
    mbl = 0
    MsgS("You see here ")
    Name(ot(k), oq(k), of(k), oe(k), 1)
    MsgC('.')
    MsgEnd()
  ELSEIF n > 1 THEN
    Msg("There are several objects here.")
  FI
RETURN

; a step: into a monster is an attack, into the pet a change of places,
; into a shut door opens it; a door is never passed diagonally
PROC Stride(BYTE d)
  BYTE nx, ny, k, ox, oy, m, swap
  swap = 0
  nx = px + dir_dx(d)
  ny = py + dir_dy(d)
  IF nx >= LW OR ny >= LH THEN RETURN FI
  k = Kind(nx, ny)
  IF Diagonal(px, py, nx, ny) == 0 THEN
    Msg("You can't move diagonally through a door.")
    RETURN
  FI
  m = MonAt(nx, ny)
  IF m THEN
    m -= 1
    IF mstat(m) & S_PET == 0 THEN
      HeroAttack(m)
      EndTurn()
      RETURN
    FI
    swap = 1                         ; not m itself: the pet's slot may be 0
  FI
  IF k == K_DOORC THEN
    SetKind(nx, ny, K_DOORO)
    Msg("The door opens.")
    DrawCell(nx, ny)
    EndTurn()
    RETURN
  FI
  IF Open(k) == 0 THEN RETURN FI
  ox = px
  oy = py
  px = nx
  py = ny
  IF swap THEN
    Unplace(m)
    mx(m) = ox
    my(m) = oy
    Place(m)
    mbl = 0
    MsgS("You swap places with your ")
    MsgS(MonName(mtype(m)))
    MsgC('.')
    MsgEnd()
  FI
  IF Aim() THEN
    See()
    DrawView()
  ELSE
    See()
    DrawCell(ox, oy)
    DrawCell(px, py)
  FI
  LookHere()
  EndTurn()
RETURN

; ------------------------------------------------------------- the keys
FUNC BYTE Held()
  BYTE n, s, e, w
  n = KeyHeld(KEY_UP) OR KeyHeld(KP8) OR KeyHeld(KEY_K)
  s = KeyHeld(KEY_DOWN) OR KeyHeld(KP2) OR KeyHeld(KEY_J)
  w = KeyHeld(KEY_LEFT) OR KeyHeld(KP4) OR KeyHeld(KEY_H)
  e = KeyHeld(KEY_RIGHT) OR KeyHeld(KP6) OR KeyHeld(KEY_L)
  IF KeyHeld(KP9) OR KeyHeld(KEY_U) OR (n AND e) THEN RETURN (2) FI
  IF KeyHeld(KP3) OR KeyHeld(KEY_N) OR (s AND e) THEN RETURN (4) FI
  IF KeyHeld(KP1) OR KeyHeld(KEY_B) OR (s AND w) THEN RETURN (6) FI
  IF KeyHeld(KP7) OR KeyHeld(KEY_Y) OR (n AND w) THEN RETURN (8) FI
  IF n THEN RETURN (1) FI
  IF e THEN RETURN (3) FI
  IF s THEN RETURN (5) FI
  IF w THEN RETURN (7) FI
RETURN (0)

; a press shorter than a frame is still a step: the latches, every one
; asked so none is left standing
FUNC BYTE Tapped()
  BYTE d
  d = 0
  IF KeyHit(KEY_UP) OR KeyHit(KP8) OR KeyHit(KEY_K) THEN d = 1 FI
  IF KeyHit(KEY_RIGHT) OR KeyHit(KP6) OR KeyHit(KEY_L) THEN d = 3 FI
  IF KeyHit(KEY_DOWN) OR KeyHit(KP2) OR KeyHit(KEY_J) THEN d = 5 FI
  IF KeyHit(KEY_LEFT) OR KeyHit(KP4) OR KeyHit(KEY_H) THEN d = 7 FI
  IF KeyHit(KP9) OR KeyHit(KEY_U) THEN d = 2 FI
  IF KeyHit(KP3) OR KeyHit(KEY_N) THEN d = 4 FI
  IF KeyHit(KP1) OR KeyHit(KEY_B) THEN d = 6 FI
  IF KeyHit(KP7) OR KeyHit(KEY_Y) THEN d = 8 FI
RETURN (d)

; the direction to step this frame: at once on a press, again after ten
; frames held and then every third
FUNC BYTE Walk()
  BYTE held, hit
  hit = Tapped()
  held = Held()
  IF held == 0 THEN
    rep_c = 0
    RETURN (hit)
  FI
  IF held <> rep_c THEN
    rep_c = held
    rep_t = 0
    RETURN (held)
  FI
  rep_t += 1
  IF rep_t >= 10 THEN
    rep_t = 7
    RETURN (held)
  FI
RETURN (0)

FUNC BYTE Shifted()
  IF KeyHeld(KEY_LSHIFT) OR KeyHeld(KEY_RSHIFT) THEN RETURN (1) FI
RETURN (0)

; a direction asked for: a movement key, or 0 for Esc
FUNC BYTE AskDir()
  BYTE d
  esc = 0
  rep_c = 255
  DO
    Tick()
    d = Tapped()
    IF KeyHit(KEY_DOT) AND Shifted() THEN d = 9 FI
    IF KeyHit(KEY_COMMA) AND Shifted() THEN d = 10 FI
    IF d THEN
      rep_c = Held()                 ; the key still down is the answer, not a step
      rep_t = 0
      RETURN (d)
    FI
  UNTIL esc OD
  esc = 0
RETURN (0)

; ------------------------------------------------------------- the pack
FUNC BYTE Passes(BYTE k, BYTE mask, BYTE mode)
  IF it(k) == 255 THEN RETURN (0) FI
  IF mask & (1 << o_class(it(k))) == 0 THEN RETURN (0) FI
  IF mode == 1 AND IsWorn(k) THEN RETURN (0) FI
  IF mode == 2 AND IsWorn(k) == 0 THEN RETURN (0) FI
RETURN (1)

PROC ClassName(BYTE c)
  IF c == C_WEAPON THEN
    MsgS("Weapons")
  ELSEIF c == C_ARMOR THEN
    MsgS("Armor")
  ELSEIF c == C_POTION THEN
    MsgS("Potions")
  ELSEIF c == C_SCROLL THEN
    MsgS("Scrolls")
  ELSEIF c == C_WAND THEN
    MsgS("Wands")
  ELSEIF c == C_RING THEN
    MsgS("Rings")
  ELSE
    MsgS("Amulets")
  FI
RETURN

; the pack over the map, a heading a class as NetHack lists it: only the
; classes in `mask`, a bit a class, and with mode 1 only what is not worn
; and with 2 only what is. A letter answers, 255 for none; the map comes
; back after
FUNC BYTE Menu(BYTE POINTER prompt, BYTE mask, BYTE mode)
  BYTE row, c, k, n, any, pick, col
  MsgClear()
  FOR row = VTOP TO VTOP + 25 DO ClearRow(row) OD
  Text(0, 0, prompt, B_YELLOW)
  row = VTOP
  n = 0
  FOR c = 0 TO 6 DO
    any = 0
    FOR k = 0 TO MAXINV - 1 DO
      IF Passes(k, mask, mode) AND row < VTOP + 26 THEN
        IF o_class(it(k)) == c THEN
          IF any == 0 THEN
            mbl = 0
            ClassName(c)
            col = Put(0, row, B_YELLOW)
            row += 1
            any = 1
          FI
          mbl = 0
          MsgC('a' + k)
          MsgS(" - ")
          InvName(k)
          IF mbl > 39 THEN mbl = 39 FI
          col = Put(1, row, B_WHITE)
          row += 1
          n += 1
        FI
      FI
    OD
  OD
  pick = 255
  IF n == 0 THEN
    Text(0, VTOP, "You don't have anything for that.", B_WHITE)
  FI
  FOR k = 0 TO MAXINV - 1 DO
    c = KeyHit(letter_sc(k))
  OD
  c = KeyHit(KEY_SPACE)
  c = KeyHit(KEY_ENTER)
  esc = 0
  DO
    Tick()
    FOR k = 0 TO MAXINV - 1 DO
      IF KeyHit(letter_sc(k)) THEN
        IF Passes(k, mask, mode) THEN pick = k FI
      FI
    OD
  UNTIL pick <> 255 OR esc OR KeyHit(KEY_SPACE) OR KeyHit(KEY_ENTER) OD
  esc = 0
  rep_c = Held()                     ; the letter still down is not a step
  rep_t = 0
  FOR row = VTOP TO VTOP + 25 DO ClearRow(row) OD
  MsgClear()
  DrawView()
RETURN (pick)

FUNC BYTE POINTER ApName(BYTE t)
  BYTE c
  c = o_class(t)
  IF c == C_POTION THEN RETURN (NameRec(NAME_POTION + ap(t))) FI
  IF c == C_SCROLL THEN RETURN (NameRec(NAME_SCROLL + ap(t))) FI
  IF c == C_WAND THEN RETURN (NameRec(NAME_WAND + ap(t))) FI
RETURN (NameRec(NAME_RING + ap(t)))

; NetHack's \: the kinds identified, and what they looked like
PROC Discoveries()
  BYTE t, row, d
  MsgClear()
  FOR row = VTOP TO VTOP + 25 DO ClearRow(row) OD
  Text(0, 0, "Discoveries", B_YELLOW)
  row = VTOP
  FOR t = O_HEALING TO O_RTELEPORT DO
    IF known(t) AND row < VTOP + 26 THEN
      mbl = 0
      Name(t, 1, 0, 0, 0)
      MsgS(" (")
      MsgS(ApName(t))
      MsgC(')')
      d = Put(1, row, B_WHITE)
      row += 1
    FI
  OD
  IF row == VTOP THEN Text(1, VTOP, "You haven't discovered anything yet.", B_WHITE) FI
  d = KeyHit(KEY_SPACE)
  esc = 0
  DO
    Tick()
  UNTIL KeyHit(KEY_SPACE) OR KeyHit(KEY_ENTER) OR esc OD
  esc = 0
  FOR row = VTOP TO VTOP + 25 DO ClearRow(row) OD
  DrawView()
RETURN

; ------------------------------------------------------ using things
; the room the hero is in lit, or darkened; in a corridor, the cells round
PROC LightRoom(BYTE on)
  BYTE r, x, y
  CARD i
  r = RoomAt(px, py)
  IF r == 255 THEN
    FOR y = py - 2 TO py + 2 DO
      FOR x = px - 2 TO px + 2 DO
        IF x < LW AND y < LH THEN
          i = Idx(x, y)
          IF lv(i) & 31 <> K_ROCK THEN lv(i) = lv(i) | F_SEEN FI
        FI
      OD
    OD
  ELSE
    FOR y = ry1(r) + 1 TO ry2(r) - 1 DO
      FOR x = rx1(r) + 1 TO rx2(r) - 1 DO
        i = Idx(x, y)
        IF on THEN lv(i) = lv(i) | F_LIT ELSE lv(i) = lv(i) & (255 ^ F_LIT) FI
      OD
    OD
  FI
  See()
  DrawView()
  IF on THEN Msg("A lit field surrounds you!") ELSE Msg("Darkness surrounds you.") FI
RETURN

PROC PickUp()
  BYTE i, k
  i = oat(Idx(px, py))
  IF i == 0 THEN
    Msg("There is nothing here to pick up.")
    RETURN
  FI
  i -= 1
  IF ot(i) == O_GOLD THEN
    ugold += oq(i)
    mbl = 0
    MsgN(oq(i))
    MsgS(" gold pieces.")
    MsgEnd()
  ELSE
    k = InvAdd(ot(i), oq(i), of(i), oe(i))
    IF k == 255 THEN
      Msg("You have too many things to carry more.")
      RETURN
    FI
    mbl = 0
    MsgC('a' + k)
    MsgS(" - ")
    InvName(k)
    MsgC('.')
    MsgEnd()
  FI
  TakeObj(i)
  EndTurn()
RETURN

PROC Welded(BYTE k)
  ifl(k) = ifl(k) | OF_BKNOWN
  mbl = 0
  MsgS("Your ")
  Name(it(k), 1, 0, 0, 0)
  MsgS(" is welded to your hand!")
  MsgEnd()
RETURN

PROC Drop()
  BYTE k
  k = Menu("What do you want to drop?", $7F, 0)
  IF k == 255 THEN RETURN FI
  IF IsWorn(k) THEN
    Msg("You cannot drop something you are wearing.")
    RETURN
  FI
  IF uwep == k AND ifl(k) & OF_CURSE THEN
    Welded(k)
    RETURN
  FI
  IF PutObj(it(k), iq(k), ifl(k), ie(k), px, py) == 255 THEN
    Msg("There is no room to drop anything here.")
    RETURN
  FI
  mbl = 0
  MsgS("You drop ")
  Name(it(k), iq(k), ifl(k), ie(k), 1)
  MsgC('.')
  MsgEnd()
  InvDel(k, iq(k))
  EndTurn()
RETURN

; a cursed weapon welds itself to the hand, and cannot be put away
PROC Wield()
  BYTE k
  IF uwep <> 255 THEN
    IF ifl(uwep) & OF_CURSE THEN
      Welded(uwep)
      RETURN
    FI
  FI
  k = Menu("What do you want to wield?", 1, 1)
  IF k == 255 THEN RETURN FI
  uwep = k
  mbl = 0
  MsgC('a' + k)
  MsgS(" - ")
  InvName(k)
  MsgC('.')
  MsgEnd()
  IF ifl(k) & OF_CURSE THEN
    ifl(k) = ifl(k) | OF_BKNOWN
    Msg("It welds itself to your hand!")
  FI
  EndTurn()
RETURN

; armour: a slot at a time, the cloak over the body armour, its
; enchantment learnt by wearing it and its curse by trying to take it off
PROC Wear()
  BYTE k, s
  k = Menu("What do you want to wear?", 2, 1)
  IF k == 255 THEN RETURN FI
  s = o_slot(it(k))
  IF worn(s) <> 255 THEN
    Msg("You are already wearing one of those.")
    RETURN
  FI
  IF s == SLOT_BODY AND worn(SLOT_CLOAK) <> 255 THEN
    Msg("You are wearing a cloak over it.")
    RETURN
  FI
  IF uwep == k THEN uwep = 255 FI
  worn(s) = k
  ifl(k) = ifl(k) | OF_EKNOWN
  CalcAC()
  mbl = 0
  MsgS("You are now wearing ")
  Name(it(k), 1, ifl(k), ie(k), 1)
  MsgC('.')
  MsgEnd()
  EndTurn()
RETURN

PROC TakeOff()
  BYTE k, s
  k = Menu("What do you want to take off?", 2, 2)
  IF k == 255 THEN RETURN FI
  s = o_slot(it(k))
  IF s == SLOT_BODY AND worn(SLOT_CLOAK) <> 255 THEN
    Msg("You are wearing a cloak over it.")
    RETURN
  FI
  IF ifl(k) & OF_CURSE THEN
    ifl(k) = ifl(k) | OF_BKNOWN
    Msg("You can't. It is cursed.")
    RETURN
  FI
  worn(s) = 255
  CalcAC()
  mbl = 0
  MsgS("You were wearing ")
  Name(it(k), 1, ifl(k), ie(k), 1)
  MsgC('.')
  MsgEnd()
  EndTurn()
RETURN

; a ring on the left hand if it is free, else the right; an amulet round
; the neck. A ring of protection shows itself in the armour class
PROC PutOn()
  BYTE k, t
  k = Menu("What do you want to put on?", 96, 1)
  IF k == 255 THEN RETURN FI
  t = it(k)
  IF uwep == k THEN uwep = 255 FI
  IF o_class(t) == C_AMULET THEN
    IF uamul <> 255 THEN
      Msg("You are already wearing an amulet.")
      RETURN
    FI
    uamul = k
  ELSEIF uleft == 255 THEN
    uleft = k
  ELSEIF uright == 255 THEN
    uright = k
  ELSE
    Msg("You are already wearing two rings.")
    RETURN
  FI
  IF t == O_RPROTECTION THEN
    Know(t)
    ifl(k) = ifl(k) | OF_EKNOWN
  FI
  CalcAC()
  mbl = 0
  MsgC('a' + k)
  MsgS(" - ")
  InvName(k)
  MsgC('.')
  MsgEnd()
  EndTurn()
RETURN

PROC TakeRing()
  BYTE k
  k = Menu("What do you want to remove?", 96, 2)
  IF k == 255 THEN RETURN FI
  IF ifl(k) & OF_CURSE THEN
    ifl(k) = ifl(k) | OF_BKNOWN
    Msg("It won't come off!")
    RETURN
  FI
  IF uleft == k THEN uleft = 255 FI
  IF uright == k THEN uright = 255 FI
  IF uamul == k THEN uamul = 255 FI
  CalcAC()
  mbl = 0
  MsgS("You were wearing ")
  Name(it(k), 1, ifl(k), ie(k), 1)
  MsgC('.')
  MsgEnd()
  EndTurn()
RETURN

; NetHack's healup(): hit points, and the most raised by `more` if they
; would run over it
PROC Heal(BYTE h, BYTE more)
  CARD v
  v = uhp
  v = v + h
  IF v > uhpmax THEN
    IF uhpmax < 240 THEN uhpmax += more FI
    v = uhpmax
  FI
  uhp = v
RETURN

; blessed 1, cursed -1, else 0
FUNC INT Sign(BYTE f)
  IF f & OF_BLESS THEN RETURN (1) FI
  IF f & OF_CURSE THEN RETURN (-1) FI
RETURN (0)

; a potion, as NetHack's peffects() has it, cut to these eight; one whose
; drinking says what it was becomes known
PROC Quaff()
  BYTE k, t, f, h
  INT s
  k = Menu("What do you want to drink?", 4, 0)
  IF k == 255 THEN RETURN FI
  t = it(k)
  f = ifl(k)
  s = Sign(f)
  InvDel(k, 1)
  IF t == O_HEALING THEN
    Know(t)
    Msg("You feel better.")
    h = 1
    IF s < 0 THEN h = 0 FI
    Heal(Dice(6 + 2 * s, 4), h)
  ELSEIF t == O_EXTRAHEALING THEN
    Know(t)
    Msg("You feel much better.")
    h = 2
    IF s > 0 THEN h = 5 FI
    IF s < 0 THEN h = 0 FI
    Heal(Dice(6 + 2 * s, 8), h)
  ELSEIF t == O_GAINLEVEL THEN
    Know(t)
    IF s < 0 THEN
      IF depth > 1 THEN
        Msg("You rise up, through the ceiling!")
        SaveLevel()
        depth -= 1
        EnterLevel(2)
      ELSE
        Msg("You have an uneasy feeling.")
      FI
    ELSEIF ulev < 12 THEN
      Msg("You feel more experienced.")
      uxp = NeedXP(ulev)
      LevelUp()
    FI
  ELSEIF t == O_GAINENERGY THEN
    Know(t)
    h = Dice(2 + s, 6)
    IF s < 0 THEN
      Msg("You feel lackluster.")
      IF upwmax > h THEN upwmax -= h ELSE upwmax = 0 FI
      IF upw > upwmax THEN upw = upwmax FI
    ELSE
      Msg("Magical energies course through your body.")
      IF upwmax < 240 THEN upwmax += h FI
      upw = upwmax
    FI
  ELSEIF t == O_SLEEPING THEN
    Know(t)
    IF Wearing(O_RFREEACTION) THEN
      Msg("You yawn.")
    ELSE
      Msg("You suddenly fall asleep.")
      upara = Roll(10 - 4 * s)
    FI
  ELSEIF t == O_SICKNESS THEN
    Know(t)
    Msg("Yecch! This stuff tastes like poison.")
    IF Wearing(O_RPOISONRES) THEN
      Msg("(But in fact it was mildly stale fruit juice.)")
    ELSE
      HurtSelf(Roll(10 - 5 * s))
    FI
  ELSEIF t == O_FRUITJUICE THEN
    Msg("This tastes like slime mold juice.")
  ELSE
    Know(t)
    IF s > 0 THEN
      Msg("You feel full of awe.")
    ELSEIF s < 0 THEN
      Msg("This burns!")
      HurtSelf(Roll(6))
    ELSE
      Msg("This tastes like water.")
    FI
  FI
  EndTurn()
RETURN

PROC IdentifyOne(BYTE k)
  known(it(k)) = 1
  ifl(k) = ifl(k) | OF_BKNOWN | OF_EKNOWN
RETURN

; a random piece of armour worn, or 255
FUNC BYTE RandomWorn()
  BYTE s, n
  s = Rnd(6)
  FOR n = 1 TO 6 DO
    s = (s % 6) + 1
    IF worn(s) <> 255 THEN RETURN (worn(s)) FI
  OD
RETURN (255)

; a scroll, as NetHack's seffects() has it, cut to these eight
PROC Read()
  BYTE k, t, f, j, ev
  INT s
  CARD c
  k = Menu("What do you want to read?", 8, 0)
  IF k == 255 THEN RETURN FI
  t = it(k)
  f = ifl(k)
  s = Sign(f)
  InvDel(k, 1)
  IF t == O_IDENTIFY THEN
    Know(t)
    IF s > 0 AND Rnd(5) == 0 THEN
      FOR j = 0 TO MAXINV - 1 DO
        IF it(j) <> 255 THEN IdentifyOne(j) FI
      OD
      Msg("You identify everything you carry.")
    ELSE
      j = Menu("This is an identify scroll. Identify what?", $7F, 0)
      IF j <> 255 THEN
        IdentifyOne(j)
        mbl = 0
        MsgC('a' + j)
        MsgS(" - ")
        InvName(j)
        MsgC('.')
        MsgEnd()
      FI
    FI
  ELSEIF t == O_ENCHANTWEAPON THEN
    IF uwep == 255 THEN
      Msg("Your hands twitch.")
    ELSE
      Know(t)
      ev = 0
      mbl = 0
      MsgS("Your ")
      Name(it(uwep), 1, 0, 0, 0)
      IF s < 0 THEN
        MsgS(" glows black for a moment.")
        ie(uwep) = ie(uwep) - 1
      ELSEIF Signed(ie(uwep)) > 5 AND Rnd(3) THEN
        MsgS(" violently glows blue, then evaporates.")
        ev = 1
      ELSE
        MsgS(" glows blue for a moment.")
        ie(uwep) = ie(uwep) + 1
        IF s > 0 THEN ie(uwep) = ie(uwep) + Rnd(2) FI
        ifl(uwep) = ifl(uwep) & (255 ^ OF_CURSE)
      FI
      MsgEnd()
      IF ev THEN InvDel(uwep, iq(uwep)) FI
    FI
  ELSEIF t == O_ENCHANTARMOR THEN
    j = RandomWorn()
    IF j == 255 THEN
      Msg("Your skin glows then fades.")
    ELSE
      Know(t)
      ev = 0
      mbl = 0
      MsgS("Your ")
      Name(it(j), 1, 0, 0, 0)
      IF s < 0 THEN
        MsgS(" glows black for a moment.")
        ie(j) = ie(j) - 1
      ELSEIF Signed(ie(j)) > 3 AND Rnd(3) THEN
        MsgS(" violently glows silver, then evaporates.")
        ev = 1
      ELSE
        MsgS(" glows silver for a moment.")
        ie(j) = ie(j) + 1
        IF s > 0 THEN ie(j) = ie(j) + Rnd(2) FI
        ifl(j) = ifl(j) & (255 ^ OF_CURSE)
      FI
      MsgEnd()
      IF ev THEN InvDel(j, 1) FI
      CalcAC()
    FI
  ELSEIF t == O_REMOVECURSE THEN
    IF s < 0 THEN
      Msg("You feel like you need some help.")
    ELSE
      Msg("You feel like someone is helping you.")
      FOR j = 0 TO MAXINV - 1 DO
        IF it(j) <> 255 THEN
          IF s > 0 OR IsWorn(j) OR uwep == j THEN ifl(j) = ifl(j) & (255 ^ OF_CURSE) FI
        FI
      OD
    FI
  ELSEIF t == O_TELEPORT THEN
    Know(t)
    IF s < 0 AND depth < MAXDEPTH THEN
      Msg("You feel very disoriented for a moment.")
      TakePet()
      SaveLevel()
      depth += 1
      EnterLevel(2)
    ELSE
      Teleport()
      Msg("You feel disoriented for a moment.")
    FI
  ELSEIF t == O_MAGICMAPPING THEN
    IF s < 0 THEN
      Msg("Unfortunately, you can't grasp the details.")
    ELSE
      Know(t)
      FOR c = 0 TO NCELL - 1 DO
        IF lv(c) & 31 <> K_ROCK THEN lv(c) = lv(c) | F_SEEN FI
      OD
      DrawView()
      Msg("A map coalesces in your mind!")
    FI
  ELSEIF t == O_LIGHT THEN
    Know(t)
    IF s < 0 THEN LightRoom(0) ELSE LightRoom(1) FI
  ELSE
    Know(t)
    Msg("The scroll erupts in a tower of flame!")
    FOR j = 0 TO MAXMON - 1 DO
      IF mstat(j) THEN
        IF mstat(j) & S_PET == 0 AND Dist(mx(j), my(j), px, py) <= 1 THEN
          mbl = 0
          MsgMon(j, 1)
          MsgS(" is burnt!")
          MsgEnd()
          ev = HurtMon(j, Dice(3 + s, 4))
        FI
      FI
    OD
    IF s <= 0 THEN
      Msg("The flames burn you.")
      HurtSelf(Roll(4))
    FI
  FI
  EndTurn()
RETURN

; a wand, as NetHack's zap.c has it for these six: light and create
; monster need no direction; striking hits the first monster along it,
; magic missile and sleep every one in eight cells; digging bores through
; rock and walls, or down through the floor to the level below
PROC Zap()
  BYTE k, t, d, n, x, y, m, kind, r
  k = Menu("What do you want to zap?", 16, 0)
  IF k == 255 THEN RETURN FI
  t = it(k)
  IF ie(k) == 0 THEN
    Msg("Nothing happens.")
    EndTurn()
    RETURN
  FI
  ie(k) = ie(k) - 1
  d = 0
  IF o_slot(t) <> D_NODIR THEN
    Msg("In what direction?")
    d = AskDir()
    IF d == 0 THEN RETURN FI
  FI
  IF t == O_WLIGHT THEN
    Know(t)
    LightRoom(1)
  ELSEIF t == O_WCREATE THEN
    n = FreeNear(px, py)
    IF n THEN
      Know(t)
      Spawn(px + dir_dx(n), py + dir_dy(n))
      See()
    FI
  ELSEIF d > 8 THEN
    IF t <> O_WDIGGING THEN
      Msg("The bugs on the floor stop moving!")
    ELSEIF d == 10 THEN
      Know(t)
      Msg("You loosen a rock from the ceiling. It falls on your head!")
      HurtSelf(Roll(6))
    ELSEIF depth >= MAXDEPTH THEN
      Msg("The floor here is too hard to dig in.")
    ELSE
      Know(t)
      Msg("You dig a hole through the floor. You fall through...")
      TakePet()
      SaveLevel()
      depth += 1
      EnterLevel(2)
    FI
  ELSE
    x = px
    y = py
    FOR n = 1 TO 8 DO
      x += dir_dx(d)
      y += dir_dy(d)
      IF x >= LW OR y >= LH THEN EXIT FI
      IF t == O_WDIGGING THEN
        kind = Kind(x, y)
        IF kind == K_WALL OR kind == K_ROCK THEN
          SetKind(x, y, K_CORR)
        ELSEIF kind == K_DOORC OR kind == K_DOORO THEN
          SetKind(x, y, K_DOORWAY)
        FI
        lv(Idx(x, y)) = lv(Idx(x, y)) | F_SEEN
      ELSE
        IF Open(Kind(x, y)) == 0 THEN EXIT FI
        m = MonAt(x, y)
        IF m THEN
          m -= 1
          Know(t)
          mbl = 0
          IF t == O_WSTRIKING THEN
            MsgS("The wand hits ")
          ELSEIF t == O_WMISSILE THEN
            MsgS("The magic missile hits ")
          ELSE
            MsgS("The sleep ray hits ")
          FI
          MsgMon(m, 0)
          MsgC('.')
          MsgEnd()
          IF t == O_WSLEEP THEN
            msl(m) = Dice(2, 25)
          ELSEIF t == O_WSTRIKING THEN
            r = HurtMon(m, Dice(2, 12))
            EXIT
          ELSE
            r = HurtMon(m, Dice(2, 6))
          FI
        FI
      FI
    OD
    IF t == O_WDIGGING THEN
      Know(t)
      See()
      DrawView()
      Msg("You dig through the rock.")
    FI
  FI
  EndTurn()
RETURN

; a thrown thing's flight: along d for up to eight cells, drawn as it
; goes, into the first monster -- NetHack's to-hit, and a dagger's +2 --
; and down where it stops
PROC Fly(BYTE k, BYTE d)
  BYTE t, f, e, x, y, n, m, lx, ly, sides, r
  INT tmp, dmg
  t = it(k)
  f = ifl(k)
  e = ie(k)
  InvDel(k, 1)
  x = px
  y = py
  lx = px
  ly = py
  FOR n = 1 TO 8 DO
    x += dir_dx(d)
    y += dir_dy(d)
    IF x >= LW OR y >= LH THEN EXIT FI
    IF Open(Kind(x, y)) == 0 OR Diagonal(lx, ly, x, y) == 0 THEN EXIT FI
    lx = x
    ly = y
    IF x >= vx AND x < vx + VW AND y >= vy AND y < vy + VH THEN
      Pic((x - vx) << 1, VTOP + ((y - vy) << 1), (o_pic(t) + ap(t)) << 2, 16)
      Tick()
      Tick()
      DrawCell(x, y)
    FI
    m = MonAt(x, y)
    IF m THEN
      m -= 1
      sides = 2
      IF o_class(t) == C_WEAPON THEN sides = o_arg(t) FI
      tmp = m_ac(mtype(m))
      tmp = tmp - 10 + 1 + r_abon(role) + ulev + Signed(e)
      IF t == O_DAGGER THEN tmp += 2 FI
      mbl = 0
      MsgS("The ")
      Name(t, 1, 0, 0, 0)
      IF tmp > Roll(20) THEN
        MsgS(" hits ")
        MsgMon(m, 0)
        MsgC('.')
        MsgEnd()
        dmg = Roll(sides) + Signed(e) + RingEnch(O_RDAMAGE)
        IF dmg < 1 THEN dmg = 1 FI
        r = HurtMon(m, dmg)
      ELSE
        MsgS(" misses ")
        MsgMon(m, 0)
        MsgC('.')
        MsgEnd()
      FI
      EXIT
    FI
  OD
  IF PutObj(t, 1, f, e, lx, ly) <> 255 THEN DrawCell(lx, ly) FI
RETURN

PROC Throw()
  BYTE k, d
  k = Menu("What do you want to throw?", $7F, 1)
  IF k == 255 THEN RETURN FI
  IF uwep == k AND ifl(k) & OF_CURSE THEN
    Welded(k)
    RETURN
  FI
  Msg("In what direction?")
  d = AskDir()
  IF d == 0 OR d > 8 THEN RETURN FI
  Fly(k, d)
  EndTurn()
RETURN

FUNC BYTE FindDagger()
  BYTE k
  FOR k = 0 TO MAXINV - 1 DO
    IF it(k) == O_DAGGER AND uwep <> k THEN RETURN (k) FI
  OD
RETURN (255)

; f: the daggers not in hand, as NetHack's fire command with a quiver of
; them; the Rogue throws up to three at once, its multishot
PROC Fire()
  BYTE k, d, n, shots
  IF FindDagger() == 255 THEN
    Msg("You have no daggers to fire.")
    RETURN
  FI
  Msg("In what direction?")
  d = AskDir()
  IF d == 0 OR d > 8 THEN RETURN FI
  shots = 1
  IF role == 2 THEN shots = 1 + Rnd(3) FI
  FOR n = 1 TO shots DO
    k = FindDagger()
    IF k <> 255 THEN Fly(k, d) FI
  OD
  EndTurn()
RETURN

; ------------------------------------------------------ a hero's things
PROC Shuffle(BYTE first, BYTE n)
  BYTE i, j, v
  FOR i = 0 TO n - 1 DO ap(first + i) = i OD
  i = n
  WHILE i > 1 DO
    i -= 1
    j = Rnd(i + 1)
    v = ap(first + i)
    ap(first + i) = ap(first + j)
    ap(first + j) = v
  OD
RETURN

; a starting thing: into the pack, its kind, blessing and enchantment
; known, as NetHack's starting inventory is
FUNC BYTE Give(BYTE t, BYTE q, BYTE f, BYTE e)
  known(t) = 1
RETURN (InvAdd(t, q, f | OF_BKNOWN | OF_EKNOWN, e))

; the appearances shuffled, and each hero's things from NetHack's
; u_init.c: the Valkyrie a +1 long sword, a dagger and a +3 small shield;
; the Wizard a blessed +1 quarterstaff, a cloak, a wand, two rings, two
; potions and two scrolls; the Rogue a short sword, a stack of daggers,
; +1 leather armour and a potion of sickness
PROC InitHero()
  BYTE i, k
  FOR i = 0 TO N_OBJ - 1 DO
    known(i) = 0
    ap(i) = 0
    IF o_class(i) <= C_ARMOR OR i == O_GOLD THEN known(i) = 1 FI
  OD
  Shuffle(O_HEALING, 7)
  ap(O_WATER) = 7
  Shuffle(O_IDENTIFY, 8)
  Shuffle(O_WLIGHT, 6)
  Shuffle(O_RPROTECTION, 6)
  FOR i = 0 TO MAXINV - 1 DO it(i) = 255 OD
  FOR i = 0 TO 6 DO worn(i) = 255 OD
  uwep = 255
  uleft = 255
  uright = 255
  uamul = 255
  ugold = 0
  IF role == 0 THEN
    uwep = Give(O_LONGSWORD, 1, 0, 1)
    k = Give(O_DAGGER, 1, 0, 0)
    worn(SLOT_SHIELD) = Give(O_SMALLSHIELD, 1, 0, 3)
  ELSEIF role == 1 THEN
    uwep = Give(O_QUARTERSTAFF, 1, OF_BLESS, 1)
    worn(SLOT_CLOAK) = Give(O_CLOAK, 1, 0, 0)
    k = Give(O_WSTRIKING + Rnd(4), 1, 0, 4 + Rnd(5))
    k = O_RPROTECTION + Rnd(5)
    i = Give(k, 1, 0, Roll(3))
    i = O_RPROTECTION + (k - O_RPROTECTION + 1 + Rnd(4)) % 5   ; a second ring, of another kind
    i = Give(i, 1, 0, Roll(3))
    FOR i = 1 TO 2 DO
      k = Give(PickKind(C_POTION), 1, 0, 0)
      k = Give(PickKind(C_SCROLL), 1, 0, 0)
    OD
  ELSE
    uwep = Give(O_SHORTSWORD, 1, 0, 0)
    k = Give(O_DAGGER, 6 + Rnd(10), 0, 0)
    worn(SLOT_BODY) = Give(O_LEATHERARMOR, 1, 0, 1)
    k = Give(O_SICKNESS, 1, 0, 0)
  FI
  CalcAC()
RETURN

; ---------------------------------------------------------------- magic
; the Wizard's force bolt, NetHack's: five power, two twelve-sided dice
; to the first monster along the direction within eight cells
PROC Cast()
  BYTE d, x, y, n, m
  IF role <> 1 THEN
    Msg("You don't know any spells.")
    RETURN
  FI
  IF upw < 5 THEN
    Msg("You don't have enough energy.")
    RETURN
  FI
  Msg("In what direction?")
  d = AskDir()
  IF d == 0 THEN RETURN FI
  upw -= 5
  x = px
  y = py
  FOR n = 1 TO 8 DO
    x += dir_dx(d)
    y += dir_dy(d)
    IF Open(Kind(x, y)) == 0 THEN EXIT FI
    m = MonAt(x, y)
    IF m THEN
      mbl = 0
      MsgS("The force bolt hits ")
      MsgMon(m - 1, 0)
      MsgC('.')
      MsgEnd()
      m = HurtMon(m - 1, Dice(2, 12))
      EndTurn()
      RETURN
    FI
  OD
  Msg("The force bolt fizzles.")
  EndTurn()
RETURN

; ---------------------------------------------------------------- death
PROC Centre(BYTE row, BYTE bank)
  BYTE i, col
  CARD a
  col = (40 - mbl) / 2
  a = row
  VRAM_ADDR = (a << 7) + (col << 1)
  VRAM_STEP = 1
  FOR i = 1 TO mbl DO
    VRAM_DATA = mb(i - 1) - FONT_FIRST
    VRAM_DATA = bank
  OD
  mbl = 0
RETURN

; the grave: who, what did it, where, and how long it took
PROC Die()
  BYTE ch, k
  BYTE POINTER n, q
  Msg("You die...")
  More()
  phase = 2
  ClearScreen()
  Pic(19, 5, T_GRAVE, B_VIEW)
  mbl = 0
  MsgS("REST IN PEACE")
  Centre(9, B_WHITE)
  IF role == 0 THEN
    MsgS("Valkyrie")
  ELSEIF role == 1 THEN
    MsgS("Wizard")
  ELSE
    MsgS("Rogue")
  FI
  Centre(11, B_YELLOW)
  MsgS("killed by ")
  n = MonName(killer)
  q = n + 1
  ch = *q
  IF killer == M_ORACLE OR killer == M_WIZARDOFYENDOR THEN
    MsgS("the ")
  ELSEIF ch == 'a' OR ch == 'e' OR ch == 'i' OR ch == 'o' OR ch == 'u' THEN
    MsgS("an ")
  ELSE
    MsgS("a ")
  FI
  MsgS(n)
  Centre(13, B_WHITE)
  MsgS("on dungeon level ")
  MsgN(depth)
  Centre(14, B_WHITE)
  MsgS("at experience level ")
  MsgN(ulev)
  Centre(16, B_GREY)
  MsgS("after ")
  MsgN(turns)
  MsgS(" turns")
  Centre(17, B_GREY)
  MsgS("with ")
  MsgN(ugold)
  MsgS(" pieces of gold")
  Centre(18, B_GREY)
  Text(9, 24, "Enter: back to the title", B_GREY)
  k = KeyHit(KEY_ENTER)
  DO
    Tick()
  UNTIL KeyHit(KEY_ENTER) OR KeyHit(KEY_SPACE) OR esc OD
  esc = 0
RETURN

; ------------------------------------------------------------- the play
FUNC BYTE Quit()
  Msg("Really quit? [yn]")
  esc = 0
  DO
    Tick()
    IF KeyHit(KEY_Y) THEN RETURN (1) FI
    IF KeyHit(KEY_N) THEN EXIT FI
  UNTIL esc OD
  esc = 0
  MsgClear()
RETURN (0)

PROC Play()
  BYTE d, i
  ClearScreen()
  FOR i = 0 TO MAXDEPTH DO made(i) = 0 OD
  rseed = (TMR_L * 256 + TMR_M) | 1
  depth = 1
  turns = 0
  anim = 0
  animt = 24
  esc = 0
  dead = 0
  phase = 1
  ulev = 1
  uxp = 0
  uhp = r_hp(role)
  uhpmax = uhp
  upw = r_pw(role)
  upwmax = upw
  upara = 0
  carry(0) = 255
  msgrow = 0
  mbl = 0
  wantport = 0
  InitHero()
  EnterLevel(1)
  d = FreeNear(px, py)
  IF d THEN
    i = NewMon(r_pet(role), px + dir_dx(d), py + dir_dy(d))
    IF i <> 255 THEN mstat(i) = S_LIVE | S_PET FI
    DrawCell(px + dir_dx(d), py + dir_dy(d))
  FI
  Msg("Welcome to the Dungeons of Yendor!")
  DO
    Tick()
    loops += 1
    IF dead THEN
      Die()
      RETURN
    FI
    IF esc THEN
      esc = 0
      IF Quit() THEN RETURN FI
    FI
    IF animt == 0 THEN
      animt = 24
      Animate()
    FI
    d = Walk()
    IF d THEN
      MsgClear()
      Stride(d)
    FI
    IF KeyHit(KEY_DOT) THEN
      MsgClear()
      IF Shifted() THEN
        Descend()
      ELSE
        EndTurn()
      FI
    FI
    IF KeyHit(KEY_COMMA) THEN
      MsgClear()
      IF Shifted() THEN Ascend() ELSE PickUp() FI
    FI
    IF KeyHit(KEY_S) OR KeyHit(KP5) THEN
      MsgClear()
      EndTurn()
    FI
    IF KeyHit(KEY_Z) THEN
      MsgClear()
      IF Shifted() THEN Cast() ELSE Zap() FI
    FI
    IF KeyHit(KEY_R) THEN
      IF KeyHeld(KEY_CTRL) THEN
        DrawView()
        Status()
      ELSE
        MsgClear()
        IF Shifted() THEN TakeRing() ELSE Read() FI
      FI
    FI
    IF KeyHit(KEY_I) THEN
      d = Menu("Inventory", $7F, 0)
    FI
    IF KeyHit(KEY_D) THEN
      MsgClear()
      Drop()
    FI
    IF KeyHit(KEY_W) THEN
      MsgClear()
      IF Shifted() THEN Wear() ELSE Wield() FI
    FI
    IF KeyHit(KEY_T) THEN
      MsgClear()
      IF Shifted() THEN TakeOff() ELSE Throw() FI
    FI
    IF KeyHit(KEY_P) AND Shifted() THEN
      MsgClear()
      PutOn()
    FI
    IF KeyHit(KEY_Q) THEN
      MsgClear()
      Quaff()
    FI
    IF KeyHit(KEY_F) THEN
      MsgClear()
      Fire()
    FI
    IF KeyHit(KEY_SEMI) AND Shifted() THEN
      MsgClear()
      LookHere()
    FI
    IF KeyHit(KEY_BSLASH) THEN Discoveries() FI
    IF wantport AND dead == 0 THEN
      wantport = 0
      MsgClear()
      Msg("You feel a wrenching sensation.")
      Teleport()
    FI
    IF KeyHit(KEY_ENTER) THEN
      MsgClear()
      IF Kind(px, py) == K_DOWN THEN
        Descend()
      ELSEIF Kind(px, py) == K_UP THEN
        Ascend()
      FI
    FI
  OD
RETURN

; ------------------------------------------------------------ the title
PROC TitleRoles(BYTE sel)
  BYTE r, bank
  FOR r = 0 TO 2 DO
    bank = B_WHITE
    IF r == sel THEN bank = B_YELLOW FI
    Pic(14, 9 + r * 3, r << 2, (2 + anim) << 4)
    RoleName(18, 10 + r * 3, r, bank)
    IF r == sel THEN Text(11, 10 + r * 3, ">", B_YELLOW) ELSE Text(11, 10 + r * 3, " ", B_WHITE) FI
  OD
RETURN

PROC Title()
  BYTE go, d
  phase = 0
  esc = 0
  ClearScreen()
  go = 1
  IF theme <> 0 THEN go = LoadTheme(0) FI
  IF DiskFind(YDRIVE, names_file) THEN names_page = disk_page ELSE go = 0 FI
  IF go == 0 THEN
    Text(1, 14, "YENDOR's files are not all on drive 9.", B_RED)
    DO
      Tick()
    UNTIL esc OD
    RETURN
  FI
  Text(17, 3, "YENDOR", B_YELLOW)
  Text(1, 5, "The Amulet of Yendor lies twelve levels", B_GREY)
  Text(1, 6, "down. Fetch it, and climb back to the", B_GREY)
  Text(1, 7, "sun.", B_GREY)
  Text(5, 20, "up, down: choose   Enter: begin", B_GREY)
  Text(3, 25, "Tiles: DawnLike by DragonDePlatino", B_CYAN)
  Text(3, 26, "Palette: DawnBringer    CC-BY 4.0", B_CYAN)
  TitleRoles(role)
  go = KeyHit(KEY_ENTER)
  go = KeyHit(KEY_SPACE)
  go = 0
  DO
    Tick()
    IF esc THEN EXIT FI
    IF animt == 0 THEN
      animt = 24
      anim = anim ^ 1
      TitleRoles(role)
    FI
    d = Walk()
    IF d == 1 THEN
      role = (role + 2) % 3
      TitleRoles(role)
    ELSEIF d == 5 THEN
      role = (role + 1) % 3
      TitleRoles(role)
    FI
    IF KeyHit(KEY_ENTER) OR KeyHit(KEY_SPACE) THEN go = 1 FI
  UNTIL go OD
RETURN

PROC Main()
  Graphics(2)
  Cursor(0)
  VID_BORDER = 0
  VID_PAT = PAT_BASE
  SpritesOff()
  Palette()
  theme = 255
  role = 0
  DO
    Title()
    IF esc THEN EXIT FI
    Play()
  OD
  SpritesOff()
  Reset()
RETURN
