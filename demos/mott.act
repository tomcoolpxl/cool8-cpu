; the eight directions, 1 north and on clockwise
BYTE ARRAY dir_dx(9) = [0 0 1 1 1 0 255 255 255]
BYTE ARRAY dir_dy(9) = [0 255 255 0 1 1 1 0 255]
; the pack's letters, a to r, as the keys that type them
BYTE ARRAY letter_sc(18) = [$1C $32 $21 $23 $24 $2B $34 $33 $43 $3B $42 $4B $3A $31 $44 $4D $15 $2D]

; the heroes: Valkyrie, Wizard, Rogue -- NetHack's starting hit points and
; power (the role's and a human's), the to-hit and damage bonuses of their
; strength and dexterity, and the pet each brings; their things are
; InitHero's
BYTE ARRAY r_hp(3) = [16 12 12]
BYTE ARRAY r_pw(3) = [1 7 2]
BYTE ARRAY r_abon(3) = [1 0 2]
BYTE ARRAY r_dbon(3) = [2 0 0]
BYTE ARRAY r_pet(3) = [M_KITTEN M_KITTEN M_LITTLEDOG]

; the three cell maps live below the program, in the loader's low RAM
; ($0800-$13FF, D109): not in the PRG, and garbage until MakeLevel or
; LoadLevel clears them
BYTE ARRAY lv(960) = $0800
BYTE ARRAY mat(960) = $0BC0          ; the monster on a cell, plus one; rebuilt, not parked
BYTE ARRAY oat(960) = $0F80          ; the top thing on a cell, plus one; rebuilt
; and after it, to $13FF, buffers nothing keeps from one command to the
; next: out of the PRG, and so out of a saved game
BYTE ARRAY sbuf(81) = $1340          ; a string read from MOTT.STR
BYTE ARRAY feat(80) = $1391          ; a special level's features, as they are read
BYTE ARRAY lb(21) = $13E1            ; a line typed
; the levels a game has: the dungeon's twelve by depth, the three of the
; mines below the level they open from, the two of Sokoban above the one
; below the Oracle's; a slot of VRAM each
CONST L_MINES = 13
CONST L_TOWN = 14
CONST L_MINEEND = 15
CONST L_SOKO1 = 16
CONST L_SOKO2 = 17
CONST NLEVEL = 17
; ---- a saved game, MOTT.SAV on drive 9. What belongs to the disc -- where
; its files are -- and the save's own working are declared first, and are
; not saved; everything from save_from to save_end is the game, and is
CARD names_page, str_page, levels_page, mus_lo
BYTE mus_hi
CONST SAVE_LEN = 32768
CARD sv_lo, fa, fp, fn               ; the file; a flash address, a pointer and a count for FlashPut and FlashGet
BYTE sv_hi, fh, fv, restoring        ; fv: the pointer is VRAM's port
BYTE ARRAY svh(4)                    ; the save's head: its state, and the stamp of this build
BYTE ARRAY save_file = "MOTT    SAV"
BYTE save_from
BYTE lvl                             ; the level the hero is on
BYTE mines_at, oracle_at             ; where the mines open and the Oracle sits, this game
BYTE uprot                           ; a priest's protection, off the armour class
BYTE uoracle                         ; consultations had: 1 minor, 2 major
BYTE aesc                            ; the last question was answered with Esc
BYTE lastpush                        ; the turn a boulder last moved
BYTE udemi                           ; the Amulet has been lifted: the Wizard's malice runs
CARD udg                             ; turns to his next intervention
BYTE wantint, won                    ; an intervention due; the game won
BYTE ARRAY made(18)                  ; levels already made, by level
CARD ARRAY vis(160)                  ; the cells in view, to fade when they leave it
BYTE nvis

CONST MAXTRAP = 8
CONST MAXENGR = 3

; ---- what a level is beyond its cells, parked in its VRAM slot after them
; as one run of memory, rx1 to park_end: declared here together and in
; this order, which the gate holds the symbol table to
; the rooms and the stairs
BYTE ARRAY rx1(9), ry1(9), rx2(9), ry2(9), rgone(9)
BYTE upx, upy, dnx, dny
BYTE brx, bry                        ; the stairs of a branch, 255 none
; the monsters: parallel arrays; a monster's turns of sleep, and of running
; from the hero -- 255 until it is well again
BYTE ARRAY mtype(20), mx(20), my(20), mhp(20), mhpmax(20), mlev(20), mstat(20), mmove(20)
BYTE ARRAY msl(20), mflee(20)
; the things on the floor: kind (255 none), place, quantity, flags, and
; enchantment or charges -- or x 255 and y the monster carrying it
BYTE ARRAY ot(32), ox(32), oy(32), oq(32), of(32), oe(32)
; the traps: kind (255 none), place, and whether seen and gone off once
BYTE ARRAY tt(8), tx(8), ty(8), tf(8)
; what is written in the dust, three a level: the place (255 none), and a
; length byte and sixteen letters each in etx
BYTE ARRAY ex(3), ey(3), etx(51)
; the shop: its room (255 none), kind, keeper's slot and name, the door
; and the keeper's post inside it, whether the hero has been in, the
; keeper's gold and what was stolen from it
BYTE shroom, shtype, shk, shname, shdx, shdy, spx, spy, shvis
CARD shgold, shrob
; the temple: its room (255 none), its priest's slot, its altar's alignment
BYTE troom, tpri, talign
BYTE park_end
; ---- the end of what is parked
; the hero's pack, and what of it is in use
BYTE ARRAY it(18), iq(18), ifl(18), ie(18)
BYTE ARRAY worn(7)                   ; the letter worn in each armour slot, 255 none
BYTE uwep, uleft, uright, uamul
BYTE ARRAY known(48), ap(48)         ; each kind identified, and its appearance this game
CARD ugold
BYTE nf, ne                          ; a new thing's flags and enchantment
BYTE wantport                        ; the ring of teleportation's pull, taken after the turn

BYTE depth, theme, role
BYTE px, py                          ; the hero
BYTE ulev, uhp, uhpmax, upw, upwmax, upara
INT uac
CARD uxp
BYTE dead, killer                    ; and what did it: a monster type, or KD_FIRST and on
BYTE killgod                         ; whose wrath, for KD_WRATH
; NetHack's alignment, alignment record, luck and prayer timeout
BYTE ARRAY r_align(3) = [1 1 2]      ; 0 lawful, 1 neutral, 2 chaotic: the human Valkyrie and Wizard, the Rogue
BYTE ualign, ugangr, upray, ptype
INT urec, uluck
CARD ublesscnt
BYTE utrap, utraptype                ; turns a bear trap or a pit still holds the hero
BYTE vx, vy                          ; the window's corner on the level
CARD turns
BYTE anim, animt                     ; the creatures' frame, and the frames to the next
BYTE esc, phase                      ; 0 the title, 1 play, 2 the grave
BYTE rep_c, rep_t
CARD st_n
CARD loops                           ; frames of play, for the gate

; the message lines: a line built in mb, then printed on the next of the
; two rows, with --More-- when both are full
BYTE ARRAY mb(81)
BYTE mbl, msgrow

; ------------------------------------------------------------- the screen
PROC Tile(BYTE col, BYTE row, BYTE t, BYTE attr)
  CARD a
  a = row
  VRAM_ADDR = (a << 7) + (col << 1)
  VRAM_STEP = 1
  VRAM_DATA = t
  VRAM_DATA = attr
RETURN

; a 16 x 16 picture: the four tiles from t
PROC Pic(BYTE col, BYTE row, BYTE t, BYTE attr)
  CARD a
  a = row
  a = (a << 7) + (col << 1)
  VRAM_STEP = 1
  VRAM_ADDR = a
  VRAM_DATA = t
  VRAM_DATA = attr
  VRAM_DATA = t + 1
  VRAM_DATA = attr
  VRAM_ADDR = a + 128
  VRAM_DATA = t + 2
  VRAM_DATA = attr
  VRAM_DATA = t + 3
  VRAM_DATA = attr
RETURN

; a cell never seen: the space glyph, which is empty in every theme
PROC Blank(BYTE col, BYTE row)
  CARD a
  a = row
  a = (a << 7) + (col << 1)
  VRAM_STEP = 1
  VRAM_ADDR = a
  VRAM_DATA = 0
  VRAM_DATA = 0
  VRAM_DATA = 0
  VRAM_DATA = 0
  VRAM_ADDR = a + 128
  VRAM_DATA = 0
  VRAM_DATA = 0
  VRAM_DATA = 0
  VRAM_DATA = 0
RETURN

PROC Text(BYTE col, BYTE row, BYTE POINTER s, BYTE bank)
  BYTE n
  CARD a
  a = row
  VRAM_ADDR = (a << 7) + (col << 1)
  VRAM_STEP = 1
  n = *s
  WHILE n > 0 DO
    s += 1
    VRAM_DATA = *s - FONT_FIRST
    VRAM_DATA = bank
    n -= 1
  OD
RETURN

PROC ClearRow(BYTE row)
  BYTE i
  CARD a
  a = row
  VRAM_ADDR = a << 7
  VRAM_STEP = 1
  FOR i = 0 TO 39 DO
    VRAM_DATA = 0
    VRAM_DATA = 0
  OD
RETURN

; a number right-aligned in n places, blank to its left
PROC Num(BYTE col, BYTE row, CARD v, BYTE n, BYTE bank)
  BYTE i
  CARD a
  a = row
  i = n
  WHILE i > 0 DO
    i -= 1
    VRAM_ADDR = (a << 7) + ((col + i) << 1)
    VRAM_STEP = 1
    IF v > 0 OR i == n - 1 THEN
      VRAM_DATA = '0' - FONT_FIRST + v % 10
    ELSE
      VRAM_DATA = 0
    FI
    VRAM_DATA = bank
    v = v / 10
  OD
RETURN

PROC ClearScreen()
  BYTE r
  FOR r = 0 TO 29 DO ClearRow(r) OD
RETURN

PROC Palette()
  BYTE b
  FOR b = 0 TO N_PAL - 1 DO SetPalette(mott_pal + (b << 5), b << 4, 16) OD
RETURN

; ---------------------------------------------------------------- music
; a tune from MMUSIC.DAT, a step read from the flash when it is due -- in
; Tick, which is never called while another stream is open -- on voices 0
; to 2: a lead, a bass and a harmony, each note fading to half. The title's
; plays on; a part of the dungeon's twice through when the hero comes into
; it, and then the dungeon is quiet. On voice 3 a sound for what just
; happened, and now and then, in the quiet, the level's own noises
CARD moff, mstart
BYTE mon, mtime, mrep
BYTE mtune = [255]
BYTE ARRAY mnote(3), mvol(3)
BYTE ARRAY mpeak(3) = [11 9 6]

PROC MusOpen(CARD off)
  CARD at
  at = mus_lo + off
  IF at < mus_lo THEN FlashOpen(at, mus_hi + 1) ELSE FlashOpen(at, mus_hi) FI
RETURN

FUNC CARD NoteInc(BYTE v)
RETURN (nbase(v % 12) >> (6 - v / 12))

PROC MusicOff()
  BYTE v
  mon = 0
  FOR v = 0 TO 2 DO Silence(v) OD
RETURN

PROC MusicStart(BYTE n)
  mtune = n
  MusicOff()
  MusOpen(n + n)
  mstart = FlashByte()
  mstart = mstart + FlashByte() * 256
  FlashClose()
  moff = mstart
  mtime = 1
  mon = 1
  mrep = 1
RETURN

PROC MusicStep()
  BYTE v, n, d
  IF mon == 0 THEN RETURN FI
  mtime -= 1
  IF mtime THEN
    IF mtime & 3 == 0 THEN
      FOR v = 0 TO 2 DO
        IF mvol(v) > mpeak(v) >> 1 THEN
          mvol(v) -= 1
          Sound(v, NoteInc(mnote(v)), mvol(v), 0)
        FI
      OD
    FI
    RETURN
  FI
  MusOpen(moff)
  d = FlashByte()
  IF d == 255 AND mrep THEN
    IF mrep < 255 THEN mrep -= 1 FI
    FlashClose()
    moff = mstart
    MusOpen(moff)
    d = FlashByte()
  FI
  IF d >= 254 THEN
    FlashClose()
    MusicOff()
    RETURN
  FI
  FOR v = 0 TO 2 DO
    n = FlashByte()
    IF n == 127 THEN
      Silence(v)
      mvol(v) = 0
    ELSEIF n THEN
      mnote(v) = n - 1
      mvol(v) = mpeak(v)
      Sound(v, NoteInc(n - 1), mvol(v), 0)
    FI
  OD
  FlashClose()
  moff = moff + 4
  mtime = d
RETURN

; the sounds: a pitch, its sweep a frame, a volume, frames; a mode -- 128
; to swell up to the volume before it fades, 64 for noise, and in the low
; bits the frames between steps of volume less one; and repeats in the
; high nibble with the gap between them, in two frames, in the low
CONST SX_HIT = 0
CONST SX_MISS = 1
CONST SX_KILL = 2
CONST SX_HURT = 3
CONST SX_LEVEL = 4
CONST SX_DOOR = 5
CONST SX_GOLD = 6
CONST SX_TRAP = 7
CONST SX_STAIRS = 8
CONST SX_MAGIC = 9
CONST SX_PRAY = 10
CONST SX_WATER = 11
CONST SX_BOULDER = 12
CONST SX_BITE = 13
CONST SX_CLAW = 14
CONST SX_CLANG = 15
CONST SX_STING = 16
CONST SX_THUD = 17
CONST SX_NOISES = 18
CONST SX_DRIP = 19
CONST SX_WIND = 20
CONST SX_RUMBLE = 21
CONST SX_STEPS = 22
CONST SX_PICK = 23
CONST SX_BUBBLE = 24
CONST SX_CHIME = 25
CONST SX_CREAK = 26
CONST SX_CHANT = 27
CARD ARRAY sf_inc(28) = [2600 3500 1400 700 900 500 3800 2000 300 4200 1800 6000 250 900 5200 6800 4000 350 600 2400 2200 150 500 4000 1600 9000 220 1100]
INT ARRAY sf_sweep(28) = [-150 -300 -60 -25 70 20 250 -120 25 -180 12 -200 -5 -50 -250 -6 300 -8 -20 500 -4 0 -30 -300 250 0 3 0]
BYTE ARRAY sf_vol(28) = [11 6 12 13 11 9 8 13 8 10 10 9 12 13 10 12 9 14 5 5 4 7 3 5 5 8 5 4]
BYTE ARRAY sf_t(28) = [6 4 16 8 30 8 6 12 12 18 40 14 14 6 5 14 6 8 5 4 120 100 3 2 3 30 40 60]
BYTE ARRAY sf_mode(28) = [65 65 1 1 1 65 1 65 65 1 1 65 65 65 65 3 1 65 65 1 207 199 65 65 1 3 131 135]
BYTE ARRAY sf_rep(28) = [0 0 0 0 0 0 $11 0 0 0 0 0 0 0 $12 0 0 0 $25 $1F 0 0 $38 $47 $42 $11 0 0]
; a monster's blow by its kind, and each part of the dungeon's two noises
BYTE ARRAY att_sx(10) = [3 13 14 15 16 3 17 17 3 17]
BYTE ARRAY amb(14) = [22 19 19 20 21 20 23 19 22 26 26 19 24 20]
CARD sxi, ambt
INT sxs
BYTE sxt, sxv, sxm, sxk, sxr, sxg, sxup, ar, area

PROC SfxGo()
  BYTE n
  n = sxk
  sxs = sf_sweep(n)
  sxv = sf_vol(n)
  sxt = sf_t(n)
  sxm = sf_mode(n)
  sxup = 0
  IF sxm & 128 THEN
    sxup = sxv
    sxv = 1
  FI
RETURN

PROC Sfx(BYTE n)
  sxk = n
  sxi = sf_inc(n)
  sxr = sf_rep(n)
  sxg = 0
  SfxGo()
RETURN

PROC SfxStep()
  IF sxg THEN
    sxg -= 1
    IF sxg == 0 THEN
      sxi = ar
      sxi = (sxi << 2) + sf_inc(sxk)     ; each repeat a little off the last
      SfxGo()
    FI
    RETURN
  FI
  IF sxt == 0 THEN RETURN FI
  sxt -= 1
  IF sxt == 0 THEN
    Silence(3)
    IF sxr >= 16 THEN
      sxr -= 16
      sxg = (sxr & 15) << 1
    FI
    RETURN
  FI
  sxi = sxi + sxs
  IF sxt & (sxm & 15) == 0 THEN
    IF sxup THEN
      sxv += 1
      IF sxv >= sxup THEN sxup = 0 FI
    ELSEIF sxv > 1 THEN
      sxv -= 1
    FI
  FI
  Sound(3, sxi, sxv, sxm & 64)
RETURN

; ------------------------------------------------------------- a frame
PROC Tick()
  BYTE d
  WaitVBlank()
  KeyPoll()
  IF KeyHit(KEY_ESC) THEN esc = 1 FI
  IF animt THEN animt -= 1 FI
  ar = (ar << 2) + ar + 17             ; the noises' own dice, apart from the game's
  MusicStep()
  SfxStep()
  IF phase == 1 AND mon == 0 AND sxt == 0 AND sxg == 0 THEN
    IF ambt THEN
      ambt -= 1
    ELSE
      ambt = ar                        ; the next in 20 to 37 seconds
      ambt = (ambt << 2) + 1200
      d = area + area
      IF ar & 8 THEN d += 1 FI
      Sfx(amb(d))
    FI
  FI
RETURN

; ------------------------------------------------------------- messages
PROC MsgClear()
  ClearRow(0)
  ClearRow(1)
  msgrow = 0
  mbl = 0
RETURN

PROC MsgC(BYTE ch)
  IF mbl < 80 THEN
    mb(mbl) = ch
    mbl += 1
  FI
RETURN

PROC MsgS(BYTE POINTER s)
  BYTE n
  n = *s
  WHILE n > 0 DO
    s += 1
    MsgC(*s)
    n -= 1
  OD
RETURN

PROC MsgN(CARD v)
  BYTE ARRAY dg(5)
  BYTE n
  n = 0
  DO
    dg(n) = v % 10
    v = v / 10
    n += 1
  UNTIL v == 0 OD
  WHILE n > 0 DO
    n -= 1
    MsgC('0' + dg(n))
  OD
RETURN

; both rows used: --More--, and a key before the next
PROC More()
  BYTE k
  Text(32, 1, "--More--", B_YELLOW)
  k = KeyHit(KEY_SPACE)
  k = KeyHit(KEY_ENTER)
  esc = 0
  DO
    Tick()
  UNTIL KeyHit(KEY_SPACE) OR KeyHit(KEY_ENTER) OR esc OD
  esc = 0
  ClearRow(0)
  ClearRow(1)
  msgrow = 0
RETURN

; the line built so far onto the next row, broken at a space onto the
; one after if it is longer than forty
PROC MsgEnd()
  BYTE i, n, cut, start
  CARD a
  start = 0
  WHILE start < mbl DO
    n = mbl - start
    cut = n
    IF n > 40 THEN
      cut = 40
      i = 40
      WHILE i > 20 DO
        IF mb(start + i) == ' ' THEN
          cut = i
          EXIT
        FI
        i -= 1
      OD
    FI
    IF msgrow >= 2 THEN More() FI
    ClearRow(msgrow)
    a = msgrow
    VRAM_ADDR = a << 7
    VRAM_STEP = 1
    FOR i = 1 TO cut DO
      VRAM_DATA = mb(start + i - 1) - FONT_FIRST
      VRAM_DATA = B_WHITE
    OD
    msgrow += 1
    start += cut
    IF start < mbl THEN
      IF mb(start) == ' ' THEN start += 1 FI
    FI
  OD
  mbl = 0
RETURN

PROC Msg(BYTE POINTER s)
  mbl = 0
  MsgS(s)
  MsgEnd()
RETURN

; a question printed: y is 1, n or Esc 0; and the key still down is the
; answer, not a step -- y and n are movement keys too
FUNC BYTE Answer()
  BYTE a
  a = KeyHit(KEY_Y)
  a = KeyHit(KEY_N)
  esc = 0
  a = 0
  DO
    Tick()
    IF KeyHit(KEY_Y) THEN a = 1 FI
  UNTIL a OR KeyHit(KEY_N) OR esc OD
  aesc = esc
  esc = 0
  rep_c = 4
  IF a THEN rep_c = 8 FI
  rep_t = 0
RETURN (a)

FUNC BYTE YesNo(BYTE POINTER q)
  Msg(q)
RETURN (Answer())

PROC Luck(INT n)
  uluck = uluck + n
  IF uluck < -10 THEN uluck = -10 FI
  IF uluck > 10 THEN uluck = 10 FI
RETURN

; "a " or "an " and a name
PROC MsgA(BYTE POINTER s)
  BYTE POINTER q
  BYTE ch
  q = s + 1
  ch = *q
  IF ch == 'a' OR ch == 'e' OR ch == 'i' OR ch == 'o' OR ch == 'u' THEN MsgS("an ") ELSE MsgS("a ") FI
  MsgS(s)
RETURN

; ------------------------------------------------------------ the dice
; NetHack's rnd(n): one to n
FUNC BYTE Roll(BYTE n)
  IF n == 0 THEN RETURN (0) FI
RETURN (Rnd(n) + 1)

; NetHack's rnl(x): 0 to x-1, pushed towards 0 by good luck and away by bad
FUNC BYTE Rnl(BYTE x)
  INT i, adj, a
  i = Rnd(x)
  adj = uluck
  a = adj
  IF a < 0 THEN a = -a FI
  IF x <= 15 THEN
    a = (a + 1) / 3
    IF adj < 0 THEN adj = -a ELSE adj = a FI
  FI
  IF adj <> 0 AND Rnd(37 + a) <> 0 THEN
    i = i - adj
    IF i < 0 THEN i = 0 FI
    IF i >= x THEN i = x - 1 FI
  FI
RETURN (i)

FUNC BYTE Dice(BYTE n, BYTE s)
  BYTE t, i
  t = 0
  FOR i = 1 TO n DO t += Roll(s) OD
RETURN (t)

; ------------------------------------------------------------ the themes
FUNC BYTE ThemeOf(BYTE d)
  IF d <= 4 THEN RETURN (0) FI
  IF d <= 8 THEN RETURN (1) FI
RETURN (2)

; a theme's four pattern banks from MOTT's drive into VRAM, at the
; flash's own rate: 32,768 bytes in about eight frames. The font is the
; same bytes in every theme, so the words on the screen do not flicker
FUNC BYTE LoadTheme(BYTE t)
  CARD o
  o = t
  IF DiskFind(MDRIVE, theme_names + o * 11) == 0 THEN RETURN (0) FI
  DiskOpen(MDRIVE)
  VRAM_ADDR = PAT_BASE
  VRAM_STEP = 1
  st_n = 32768
  ASM
    LDW  X,[v_st_n]
.l: LD   R0,[v_FLS_DATA]
    ST   [v_VRAM_DATA],R0
    DECW X
    BNE  .l
  ENDASM
  FlashClose()
  theme = t
RETURN (1)

; ------------------------------------------------------------- the level
FUNC CARD Idx(BYTE x, BYTE y)
  CARD i
  i = y
RETURN ((i << 5) + (i << 3) + x)

FUNC BYTE Kind(BYTE x, BYTE y)
  IF x >= LW OR y >= LH THEN RETURN (K_ROCK) FI
RETURN (lv(Idx(x, y)) & 15)

PROC SetKind(BYTE x, BYTE y, BYTE k)
  CARD i
  i = Idx(x, y)
  lv(i) = (lv(i) & 240) | k
RETURN

; a wall joins to a wall, and to a door in one, found or not
FUNC BYTE WallLike(BYTE x, BYTE y)
  BYTE k
  k = Kind(x, y)
  IF k == K_WALL OR k == K_DOORC OR k == K_DOORO OR k == K_DOORWAY OR k == K_SDOOR THEN RETURN (1) FI
RETURN (0)

; what a foot can stand on; a shut door is not that, nor what is hidden
FUNC BYTE Open(BYTE k)
  IF k == K_ROCK OR k == K_WALL OR k == K_DOORC OR k == K_SDOOR OR k == K_SCORR THEN RETURN (0) FI
RETURN (1)

; a door is never entered or left on the diagonal, as NetHack has it;
; an empty doorway is no bar
FUNC BYTE Diagonal(BYTE x, BYTE y, BYTE nx, BYTE ny)
  BYTE a, b
  IF x == nx OR y == ny THEN RETURN (1) FI
  a = Kind(x, y)
  b = Kind(nx, ny)
  IF a == K_DOORO OR a == K_DOORC OR b == K_DOORO OR b == K_DOORC THEN RETURN (0) FI
RETURN (1)

; a door where a corridor meets a room's wall: one in eight a secret
; door, as NetHack's dodoor() makes them; of the rest half an empty
; doorway, a third shut, the others standing open
PROC Door(BYTE x, BYTE y)
  BYTE r
  IF Rnd(8) == 0 THEN
    SetKind(x, y, K_SDOOR)
    RETURN
  FI
  r = Rnd(6)
  IF r < 3 THEN
    SetKind(x, y, K_DOORWAY)
  ELSEIF r < 5 THEN
    SetKind(x, y, K_DOORC)
  ELSE
    SetKind(x, y, K_DOORO)
  FI
RETURN

BYTE nxcor                           ; digging the corridors beyond the ones that join every room

PROC Dig(BYTE x, BYTE y)
  IF Kind(x, y) == K_ROCK THEN
    IF nxcor AND Rnd(35) == 0 THEN SetKind(x, y, K_SCORR) ELSE SetKind(x, y, K_CORR) FI
  FI
RETURN

; a corridor from a's east side to b's west, b the grid cell to its right:
; along a's row to a column between them, down or up to b's, and along
PROC JoinAcross(BYTE a, BYTE b)
  BYTE ax, ay, bx, by, m, x, y
  IF rgone(a) THEN
    ax = rx1(a)
    ay = ry1(a)
  ELSE
    ax = rx2(a)
    ay = ry1(a) + 1 + Rnd(ry2(a) - ry1(a) - 1)
    Door(ax, ay)
    ax += 1
  FI
  IF rgone(b) THEN
    bx = rx1(b)
    by = ry1(b)
  ELSE
    bx = rx1(b)
    by = ry1(b) + 1 + Rnd(ry2(b) - ry1(b) - 1)
    Door(bx, by)
    bx -= 1
  FI
  m = ax + Rnd(bx - ax + 1)
  FOR x = ax TO m DO Dig(x, ay) OD
  IF ay < by THEN
    FOR y = ay TO by DO Dig(m, y) OD
  ELSE
    FOR y = by TO ay DO Dig(m, y) OD
  FI
  FOR x = m TO bx DO Dig(x, by) OD
RETURN

; the same, a above b
PROC JoinDown(BYTE a, BYTE b)
  BYTE ax, ay, bx, by, m, x, y
  IF rgone(a) THEN
    ax = rx1(a)
    ay = ry1(a)
  ELSE
    ay = ry2(a)
    ax = rx1(a) + 1 + Rnd(rx2(a) - rx1(a) - 1)
    Door(ax, ay)
    ay += 1
  FI
  IF rgone(b) THEN
    bx = rx1(b)
    by = ry1(b)
  ELSE
    by = ry1(b)
    bx = rx1(b) + 1 + Rnd(rx2(b) - rx1(b) - 1)
    Door(bx, by)
    by -= 1
  FI
  m = ay + Rnd(by - ay + 1)
  FOR y = ay TO m DO Dig(ax, y) OD
  IF ax < bx THEN
    FOR x = ax TO bx DO Dig(x, m) OD
  ELSE
    FOR x = bx TO ax DO Dig(x, m) OD
  FI
  FOR y = m TO by DO Dig(bx, y) OD
RETURN

; the grid cell next to g in direction d -- 0 east, 1 south, 2 west,
; 3 north -- or 255 off the grid
FUNC BYTE Beside(BYTE g, BYTE d)
  IF d == 0 THEN
    IF g % 3 < 2 THEN RETURN (g + 1) FI
  ELSEIF d == 1 THEN
    IF g < 6 THEN RETURN (g + 3) FI
  ELSEIF d == 2 THEN
    IF g % 3 > 0 THEN RETURN (g - 1) FI
  ELSEIF g >= 3 THEN
    RETURN (g - 3)
  FI
RETURN (255)

BYTE ARRAY joined(9)                 ; a bit for each cell a cell is joined to
BYTE ARRAY njoin(9)                  ; how many corridors meet at a cell
BYTE ARRAY conn(9)                   ; the cells the walk has reached

PROC Join(BYTE a, BYTE b)
  BYTE t
  IF b < a THEN
    t = a
    a = b
    b = t
  FI
  IF joined(a) & (1 << (b - a)) THEN RETURN FI
  joined(a) = joined(a) | (1 << (b - a))
  njoin(a) += 1
  njoin(b) += 1
  IF b == a + 1 THEN JoinAcross(a, b) ELSE JoinDown(a, b) FI
RETURN

; where a turn's two corridors leave it the same way they lie over each
; other, and the turn is left a stub going nowhere: rock again, from the
; turn back to where they part
PROC Prune(BYTE x, BYTE y)
  BYTE i, n, nx, ny, k
  DO
    IF Kind(x, y) <> K_CORR THEN RETURN FI
    n = 0
    FOR i = 1 TO 7 STEP 2 DO
      k = Kind(x + dir_dx(i), y + dir_dy(i))
      IF k <> K_ROCK AND k <> K_WALL THEN
        n += 1
        nx = x + dir_dx(i)
        ny = y + dir_dy(i)
      FI
    OD
    IF n <> 1 THEN RETURN FI
    SetKind(x, y, K_ROCK)
    x = nx
    y = ny
  OD
RETURN

; a room of the stairs is never shut in by secret doors alone: one of
; them made a plain door if it has no other
PROC Unseal(BYTE g)
  BYTE x, y, k, sx, sy
  sx = 255
  FOR y = ry1(g) TO ry2(g) DO
    FOR x = rx1(g) TO rx2(g) DO
      k = Kind(x, y)
      IF k == K_DOORC OR k == K_DOORO OR k == K_DOORWAY THEN RETURN FI
      IF k == K_SDOOR THEN
        sx = x
        sy = y
      FI
    OD
  OD
  IF sx <> 255 THEN SetKind(sx, sy, K_DOORC) FI
RETURN

; a cell somewhere inside a room that is a room, on its floor
FUNC CARD RoomSpot(BYTE r)
  BYTE x, y, tries
  CARD s
  FOR tries = 1 TO 40 DO
    x = rx1(r) + 1 + Rnd(rx2(r) - rx1(r) - 1)
    y = ry1(r) + 1 + Rnd(ry2(r) - ry1(r) - 1)
    IF lv(Idx(x, y)) & (15 | F_TRAP) == K_FLOOR AND mat(Idx(x, y)) == 0 THEN
      s = x                          ; a shift keeps its left side's width: widen first
      RETURN ((s << 8) | y)
    FI
  OD
RETURN ($FFFF)

PROC Stair(BYTE r, BYTE k)
  BYTE x, y
  CARD s
  s = RoomSpot(r)
  x = s >> 8
  y = s
  SetKind(x, y, k)
  IF k == K_UP THEN
    upx = x
    upy = y
  ELSE
    dnx = x
    dny = y
  FI
RETURN

; ------------------------------------------------------------- the traps
CONST TF_SEEN = 1
CONST TF_ONCE = 2
; NetHack's rubouts: a letter wiped becomes the one below it, or ?
BYTE ARRAY ru_from = "ABCDEFGHIKLMNOPQRTUVWZbdeghjklmnoqwy:;,="
BYTE ARRAY ru_to = "^P(|||C||||||CFCP|J/V/|cccni||nrccvv.,.-"
BYTE ARRAY elbereth = "elbereth"
BYTE ARRAY platino = "platino"

CONST OF_UNPAID = 16                 ; in the pack, the shop's until paid for
CONST OF_DEAR = 32                   ; one in four of a shop's things: dearer while its kind is unknown
CONST OF_NOCHG = 64                  ; on a shop's floor, the hero's own
CONST S_HOSTILE = 8                  ; a peaceful kind of monster made angry
CONST S_PEACE = 16                   ; a hostile kind made peaceful: the Oracle's centaurs, the town's gnomes
CARD shdebt                          ; what the hero has used up unpaid, not parked: it is settled or stolen on leaving

FUNC BYTE TrapAt(BYTE x, BYTE y)
  BYTE i
  IF x >= LW OR y >= LH THEN RETURN (255) FI
  IF lv(Idx(x, y)) & F_TRAP == 0 THEN RETURN (255) FI
  FOR i = 0 TO MAXTRAP - 1 DO
    IF tt(i) <> 255 AND tx(i) == x AND ty(i) == y THEN RETURN (i) FI
  OD
RETURN (255)

; the boulder on a cell -- always the only thing there -- or 255
FUNC BYTE BoulderAt(BYTE x, BYTE y)
  BYTE i
  IF x >= LW OR y >= LH THEN RETURN (255) FI
  i = oat(Idx(x, y))
  IF i THEN
    IF ot(i - 1) == O_BOULDER THEN RETURN (i - 1) FI
  FI
RETURN (255)

PROC DelTrap(BYTE i)
  CARD c
  c = Idx(tx(i), ty(i))
  lv(c) = lv(c) & (255 ^ F_TRAP)
  tt(i) = 255
RETURN

; ------------------------------------------------------------- the objects
; an enchantment or a charge count is a byte; enchantments go below zero
FUNC INT Signed(BYTE v)
  INT e
  e = v
  IF e > 127 THEN e = e - 256 FI
RETURN (e)

; the top thing on a cell is the highest-numbered one there
PROC TopObj(BYTE x, BYTE y)
  BYTE i, top
  top = 0
  FOR i = 0 TO MAXOBJ - 1 DO
    IF ot(i) <> 255 AND ox(i) == x AND oy(i) == y THEN top = i + 1 FI
  OD
  oat(Idx(x, y)) = top
RETURN

; a thing onto the floor, on top of what is there; 255 if the level has
; no room for more
FUNC BYTE PutObj(BYTE t, BYTE q, BYTE f, BYTE e, BYTE x, BYTE y)
  BYTE i
  FOR i = 0 TO MAXOBJ - 1 DO
    IF ot(i) == 255 THEN
      ot(i) = t
      oq(i) = q
      of(i) = f
      oe(i) = e
      ox(i) = x
      oy(i) = y
      IF x < LW THEN oat(Idx(x, y)) = i + 1 FI
      RETURN (i)
    FI
  OD
RETURN (255)

PROC TakeObj(BYTE i)
  ot(i) = 255
  TopObj(ox(i), oy(i))
RETURN

; a kind of a class, as often as objects.c's probabilities say
FUNC BYTE PickKind(BYTE cls)
  BYTE t
  CARD total, r
  total = 0
  FOR t = 0 TO N_OBJ - 1 DO
    IF o_class(t) == cls THEN total += o_prob(t) FI
  OD
  r = Rnd(total)
  FOR t = 0 TO N_OBJ - 1 DO
    IF o_class(t) == cls THEN
      IF r < o_prob(t) THEN RETURN (t) FI
      r -= o_prob(t)
    FI
  OD
RETURN (0)

; NetHack's mkobj() odds among the classes the game has -- weapons 10,
; armour 10, potions 16, scrolls 16, wands 4, rings 3, amulets 1
FUNC BYTE MkKind()
  BYTE r
  r = Rnd(60)
  IF r < 10 THEN RETURN (PickKind(C_WEAPON)) FI
  IF r < 20 THEN RETURN (PickKind(C_ARMOR)) FI
  IF r < 36 THEN RETURN (PickKind(C_POTION)) FI
  IF r < 52 THEN RETURN (PickKind(C_SCROLL)) FI
  IF r < 56 THEN RETURN (PickKind(C_WAND)) FI
  IF r < 59 THEN RETURN (PickKind(C_RING)) FI
RETURN (O_LIFESAVING)

; mksobj()'s blessings, curses, enchantments and charges for a new thing
; of kind t, into nf and ne: a weapon or armour one in eleven enchanted
; and half of those blessed, else one in ten cursed and enchanted down; a
; potion, scroll or amulet one in four blessed or cursed; a wand 4-8
; charges, 11-15 if it needs no direction; a ring of protection or
; increase damage +1 to +3, one in four of them cursed and negative
PROC Bless(BYTE t)
  BYTE c
  c = o_class(t)
  nf = 0
  ne = 0
  IF c == C_WEAPON OR c == C_ARMOR THEN
    IF Rnd(11) == 0 THEN
      ne = Roll(3)
      IF Rnd(2) THEN nf = OF_BLESS FI
    ELSEIF Rnd(10) == 0 THEN
      nf = OF_CURSE
      ne = 256 - Roll(3)
    FI
  ELSEIF c == C_POTION OR c == C_SCROLL OR c == C_AMULET THEN
    IF Rnd(4) == 0 THEN
      IF Rnd(2) THEN nf = OF_BLESS ELSE nf = OF_CURSE FI
    FI
  ELSEIF c == C_WAND THEN
    IF o_slot(t) == D_NODIR THEN ne = 11 + Rnd(5) ELSE ne = 4 + Rnd(5) FI
  ELSEIF c == C_RING THEN
    IF t == O_RPROTECTION OR t == O_RDAMAGE THEN
      ne = Roll(3)
      IF Rnd(4) == 0 THEN
        nf = OF_CURSE
        ne = 256 - ne
      FI
    ELSEIF t == O_RTELEPORT AND Rnd(3) == 0 THEN
      nf = OF_CURSE
    FI
  FI
RETURN

PROC MkObj(BYTE x, BYTE y)
  BYTE t, i
  t = MkKind()
  Bless(t)
  i = PutObj(t, 1, nf, ne, x, y)
RETURN

; NetHack's mkgold(): a d(depth+2) times a d30 pile, kept to a byte
PROC MkGold(BYTE x, BYTE y)
  BYTE i
  CARD q
  q = Roll(depth + 2)
  q = q * Roll(30)
  IF q > 250 THEN q = 250 FI
  i = PutObj(O_GOLD, q, 0, 0, x, y)
RETURN

FUNC BYTE Wearing(BYTE t)
  IF uleft <> 255 THEN
    IF it(uleft) == t THEN RETURN (1) FI
  FI
  IF uright <> 255 THEN
    IF it(uright) == t THEN RETURN (1) FI
  FI
RETURN (0)

; what the rings of a kind worn add up to
FUNC INT RingEnch(BYTE t)
  INT e
  e = 0
  IF uleft <> 255 THEN
    IF it(uleft) == t THEN e = e + Signed(ie(uleft)) FI
  FI
  IF uright <> 255 THEN
    IF it(uright) == t THEN e = e + Signed(ie(uright)) FI
  FI
RETURN (e)

; NetHack's armour class: ten, less each piece worn and its enchantment,
; less the rings of protection
PROC CalcAC()
  BYTE s, k
  INT a
  a = 10
  FOR s = 1 TO 6 DO
    k = worn(s)
    IF k <> 255 THEN a = a - o_arg(it(k)) - Signed(ie(k)) FI
  OD
  uac = a - RingEnch(O_RPROTECTION) - uprot
RETURN

; q of the pack's letter k gone; when none is left, it is no longer worn
PROC InvDel(BYTE k, BYTE q)
  BYTE s
  IF iq(k) > q THEN
    iq(k) -= q
    RETURN
  FI
  it(k) = 255
  IF uwep == k THEN uwep = 255 FI
  IF uleft == k THEN uleft = 255 FI
  IF uright == k THEN uright = 255 FI
  IF uamul == k THEN uamul = 255 FI
  FOR s = 1 TO 6 DO
    IF worn(s) == k THEN worn(s) = 255 FI
  OD
  CalcAC()
RETURN

; a thing into the pack: daggers, potions and scrolls onto a stack of
; their own like, else the first free letter; 255 if the pack is full
FUNC BYTE InvAdd(BYTE t, BYTE q, BYTE f, BYTE e)
  BYTE k, c
  c = o_class(t)
  IF t == O_DAGGER OR c == C_POTION OR c == C_SCROLL THEN
    FOR k = 0 TO MAXINV - 1 DO
      IF it(k) == t AND ifl(k) == f AND ie(k) == e AND uwep <> k AND iq(k) < 240 THEN
        iq(k) += q
        RETURN (k)
      FI
    OD
  FI
  FOR k = 0 TO MAXINV - 1 DO
    IF it(k) == 255 THEN
      it(k) = t
      iq(k) = q
      ifl(k) = f
      ie(k) = e
      RETURN (k)
    FI
  OD
RETURN (255)

FUNC BYTE HasAmulet()
  BYTE k
  FOR k = 0 TO MAXINV - 1 DO
    IF it(k) == O_MOTT THEN RETURN (1) FI
  OD
RETURN (0)

; ----------------------------------------------------------- the monsters
; a file on MOTT's drive opened at an offset: the page Title found it on
PROC FOpen(CARD page, CARD off)
  CARD lo, at
  BYTE hi
  lo = page & 255
  lo = lo << 8
  at = lo + off
  hi = $10 + MDRIVE * 7 + (page >> 8)
  IF at < lo THEN hi += 1 FI
  FlashOpen(at, hi)
RETURN

; a name from MNAMES.DAT, into nbuf: record k, NAME_REC bytes each. One
; buffer, so a name is used before the next is asked for
BYTE ARRAY nbuf(NAME_REC)

FUNC BYTE POINTER NameRec(CARD k)
  FOpen(names_page, k * NAME_REC)
  nbuf(0) = FlashByte()
  FlashRead(nbuf + 1, nbuf(0))
  FlashClose()
RETURN (nbuf)

; a #"text" string from MOTT.STR, the compiler's file of them, into sbuf:
; its offset from the table at the front, then the string. One buffer, as
; for the names
BYTE ARRAY str_file = "MOTT    STR"

FUNC BYTE POINTER Str(CARD n)
  CARD o
  FOpen(str_page, n + n + 2)
  o = FlashByte()
  o = o + FlashByte() * 256
  FlashClose()
  FOpen(str_page, o)
  sbuf(0) = FlashByte()
  FlashRead(sbuf + 1, sbuf(0))
  FlashClose()
RETURN (sbuf)

; a message of MOTT.STR's: Msg(Str(n)) and MsgS(Str(n)) as one call each,
; eight bytes a place they are said rather than thirteen
PROC MsgD(CARD n)
  Msg(Str(n))
RETURN

PROC MsgSD(CARD n)
  MsgS(Str(n))
RETURN

FUNC BYTE POINTER MonName(BYTE t)
RETURN (NameRec(NAME_MON + t))

PROC Place(BYTE i)
  mat(Idx(mx(i), my(i))) = i + 1
RETURN

PROC Unplace(BYTE i)
  mat(Idx(mx(i), my(i))) = 0
RETURN

FUNC BYTE MonAt(BYTE x, BYTE y)
  IF x >= LW OR y >= LH THEN RETURN (0) FI
RETURN (mat(Idx(x, y)))

; a new monster of type t at (x, y): NetHack's hit points, a level's
; worth of eight-sided dice, or up to four at level 0; 255 if the level
; is full
FUNC BYTE NewMon(BYTE t, BYTE x, BYTE y)
  BYTE i, l
  FOR i = 0 TO MAXMON - 1 DO
    IF mstat(i) == 0 THEN
      mtype(i) = t
      l = m_lvl(t)
      mlev(i) = l
      IF l == 0 THEN mhp(i) = Roll(4) ELSE mhp(i) = Dice(l, 8) FI
      mhpmax(i) = mhp(i)
      mstat(i) = S_LIVE
      mmove(i) = Rnd(12)
      msl(i) = 0
      mflee(i) = 0
      mx(i) = x
      my(i) = y
      Place(i)
      RETURN (i)
    FI
  OD
RETURN (255)

; which kind of monster: NetHack's choice by difficulty -- no harder than
; half the depth and the hero's level together, no easier than a sixth
; of the depth -- each as likely as its frequency says
FUNC BYTE PickType()
  BYTE t, lo, hi
  CARD total, r
  hi = (depth + ulev) / 2
  IF hi < 1 THEN hi = 1 FI
  lo = depth / 6
  total = 0
  FOR t = 0 TO N_MON - 1 DO
    IF m_flag(t) & MF_NOGEN == 0 AND m_diff(t) >= lo AND m_diff(t) <= hi THEN total += m_freq(t) FI
  OD
  IF total == 0 THEN RETURN (M_NEWT) FI
  r = Rnd(total)
  FOR t = 0 TO N_MON - 1 DO
    IF m_flag(t) & MF_NOGEN == 0 AND m_diff(t) >= lo AND m_diff(t) <= hi THEN
      IF r < m_freq(t) THEN RETURN (t) FI
      r -= m_freq(t)
    FI
  OD
RETURN (M_NEWT)

; a free open cell next to (x, y), as dir 1-8, or 0
FUNC BYTE FreeNear(BYTE x, BYTE y)
  BYTE d, k, nx, ny
  k = Rnd(8)
  FOR d = 1 TO 8 DO
    k = (k % 8) + 1
    nx = x + dir_dx(k)
    ny = y + dir_dy(k)
    IF nx < LW AND ny < LH THEN
      IF Open(Kind(nx, ny)) AND MonAt(nx, ny) == 0 AND (nx <> px OR ny <> py) THEN RETURN (k) FI
    FI
  OD
RETURN (0)

; a monster, and its fellows round it if it comes in a group -- smaller
; groups while the hero is new, as NetHack does
PROC Spawn(BYTE x, BYTE y)
  BYTE t, i, n, d
  t = PickType()
  i = NewMon(t, x, y)
  IF i == 255 THEN RETURN FI
  n = 0
  IF m_flag(t) & MF_SGROUP THEN n = Rnd(3) FI
  IF m_flag(t) & MF_LGROUP THEN n = Rnd(6) FI
  IF ulev < 3 THEN n = n / 2 FI
  WHILE n > 0 DO
    n -= 1
    d = FreeNear(x, y)
    IF d THEN i = NewMon(t, x + dir_dx(d), y + dir_dy(d)) FI
  OD
RETURN

; a monster arriving out of sight, one turn in seventy
; a free floor or corridor cell anywhere on the level -- no monster, thing
; or trap on it, and not the hero's -- or $FFFF
FUNC CARD AnySpot()
  BYTE x, y, tries, k
  CARD i, s
  FOR tries = 1 TO 250 DO
    x = Rnd(LW)
    y = Rnd(LH)
    i = Idx(x, y)
    k = lv(i) & (15 | F_TRAP)
    IF (k == K_FLOOR OR k == K_CORR) AND mat(i) == 0 AND oat(i) == 0 AND (x <> px OR y <> py) THEN
      s = x
      RETURN ((s << 8) | y)
    FI
  OD
RETURN ($FFFF)

PROC SpawnSomewhere()
  BYTE tries
  CARD s
  FOR tries = 1 TO 20 DO
    s = AnySpot()
    IF s <> $FFFF THEN
      IF lv(Idx(s >> 8, s)) & F_VIS == 0 THEN
        Spawn(s >> 8, s)
        RETURN
      FI
    FI
  OD
RETURN

; a monster peaceful by its kind, or made so, and not made angry
FUNC BYTE Peaceful(BYTE i)
  IF mstat(i) & S_HOSTILE THEN RETURN (0) FI
  IF mstat(i) & S_PEACE THEN RETURN (1) FI
RETURN (m_flag(mtype(i)) & MF_PEACE)

FUNC BYTE FindPet()
  BYTE i
  FOR i = 0 TO MAXMON - 1 DO
    IF mstat(i) & S_PET THEN RETURN (i) FI
  OD
RETURN (255)

; NetHack's mktrap(): a trap somewhere in room g, of a kind no harder than
; the depth allows, and no trap door on the bottom level
PROC MkTrapAt(BYTE k, BYTE x, BYTE y, BYTE f)
  BYTE i
  CARD c
  FOR i = 0 TO MAXTRAP - 1 DO
    IF tt(i) == 255 THEN
      tt(i) = k
      tx(i) = x
      ty(i) = y
      tf(i) = f
      c = Idx(x, y)
      lv(c) = lv(c) | F_TRAP
      RETURN
    FI
  OD
RETURN

PROC MkTrap(BYTE g)
  BYTE k
  CARD s
  s = RoomSpot(g)
  IF s == $FFFF THEN RETURN FI
  DO
    k = Rnd(N_TRAP)
  UNTIL depth >= tr_min(k) AND (k <> TR_TRAPDOOR OR depth < MAXDEPTH) OD
  MkTrapAt(k, s >> 8, s, 0)
RETURN

; ---------------------------------------------------------------- shops
; the doors in room g's walls, the last found into shdx, shdy
FUNC BYTE Doors(BYTE g)
  BYTE x, y, k, n
  n = 0
  FOR y = ry1(g) TO ry2(g) DO
    FOR x = rx1(g) TO rx2(g) DO
      IF x == rx1(g) OR x == rx2(g) OR y == ry1(g) OR y == ry2(g) THEN
        k = Kind(x, y)
        IF k == K_DOORC OR k == K_DOORO OR k == K_DOORWAY OR k == K_SDOOR THEN
          n += 1
          shdx = x
          shdy = y
        FI
      FI
    OD
  OD
RETURN (n)

; NetHack's mkshop() and stock_room(): a room with one door and no stairs,
; lit; a kind by shknam.c's odds, a big room no wand shop; the keeper on
; the post inside the door with 1000 to 4000 gold; a thing on every floor
; cell but the row along the door's wall, while the level has room for
PROC MkShop(BYTE u, BYTE d)
  BYTE g, x, y, r, i, t, c
  CARD k
  shroom = 255
  FOR g = 0 TO 8 DO
    IF rgone(g) == 0 AND g <> u AND g <> d AND shroom == 255 AND RoomAt(brx, bry) <> g THEN
      IF Doors(g) == 1 THEN shroom = g FI
    FI
  OD
  IF shroom == 255 THEN RETURN FI
  r = Rnd(SHOP_ODDS)
  t = 0
  WHILE r >= sh_prob(t) DO
    r -= sh_prob(t)
    t += 1
  OD
  MkShopIn(shroom, t)
RETURN

PROC MkShopIn(BYTE g, BYTE st)
  BYTE x, y, r, i, t, c
  CARD k
  shroom = g
  shtype = st
  Doors(g)
  k = Kind(shdx, shdy)
  IF k == K_SDOOR THEN SetKind(shdx, shdy, K_DOORC) FI
  IF k == K_DOORWAY THEN SetKind(shdx, shdy, K_DOORO) FI
  spx = shdx
  spy = shdy
  IF shdx == rx1(g) THEN spx += 1 FI
  IF shdx == rx2(g) THEN spx -= 1 FI
  IF shdy == ry1(g) THEN spy += 1 FI
  IF shdy == ry2(g) THEN spy -= 1 FI
  IF shtype == SH_WAND AND (rx2(g) - rx1(g) - 1) * (ry2(g) - ry1(g) - 1) > 20 THEN shtype = SH_GENERAL FI
  shname = Rnd(8)
  shvis = 0
  shrob = 0
  shgold = 1000 + 30 * Roll(100)
  shk = NewMon(M_SHOPKEEPER, spx, spy)
  FOR y = ry1(g) + 1 TO ry2(g) - 1 DO
    FOR x = rx1(g) + 1 TO rx2(g) - 1 DO
      IF lv(Idx(x, y)) & F_TRAP == 0 THEN lv(Idx(x, y)) = lv(Idx(x, y)) | F_LIT FI
      c = 1
      IF (shdx == rx1(g) AND x == rx1(g) + 1) OR (shdx == rx2(g) AND x == rx2(g) - 1) THEN c = 0 FI
      IF (shdy == ry1(g) AND y == ry1(g) + 1) OR (shdy == ry2(g) AND y == ry2(g) - 1) THEN c = 0 FI
      i = 0
      FOR r = 0 TO MAXOBJ - 1 DO
        IF ot(r) == 255 THEN i += 1 FI
      OD
      IF c AND i > 6 THEN
        r = Rnd(20)
        IF shtype == SH_GENERAL THEN
          t = MkKind()
        ELSEIF shtype == SH_ARMOR THEN
          IF r < 18 THEN t = PickKind(C_ARMOR) ELSE t = PickKind(C_WEAPON) FI
        ELSEIF shtype == SH_SCROLL THEN
          t = PickKind(C_SCROLL)
        ELSEIF shtype == SH_POTION THEN
          t = PickKind(C_POTION)
        ELSEIF shtype == SH_WEAPON THEN
          IF r < 18 THEN t = PickKind(C_WEAPON) ELSE t = PickKind(C_ARMOR) FI
        ELSEIF shtype == SH_RING THEN
          IF r < 19 THEN t = PickKind(C_RING) ELSE t = O_LIFESAVING FI
        ELSE
          t = PickKind(C_WAND)
          IF r == 18 THEN t = O_GLOVES FI
          IF r == 19 THEN t = O_CLOAK FI
        FI
        Bless(t)
        IF Rnd(4) == 0 THEN nf = nf | OF_DEAR FI
        i = PutObj(t, 1, nf, ne, x, y)
      FI
    OD
  OD
RETURN

FUNC BYTE ShkOk()
  IF shroom == 255 THEN RETURN (0) FI
  IF mstat(shk) == 0 OR mtype(shk) <> M_SHOPKEEPER THEN RETURN (0) FI
RETURN (1)

; the shop's room, its walls and door among it
FUNC BYTE InRect(BYTE r, BYTE x, BYTE y)
  IF r == 255 THEN RETURN (0) FI
  IF x < rx1(r) OR x > rx2(r) OR y < ry1(r) OR y > ry2(r) THEN RETURN (0) FI
RETURN (1)

FUNC BYTE InShop(BYTE x, BYTE y)
RETURN (InRect(shroom, x, y))

PROC ShkName()
  MsgS(NameRec(NAME_SHK + shtype * 8 + shname))
RETURN

; NetHack's get_cost() for one, or set_cost() when the keeper buys:
; objects.c's cost, ten a point of a weapon's or armour's enchantment,
; uncursed water nothing; a third more for one in four of a kind not
; known, a third more again from an angry keeper; half when selling, and
; a quarter less of that for the same ones
FUNC CARD Price(BYTE t, BYTE f, BYTE e, BYTE sell)
  CARD p
  BYTE c
  p = o_cost(t)
  c = o_class(t)
  IF (c == C_WEAPON OR c == C_ARMOR) AND e > 0 AND e < 128 THEN p = p + e * 10 FI
  IF t == O_WATER AND f & (OF_BLESS | OF_CURSE) == 0 THEN p = 0 FI
  IF sell THEN
    IF known(t) == 0 AND f & OF_DEAR THEN RETURN ((p * 30 / 8 + 5) / 10) FI
    RETURN ((p * 5 + 5) / 10)
  FI
  IF p == 0 THEN p = 5 FI
  IF known(t) == 0 AND f & OF_DEAR THEN p = (p * 40 / 3 + 5) / 10 FI
  IF mstat(shk) & S_HOSTILE THEN p = p + (p + 2) / 3 FI
RETURN (p)

; what the hero owes the shop: the unpaid things and what is used up
FUNC CARD Bill()
  BYTE k
  CARD b
  b = shdebt
  FOR k = 0 TO MAXINV - 1 DO
    IF it(k) <> 255 AND ifl(k) & OF_UNPAID THEN b = b + Price(it(k), ifl(k), ie(k), 0) * iq(k) FI
  OD
RETURN (b)

; what the hero owes for a thing used up unpaid
PROC Owe(CARD p)
  shdebt = shdebt + p
  mbl = 0
  MsgSD(#"You owe ")
  ShkName()
  MsgC(' ')
  MsgN(p)
  MsgS(" zorkmids.")
  MsgEnd()
RETURN

; the pack's unpaid things the hero's own, the debt gone
PROC ClearUnpaid()
  BYTE k
  FOR k = 0 TO MAXINV - 1 DO
    ifl(k) = ifl(k) & (255 ^ (OF_UNPAID | OF_DEAR))
  OD
  shdebt = 0
RETURN

; NetHack's rob_shop(): out of the shop, or off the level, owing; the
; keeper angry, the things the hero's, and the reckoning kept
PROC Rob()
  BYTE k
  CARD b
  b = Bill()
  IF ShkOk() == 0 THEN ClearUnpaid() FI
  IF b == 0 OR ShkOk() == 0 THEN RETURN FI
  MsgD(#"You escaped the shop without paying!")
  mbl = 0
  MsgSD(#"You stole ")
  MsgN(b)
  MsgSD(#" zorkmids worth of merchandise.")
  MsgEnd()
  ClearUnpaid()
  shrob = shrob + b
  mstat(shk) = mstat(shk) | S_HOSTILE
  IF role <> 2 THEN
    IF ualign == 0 THEN urec -= 1 FI
    IF ualign == 2 THEN urec += 1 FI
  FI
RETURN

; Rogue's level: nine cells of a three by three grid, most of them a room
; and a few only a turn in a corridor; every cell joined to the rest by a
; walk from one to a neighbour not yet joined, then a few loops more;
; then its monsters, one in three rooms, never in the room of the stairs
; the hero comes down
; a level empty: rock, no monster, thing, trap, writing, room, shop,
; temple or branch
PROC ClearLevel()
  BYTE g
  CARD i
  FOR i = 0 TO NCELL - 1 DO
    lv(i) = 0
    mat(i) = 0
    oat(i) = 0
  OD
  FOR g = 0 TO MAXMON - 1 DO mstat(g) = 0 OD
  FOR g = 0 TO MAXOBJ - 1 DO ot(g) = 255 OD
  FOR g = 0 TO MAXTRAP - 1 DO tt(g) = 255 OD
  FOR g = 0 TO MAXENGR - 1 DO ex(g) = 255 OD
  FOR g = 0 TO 8 DO rgone(g) = 1 OD
  shroom = 255
  troom = 255
  brx = 255
  bry = 255
RETURN

PROC MakeLevel()
  BYTE g, x0, y0, w, h, x, y, gone, lit, a, b, d, n, u, k
  CARD i, s
  ClearLevel()
  lit = 9
  IF depth > 4 THEN lit = 7 FI
  IF depth > 8 THEN lit = 5 FI
  gone = 0
  FOR g = 0 TO 8 DO
    x0 = (g % 3) * 13 + 1
    y0 = (g / 3) * 8
    joined(g) = 0
    njoin(g) = 0
    rgone(g) = 0
    IF gone < 2 AND Rnd(5) == 0 THEN
      gone += 1
      rgone(g) = 1
      rx1(g) = x0 + 1 + Rnd(10)
      ry1(g) = y0 + 1 + Rnd(5)
      rx2(g) = rx1(g)
      ry2(g) = ry1(g)
      SetKind(rx1(g), ry1(g), K_CORR)
    ELSE
      w = 5 + Rnd(8)
      h = 4 + Rnd(4)
      rx1(g) = x0 + Rnd(13 - w)
      ry1(g) = y0 + Rnd(8 - h)
      rx2(g) = rx1(g) + w - 1
      ry2(g) = ry1(g) + h - 1
      k = K_FLOOR
      IF Rnd(10) < lit THEN k = K_FLOOR | F_LIT FI
      FOR y = ry1(g) TO ry2(g) DO
        FOR x = rx1(g) TO rx2(g) DO
          IF x == rx1(g) OR x == rx2(g) OR y == ry1(g) OR y == ry2(g) THEN
            SetKind(x, y, K_WALL)
          ELSE
            lv(Idx(x, y)) = k
          FI
        OD
      OD
    FI
  OD
  FOR g = 0 TO 8 DO conn(g) = 0 OD
  g = Rnd(9)
  conn(g) = 1
  n = 1
  WHILE n < 9 DO
    a = Rnd(9)
    IF conn(a) THEN
      b = Beside(a, Rnd(4))
      IF b <> 255 THEN
        IF conn(b) == 0 THEN
          Join(a, b)
          conn(b) = 1
          n += 1
        FI
      FI
    FI
  OD
  FOR g = 0 TO 8 DO                  ; a turn in a corridor goes on: no dead end
    d = Rnd(4)
    FOR n = 0 TO 3 DO
      b = Beside(g, (d + n) & 3)
      IF rgone(g) AND njoin(g) < 2 AND b <> 255 THEN Join(g, b) FI
    OD
  OD
  nxcor = 1                          ; NetHack's makecorridors(): four or more besides
  FOR n = 0 TO 3 + Rnd(3) DO
    a = Rnd(9)
    b = Beside(a, Rnd(4))
    IF b <> 255 THEN Join(a, b) FI
  OD
  nxcor = 0
  FOR g = 0 TO 8 DO
    IF rgone(g) THEN Prune(rx1(g), ry1(g)) FI
  OD
  DO
    u = Rnd(9)
  UNTIL rgone(u) == 0 OD
  Stair(u, K_UP)
  Unseal(u)
  d = 255
  shroom = 255
  IF depth < MAXDEPTH THEN
    DO
      d = Rnd(9)
    UNTIL rgone(d) == 0 AND d <> u OD
    Stair(d, K_DOWN)
    Unseal(d)
  FI
  IF lvl == mines_at OR lvl == oracle_at - 1 THEN   ; the mines' stairs down, Sokoban's up
    DO
      b = Rnd(9)
    UNTIL rgone(b) == 0 AND b <> u AND b <> d OD
    s = RoomSpot(b)
    IF s <> $FFFF THEN
      brx = s >> 8
      bry = s
      IF lvl == mines_at THEN SetKind(brx, bry, K_DOWN) ELSE SetKind(brx, bry, K_UP) FI
    FI
  FI
  IF depth > 1 AND Rnd(depth) < 3 THEN MkShop(u, d) FI
  IF lvl == MAXDEPTH THEN              ; the Amulet, and the Wizard of Mott asleep beside it
    DO
      a = Rnd(9)
    UNTIL rgone(a) == 0 AND a <> u AND a <> shroom OD
    s = RoomSpot(a)
    IF s <> $FFFF THEN
      n = PutObj(O_MOTT, 1, 0, 0, s >> 8, s)
      d = FreeNear(s >> 8, s)
      IF d THEN
        k = NewMon(M_WIZARDOFMOTT, (s >> 8) + dir_dx(d), s + dir_dy(d))
        IF k <> 255 THEN msl(k) = 255 FI
      FI
    FI
  FI
  FOR g = 0 TO 8 DO
    IF rgone(g) == 0 AND g <> u AND g <> shroom AND Rnd(3) == 0 THEN
      s = RoomSpot(g)
      IF s <> $FFFF THEN Spawn(s >> 8, s) FI
    FI
  OD
  ; NetHack's room filling: gold one room in three, and a thing one room
  ; in three with a one in five chance of another after each
  FOR g = 0 TO 8 DO
    IF rgone(g) == 0 AND g <> shroom THEN
      k = 8 - depth / 6
      WHILE Rnd(k) == 0 DO MkTrap(g) OD
      IF Rnd(3) == 0 THEN
        s = RoomSpot(g)
        IF s <> $FFFF THEN MkGold(s >> 8, s) FI
      FI
      IF Rnd(10) == 0 THEN
        s = RoomSpot(g)
        IF s <> $FFFF THEN SetKind(s >> 8, s, K_FOUNTAIN) FI
      FI
      IF Rnd(20) == 0 THEN
        s = RoomSpot(g)
        IF s <> $FFFF THEN SetKind(s >> 8, s, K_ALTAR + Rnd(3)) FI
      FI
      IF Rnd(3) == 0 THEN
        DO
          s = RoomSpot(g)
          IF s <> $FFFF THEN MkObj(s >> 8, s) FI
        UNTIL Rnd(5) <> 0 OD
      FI
    FI
  OD
RETURN

; ------------------------------------------------------- special levels
; NetHack's mkmap() for the mines' caves: two cells in five floor at random,
; its three passes of counting neighbours, every cave joined to the first by
; a corridor dug across and down, and the rock beside floor walled. While it
; is made a cell is 1 for floor and 0 for rock, so a count is a sum; the
; passes and the joining's flood walk lv, mat and oat at their fixed
; addresses, and are assembly for their size and their speed
BYTE cpass

; one pass over the cells inside the edge: the first in place -- two or
; fewer floor neighbours rock, five or more floor -- the others into mat,
; the second making rock of five, the third and fourth of fewer than three
PROC CavePass()
  ASM
        LDW  X,#$0829
        LDW  Y,#$0BE9
        MOV  R1,#1
.c:     CLR  R2
        LD   R0,[X-41]
        ADD  R2,R0
        LD   R0,[X-40]
        ADD  R2,R0
        LD   R0,[X-39]
        ADD  R2,R0
        LD   R0,[X-1]
        ADD  R2,R0
        LD   R0,[X+1]
        ADD  R2,R0
        LD   R0,[X+39]
        ADD  R2,R0
        LD   R0,[X+40]
        ADD  R2,R0
        LD   R0,[X+41]
        ADD  R2,R0
        LD   R0,[X]
        LD   R3,[v_cpass]
        TST  R3
        BNE  .p1
        CMP  R2,#3
        BHS  .a
        CLR  R0
.a:     CMP  R2,#5
        BLO  .s
        MOV  R0,#1
.s:     ST   [X],R0
        BRA  .n
.p1:    CMP  R3,#1
        BNE  .p3
        CMP  R2,#5
        BNE  .m
        CLR  R0
        BRA  .m
.p3:    CMP  R2,#3
        BHS  .m
        CLR  R0
.m:     ST   [Y],R0
.n:     INCW X
        INCW Y
        ADD  R1,#1
        CMP  R1,#39
        BNE  .c
        ADDW X,#2
        ADDW Y,#2
        MOV  R1,#1
        MOV  R0,XH
        CMP  R0,#$0B
        BNE  .c
        MOV  R0,XL
        CMP  R0,#$99
        BNE  .c
  ENDASM
RETURN

; the cave oat marks with 1 grown over every floor cell beside it, sweeping
; forwards and back until a sweep marks nothing
PROC CaveFlood()
  ASM
.g:     CLR  R3
        LDW  X,#$0829
        LDW  Y,#$0FA9
.f:     CALL .k
        INCW X
        INCW Y
        MOV  R0,XH
        CMP  R0,#$0B
        BNE  .f
        MOV  R0,XL
        CMP  R0,#$97
        BNE  .f
.b:     DECW X
        DECW Y
        CALL .k
        MOV  R0,XH
        CMP  R0,#$08
        BNE  .b
        MOV  R0,XL
        CMP  R0,#$29
        BNE  .b
        TST  R3
        BNE  .g
        BRA  .x
.k:     LD   R0,[Y]
        BNE  .r
        LD   R0,[X]
        BEQ  .r
        LD   R0,[Y-1]
        LD   R1,[Y+1]
        OR   R0,R1
        LD   R1,[Y-40]
        OR   R0,R1
        LD   R1,[Y+40]
        OR   R0,R1
        BEQ  .r
        MOV  R0,#1
        ST   [Y],R0
        MOV  R3,#1
.r:     RET
.x:
  ENDASM
RETURN

; mat copied over lv
PROC CaveCopy()
  ASM
        LDW  X,#$0800
        LDW  Y,#$0BC0
.l:     LD   R0,[Y]
        ST   [X],R0
        INCW X
        INCW Y
        MOV  R0,XH
        CMP  R0,#$0B
        BNE  .l
        MOV  R0,XL
        CMP  R0,#$C0
        BNE  .l
  ENDASM
RETURN

; the first floor cell inside the edge oat has not marked, into cidx: 919
; for none
CARD cidx

PROC CaveFind()
  ASM
        LDW  X,#$0829
        LDW  Y,#$0FA9
.l:     LD   R0,[X]
        BEQ  .n
        LD   R0,[Y]
        BEQ  .x
.n:     INCW X
        INCW Y
        MOV  R0,XH
        CMP  R0,#$0B
        BNE  .l
        MOV  R0,XL
        CMP  R0,#$97
        BNE  .l
.x:     ADDW X,#$F800
        STW  [v_cidx],X
  ENDASM
RETURN

; the cave's floor made K_FLOOR and oat cleared; then the rock round every
; floor cell walled
PROC CaveWalls()
  ASM
        LDW  X,#$0800
        LDW  Y,#$0F80
        CLR  R1
.c:     ST   [Y],R1
        LD   R0,[X]
        BEQ  .d
        MOV  R0,#2
        ST   [X],R0
.d:     INCW X
        INCW Y
        MOV  R0,XH
        CMP  R0,#$0B
        BNE  .c
        MOV  R0,XL
        CMP  R0,#$C0
        BNE  .c
        LDW  X,#$0829
        MOV  R1,#1
.w:     LD   R0,[X]
        CMP  R0,#2
        BNE  .n
        CALL .r
.n:     INCW X
        MOV  R0,XH
        CMP  R0,#$0B
        BNE  .w
        MOV  R0,XL
        CMP  R0,#$97
        BNE  .w
        BRA  .x
.r:     LD   R0,[X-41]
        BNE  .1
        ST   [X-41],R1
.1:     LD   R0,[X-40]
        BNE  .2
        ST   [X-40],R1
.2:     LD   R0,[X-39]
        BNE  .3
        ST   [X-39],R1
.3:     LD   R0,[X-1]
        BNE  .4
        ST   [X-1],R1
.4:     LD   R0,[X+1]
        BNE  .5
        ST   [X+1],R1
.5:     LD   R0,[X+39]
        BNE  .6
        ST   [X+39],R1
.6:     LD   R0,[X+40]
        BNE  .7
        ST   [X+40],R1
.7:     LD   R0,[X+41]
        BNE  .8
        ST   [X+41],R1
.8:     RET
.x:
  ENDASM
RETURN

FUNC CARD CaveSpot(BYTE xlo, BYTE xhi)
  BYTE x, y, tries
  CARD s
  FOR tries = 1 TO 250 DO
    x = xlo + Rnd(xhi - xlo)
    y = 1 + Rnd(22)
    IF lv(Idx(x, y)) == K_FLOOR AND mat(Idx(x, y)) == 0 THEN
      s = x
      RETURN ((s << 8) | y)
    FI
  OD
RETURN ($FFFF)

PROC CaveMon(BYTE t, BYTE n)
  BYTE i
  CARD s
  WHILE n > 0 DO
    s = CaveSpot(1, 39)
    IF s <> $FFFF THEN i = NewMon(t, s >> 8, s) FI
    n -= 1
  OD
RETURN

PROC MakeCave()
  BYTE x, y, n, p, jx, jy
  CARD i, j, c
  ClearLevel()
  c = 0
  WHILE c < 350 DO
    i = Idx(1 + Rnd(38), 1 + Rnd(22))
    IF lv(i) == 0 THEN
      lv(i) = 1
      c += 1
    FI
  OD
  FOR p = 0 TO 3 DO
    cpass = p
    CavePass()
    IF p THEN CaveCopy() FI
  OD
  CaveFind()
  j = cidx
  IF j == 919 THEN
    j = 500
    lv(j) = 1
  FI
  jx = j % LW
  jy = j / LW
  DO
    FOR i = 0 TO NCELL - 1 DO
      oat(i) = 0
      mat(i) = 0
    OD
    oat(j) = 1
    CaveFlood()
    CaveFind()
    IF cidx == 919 THEN EXIT FI
    x = cidx % LW
    y = cidx / LW
    WHILE x <> jx DO
      lv(Idx(x, y)) = 1
      IF x < jx THEN x += 1 ELSE x -= 1 FI
    OD
    WHILE y <> jy DO
      lv(Idx(x, y)) = 1
      IF y < jy THEN y += 1 ELSE y -= 1 FI
    OD
  OD
  CaveWalls()
  c = CaveSpot(1, 13)
  upx = c >> 8
  upy = c
  SetKind(upx, upy, K_UP)
  IF lvl < L_MINEEND THEN
    c = CaveSpot(27, 39)
    dnx = c >> 8
    dny = c
    SetKind(dnx, dny, K_DOWN)
  FI
  CaveMon(M_GNOME, 4)
  CaveMon(M_GNOMELORD, 1)
  CaveMon(M_DWARF, 1)
  CaveMon(M_HILLORC, 1)
  n = 3
  IF lvl == L_MINEEND THEN n = 7 FI
  FOR p = 1 TO n DO
    c = CaveSpot(1, 39)
    IF c <> $FFFF THEN MkObj(c >> 8, c) FI
    c = CaveSpot(1, 39)
    IF c <> $FFFF THEN MkGold(c >> 8, c) FI
  OD
RETURN

; a special level from MLEVELS.DAT: its cells, rooms and stairs, then its
; features -- monsters, peaceful ones, things, gold, traps, the shop, the
; temple, monsters at random, and Sokoban's map known from the start

PROC LoadSpecial(BYTE n)
  BYTE f, c, a, x, y, i
  CARD k
  ClearLevel()
  FOpen(levels_page, SPEC_REC * n)
  FlashRead(lv, NCELL)
  FlashRead(rx1, 51)
  FlashRead(feat, 80)
  FlashClose()
  FOR f = 0 TO MAXFEAT - 1 DO
    k = f * 4
    c = feat(k)
    a = feat(k + 1)
    x = feat(k + 2)
    y = feat(k + 3)
    IF c == FT_MON OR c == FT_PEACE THEN
      i = NewMon(a, x, y)
      IF c == FT_PEACE AND i <> 255 THEN mstat(i) = mstat(i) | S_PEACE FI
    ELSEIF c == FT_OBJ THEN
      nf = 0
      ne = 0
      IF a <> O_BOULDER THEN Bless(a) FI
      i = PutObj(a, 1, nf, ne, x, y)
    ELSEIF c == FT_GOLD THEN
      i = PutObj(O_GOLD, a * 5, 0, 0, x, y)
    ELSEIF c == FT_TRAP THEN
      MkTrapAt(a, x, y, TF_SEEN)
    ELSEIF c == FT_SHOP THEN
      MkShopIn(a, x)
    ELSEIF c == FT_TEMPLE THEN
      troom = a
      talign = Rnd(3)
      tpri = NewMon(M_PRIEST, x, y)
      FOR y = ry1(a) TO ry2(a) DO
        FOR x = rx1(a) TO rx2(a) DO
          IF Kind(x, y) >= K_ALTAR THEN SetKind(x, y, K_ALTAR + talign) FI
        OD
      OD
    ELSEIF c == FT_SPAWN THEN
      FOR i = 1 TO a DO SpawnSomewhere() OD
    ELSEIF c == FT_PREMAP THEN
      FOR k = 0 TO NCELL - 1 DO
        IF lv(k) & 15 <> K_ROCK THEN lv(k) = lv(k) | F_SEEN FI
      OD
    FI
  OD
RETURN

; the level parked in its VRAM slot, or brought back from it
FUNC CARD Slot(BYTE d)
  CARD s
  s = d - 1
RETURN (SLOT_BASE + (s << 10) + (s << 9))

PROC ForgetView()
  BYTE k
  CARD i
  k = 0
  WHILE k < nvis DO                  ; not FOR k = 0 TO nvis - 1: with none, that is 256
    i = vis(k)
    lv(i) = lv(i) & 127
    k += 1
  OD
  nvis = 0
RETURN

PROC Park()
  CARD s
  IF nvis THEN ForgetView() FI
  s = Slot(lvl)
  VWrite(s, lv, NCELL)
  VWrite(s + NCELL, rx1, &park_end - rx1)
RETURN

PROC SaveLevel()
  Rob()
  Park()
RETURN

PROC LoadLevel()
  CARD s, i
  BYTE m
  s = Slot(lvl)
  VRead(s, lv, NCELL)
  VRead(s + NCELL, rx1, &park_end - rx1)
  FOR i = 0 TO NCELL - 1 DO
    mat(i) = 0
    oat(i) = 0
  OD
  FOR m = 0 TO MAXMON - 1 DO
    IF mstat(m) THEN Place(m) FI
  OD
  FOR m = 0 TO MAXOBJ - 1 DO
    IF ot(m) <> 255 AND ox(m) < LW THEN oat(Idx(ox(m), oy(m))) = m + 1 FI
  OD
RETURN

; --------------------------------------------------------------- the view
PROC DrawCell(BYTE x, BYTE y)
  BYTE c, k, t, a, col, row, m
  CARD i
  IF x < vx OR x >= vx + VW OR y < vy OR y >= vy + VH THEN RETURN FI
  col = (x - vx) << 1
  row = VTOP + ((y - vy) << 1)
  IF x == px AND y == py THEN
    Pic(col, row, role << 2, (2 + anim) << 4)
    RETURN
  FI
  i = Idx(x, y)
  c = lv(i)
  IF c & F_SEEN == 0 THEN
    Blank(col, row)
    RETURN
  FI
  IF c & F_VIS THEN
    m = mat(i)
    IF m THEN
      Pic(col, row, (3 + mtype(m - 1)) << 2, (2 + anim) << 4)
      RETURN
    FI
    a = B_VIEW
  ELSE
    a = B_DIM
  FI
  m = oat(i)
  IF m THEN
    t = ot(m - 1)
    Pic(col, row, (o_pic(t) + ap(t)) << 2, 16 | a)
    RETURN
  FI
  IF c & F_TRAP THEN
    m = TrapAt(x, y)
    IF m <> 255 THEN
      IF tf(m) & TF_SEEN THEN
        Pic(col, row, T_TRAP + (tt(m) << 2), a)
        RETURN
      FI
    FI
  FI
  k = c & 15
  IF k == K_SCORR THEN
    Blank(col, row)
    RETURN
  FI
  IF k == K_WALL OR k == K_SDOOR THEN
    m = (WallLike(x, y - 1) << 3) | (WallLike(x, y + 1) << 2) | (WallLike(x - 1, y) << 1) | WallLike(x + 1, y)
    t = T_WALL + (m << 2)
  ELSEIF k == K_FLOOR THEN
    t = T_FLOOR
  ELSEIF k == K_CORR THEN
    t = T_CORR
  ELSEIF k == K_DOORWAY THEN
    t = T_DOORWAY
  ELSEIF k == K_UP THEN
    t = T_UP
  ELSEIF k == K_DOWN THEN
    t = T_DOWN
  ELSEIF k == K_FOUNTAIN THEN
    t = T_FOUNTAIN
  ELSEIF k >= K_ALTAR THEN
    t = T_ALTAR
  ELSEIF Kind(x - 1, y) == K_WALL OR Kind(x + 1, y) == K_WALL THEN
    t = T_DOOR_CLOSED_H
    IF k == K_DOORO THEN t = T_DOOR_OPEN_H FI
  ELSE
    t = T_DOOR_CLOSED_V
    IF k == K_DOORO THEN t = T_DOOR_OPEN_V FI
  FI
  Pic(col, row, t, a)
RETURN

PROC DrawView()
  BYTE x, y
  FOR y = vy TO vy + VH - 1 DO
    FOR x = vx TO vx + VW - 1 DO DrawCell(x, y) OD
  OD
RETURN

; the window moved to keep the hero four cells from its sides and three
; from its top and bottom; 1 when it moved
FUNC BYTE Aim()
  INT nx, ny, v
  nx = vx
  ny = vy
  v = px
  IF v < nx + 4 OR v >= nx + VW - 4 THEN
    nx = v - 10
    IF nx < 0 THEN nx = 0 FI
    IF nx > LW - VW THEN nx = LW - VW FI
  FI
  v = py
  IF v < ny + 3 OR v >= ny + VH - 3 THEN
    ny = v - 6
    IF ny < 0 THEN ny = 0 FI
    IF ny > LH - VH THEN ny = LH - VH FI
  FI
  IF nx == vx AND ny == vy THEN RETURN (0) FI
  vx = nx
  vy = ny
RETURN (1)

FUNC BYTE RoomAt(BYTE x, BYTE y)
  BYTE r
  FOR r = 0 TO 8 DO
    IF rgone(r) == 0 AND x >= rx1(r) AND x <= rx2(r) AND y >= ry1(r) AND y <= ry2(r) THEN RETURN (r) FI
  OD
RETURN (255)

PROC Show(CARD i)
  IF lv(i) & F_VIS THEN RETURN FI
  lv(i) = lv(i) | F_VIS | F_SEEN
  IF nvis < 160 THEN
    vis(nvis) = i
    nvis += 1
  FI
RETURN

CARD ARRAY was(160)

; what the hero sees: the whole of a lit room from inside it or its door,
; and anywhere the eight cells round. Whatever left the view is drawn
; again dimmed, whatever came into it drawn bright
PROC See()
  BYTE r, x, y, n, k, dx, dy
  CARD i
  n = nvis
  k = 0
  WHILE k < n DO                     ; a FOR to n - 1 runs 256 times when n is 0
    i = vis(k)
    was(k) = i
    lv(i) = lv(i) & 127
    k += 1
  OD
  nvis = 0
  r = RoomAt(px, py)
  IF r <> 255 THEN
    IF lv(Idx(rx1(r) + 1, ry1(r) + 1)) & F_LIT THEN
      FOR y = ry1(r) TO ry2(r) DO
        FOR x = rx1(r) TO rx2(r) DO Show(Idx(x, y)) OD
      OD
    FI
  FI
  FOR dy = 0 TO 2 DO
    y = py + dy - 1
    IF y < LH THEN
      FOR dx = 0 TO 2 DO
        x = px + dx - 1
        IF x < LW THEN
          IF Kind(x, y) <> K_ROCK THEN Show(Idx(x, y)) FI
        FI
      OD
    FI
  OD
  k = 0
  WHILE k < n DO
    i = was(k)
    IF lv(i) & F_VIS == 0 THEN DrawCell(i % LW, i / LW) FI
    k += 1
  OD
  k = 0
  WHILE k < nvis DO
    i = vis(k)
    DrawCell(i % LW, i / LW)
    k += 1
  OD
RETURN

; the creatures' other frame: the hero and every monster in view
PROC Animate()
  BYTE i
  anim = anim ^ 1
  DrawCell(px, py)
  FOR i = 0 TO MAXMON - 1 DO
    IF mstat(i) THEN
      IF lv(Idx(mx(i), my(i))) & F_VIS THEN DrawCell(mx(i), my(i)) FI
    FI
  OD
RETURN

; ---------------------------------------------------------------- status
PROC RoleName(BYTE col, BYTE row, BYTE r, BYTE bank)
  IF r == 0 THEN
    Text(col, row, "Valkyrie", bank)
  ELSEIF r == 1 THEN
    Text(col, row, "Wizard  ", bank)
  ELSE
    Text(col, row, "Rogue   ", bank)
  FI
RETURN

; the line built in mb printed at a column in one ink; the column after it
FUNC BYTE Put(BYTE col, BYTE row, BYTE bank)
  BYTE i
  CARD a
  a = row
  VRAM_ADDR = (a << 7) + (col << 1)
  VRAM_STEP = 1
  FOR i = 1 TO mbl DO
    VRAM_DATA = mb(i - 1) - FONT_FIRST
    VRAM_DATA = bank
  OD
  col += mbl
  mbl = 0
RETURN (col)

; NetHack's two status lines: who, where, experience and time; hit
; points -- in yellow below half and red below a third -- power and
; armour class
PROC Status()
  BYTE bank, c, save
  INT a
  save = mbl
  ClearRow(28)
  ClearRow(29)
  RoleName(0, 28, role, B_WHITE)
  mbl = 0
  MsgS("Dlvl:")
  MsgN(depth)
  MsgS("  Xp:")
  MsgN(ulev)
  MsgC('/')
  MsgN(uxp)
  MsgS("  T:")
  MsgN(turns)
  c = Put(10, 28, B_WHITE)
  bank = B_GREEN
  IF uhp < uhpmax / 2 THEN bank = B_YELLOW FI
  IF uhp < uhpmax / 3 OR uhp < 6 THEN bank = B_RED FI
  MsgS("HP:")
  c = Put(0, 29, B_GREY)
  MsgN(uhp)
  c = Put(c, 29, bank)
  MsgC('(')
  MsgN(uhpmax)
  MsgS(")  Pw:")
  MsgN(upw)
  MsgC('(')
  MsgN(upwmax)
  MsgS(")  AC:")
  a = uac
  IF a < 0 THEN
    MsgC('-')
    a = -a
  FI
  MsgN(a)
  MsgS("  $:")
  MsgN(ugold)
  c = Put(c, 29, B_WHITE)
  mbl = save
RETURN

; ------------------------------------------------------- the reckoning
FUNC CARD NeedXP(BYTE l)
  CARD v
  IF l < 10 THEN
    v = 10
    RETURN (v << l)
  FI
  v = 10000
RETURN (v << (l - 10))

; NetHack's hit points for a level: a d8 for the role and a d2 for being
; human, and the Valkyrie's constitution one more; the Wizard's power
; grows faster than the others'
PROC LevelUp()
  BYTE g
  ulev += 1
  Sfx(SX_LEVEL)
  g = Roll(8) + Roll(2)
  IF role == 0 THEN g += 1 FI
  IF uhpmax > 250 - g THEN g = 0 FI  ; a byte of hit points: room for twelve levels, not for more
  uhpmax += g
  uhp += g
  IF role == 1 THEN g = Roll(3) + 1 ELSE g = Roll(2) FI
  upwmax += g
  upw += g
  mbl = 0
  MsgSD(#"Welcome to experience level ")
  MsgN(ulev)
  MsgC('.')
  MsgEnd()
RETURN

PROC GainXP(CARD x)
  uxp += x
  WHILE ulev < 12 AND uxp >= NeedXP(ulev) DO LevelUp() OD
RETURN

PROC LoseLevel()
  BYTE g
  IF ulev <= 1 THEN RETURN FI
  mbl = 0
  MsgSD(#"Goodbye level ")
  MsgN(ulev)
  MsgC('.')
  MsgEnd()
  ulev -= 1
  uxp = NeedXP(ulev - 1)
  IF ulev == 1 THEN uxp = 0 FI
  g = Roll(8)
  IF uhpmax > g + 1 THEN uhpmax -= g FI
  IF uhp > uhpmax THEN uhp = uhpmax FI
RETURN

PROC MonTeleport(BYTE i)
  BYTE x, y
  CARD s
  s = AnySpot()
  IF s == $FFFF THEN RETURN FI
  x = mx(i)
  y = my(i)
  Unplace(i)
  mx(i) = s >> 8
  my(i) = s
  Place(i)
  DrawCell(x, y)
  DrawCell(mx(i), my(i))
RETURN

; the hero hurt by a monster of type t; the amulet of life saving takes
; the death, as NetHack's does, and crumbles
PROC HurtHero(BYTE d, BYTE t)
  IF d < uhp THEN
    uhp -= d
    RETURN
  FI
  IF uamul <> 255 THEN
    IF it(uamul) == O_LIFESAVING THEN
      MsgD(#"But wait... Your medallion begins to glow!")
      MsgD(#"You feel much better!")
      MsgD(#"The medallion crumbles to dust!")
      known(O_LIFESAVING) = 1
      InvDel(uamul, 1)
      uhp = uhpmax
      RETURN
    FI
  FI
  uhp = 0
  dead = 1
  killer = t
RETURN

; the hero hurt by its own doing, which does not kill
PROC HurtSelf(BYTE d)
  IF d >= uhp THEN uhp = 1 ELSE uhp -= d FI
RETURN

; "The jackal", "the jackal", or "It" and "it" for one out of sight
PROC MsgMon(BYTE i, BYTE cap)
  IF i == shk AND ShkOk() AND lv(Idx(mx(i), my(i))) & F_VIS THEN
    ShkName()
    RETURN
  FI
  IF i == tpri AND troom <> 255 AND mtype(i) == M_PRIEST THEN
    IF cap THEN MsgSD(#"The priest of ") ELSE MsgSD(#"the priest of ") FI
    MsgS(NameRec(NAME_GOD + role * 3 + talign))
    RETURN
  FI
  IF lv(Idx(mx(i), my(i))) & F_VIS THEN
    IF cap THEN MsgS("The ") ELSE MsgS("the ") FI
    MsgS(MonName(mtype(i)))
  ELSEIF cap THEN
    MsgS("It")
  ELSE
    MsgS("it")
  FI
RETURN

PROC Remove(BYTE i)
  BYTE k
  FOR k = 0 TO MAXOBJ - 1 DO          ; what it carried falls where it was
    IF ot(k) <> 255 AND ox(k) == 255 AND oy(k) == i THEN
      ox(k) = mx(i)
      oy(k) = my(i)
      oat(Idx(mx(i), my(i))) = k + 1
    FI
  OD
  Unplace(i)
  mstat(i) = 0
  DrawCell(mx(i), my(i))
RETURN

; a monster's kill makes its pet grow as NetHack's grow_up() does: its
; hit points by up to the victim's level and one, a level whenever they
; pass eight a level, and a kitten or a little dog a new form at level
; four, a housecat or a dog at six
PROC PetGrow(BYTE p, BYTE vl)
  BYTE g, t
  g = Roll(vl + 1)
  IF mhpmax(p) < 250 THEN
    mhpmax(p) += g
    mhp(p) += g
  FI
  IF mhpmax(p) >= (mlev(p) + 1) * 8 AND mlev(p) < 12 THEN mlev(p) += 1 FI
  t = mtype(p)
  IF ((t == M_KITTEN OR t == M_LITTLEDOG) AND mlev(p) >= 4) OR ((t == M_HOUSECAT OR t == M_DOG) AND mlev(p) >= 6) THEN
    mbl = 0
    MsgS("Your ")
    MsgS(MonName(t))
    MsgSD(#" grows up into a ")
    mtype(p) = t + 1
    MsgS(MonName(t + 1))
    MsgC('.')
    MsgEnd()
    DrawCell(mx(p), my(p))
  FI
RETURN

; damage dealt to a monster by the hero; 1 if it died of it
FUNC BYTE HurtMon(BYTE i, BYTE d)
  BYTE t
  msl(i) = 0
  IF d < mhp(i) THEN
    mhp(i) -= d
    RETURN (0)
  FI
  t = mtype(i)
  mbl = 0
  Sfx(SX_KILL)
  MsgS("You kill ")
  MsgMon(i, 0)
  MsgC('!')
  MsgEnd()
  IF Peaceful(i) THEN
    urec -= 6
    IF ualign <> 2 THEN
      MsgD(#"You murderer!")
      Luck(-2)
    FI
    IF Rnd(2) THEN Luck(-1) FI
  FI
  Remove(i)
  IF i == shk AND t == M_SHOPKEEPER THEN ClearUnpaid() FI
  IF Rnd(6) == 0 THEN
    MkObj(mx(i), my(i))
    DrawCell(mx(i), my(i))
  FI
  IF urec < 10 + turns / 200 THEN urec += 1 FI
  GainXP(m_xp(t))
RETURN (1)

; what a monster does back when it is struck: the floating eye's gaze, the
; acid blob's acid, the yellow mold's sting
PROC Passive(BYTE i)
  BYTE t, fx, n, s
  CARD o
  t = mtype(i)
  o = t
  o = o * 9
  IF m_att(o) >> 4 <> A_PASV THEN RETURN FI
  fx = m_att(o) & 15
  s = m_att(o + 2)
  IF fx == E_PLYS THEN
    IF Wearing(O_RFREEACTION) THEN
      MsgD(#"You momentarily stiffen.")
    ELSEIF upara == 0 THEN
      MsgD(#"You are frozen by its gaze!")
      upara = Dice(mlev(i) + 1, 10)
    FI
  ELSEIF fx == E_ACID THEN
    IF Rnd(2) == 0 THEN
      MsgD(#"You are splashed by acid!")
      HurtHero(Dice(mlev(i) + 1, s), t)
    FI
  ELSEIF fx == E_STUN THEN
    MsgD(#"You are stung!")
    HurtHero(Dice(mlev(i) + 1, s), t)
  FI
RETURN

; the hero strikes: NetHack's find_roll_to_hit(), then the weapon's die,
; its enchantment and strength's bonus
PROC HeroAttack(BYTE i)
  INT tmp, en, d
  BYTE t, sides
  WipeEngr(px, py, 3)
  t = mtype(i)
  sides = 2                          ; bare hands
  en = 0
  IF uwep <> 255 THEN
    sides = o_arg(it(uwep))
    en = Signed(ie(uwep))
  FI
  tmp = m_ac(t)
  tmp = tmp - 10 + 1 + r_abon(role) + ulev + en
  IF msl(i) THEN tmp += 2 FI         ; a sleeping monster is easier to hit
  mbl = 0
  IF tmp > Roll(20) THEN
    d = Roll(sides) + en + r_dbon(role) + RingEnch(O_RDAMAGE)
    IF d < 1 THEN d = 1 FI
    Sfx(SX_HIT)
    MsgS("You hit ")
    MsgMon(i, 0)
    MsgC('.')
    MsgEnd()
    IF HurtMon(i, d) == 0 THEN Passive(i) FI
  ELSE
    Sfx(SX_MISS)
    MsgS("You miss ")
    MsgMon(i, 0)
    MsgC('.')
    MsgEnd()
  FI
RETURN

PROC Verb(BYTE kind)
  IF kind == A_BITE THEN
    MsgS(" bites!")
  ELSEIF kind == A_STNG THEN
    MsgS(" stings!")
  ELSEIF kind == A_TUCH THEN
    MsgSD(#" touches you!")
  ELSEIF kind == A_BUTT THEN
    MsgS(" butts!")
  ELSEIF kind == A_HUGS THEN
    MsgSD(#" squeezes you!")
  ELSEIF kind == A_KICK THEN
    MsgS(" kicks!")
  ELSE
    MsgS(" hits!")
  FI
RETURN

; NetHack's steal(): a thing not worn, the whole of it, into the thief's
; hands -- a thing on the level's list at x 255, y the thief -- and the
; thief away elsewhere on the level, running
FUNC BYTE Stealable(BYTE k, BYTE w)
  IF it(k) == 255 THEN RETURN (0) FI
  IF w <> 255 THEN RETURN (it(k) == w) FI
RETURN (IsWorn(k) == 0)

PROC Steal(BYTE i, BYTE w)
  BYTE k, n, j
  n = 0
  FOR k = 0 TO MAXINV - 1 DO
    IF Stealable(k, w) THEN n += 1 FI
  OD
  mbl = 0
  MsgMon(i, 1)
  IF n == 0 THEN
    MsgSD(#" tries to rob you, but there is nothing to steal!")
    MsgEnd()
    mflee(i) = 255
    RETURN
  FI
  n = Rnd(n)
  FOR k = 0 TO MAXINV - 1 DO
    IF Stealable(k, w) THEN
      IF n == 0 THEN
        MsgSD(#" stole ")
        InvName(k)
        MsgC('.')
        MsgEnd()
        j = PutObj(it(k), iq(k), ifl(k), ie(k), 255, i)
        InvDel(k, iq(k))
        MonTeleport(i)
        mflee(i) = 255
        RETURN
      FI
      n -= 1
    FI
  OD
RETURN

; a monster strikes the hero: NetHack's mattacku(), each attack in turn
PROC MonAttack(BYTE i)
  BYTE t, a, kind, fx, n, s, d
  INT tmp
  CARD o
  IF upray AND ptype == 3 THEN
    mbl = 0
    MsgMon(i, 1)
    MsgSD(#" starts to attack you, but pulls back.")
    MsgEnd()
    RETURN
  FI
  t = mtype(i)
  FOR a = 0 TO 2 DO
    o = t
    o = o * 9 + a * 3
    kind = m_att(o) >> 4
    IF kind <> 0 AND kind <> A_PASV AND dead == 0 THEN
      fx = m_att(o) & 15
      n = m_att(o + 1)
      s = m_att(o + 2)
      tmp = uac + 10 + mlev(i)
      mbl = 0
      MsgMon(i, 1)
      IF tmp > Roll(20 + a) THEN
        Verb(kind)
        Sfx(att_sx(kind))
        MsgEnd()
        d = Dice(n, s)
        IF fx == E_POIS AND Rnd(8) == 0 THEN
          IF Wearing(O_RPOISONRES) THEN
            MsgD(#"The poison doesn't seem to affect you.")
          ELSE
            MsgD(#"It was poisoned!")
            d += Roll(6)
          FI
        ELSEIF fx == E_SLEE AND Rnd(3) == 0 AND upara == 0 AND Wearing(O_RFREEACTION) == 0 THEN
          MsgD(#"You are put to sleep!")
          upara = Roll(10)
        ELSEIF fx == E_DRLI AND Rnd(3) == 0 THEN
          LoseLevel()
        ELSEIF fx == E_SITM THEN
          Steal(i, 255)
          RETURN
        ELSEIF fx == E_SAMU AND Rnd(20) == 0 AND HasAmulet() THEN
          Steal(i, O_MOTT)                 ; NetHack's stealamulet(): one blow in twenty
          RETURN
        ELSEIF fx == E_SGLD AND ugold > 0 THEN
          ugold = ugold / 2
          MsgD(#"Your purse feels lighter.")
          MonTeleport(i)
          HurtHero(d, t)
          RETURN
        FI
        HurtHero(d, t)
      ELSE
        Sfx(SX_MISS)
        MsgS(" misses!")
        MsgEnd()
      FI
    FI
  OD
RETURN

; one monster strikes another -- the pet and what it fights: NetHack's
; mattackm(), the defender's armour class and the attacker's level
; against a twenty-sided die
PROC MonHitsMon(BYTE ag, BYTE df)
  BYTE a, kind, n, s, d, t, seen
  INT tmp
  CARD o
  t = mtype(ag)
  seen = lv(Idx(mx(ag), my(ag))) & F_VIS
  IF mstat(ag) & S_PET == 0 THEN mstat(ag) = mstat(ag) | S_ANGRY FI
  IF mstat(df) & S_PET == 0 THEN mstat(df) = mstat(df) | S_ANGRY FI
  FOR a = 0 TO 2 DO
    o = t
    o = o * 9 + a * 3
    kind = m_att(o) >> 4
    IF kind <> 0 AND kind <> A_PASV AND mstat(df) AND mstat(ag) THEN
      tmp = m_ac(mtype(df))
      tmp = tmp - 10 + mlev(ag)
      n = m_att(o + 1)
      s = m_att(o + 2)
      mbl = 0
      IF seen == 0 THEN Noises(ag) FI
      IF tmp > Roll(20 + a) THEN
        d = Dice(n, s)
        IF seen THEN
          Sfx(att_sx(kind))
          MsgMon(ag, 1)
          MsgS(" hits ")
          MsgMon(df, 0)
          MsgC('.')
          MsgEnd()
        FI
        msl(df) = 0
        IF d >= mhp(df) THEN
          IF seen THEN
            MsgMon(df, 1)
            MsgSD(#" is killed!")
            MsgEnd()
          FI
          Remove(df)
          IF Rnd(6) == 0 THEN
            MkObj(mx(df), my(df))
            DrawCell(mx(df), my(df))
          FI
          IF mstat(ag) & S_PET THEN PetGrow(ag, mlev(df)) FI
        ELSE
          mhp(df) -= d
        FI
      ELSEIF seen THEN
        Sfx(SX_MISS)
        MsgMon(ag, 1)
        MsgS(" misses ")
        MsgMon(df, 0)
        MsgC('.')
        MsgEnd()
      FI
    FI
  OD
RETURN

; ----------------------------------------------------------- engravings

FUNC BYTE EngrAt(BYTE x, BYTE y)
  BYTE e
  FOR e = 0 TO MAXENGR - 1 DO
    IF ex(e) == x AND ey(e) == y THEN RETURN (e) FI
  OD
RETURN (255)

; NetHack's wipe_engr_at() for dust: cnt letters rubbed out at random, and
; the engraving gone when nothing is left of it
PROC WipeEngr(BYTE x, BYTE y, BYTE cnt)
  BYTE e, n, p, ch, j
  CARD at
  e = EngrAt(x, y)
  IF e == 255 THEN RETURN FI
  at = e * 17
  n = etx(at)
  WHILE cnt > 0 DO
    cnt -= 1
    p = at + 1 + Rnd(n)
    ch = etx(p)
    IF ch <> ' ' THEN
      IF ch == '?' OR ch == '.' OR ch == ',' OR ch == '-' OR ch == '|' OR ch == '_' THEN
        etx(p) = ' '
      ELSE
        etx(p) = '?'
        IF Rnd(4) THEN
          FOR j = 1 TO ru_from(0) DO
            IF ru_from(j) == ch THEN etx(p) = ru_to(j) FI
          OD
        FI
      FI
    FI
  OD
  FOR p = 1 TO n DO
    IF etx(at + p) <> ' ' THEN RETURN FI
  OD
  ex(e) = 255
RETURN

; NetHack 3.6's onscary() for Elbereth: the hero standing on it, exactly
; that and nothing more, before a monster that is not a human -- the
; soldier and the town's people, who come last -- nor peaceful
; an engraving that says exactly a word, capitals as small letters
FUNC BYTE EngrIs(BYTE e, BYTE POINTER w)
  BYTE j
  BYTE POINTER q
  CARD at
  IF e == 255 THEN RETURN (0) FI
  at = e * 17
  IF etx(at) <> *w THEN RETURN (0) FI
  q = w
  FOR j = 1 TO *w DO
    q += 1
    IF etx(at + j) | $20 <> *q THEN RETURN (0) FI
  OD
RETURN (1)

FUNC BYTE Scary(BYTE i)
  BYTE t
  t = mtype(i)
  IF t == M_SOLDIER OR t >= M_SHOPKEEPER OR Peaceful(i) THEN RETURN (0) FI
RETURN (EngrIs(EngrAt(px, py), elbereth))

; ------------------------------------------------------- monsters moving
FUNC BYTE Dist(BYTE ax, BYTE ay, BYTE bx, BYTE by)
  BYTE dx, dy
  IF ax > bx THEN dx = ax - bx ELSE dx = bx - ax FI
  IF ay > by THEN dy = ay - by ELSE dy = by - ay FI
  IF dx > dy THEN RETURN (dx) FI
RETURN (dy)

; a monster's step towards (tx, ty): of the eight cells, the free one
; nearest, if it is nearer than where it stands; a shut door opened by a
; monster with hands, which is its move
FUNC BYTE StepToward(BYTE i, BYTE tx, BYTE ty, BYTE away)
  BYTE d, k, nx, ny, best, bx, by, kind, x, y
  INT dx, dy, bd, dd
  x = mx(i)
  y = my(i)
  dx = x
  dx = dx - tx
  dy = y
  dy = dy - ty
  bd = dx * dx + dy * dy
  best = 0
  k = Rnd(8)
  FOR d = 1 TO 8 DO
    k = (k % 8) + 1
    nx = x + dir_dx(k)
    ny = y + dir_dy(k)
    IF nx < LW AND ny < LH THEN
      kind = Kind(nx, ny)
      IF (Open(kind) OR kind == K_DOORC) AND MonAt(nx, ny) == 0 AND (nx <> px OR ny <> py) AND Diagonal(x, y, nx, ny) AND lv(Idx(nx, ny)) & F_TRAP == 0 AND BoulderAt(nx, ny) == 255 THEN
        dx = nx
        dx = dx - tx
        dy = ny
        dy = dy - ty
        dd = dx * dx + dy * dy
        IF (away == 0 AND dd < bd) OR (away AND dd > bd) THEN
          bd = dd
          best = k
          bx = nx
          by = ny
        FI
      FI
    FI
  OD
  IF best == 0 THEN RETURN (0) FI
  IF Kind(bx, by) == K_DOORC THEN
    IF m_flag(mtype(i)) & MF_NOHANDS THEN RETURN (0) FI
    SetKind(bx, by, K_DOORO)
    DrawCell(bx, by)
    RETURN (1)
  FI
  Unplace(i)
  mx(i) = bx
  my(i) = by
  Place(i)
  DrawCell(x, y)
  DrawCell(bx, by)
RETURN (1)

; the hero's last steps, NetHack's utrack: settrack() at each, gettrack()
; the newest beside a cell -- 255 for none, or when the cell is itself the
; newest near it
BYTE ARRAY utx(32), uty(32)
BYTE utp, utc

PROC SetTrack(BYTE x, BYTE y)
  utx(utp) = x
  uty(utp) = y
  utp = (utp + 1) & 31
  IF utc < 32 THEN utc += 1 FI
RETURN

FUNC BYTE GetTrack(BYTE x, BYTE y)
  BYTE n, t, d
  t = utp
  n = utc
  WHILE n > 0 DO
    t = (t + 31) & 31
    d = Dist(x, y, utx(t), uty(t))
    IF d == 1 THEN RETURN (t) FI
    IF d == 0 THEN RETURN (255) FI
    n -= 1
  OD
RETURN (255)

; the pet, as NetHack's dog_move(): at a hostile beside it that it is not
; afraid of -- nothing two levels above it; else towards the hero when
; three or more away, or beside but for one in the way and the hero not
; in a room -- and when it cannot see the hero, to the hero's newest step
; beside it, so it follows round corners and through doors; else about
PROC PetAct(BYTE i)
  BYTE j, d, k, gx, gy
  FOR j = 0 TO MAXMON - 1 DO
    IF mstat(j) AND j <> i THEN
      IF Dist(mx(i), my(i), mx(j), my(j)) == 1 AND mlev(j) < mlev(i) + 2 THEN
        IF Peaceful(j) == 0 AND Diagonal(mx(i), my(i), mx(j), my(j)) THEN
          MonHitsMon(i, j)
          RETURN
        FI
      FI
    FI
  OD
  d = Dist(mx(i), my(i), px, py)
  k = Kind(px, py)
  IF d >= 3 OR (d == 2 AND ((k >= K_CORR AND k <= K_DOORWAY) OR Rnd(4) == 0)) THEN
    gx = px
    gy = py
    IF lv(Idx(mx(i), my(i))) & F_VIS == 0 THEN
      j = GetTrack(mx(i), my(i))
      IF j <> 255 THEN
        gx = utx(j)
        gy = uty(j)
      FI
    FI
    IF StepToward(i, gx, gy, 0) THEN RETURN FI
  FI
  j = StepToward(i, mx(i) + Rnd(3) - 1, my(i) + Rnd(3) - 1, 0)
RETURN

; the peaceful shopkeeper, NetHack's shk_move(): to the post inside the
; door while the hero in the shop owes, off it to let the hero by when
; not, and back to it when the hero is outside
PROC ShkAct(BYTE i)
  BYTE g, b
  IF i <> shk THEN RETURN FI
  g = shroom
  IF InShop(px, py) AND Bill() == 0 THEN
    IF mx(i) == spx AND my(i) == spy AND Dist(px, py, spx, spy) <= 2 THEN
      b = StepToward(i, (rx1(g) + rx2(g)) / 2, (ry1(g) + ry2(g)) / 2, 0)
    FI
  ELSEIF mx(i) <> spx OR my(i) <> spy THEN
    b = StepToward(i, spx, spy, 0)
  FI
RETURN

; a hostile: at the hero if beside it, at the pet if the pet has bitten
; it, towards the hero if it sees it -- anything the hero sees, sees the
; hero -- and otherwise wandering
PROC MonAct(BYTE i)
  BYTE t, p, near, sc
  IF msl(i) THEN
    msl(i) -= 1
    RETURN
  FI
  t = mtype(i)
  IF mstat(i) & S_PET THEN
    PetAct(i)
    RETURN
  FI
  IF Peaceful(i) THEN
    IF t == M_SHOPKEEPER AND ShkOk() THEN
      ShkAct(i)
    ELSEIF t <> M_PRIEST AND m_spd(t) AND Rnd(3) == 0 THEN
      p = StepToward(i, mx(i) + Rnd(5) - 2, my(i) + Rnd(5) - 2, 0)
    FI
    RETURN
  FI
  IF m_spd(t) == 0 THEN RETURN FI
  WipeEngr(mx(i), my(i), 1)
  near = 0
  IF Dist(mx(i), my(i), px, py) == 1 AND Diagonal(mx(i), my(i), px, py) THEN near = 1 FI
  sc = 0
  IF near AND Scary(i) THEN
    sc = 1
    IF mflee(i) == 0 THEN
      IF Rnd(7) THEN mflee(i) = Roll(10) ELSE mflee(i) = Roll(100) FI
    FI
  FI
  IF mflee(i) THEN
    IF mflee(i) == 255 THEN
      IF mhp(i) == mhpmax(i) AND Rnd(25) == 0 THEN mflee(i) = 0 FI
    ELSE
      mflee(i) -= 1
    FI
    IF StepToward(i, px, py, 1) == 0 AND near AND sc == 0 THEN MonAttack(i) FI
    RETURN
  FI
  IF near AND sc == 0 THEN
    MonAttack(i)
    RETURN
  FI
  IF mstat(i) & S_ANGRY THEN
    p = FindPet()
    IF p <> 255 THEN
      IF Dist(mx(i), my(i), mx(p), my(p)) == 1 AND Diagonal(mx(i), my(i), mx(p), my(p)) THEN
        MonHitsMon(i, p)
        RETURN
      FI
    FI
  FI
  IF lv(Idx(mx(i), my(i))) & F_VIS THEN
    p = StepToward(i, px, py, 0)
  ELSEIF Rnd(2) == 0 THEN
    p = StepToward(i, mx(i) + Rnd(5) - 2, my(i) + Rnd(5) - 2, 0)
  FI
RETURN

; the rest of the turn: every monster's speed added to its movement, and a
; move for every twelve -- the hero's speed -- it has; the regenerating
; ones mend; now and then a new one arrives
PROC MonTurns()
  BYTE i, t
  FOR i = 0 TO MAXMON - 1 DO
    IF mstat(i) AND dead == 0 THEN
      t = mtype(i)
      IF m_flag(t) & MF_REGEN AND mhp(i) < mhpmax(i) THEN mhp(i) += 1 FI
      mmove(i) += m_spd(t)
      WHILE mmove(i) >= 12 AND mstat(i) AND dead == 0 DO
        mmove(i) -= 12
        MonAct(i)
      OD
    FI
  OD
  IF Rnd(70) == 0 THEN SpawnSomewhere() FI
RETURN

; NetHack's slow mending below level ten: a hit point every so many turns,
; fewer as the hero rises; power by its own clock, the Wizard's quicker
PROC Mend()
  BYTE n
  IF uhp < uhpmax THEN
    n = 3
    IF ulev < 10 THEN n = 42 / (ulev + 2) + 1 FI
    IF turns % n == 0 THEN uhp += 1 FI
  FI
  IF upw < upwmax THEN
    n = (38 - ulev) * 4 / 6
    IF role == 1 THEN n = (38 - ulev) * 3 / 6 FI
    IF turns % n == 0 THEN upw += 1 FI
  FI
  IF Wearing(O_RREGEN) AND uhp < uhpmax THEN uhp += 1 FI
  IF Wearing(O_RTELEPORT) AND Rnd(85) == 0 THEN wantport = 1 FI
RETURN

; a turn has passed: the hero mends, the monsters move, and while the
; hero is frozen they go on moving
; NetHack's noises(): a fight out of sight is heard, once in ten turns
; unless it has come nearer or gone further
BYTE farn
CARD ntime

PROC Noises(BYTE ag)
  BYTE f
  f = 0
  IF Dist(mx(ag), my(ag), px, py) > 3 THEN f = 1 FI
  IF f <> farn OR turns - ntime > 10 THEN
    farn = f
    ntime = turns
    Sfx(SX_NOISES)
    IF f THEN MsgD(#"You hear some noises in the distance.") ELSE MsgD(#"You hear some noises.") FI
  FI
RETURN

; NetHack's dosounds(): now and then what the level holds, heard from
; where the hero is -- a fountain, a shop, a temple, the Oracle
PROC Hear(CARD s, BYTE sx)
  Sfx(sx)
  mbl = 0
  MsgSD(#"You hear ")
  MsgS(Str(s))
  MsgEnd()
RETURN

PROC DoSounds()
  BYTE i
  CARD k
  IF Rnd(400) == 0 THEN
    FOR k = 0 TO NCELL - 1 DO
      IF lv(k) & 15 == K_FOUNTAIN THEN
        i = Rnd(3)
        IF i == 0 THEN
          Hear(#"bubbling water.", SX_BUBBLE)
        ELSEIF i == 1 THEN
          Hear(#"water falling on coins.", SX_BUBBLE)
        ELSE
          Hear(#"the splashing of a naiad.", SX_BUBBLE)
        FI
        EXIT
      FI
    OD
  FI
  IF shroom <> 255 AND Rnd(200) == 0 THEN
    IF ShkOk() AND InShop(px, py) == 0 THEN
      IF Rnd(2) THEN
        Hear(#"the chime of a cash register.", SX_CHIME)
      ELSE
        Hear(#"someone cursing shoplifters.", SX_CHIME)
      FI
    FI
    RETURN
  FI
  IF troom <> 255 AND Rnd(200) == 0 THEN
    IF mstat(tpri) AND mtype(tpri) == M_PRIEST AND InRect(troom, px, py) == 0 THEN
      i = Rnd(3)
      IF i == 2 AND lv(Idx(mx(tpri), my(tpri))) & F_VIS THEN i = Rnd(2) FI
      Sfx(SX_CHANT)
      mbl = 0
      MsgSD(#"You hear ")
      IF i == 0 THEN
        MsgSD(#"someone praising ")
      ELSEIF i == 1 THEN
        MsgSD(#"someone beseeching ")
      ELSE
        MsgSD(#"an animal carcass being offered in sacrifice.")
      FI
      IF i < 2 THEN
        GodName(talign)
        MsgC('.')
      FI
      MsgEnd()
    FI
    RETURN
  FI
  IF lvl == oracle_at AND Rnd(400) == 0 THEN
    FOR i = 0 TO MAXMON - 1 DO
      IF mstat(i) AND mtype(i) == M_ORACLE AND lv(Idx(mx(i), my(i))) & F_VIS == 0 THEN
        k = Rnd(3)
        IF k == 0 THEN
          Hear(#"a strange wind.", SX_WIND)
        ELSEIF k == 1 THEN
          Hear(#"convulsive ravings.", SX_WIND)
        ELSE
          Hear(#"snoring snakes.", SX_WIND)
        FI
        EXIT
      FI
    OD
  FI
RETURN

PROC EndTurn()
  BYTE f
  turns += 1
  IF ublesscnt THEN ublesscnt -= 1 FI
  IF Rnd(82) == 0 THEN WipeEngr(px, py, Roll(3)) FI
  DoSounds()
  IF udemi THEN
    IF udg THEN udg -= 1 ELSE wantint = 1 FI
  FI
  IF HasAmulet() AND Rnd(40) == 0 THEN      ; NetHack's amulet(): the Wizard wakes
    FOR f = 0 TO MAXMON - 1 DO
      IF mstat(f) AND mtype(f) == M_WIZARDOFMOTT AND msl(f) THEN
        msl(f) = 0
        IF Dist(mx(f), my(f), px, py) > 2 THEN MsgD(#"You get the feeling that something is watching you.") FI
      FI
    OD
  FI
  IF uluck <> 0 AND (turns % 600 == 0 OR (ugangr AND turns % 300 == 0)) THEN
    IF uluck < 0 THEN uluck = uluck + 1 ELSE uluck = uluck - 1 FI
  FI
  Mend()
  MonTurns()
  Status()
  WHILE upara AND dead == 0 DO
    upara -= 1
    turns += 1
    MonTurns()
    Status()
    FOR f = 1 TO 6 DO Tick() OD
    IF upara == 0 THEN MsgD(#"You can move again.") FI
  OD
RETURN

; ------------------------------------------------------------ the dungeon
BYTE ARRAY carry(4)                  ; the pet on the stairs: type, hit points, most, level

PROC EnterLevel(BYTE down)
  BYTE t, r, i, d
  CARD s
  t = ThemeOf(depth)
  IF lvl >= L_MINES THEN t = 1 FI
  IF lvl >= L_SOKO1 THEN t = 0 FI
  IF t <> theme THEN
    FOR r = VTOP TO VTOP + 25 DO ClearRow(r) OD
    IF LoadTheme(t) == 0 THEN
      MsgD(#"The theme file is not on drive 9.")
      RETURN
    FI
  FI
  IF made(lvl) THEN
    LoadLevel()
  ELSE
    IF lvl == oracle_at THEN
      LoadSpecial(SP_DELPHI)
    ELSEIF lvl == L_TOWN THEN
      LoadSpecial(SP_TOWN)
    ELSEIF lvl == L_SOKO1 THEN
      LoadSpecial(SP_SOKO1)
    ELSEIF lvl == L_SOKO2 THEN
      LoadSpecial(SP_SOKO2)
    ELSEIF lvl >= L_MINES THEN
      MakeCave()
    ELSE
      MakeLevel()
    FI
    made(lvl) = 1
  FI
  nvis = 0
  utc = 0                            ; NetHack's initrack(): no steps yet on this level
  IF down == 1 THEN
    px = upx
    py = upy
  ELSEIF down == 0 THEN
    px = dnx
    py = dny
  ELSEIF down == 3 THEN
    px = brx
    py = bry
  ELSEIF down == 2 THEN
    px = upx
    py = upy
    s = AnySpot()
    IF s <> $FFFF THEN
      px = s >> 8
      py = s
    FI
  FI
  r = TU_HALLS + ThemeOf(depth)
  IF lvl >= L_MINES THEN r = TU_MINES FI
  IF lvl == L_TOWN THEN r = TU_TOWN FI
  IF lvl >= L_SOKO1 THEN r = TU_SOKOBAN FI
  IF lvl == oracle_at THEN r = TU_DELPHI FI
  IF r <> mtune THEN MusicStart(r) FI
  area = r - TU_HALLS
  ambt = 900
  i = MonAt(px, py)                  ; something on the stairs moves aside
  IF i THEN
    d = FreeNear(px, py)
    Unplace(i - 1)
    IF d THEN
      mx(i - 1) = px + dir_dx(d)
      my(i - 1) = py + dir_dy(d)
      Place(i - 1)
    ELSE
      mstat(i - 1) = 0
    FI
  FI
  IF carry(0) <> 255 THEN
    d = FreeNear(px, py)
    IF d THEN
      i = NewMon(carry(0), px + dir_dx(d), py + dir_dy(d))
      IF i <> 255 THEN
        mhp(i) = carry(1)
        mhpmax(i) = carry(2)
        mlev(i) = carry(3)
        mstat(i) = S_LIVE | S_PET
      FI
    FI
    carry(0) = 255
  FI
  vx = 255
  t = Aim()
  See()
  DrawView()
  Status()
RETURN

; the pet comes along if it is beside the hero, as in NetHack
PROC TakePet()
  BYTE p
  carry(0) = 255
  p = FindPet()
  IF p == 255 THEN RETURN FI
  IF Dist(mx(p), my(p), px, py) > 1 THEN RETURN FI
  carry(0) = mtype(p)
  carry(1) = mhp(p)
  carry(2) = mhpmax(p)
  carry(3) = mlev(p)
  Unplace(p)
  mstat(p) = 0
RETURN

; the level's depth: the dungeon's by number, the mines' below where they
; open, Sokoban's above the level under the Oracle
FUNC BYTE LDepth(BYTE l)
  IF l <= MAXDEPTH THEN RETURN (l) FI
  IF l <= L_MINEEND THEN RETURN (mines_at + l - MAXDEPTH) FI
RETURN (oracle_at + L_MINEEND - 1 - l)

; the level under this one, and the one over it; 0 for none
FUNC BYTE Below()
  IF lvl < MAXDEPTH OR (lvl >= L_MINES AND lvl < L_MINEEND) THEN RETURN (lvl + 1) FI
  IF lvl == L_SOKO2 THEN RETURN (L_SOKO1) FI
  IF lvl == L_SOKO1 THEN RETURN (oracle_at - 1) FI
RETURN (0)

FUNC BYTE Above()
  IF lvl == L_MINES THEN RETURN (mines_at) FI
  IF lvl == L_SOKO1 THEN RETURN (L_SOKO2) FI
  IF lvl == L_SOKO2 THEN RETURN (0) FI
RETURN (lvl - 1)

; to another level, the pet beside the hero along: arriving 1 on its stairs
; up, 0 on its stairs down, 2 anywhere, 3 on its branch's stairs
PROC GoLevel(BYTE l, BYTE arrive)
  Sfx(SX_STAIRS)
  TakePet()
  SaveLevel()
  lvl = l
  depth = LDepth(l)
  EnterLevel(arrive)
RETURN

PROC Descend()
  BYTE l, a
  IF Kind(px, py) <> K_DOWN THEN
    MsgD(#"You can't go down here.")
    RETURN
  FI
  a = 1
  l = Below()
  IF px == brx AND py == bry THEN
    l = L_MINES
  ELSEIF lvl == L_SOKO1 THEN
    a = 3
  FI
  GoLevel(l, a)
RETURN

PROC Ascend()
  BYTE l, a
  IF Kind(px, py) <> K_UP THEN
    MsgD(#"You can't go up here.")
    RETURN
  FI
  a = 0
  l = Above()
  IF px == brx AND py == bry THEN
    l = L_SOKO1
  ELSEIF lvl == L_MINES THEN
    a = 3
  FI
  IF l == 0 THEN
    IF HasAmulet() AND lvl == 1 THEN      ; out into the sun with it: the game is won
      won = 1
      dead = 1
      RETURN
    FI
    MsgD(#"The way out. You have no Amulet yet.")
    RETURN
  FI
  ; NetHack's mysterious force: carrying the Amulet up the dungeon's stairs,
  ; one time in four, the hero sent down as many as the alignment allows --
  ; a lawful three, a chaotic one -- or about the level
  IF HasAmulet() AND lvl < MAXDEPTH - 3 AND l < lvl AND Rnd(4) == 0 THEN
    MsgD(#"A mysterious force momentarily surrounds you...")
    l = lvl + Rnd(4 - ualign)
    IF l > MAXDEPTH THEN l = MAXDEPTH FI
    GoLevel(l, 2)
    RETURN
  FI
  GoLevel(l, a)
RETURN

; ------------------------------------------------------- names of things
FUNC BYTE POINTER ObjName(BYTE t)
RETURN (NameRec(NAME_OBJ + t))

PROC Know(BYTE t)
  known(t) = 1
RETURN

; words put in front of what mb holds from `at`
PROC MsgIns(BYTE at, BYTE POINTER s)
  BYTE n, i
  BYTE POINTER q
  n = *s
  IF mbl + n > 80 THEN RETURN FI
  i = mbl
  WHILE i > at DO
    i -= 1
    mb(i + n) = mb(i)
  OD
  q = s + 1
  FOR i = 1 TO n DO
    mb(at + i - 1) = *q
    q += 1
  OD
  mbl += n
RETURN

; a thing's name as NetHack's doname() gives it, onto mb: the count, or
; "a" or "an"; its blessing and enchantment if they are known; and the
; name of its kind if that is known, else its appearance this game
PROC Name(BYTE t, BYTE q, BYTE f, BYTE e, BYTE art)
  BYTE at, c, ch
  INT en
  at = mbl
  c = o_class(t)
  IF c == C_GOLD THEN
    MsgN(q)
    MsgSD(#" gold piece")
    IF q <> 1 THEN MsgC('s') FI
    RETURN
  FI
  IF q > 1 THEN
    MsgN(q)
    MsgC(' ')
  FI
  IF f & OF_BKNOWN THEN               ; NetHack's implicit_uncursed: not said of a kind that is known
    IF f & OF_BLESS THEN
      MsgS("blessed ")
    ELSEIF f & OF_CURSE THEN
      MsgS("cursed ")
    ELSEIF known(t) == 0 THEN
      MsgS("uncursed ")
    FI
  FI
  IF f & OF_EKNOWN AND (c == C_WEAPON OR c == C_ARMOR OR t == O_RPROTECTION OR t == O_RDAMAGE) THEN
    en = Signed(e)
    IF en < 0 THEN
      MsgC('-')
      en = -en
    ELSE
      MsgC('+')
    FI
    MsgN(en)
    MsgC(' ')
  FI
  IF c == C_WEAPON OR c == C_ARMOR THEN
    MsgS(ObjName(t))
    IF q > 1 THEN MsgC('s') FI
  ELSEIF c == C_POTION THEN
    IF known(t) THEN
      MsgS("potion")
      IF q > 1 THEN MsgC('s') FI
      MsgS(" of ")
      IF t == O_WATER AND f & OF_BKNOWN THEN
        IF f & OF_BLESS THEN
          MsgS("holy ")
        ELSEIF f & OF_CURSE THEN
          MsgS("unholy ")
        FI
      FI
      MsgS(ObjName(t))
    ELSE
      MsgS(NameRec(NAME_POTION + ap(t)))
      MsgS(" potion")
      IF q > 1 THEN MsgC('s') FI
    FI
  ELSEIF c == C_SCROLL THEN
    MsgS("scroll")
    IF q > 1 THEN MsgC('s') FI
    IF known(t) THEN
      MsgS(" of ")
      MsgS(ObjName(t))
    ELSE
      MsgS(" labeled ")
      MsgS(NameRec(NAME_SCROLL + ap(t)))
    FI
  ELSEIF c == C_WAND THEN
    IF known(t) THEN
      MsgS("wand of ")
      MsgS(ObjName(t))
    ELSE
      MsgS(NameRec(NAME_WAND + ap(t)))
      MsgS(" wand")
    FI
    IF f & OF_EKNOWN THEN
      MsgS(" (0:")
      MsgN(e)
      MsgC(')')
    FI
  ELSEIF c == C_RING THEN
    IF known(t) THEN
      MsgS("ring of ")
      MsgS(ObjName(t))
    ELSE
      MsgS(NameRec(NAME_RING + ap(t)))
      MsgS(" ring")
    FI
  ELSEIF t == O_LIFESAVING THEN
    IF known(t) THEN MsgSD(#"amulet of life saving") ELSE MsgSD(#"spherical amulet") FI
  ELSE
    IF t == O_FAKEMOTT AND known(t) THEN
      MsgSD(#"plastic imitation Amulet")
    ELSE
      MsgSD(#"Amulet of Mott")
    FI
    IF art AND q == 1 THEN MsgIns(at, "the ") FI
    RETURN
  FI
  IF art AND q == 1 THEN
    ch = mb(at)
    IF ch == 'a' OR ch == 'e' OR ch == 'i' OR ch == 'o' OR ch == 'u' THEN
      MsgIns(at, "an ")
    ELSE
      MsgIns(at, "a ")
    FI
  FI
RETURN

FUNC BYTE IsWorn(BYTE k)
  BYTE s
  IF uleft == k OR uright == k OR uamul == k THEN RETURN (1) FI
  FOR s = 1 TO 6 DO
    IF worn(s) == k THEN RETURN (1) FI
  OD
RETURN (0)

; a pack letter's name, and what is being done with it
PROC InvName(BYTE k)
  Name(it(k), iq(k), ifl(k), ie(k), 1)
  IF uwep == k THEN MsgSD(#" (wielded)") FI
  IF ifl(k) & OF_UNPAID THEN
    MsgS(" (unpaid, ")
    MsgN(Price(it(k), ifl(k), ie(k), 0) * iq(k))
    MsgS(" zorkmids)")
  FI
  IF uleft == k THEN
    MsgSD(#" (left hand)")
  ELSEIF uright == k THEN
    MsgSD(#" (right hand)")
  ELSEIF IsWorn(k) THEN
    MsgS(" (worn)")
  FI
RETURN

; the hero stepped from (ox, oy): into the shop, and the keeper greets;
; onto its door owing, and is asked to pay; out of it owing, and has robbed
PROC RoleWord()
  IF role == 0 THEN
    MsgS("Valkyrie")
  ELSEIF role == 1 THEN
    MsgS("Wizard")
  ELSE
    MsgS("Rogue")
  FI
RETURN

PROC ShopWord()
  ShkName()
  MsgS("'s ")
  MsgS(NameRec(NAME_SHOP + shtype))
RETURN

PROC ShopMove(BYTE ox, BYTE oy)
  BYTE was, now
  IF ShkOk() == 0 THEN RETURN FI
  was = InShop(ox, oy)
  now = InShop(px, py)
  mbl = 0
  IF now AND was == 0 THEN
    IF mstat(shk) & S_HOSTILE THEN
      MsgS("\"So, ")
      RoleWord()
      MsgSD(#", you dare return to ")
      ShopWord()
      MsgS("?!\"")
    ELSE
      MsgS("\"Hello, ")
      RoleWord()
      MsgS("!  Welcome")
      IF shvis THEN MsgS(" again") FI
      MsgS(" to ")
      ShopWord()
      MsgS("!\"")
      shvis = 1
    FI
    MsgEnd()
  ELSEIF now AND px == shdx AND py == shdy AND Bill() THEN
    MsgC('"')
    RoleWord()
    MsgS(Str(#"!  Please pay before leaving.\""))
    MsgEnd()
  ELSEIF was AND now == 0 THEN
    Rob()
  FI
RETURN

; a thing on the shop's floor that the keeper will buy
FUNC BYTE Saleable(BYTE t)
  BYTE c
  c = o_class(t)
  IF shtype == SH_GENERAL THEN RETURN (1) FI
  IF shtype == SH_ARMOR OR shtype == SH_WEAPON THEN
    IF c <= C_ARMOR THEN RETURN (1) FI
  ELSEIF shtype == SH_SCROLL THEN
    IF c == C_SCROLL THEN RETURN (1) FI
  ELSEIF shtype == SH_POTION THEN
    IF c == C_POTION THEN RETURN (1) FI
  ELSEIF shtype == SH_RING THEN
    IF c == C_RING OR c == C_AMULET THEN RETURN (1) FI
  ELSEIF c == C_WAND OR t == O_GLOVES OR t == O_CLOAK THEN
    RETURN (1)
  FI
RETURN (0)

; a thing dropped on the shop's floor, NetHack's sellobj(): back on the
; shelf if it was unpaid; otherwise offered for, or not wanted
PROC Sell(BYTE j)
  CARD offer
  IF of(j) & OF_UNPAID THEN
    of(j) = of(j) & (255 ^ OF_UNPAID)
    RETURN
  FI
  of(j) = of(j) | OF_NOCHG
  IF mstat(shk) & S_HOSTILE OR ot(j) == O_GOLD THEN RETURN FI
  offer = Price(ot(j), of(j), oe(j), 1) * oq(j)
  mbl = 0
  ShkName()
  IF Saleable(ot(j)) == 0 OR offer == 0 THEN
    MsgSD(#" seems uninterested.")
    MsgEnd()
    RETURN
  FI
  IF shgold == 0 THEN
    MsgSD(#" cannot pay you at present.")
    MsgEnd()
    RETURN
  FI
  IF offer > shgold THEN offer = shgold FI
  MsgS(" offers ")
  MsgN(offer)
  MsgSD(#" gold pieces for your ")
  Name(ot(j), oq(j), 0, oe(j), 0)
  MsgSD(#".  Sell it? [yn] (n)")
  MsgEnd()
  IF Answer() THEN
    MsgClear()
    ugold = ugold + offer
    shgold = shgold - offer
    of(j) = of(j) & (255 ^ OF_NOCHG)
    mbl = 0
    MsgS("You sold ")
    Name(ot(j), oq(j), 0, oe(j), 1)
    MsgS(" for ")
    MsgN(offer)
    MsgSD(#" gold pieces.")
    MsgEnd()
    Status()
  FI
RETURN

; NetHack's intemple(): into the temple of a peaceful priest, his
; greeting, and the feeling of the place -- peace for a hero of the
; altar's alignment in good standing, a forbidding feeling otherwise
PROC TempleMove(BYTE ox, BYTE oy)
  IF troom == 255 OR InRect(troom, px, py) == 0 OR InRect(troom, ox, oy) THEN RETURN FI
  IF mstat(tpri) == 0 OR mtype(tpri) <> M_PRIEST OR Peaceful(tpri) == 0 THEN RETURN FI
  mbl = 0
  MsgMon(tpri, 1)
  MsgS(" intones:")
  MsgEnd()
  Msg(Str(#"\"Pilgrim, you enter a sacred place!\""))
  mbl = 0
  MsgS("You ")
  IF talign <> ualign OR urec <= -4 THEN
    MsgS("have a")
    IF talign == ualign THEN MsgS(" strange") FI
    MsgSD(#" forbidding feeling...")
  ELSE
    MsgS("experience ")
    IF urec >= 20 THEN MsgS("a") ELSE MsgSD(#"an unusual") FI
    MsgSD(#" sense of peace.")
  FI
  MsgEnd()
RETURN

; the hero set down somewhere on the level, at random
PROC Teleport()
  BYTE r, ox, oy
  CARD s
  IF lvl >= L_SOKO1 THEN
    MsgD(#"You feel a wrenching sensation.")
    RETURN
  FI
  ox = px
  oy = py
  s = AnySpot()
  IF s == $FFFF THEN RETURN FI
  px = s >> 8
  py = s
  vx = 255
  r = Aim()
  See()
  DrawView()
  ShopMove(ox, oy)
RETURN

; what is here: gold is taken up as it is walked over, as NetHack's
; autopickup does, and the rest is said
PROC LookHere()
  BYTE i, n, k
  CARD c
  c = Idx(px, py)
  i = oat(c)
  WHILE i DO
    IF ot(i - 1) <> O_GOLD THEN EXIT FI
    ugold += oq(i - 1)
    Sfx(SX_GOLD)
    mbl = 0
    MsgN(oq(i - 1))
    MsgSD(#" gold pieces.")
    MsgEnd()
    TakeObj(i - 1)
    i = oat(c)
  OD
  k = EngrAt(px, py)
  IF k <> 255 THEN
    MsgD(#"Something is written here in the dust.")
    mbl = 0
    MsgS(Str(#"You read: \""))
    c = k * 17
    FOR n = 1 TO etx(c) DO MsgC(etx(c + n)) OD
    MsgS("\".")
    MsgEnd()
  FI
  n = 0
  FOR k = 0 TO MAXOBJ - 1 DO
    IF ot(k) <> 255 AND ox(k) == px AND oy(k) == py THEN n += 1 FI
  OD
  IF n == 1 THEN
    k = oat(c) - 1
    mbl = 0
    MsgSD(#"You see here ")
    Name(ot(k), oq(k), of(k), oe(k), 1)
    MsgC('.')
    MsgEnd()
  ELSEIF n > 1 THEN
    MsgD(#"There are several objects here.")
  FI
RETURN

; ------------------------------------------------------------ the traps
PROC Found(BYTE x, BYTE y)
  lv(Idx(x, y)) = lv(Idx(x, y)) | F_SEEN
  DrawCell(x, y)
RETURN

; NetHack's dosearch0(): each cell round the hero, a secret door or passage
; found one time in seven and a trap one in eight, luck helping
PROC Search()
  BYTE dx, dy, x, y, k, i
  FOR dy = 0 TO 2 DO
    FOR dx = 0 TO 2 DO
      x = px + dx - 1
      y = py + dy - 1
      IF (dx <> 1 OR dy <> 1) AND x < LW AND y < LH THEN
        k = Kind(x, y)
        IF k == K_SDOOR THEN
          IF Rnl(7) == 0 THEN
            SetKind(x, y, K_DOORC)
            Found(x, y)
            MsgD(#"You find a hidden door.")
          FI
        ELSEIF k == K_SCORR THEN
          IF Rnl(7) == 0 THEN
            SetKind(x, y, K_CORR)
            Found(x, y)
            MsgD(#"You find a hidden passage.")
          FI
        ELSE
          i = TrapAt(x, y)
          IF i <> 255 THEN
            IF tf(i) & TF_SEEN == 0 AND Rnl(8) == 0 THEN
              tf(i) = tf(i) | TF_SEEN
              Found(x, y)
              mbl = 0
              MsgS("You find ")
              MsgA(NameRec(NAME_TRAP + tt(i)))
              MsgC('.')
              MsgEnd()
            FI
          FI
        FI
      FI
    OD
  OD
RETURN

; NetHack's thitu(): a trap's missile against the armour class
FUNC BYTE HitU(BYTE tlev, BYTE dam, BYTE POINTER what, BYTE kd)
  INT t, r
  t = uac + tlev
  r = Roll(20)
  mbl = 0
  IF t <= r THEN
    MsgSD(#"You are almost hit by ")
    MsgS(what)
    MsgC('.')
    MsgEnd()
    RETURN (0)
  FI
  MsgSD(#"You are hit by ")
  MsgS(what)
  IF dam < 5 THEN MsgC('.') ELSE MsgC('!') FI
  MsgEnd()
  HurtHero(dam, kd)
RETURN (1)

; NetHack's poisoned(): nothing with poison resistance; else one time in
; `fatal` (and twenty more for a missile) death, sometimes hit points,
; otherwise the strength or constitution it would have taken
PROC Poisoned(BYTE POINTER said, BYTE kd, BYTE kdeath, BYTE fatal, BYTE thrown)
  BYTE i
  Msg(said)
  IF Wearing(O_RPOISONRES) THEN
    MsgD(#"The poison doesn't seem to affect you.")
    RETURN
  FI
  i = Rnd(fatal + thrown * 20)
  IF i == 0 THEN
    MsgD(#"The poison was deadly...")
    HurtHero(255, kdeath)
  ELSEIF i > 5 THEN
    IF thrown THEN HurtHero(Roll(6), kd) ELSE HurtHero(6 + Rnd(10), kd) FI
  ELSEIF thrown THEN
    MsgD(#"You feel very sick!")
  ELSE
    MsgD(#"You feel weaker!")
  FI
RETURN

; down to another level through a hole in the floor, the pet beside the
; hero coming along
PROC FallTo(BYTE l)
  GoLevel(l, 2)
RETURN

; the trap under the hero goes off: NetHack's dotrap() for these eleven.
; One already seen is escaped one time in five; an arrow, dart or rock
; trap that has gone off runs out one time in fifteen
PROC Spring()
  BYTE i, k, n, f
  i = TrapAt(px, py)
  IF i == 255 THEN RETURN FI
  k = tt(i)
  f = tf(i)
  IF f & TF_SEEN AND Rnd(5) == 0 AND lvl < L_SOKO1 THEN
    mbl = 0
    MsgSD(#"You escape ")
    MsgA(NameRec(NAME_TRAP + k))
    MsgC('.')
    MsgEnd()
    RETURN
  FI
  IF k <= TR_ROCK AND f & TF_ONCE AND f & TF_SEEN AND Rnd(15) == 0 THEN
    IF k == TR_ARROW THEN
      MsgD(#"You hear a loud click!")
    ELSEIF k == TR_DART THEN
      MsgD(#"You hear a soft click.")
    ELSE
      MsgD(#"A trap door in the ceiling opens, but nothing falls out!")
    FI
    DelTrap(i)
    RETURN
  FI
  tf(i) = f | TF_SEEN | TF_ONCE
  Sfx(SX_TRAP)
  IF k == TR_ARROW THEN
    MsgD(#"An arrow shoots out at you!")
    n = HitU(8, Roll(6), "an arrow", KD_ARROW)
  ELSEIF k == TR_DART THEN
    MsgD(#"A little dart shoots out at you!")
    IF HitU(7, Roll(3), "a little dart", KD_DART) AND Rnd(6) == 0 AND dead == 0 THEN
      Poisoned("The dart was poisoned!", KD_DART, KD_DARTPOIS, 10, 1)
    FI
  ELSEIF k == TR_ROCK THEN
    MsgD(#"A trap door in the ceiling opens and a rock falls on your head!")
    n = Dice(2, 6)
    IF worn(SLOT_HELM) <> 255 THEN
      MsgD(#"Fortunately, you are wearing a hard helmet.")
      n = 2
    FI
    HurtHero(n, KD_ROCK)
  ELSEIF k == TR_SQUEAKY THEN
    MsgD(#"A board beneath you squeaks loudly.")
    FOR n = 0 TO MAXMON - 1 DO msl(n) = 0 OD
  ELSEIF k == TR_BEAR THEN
    MsgD(#"A bear trap closes on your foot!")
    utrap = 4 + Rnd(4)
    utraptype = TR_BEAR
    HurtHero(Dice(2, 4), KD_BEAR)
  ELSEIF k == TR_SLEEPGAS THEN
    MsgD(#"A cloud of gas puts you to sleep!")
    upara = Roll(25)
  ELSEIF k <= TR_SPIKEDPIT THEN
    MsgD(#"You fall into a pit!")
    utrap = 2 + Rnd(6)
    utraptype = TR_PIT
    IF k == TR_PIT THEN
      HurtHero(Roll(6), KD_PIT)
    ELSE
      MsgD(#"You land on a set of sharp iron spikes!")
      IF Rnd(6) == 0 THEN Poisoned("The spikes were poisoned!", KD_SPIKEHP, KD_SPIKEPOIS, 8, 0) FI
      IF dead == 0 THEN HurtHero(Roll(10), KD_SPIKES) FI
    FI
  ELSEIF k == TR_TRAPDOOR THEN
    MsgD(#"A trap door opens up under you!")
    n = Below()
    IF lvl < MAXDEPTH THEN
      WHILE Rnd(4) == 0 AND n < MAXDEPTH DO n += 1 OD
    FI
    mbl = 0
    IF n > lvl + 1 THEN
      MsgSD(#"You fall down a ")
      IF n > lvl + 3 THEN MsgS("very ") FI
      IF n > lvl + 2 THEN MsgS("deep ") FI
      MsgS("shaft!")
    ELSE
      MsgSD(#"You fall through...")
    FI
    MsgEnd()
    FallTo(n)
  ELSEIF k == TR_HOLE THEN
    IF lvl >= L_SOKO1 THEN
      MsgD(#"Air currents pull you down into a hole!")
    ELSE
      MsgD(#"There's a gaping hole under you!")
    FI
    FallTo(Below())
  ELSEIF k == TR_TELEPORT THEN
    Teleport()
  ELSEIF lvl > MAXDEPTH THEN
    MsgD(#"You shudder for a moment.")
  ELSE
    MsgD(#"You are momentarily blinded by a flash of light.")
    DelTrap(i)
    n = Rnd(depth + 2) + 1
    IF n >= depth THEN n += 1 FI
    IF n > MAXDEPTH THEN
      n = MAXDEPTH
      IF depth == MAXDEPTH THEN n -= Roll(3) FI
    FI
    IF n == depth THEN
      MsgD(#"You shudder for a moment.")
    ELSE
      FallTo(n)
    FI
  FI
RETURN

; NetHack's moverock(): the boulder rolls a cell ahead of the hero, never
; aslant in Sokoban, nor into a wall, a shut door, another boulder or a
; monster; into a hole or a pit it falls and plugs it. 1 if it moved
FUNC BYTE Push(BYTE b, BYTE d)
  BYTE x, y, tx, ty, t, k
  x = ox(b)
  y = oy(b)
  IF d % 2 == 0 AND lvl >= L_SOKO1 THEN
    MsgD(#"The boulder won't roll diagonally on this floor.")
    RETURN (0)
  FI
  tx = x + dir_dx(d)
  ty = y + dir_dy(d)
  IF tx >= LW OR ty >= LH THEN RETURN (0) FI
  IF Open(Kind(tx, ty)) == 0 OR BoulderAt(tx, ty) <> 255 OR MonAt(tx, ty) OR Diagonal(x, y, tx, ty) == 0 THEN
    MsgD(#"You try to move the boulder, but in vain.")
    RETURN (0)
  FI
  IF turns > lastpush + 2 THEN MsgD(#"With great effort you move the boulder.") FI
  lastpush = turns
  TakeObj(b)
  t = TrapAt(tx, ty)
  k = 255
  IF t <> 255 THEN k = tt(t) FI
  IF k == TR_HOLE OR k == TR_TRAPDOOR THEN
    MsgD(#"The boulder falls into and plugs a hole in the floor!")
    DelTrap(t)
  ELSEIF k == TR_PIT OR k == TR_SPIKEDPIT THEN
    MsgD(#"The boulder fills a pit.")
    DelTrap(t)
  ELSE
    t = PutObj(O_BOULDER, 1, 0, 0, tx, ty)
    Sfx(SX_BOULDER)
  FI
  DrawCell(tx, ty)
RETURN (1)

; not to be squeezed past in Sokoban: rock, wall, a boulder
FUNC BYTE Blocked(BYTE x, BYTE y)
  IF Open(Kind(x, y)) == 0 OR BoulderAt(x, y) <> 255 THEN RETURN (1) FI
RETURN (0)

; a step: into a monster is an attack, into the pet a change of places,
; into a shut door opens it; a door is never passed diagonally
PROC Stride(BYTE d)
  BYTE nx, ny, k, ox, oy, m, swap, b
  swap = 0
  nx = px + dir_dx(d)
  ny = py + dir_dy(d)
  IF nx >= LW OR ny >= LH THEN RETURN FI
  k = Kind(nx, ny)
  IF Diagonal(px, py, nx, ny) == 0 THEN
    MsgD(#"You can't move diagonally through a door.")
    RETURN
  FI
  m = MonAt(nx, ny)
  IF m THEN
    m -= 1
    IF mstat(m) & S_PET == 0 THEN
      IF Peaceful(m) THEN
        mbl = 0
        MsgSD(#"Really attack ")
        MsgMon(m, 0)
        MsgS("? [yn] (n)")
        MsgEnd()
        IF Answer() == 0 THEN
          MsgClear()
          RETURN
        FI
        MsgClear()
        mstat(m) = mstat(m) | S_HOSTILE
        urec -= 1
        IF m == shk AND ShkOk() THEN
          mbl = 0
          ShkName()
          MsgSD(#" gets angry!")
          MsgEnd()
        FI
      FI
      HeroAttack(m)
      EndTurn()
      RETURN
    FI
    swap = 1                         ; not m itself: the pet's slot may be 0
  FI
  IF utrap THEN                      ; NetHack's trapmove()
    IF utraptype == TR_BEAR THEN
      MsgD(#"You are caught in a bear trap.")
      IF d % 2 == 0 OR Rnd(5) == 0 THEN utrap -= 1 FI
    ELSE
      utrap -= 1
      IF utrap THEN MsgD(#"You are still in a pit.") ELSE MsgD(#"You crawl to the edge of the pit.") FI
    FI
    EndTurn()
    RETURN
  FI
  IF lvl >= L_SOKO1 AND d % 2 == 0 THEN
    IF Blocked(nx, py) AND Blocked(px, ny) THEN
      MsgD(#"You cannot pass that way.")
      RETURN
    FI
  FI
  b = BoulderAt(nx, ny)
  IF b <> 255 THEN
    IF Push(b, d) == 0 THEN RETURN FI
  FI
  IF k == K_DOORC THEN
    SetKind(nx, ny, K_DOORO)
    Sfx(SX_DOOR)
    MsgD(#"The door opens.")
    DrawCell(nx, ny)
    EndTurn()
    RETURN
  FI
  IF Open(k) == 0 THEN RETURN FI
  ox = px
  oy = py
  SetTrack(px, py)
  px = nx
  py = ny
  IF swap THEN
    Unplace(m)
    mx(m) = ox
    my(m) = oy
    Place(m)
    mbl = 0
    MsgSD(#"You swap places with your ")
    MsgS(MonName(mtype(m)))
    MsgC('.')
    MsgEnd()
  FI
  IF Aim() THEN
    See()
    DrawView()
  ELSE
    See()
    DrawCell(ox, oy)
    DrawCell(px, py)
  FI
  ShopMove(ox, oy)
  TempleMove(ox, oy)
  LookHere()
  Spring()
  EndTurn()
RETURN

; ------------------------------------------------------------- the keys
FUNC BYTE Held()
  BYTE n, s, e, w
  n = KeyHeld(KEY_UP) OR KeyHeld(KP8) OR KeyHeld(KEY_K)
  s = KeyHeld(KEY_DOWN) OR KeyHeld(KP2) OR KeyHeld(KEY_J)
  w = KeyHeld(KEY_LEFT) OR KeyHeld(KP4) OR KeyHeld(KEY_H)
  e = KeyHeld(KEY_RIGHT) OR KeyHeld(KP6) OR KeyHeld(KEY_L)
  IF KeyHeld(KP9) OR KeyHeld(KEY_U) OR (n AND e) THEN RETURN (2) FI
  IF KeyHeld(KP3) OR KeyHeld(KEY_N) OR (s AND e) THEN RETURN (4) FI
  IF KeyHeld(KP1) OR KeyHeld(KEY_B) OR (s AND w) THEN RETURN (6) FI
  IF KeyHeld(KP7) OR KeyHeld(KEY_Y) OR (n AND w) THEN RETURN (8) FI
  IF n THEN RETURN (1) FI
  IF e THEN RETURN (3) FI
  IF s THEN RETURN (5) FI
  IF w THEN RETURN (7) FI
RETURN (0)

; a press shorter than a frame is still a step: the latches, every one
; asked so none is left standing
FUNC BYTE Tapped()
  BYTE d
  d = 0
  IF KeyHit(KEY_UP) OR KeyHit(KP8) OR KeyHit(KEY_K) THEN d = 1 FI
  IF KeyHit(KEY_RIGHT) OR KeyHit(KP6) OR KeyHit(KEY_L) THEN d = 3 FI
  IF KeyHit(KEY_DOWN) OR KeyHit(KP2) OR KeyHit(KEY_J) THEN d = 5 FI
  IF KeyHit(KEY_LEFT) OR KeyHit(KP4) OR KeyHit(KEY_H) THEN d = 7 FI
  IF KeyHit(KP9) OR KeyHit(KEY_U) THEN d = 2 FI
  IF KeyHit(KP3) OR KeyHit(KEY_N) THEN d = 4 FI
  IF KeyHit(KP1) OR KeyHit(KEY_B) THEN d = 6 FI
  IF KeyHit(KP7) OR KeyHit(KEY_Y) THEN d = 8 FI
RETURN (d)

; the direction to step this frame: at once on a press, again after ten
; frames held and then every third
FUNC BYTE Walk()
  BYTE held, hit
  hit = Tapped()
  held = Held()
  IF held == 0 THEN
    rep_c = 0
    RETURN (hit)
  FI
  IF held <> rep_c THEN
    rep_c = held
    rep_t = 0
    RETURN (held)
  FI
  rep_t += 1
  IF rep_t >= 10 THEN
    rep_t = 7
    RETURN (held)
  FI
RETURN (0)

FUNC BYTE Shifted()
  IF KeyHeld(KEY_LSHIFT) OR KeyHeld(KEY_RSHIFT) THEN RETURN (1) FI
RETURN (0)

; a direction asked for: a movement key, or 0 for Esc
FUNC BYTE AskDir()
  BYTE d
  esc = 0
  rep_c = 255
  DO
    Tick()
    d = Tapped()
    IF KeyHit(KEY_DOT) AND Shifted() THEN d = 9 FI
    IF KeyHit(KEY_COMMA) AND Shifted() THEN d = 10 FI
    IF d THEN
      rep_c = Held()                 ; the key still down is the answer, not a step
      rep_t = 0
      RETURN (d)
    FI
  UNTIL esc OD
  esc = 0
RETURN (0)

; a line typed at the keyboard into lb, a length byte and the letters,
; up to `max`: letters by the keyboard's own map, shift for capitals, the
; backspace, Enter to end and Esc to give up (0)
CONST KEY_BACK = $66

FUNC BYTE GetLine(BYTE POINTER prompt, BYTE max)
  BYTE c, ch, i, n, done
  MsgClear()
  Text(0, 0, prompt, B_YELLOW)
  FOR c = 1 TO 127 DO i = KeyHit(c) OD
  lb(0) = 0
  done = 0
  esc = 0
  DO
    n = lb(0)
    Text(0, 1, lb, B_WHITE)
    Text(n, 1, "_ ", B_YELLOW)
    Tick()
    FOR c = 1 TO 127 DO
      ch = kb_map(c)
      IF ch AND KeyHit(c) THEN
        IF ch == 13 THEN
          done = 1
        ELSEIF c == KEY_BACK THEN
          IF lb(0) THEN lb(0) = lb(0) - 1 FI
        ELSEIF ch >= 32 AND lb(0) < max THEN
          IF Shifted() THEN
            IF ch >= 'a' AND ch <= 'z' THEN
              ch = ch & $DF
            ELSE
              i = 0
              WHILE kb_shift(i) DO
                IF kb_shift(i) == ch THEN
                  ch = kb_shift(i + 1)
                  EXIT
                FI
                i += 2
              OD
            FI
          FI
          lb(0) = lb(0) + 1
          lb(lb(0)) = ch
        FI
      FI
    OD
  UNTIL done OR esc OD
  MsgClear()
  rep_c = Held()
  rep_t = 0
  IF esc THEN
    esc = 0
    RETURN (0)
  FI
RETURN (1)

; lb against a word, capitals as small letters, all of lb a prefix of it
FUNC BYTE Typed(BYTE POINTER w)
  BYTE i, ch
  BYTE POINTER q
  IF lb(0) == 0 OR lb(0) > *w THEN RETURN (0) FI
  q = w
  FOR i = 1 TO lb(0) DO
    q += 1
    ch = lb(i)
    IF ch >= 'A' AND ch <= 'Z' THEN ch = ch | $20 FI
    IF ch <> *q THEN RETURN (0) FI
  OD
RETURN (1)

; ------------------------------------------------------------- the pack
FUNC BYTE Passes(BYTE k, BYTE mask, BYTE mode)
  IF it(k) == 255 THEN RETURN (0) FI
  IF mask & (1 << o_class(it(k))) == 0 THEN RETURN (0) FI
  IF mode == 1 AND IsWorn(k) THEN RETURN (0) FI
  IF mode == 2 AND IsWorn(k) == 0 THEN RETURN (0) FI
RETURN (1)

PROC ClassName(BYTE c)
  IF c == C_WEAPON THEN
    MsgS("Weapons")
  ELSEIF c == C_ARMOR THEN
    MsgS("Armor")
  ELSEIF c == C_POTION THEN
    MsgS("Potions")
  ELSEIF c == C_SCROLL THEN
    MsgS("Scrolls")
  ELSEIF c == C_WAND THEN
    MsgS("Wands")
  ELSEIF c == C_RING THEN
    MsgS("Rings")
  ELSE
    MsgS("Amulets")
  FI
RETURN

; the pack over the map, a heading a class as NetHack lists it: only the
; classes in `mask`, a bit a class, and with mode 1 only what is not worn
; and with 2 only what is. A letter answers, 255 for none; the map comes
; back after
FUNC BYTE Menu(BYTE POINTER prompt, BYTE mask, BYTE mode)
  BYTE row, c, k, n, any, pick, col
  MsgClear()
  FOR row = VTOP TO VTOP + 25 DO ClearRow(row) OD
  Text(0, 0, prompt, B_YELLOW)
  row = VTOP
  n = 0
  FOR c = 0 TO 6 DO
    any = 0
    FOR k = 0 TO MAXINV - 1 DO
      IF Passes(k, mask, mode) AND row < VTOP + 26 THEN
        IF o_class(it(k)) == c THEN
          IF any == 0 THEN
            mbl = 0
            ClassName(c)
            col = Put(0, row, B_YELLOW)
            row += 1
            any = 1
          FI
          mbl = 0
          MsgC('a' + k)
          MsgS(" - ")
          InvName(k)
          IF mbl > 39 THEN mbl = 39 FI
          col = Put(1, row, B_WHITE)
          row += 1
          n += 1
        FI
      FI
    OD
  OD
  pick = 255
  IF n == 0 THEN
    Text(0, VTOP, Str(#"You don't have anything for that."), B_WHITE)
  FI
  FOR k = 0 TO MAXINV - 1 DO
    c = KeyHit(letter_sc(k))
  OD
  c = KeyHit(KEY_SPACE)
  c = KeyHit(KEY_ENTER)
  esc = 0
  DO
    Tick()
    FOR k = 0 TO MAXINV - 1 DO
      IF KeyHit(letter_sc(k)) THEN
        IF Passes(k, mask, mode) THEN pick = k FI
      FI
    OD
  UNTIL pick <> 255 OR esc OR KeyHit(KEY_SPACE) OR KeyHit(KEY_ENTER) OD
  esc = 0
  rep_c = Held()                     ; the letter still down is not a step
  rep_t = 0
  FOR row = VTOP TO VTOP + 25 DO ClearRow(row) OD
  MsgClear()
  DrawView()
RETURN (pick)

FUNC BYTE POINTER ApName(BYTE t)
  BYTE c
  c = o_class(t)
  IF c == C_POTION THEN RETURN (NameRec(NAME_POTION + ap(t))) FI
  IF c == C_SCROLL THEN RETURN (NameRec(NAME_SCROLL + ap(t))) FI
  IF c == C_WAND THEN RETURN (NameRec(NAME_WAND + ap(t))) FI
RETURN (NameRec(NAME_RING + ap(t)))

; NetHack's \: the kinds identified, and what they looked like
PROC Discoveries()
  BYTE t, row, d
  MsgClear()
  FOR row = VTOP TO VTOP + 25 DO ClearRow(row) OD
  Text(0, 0, Str(#"Discoveries"), B_YELLOW)
  row = VTOP
  FOR t = O_HEALING TO O_RTELEPORT DO
    IF known(t) AND row < VTOP + 26 THEN
      mbl = 0
      Name(t, 1, 0, 0, 0)
      MsgS(" (")
      MsgS(ApName(t))
      MsgC(')')
      d = Put(1, row, B_WHITE)
      row += 1
    FI
  OD
  IF row == VTOP THEN Text(1, VTOP, Str(#"You haven't discovered anything yet."), B_WHITE) FI
  d = KeyHit(KEY_SPACE)
  esc = 0
  DO
    Tick()
  UNTIL KeyHit(KEY_SPACE) OR KeyHit(KEY_ENTER) OR esc OD
  esc = 0
  FOR row = VTOP TO VTOP + 25 DO ClearRow(row) OD
  DrawView()
RETURN

; ------------------------------------------------------ using things
; the room the hero is in lit, or darkened; in a corridor, the cells round
PROC LightRoom(BYTE on)
  BYTE r, x, y
  CARD i
  r = RoomAt(px, py)
  IF r == 255 THEN
    FOR y = py - 2 TO py + 2 DO
      FOR x = px - 2 TO px + 2 DO
        IF x < LW AND y < LH THEN
          i = Idx(x, y)
          IF lv(i) & 15 <> K_ROCK THEN lv(i) = lv(i) | F_SEEN FI
        FI
      OD
    OD
  ELSE
    FOR y = ry1(r) + 1 TO ry2(r) - 1 DO
      FOR x = rx1(r) + 1 TO rx2(r) - 1 DO
        i = Idx(x, y)
        IF on THEN lv(i) = lv(i) | F_LIT ELSE lv(i) = lv(i) & (255 ^ F_LIT) FI
      OD
    OD
  FI
  See()
  DrawView()
  IF on THEN MsgD(#"A lit field surrounds you!") ELSE MsgD(#"Darkness surrounds you.") FI
RETURN

PROC PickUp()
  BYTE i, k, f
  i = oat(Idx(px, py))
  IF i == 0 THEN
    MsgD(#"There is nothing here to pick up.")
    RETURN
  FI
  i -= 1
  IF ot(i) == O_BOULDER THEN
    MsgD(#"The boulder is too heavy to lift.")
    RETURN
  FI
  IF ot(i) == O_GOLD THEN
    ugold += oq(i)
    mbl = 0
    MsgN(oq(i))
    MsgSD(#" gold pieces.")
    MsgEnd()
  ELSE
    f = of(i) & (255 ^ OF_NOCHG)
    IF ShkOk() AND InShop(px, py) AND of(i) & OF_NOCHG == 0 THEN
      f = f | OF_UNPAID
      mbl = 0
      MsgS("\"For you, ")
      IF mstat(shk) & S_HOSTILE THEN
        MsgS("scum")
      ELSE
        k = Rnd(4)
        IF k == 0 THEN
          MsgS("good")
        ELSEIF k == 1 THEN
          MsgS("honored")
        ELSEIF k == 2 THEN
          MsgSD(#"most gracious")
        ELSE
          MsgS("esteemed")
        FI
        IF role == 0 THEN MsgS(" lady") ELSE MsgS(" sir") FI
      FI
      MsgS("; only ")
      MsgN(Price(ot(i), f, oe(i), 0))
      IF oq(i) > 1 THEN MsgSD(#" zorkmids per ") ELSE MsgSD(#" zorkmids for this ") FI
      Name(ot(i), 1, 0, oe(i), 0)
      MsgS(".\"")
      MsgEnd()
    FI
    IF ot(i) == O_MOTT AND udemi == 0 THEN
      udemi = 1
      udg = 50 + Rnd(250)
    FI
    k = InvAdd(ot(i), oq(i), f, oe(i))
    IF k == 255 THEN
      MsgD(#"You have too many things to carry more.")
      RETURN
    FI
    mbl = 0
    MsgC('a' + k)
    MsgS(" - ")
    InvName(k)
    MsgC('.')
    MsgEnd()
  FI
  TakeObj(i)
  EndTurn()
RETURN

PROC Welded(BYTE k)
  ifl(k) = ifl(k) | OF_BKNOWN
  mbl = 0
  MsgS("Your ")
  Name(it(k), 1, 0, 0, 0)
  MsgSD(#" is welded to your hand!")
  MsgEnd()
RETURN

PROC Drop()
  BYTE k, j
  k = Menu(Str(#"What do you want to drop?"), $7F, 0)
  IF k == 255 THEN RETURN FI
  IF IsWorn(k) THEN
    MsgD(#"You cannot drop something you are wearing.")
    RETURN
  FI
  IF uwep == k AND ifl(k) & OF_CURSE THEN
    Welded(k)
    RETURN
  FI
  j = PutObj(it(k), iq(k), ifl(k), ie(k), px, py)
  IF j == 255 THEN
    MsgD(#"There is no room to drop anything here.")
    RETURN
  FI
  mbl = 0
  IF Kind(px, py) >= K_ALTAR THEN   ; NetHack's doaltarobj(): the curse shown
    IF ifl(k) & OF_BLESS THEN
      MsgSD(#"There is an amber flash as ")
    ELSEIF ifl(k) & OF_CURSE THEN
      MsgSD(#"There is a black flash as ")
    FI
    Name(it(k), iq(k), ifl(k), ie(k), 1)
    IF ifl(k) & (OF_BLESS | OF_CURSE) THEN
      MsgSD(#" hits the altar.")
    ELSE
      IF mb(0) >= 'a' THEN mb(0) = mb(0) & $DF FI
      MsgSD(#" lands on the altar.")
    FI
    of(j) = of(j) | OF_BKNOWN
  ELSE
    MsgS("You drop ")
    Name(it(k), iq(k), ifl(k), ie(k), 1)
    MsgC('.')
  FI
  MsgEnd()
  InvDel(k, iq(k))
  IF ShkOk() AND InShop(px, py) AND (px <> shdx OR py <> shdy) THEN Sell(j) FI
  EndTurn()
RETURN

; a cursed weapon welds itself to the hand, and cannot be put away
PROC Wield()
  BYTE k
  IF uwep <> 255 THEN
    IF ifl(uwep) & OF_CURSE THEN
      Welded(uwep)
      RETURN
    FI
  FI
  k = Menu(Str(#"What do you want to wield?"), 1, 1)
  IF k == 255 THEN RETURN FI
  uwep = k
  mbl = 0
  MsgC('a' + k)
  MsgS(" - ")
  InvName(k)
  MsgC('.')
  MsgEnd()
  IF ifl(k) & OF_CURSE THEN
    ifl(k) = ifl(k) | OF_BKNOWN
    MsgD(#"It welds itself to your hand!")
  FI
  EndTurn()
RETURN

; armour: a slot at a time, the cloak over the body armour, its
; enchantment learnt by wearing it and its curse by trying to take it off
PROC Wear()
  BYTE k, s
  k = Menu(Str(#"What do you want to wear?"), 2, 1)
  IF k == 255 THEN RETURN FI
  s = o_slot(it(k))
  IF worn(s) <> 255 THEN
    MsgD(#"You are already wearing one of those.")
    RETURN
  FI
  IF s == SLOT_BODY AND worn(SLOT_CLOAK) <> 255 THEN
    MsgD(#"You are wearing a cloak over it.")
    RETURN
  FI
  IF uwep == k THEN uwep = 255 FI
  worn(s) = k
  ifl(k) = ifl(k) | OF_EKNOWN
  CalcAC()
  mbl = 0
  MsgSD(#"You are now wearing ")
  Name(it(k), 1, ifl(k), ie(k), 1)
  MsgC('.')
  MsgEnd()
  EndTurn()
RETURN

PROC TakeOff()
  BYTE k, s
  k = Menu(Str(#"What do you want to take off?"), 2, 2)
  IF k == 255 THEN RETURN FI
  s = o_slot(it(k))
  IF s == SLOT_BODY AND worn(SLOT_CLOAK) <> 255 THEN
    MsgD(#"You are wearing a cloak over it.")
    RETURN
  FI
  IF ifl(k) & OF_CURSE THEN
    ifl(k) = ifl(k) | OF_BKNOWN
    MsgD(#"You can't. It is cursed.")
    RETURN
  FI
  worn(s) = 255
  CalcAC()
  mbl = 0
  MsgSD(#"You were wearing ")
  Name(it(k), 1, ifl(k), ie(k), 1)
  MsgC('.')
  MsgEnd()
  EndTurn()
RETURN

; a ring on the left hand if it is free, else the right; an amulet round
; the neck. A ring of protection shows itself in the armour class
PROC PutOn()
  BYTE k, t
  k = Menu(Str(#"What do you want to put on?"), 96, 1)
  IF k == 255 THEN RETURN FI
  t = it(k)
  IF uwep == k THEN uwep = 255 FI
  IF o_class(t) == C_AMULET THEN
    IF uamul <> 255 THEN
      MsgD(#"You are already wearing an amulet.")
      RETURN
    FI
    uamul = k
  ELSEIF uleft == 255 THEN
    uleft = k
  ELSEIF uright == 255 THEN
    uright = k
  ELSE
    MsgD(#"You are already wearing two rings.")
    RETURN
  FI
  IF t == O_RPROTECTION THEN
    Know(t)
    ifl(k) = ifl(k) | OF_EKNOWN
  FI
  CalcAC()
  mbl = 0
  MsgC('a' + k)
  MsgS(" - ")
  InvName(k)
  MsgC('.')
  MsgEnd()
  EndTurn()
RETURN

PROC TakeRing()
  BYTE k
  k = Menu(Str(#"What do you want to remove?"), 96, 2)
  IF k == 255 THEN RETURN FI
  IF ifl(k) & OF_CURSE THEN
    ifl(k) = ifl(k) | OF_BKNOWN
    MsgD(#"It won't come off!")
    RETURN
  FI
  IF uleft == k THEN uleft = 255 FI
  IF uright == k THEN uright = 255 FI
  IF uamul == k THEN uamul = 255 FI
  CalcAC()
  mbl = 0
  MsgSD(#"You were wearing ")
  Name(it(k), 1, ifl(k), ie(k), 1)
  MsgC('.')
  MsgEnd()
  EndTurn()
RETURN

; NetHack's healup(): hit points, and the most raised by `more` if they
; would run over it
PROC Heal(BYTE h, BYTE more)
  CARD v
  v = uhp
  v = v + h
  IF v > uhpmax THEN
    IF uhpmax < 240 THEN uhpmax += more FI
    v = uhpmax
  FI
  uhp = v
RETURN

; blessed 1, cursed -1, else 0
FUNC INT Sign(BYTE f)
  IF f & OF_BLESS THEN RETURN (1) FI
  IF f & OF_CURSE THEN RETURN (-1) FI
RETURN (0)

; ------------------------------------------------------------ fountains
; a monster of type t beside the hero, awake; 1 if there was room
FUNC BYTE SpawnNear(BYTE t)
  BYTE d, i
  d = FreeNear(px, py)
  IF d == 0 THEN RETURN (0) FI
  i = NewMon(t, px + dir_dx(d), py + dir_dy(d))
  IF i == 255 THEN RETURN (0) FI
  DrawCell(mx(i), my(i))
RETURN (1)

; every monster on the level shown where it is until a key, as NetHack's
; monster detection does
PROC DetectMonsters()
  BYTE i, n
  n = 0
  FOR i = 0 TO MAXMON - 1 DO
    IF mstat(i) THEN
      n += 1
      IF mx(i) >= vx AND mx(i) < vx + VW AND my(i) >= vy AND my(i) < vy + VH THEN
        Pic((mx(i) - vx) << 1, VTOP + ((my(i) - vy) << 1), (3 + mtype(i)) << 2, (2 + anim) << 4)
      FI
    FI
  OD
  IF n == 0 THEN
    MsgD(#"You feel threatened.")
    RETURN
  FI
  MsgD(#"You sense the presence of monsters.")
  msgrow = 2
  More()
  DrawView()
RETURN

; NetHack's drinkfountain(), fate by a thirty-sided die, less the magic
; fountain, the wish and the pools the game has not; one time in three
; the fountain dries up after
PROC DrinkFountain()
  BYTE fate, i, n
  fate = Roll(30)
  Sfx(SX_WATER)
  IF fate < 10 THEN
    MsgD(#"The cool draught refreshes you.")
  ELSEIF fate == 19 THEN
    MsgD(#"You feel self-knowledgeable...")
    MsgD(#"The feeling subsides.")
  ELSEIF fate == 20 THEN
    MsgD(#"The water is foul!  You gag and vomit.")
  ELSEIF fate == 21 THEN
    MsgD(#"The water is contaminated!")
    IF Wearing(O_RPOISONRES) THEN
      MsgD(#"Perhaps it is runoff from the nearby slime mold farm.")
      HurtHero(Roll(4), KD_JUICE)
    ELSE
      HurtHero(Roll(10), KD_WATER)
    FI
  ELSEIF fate == 22 THEN
    MsgD(#"An endless stream of snakes pours forth!")
    n = 2 + Rnd(5)
    FOR i = 1 TO n DO fate = SpawnNear(M_SNAKE) OD
  ELSEIF fate == 23 THEN
    IF SpawnNear(M_WATERDEMON) THEN MsgD(#"You unleash a water demon!") FI
  ELSEIF fate == 24 THEN
    MsgD(#"This water's no good!")
    FOR i = 0 TO MAXINV - 1 DO
      IF it(i) <> 255 AND Rnd(5) == 0 THEN ifl(i) = (ifl(i) & (255 ^ OF_BLESS)) | OF_CURSE FI
    OD
  ELSEIF fate == 25 THEN
    MsgD(#"You see an image of someone stalking you.")
    MsgD(#"But it disappears.")
  ELSEIF fate == 26 THEN
    DetectMonsters()
  ELSEIF fate <= 28 THEN
    IF SpawnNear(M_WATERNYMPH) THEN
      MsgD(#"You attract a water nymph!")
    ELSE
      MsgD(#"A large bubble rises to the surface and pops.")
    FI
  ELSEIF fate == 29 THEN
    MsgD(#"This water gives you bad breath!")
    FOR i = 0 TO MAXMON - 1 DO
      IF mstat(i) THEN mflee(i) = 255 FI
    OD
  ELSEIF fate == 30 THEN
    MsgD(#"Your thirst is quenched.")
  ELSE
    MsgD(#"This tepid water is tasteless.")
  FI
  IF Rnd(3) == 0 AND Kind(px, py) == K_FOUNTAIN THEN
    MsgD(#"The fountain dries up!")
    SetKind(px, py, K_FLOOR)
  FI
RETURN

; a potion, as NetHack's peffects() has it, cut to these eight; one whose
; drinking says what it was becomes known
PROC Quaff()
  BYTE k, t, f, h
  INT s
  IF Kind(px, py) == K_FOUNTAIN THEN
    IF YesNo(Str(#"Drink from the fountain? [yn] (n)")) THEN
      MsgClear()
      DrinkFountain()
      EndTurn()
      RETURN
    FI
  FI
  k = Menu(Str(#"What do you want to drink?"), 4, 0)
  IF k == 255 THEN RETURN FI
  t = it(k)
  f = ifl(k)
  s = Sign(f)
  IF f & OF_UNPAID AND ShkOk() THEN Owe(Price(t, f, ie(k), 0)) FI
  InvDel(k, 1)
  IF t == O_HEALING THEN
    Know(t)
    MsgD(#"You feel better.")
    h = 1
    IF s < 0 THEN h = 0 FI
    Heal(Dice(6 + 2 * s, 4), h)
  ELSEIF t == O_EXTRAHEALING THEN
    Know(t)
    MsgD(#"You feel much better.")
    h = 2
    IF s > 0 THEN h = 5 FI
    IF s < 0 THEN h = 0 FI
    Heal(Dice(6 + 2 * s, 8), h)
  ELSEIF t == O_GAINLEVEL THEN
    Know(t)
    IF s < 0 THEN
      IF Above() THEN
        MsgD(#"You rise up, through the ceiling!")
        GoLevel(Above(), 2)
      ELSE
        MsgD(#"You have an uneasy feeling.")
      FI
    ELSEIF ulev < 12 THEN
      MsgD(#"You feel more experienced.")
      uxp = NeedXP(ulev)
      LevelUp()
    FI
  ELSEIF t == O_GAINENERGY THEN
    Know(t)
    h = Dice(2 + s, 6)
    IF s < 0 THEN
      MsgD(#"You feel lackluster.")
      IF upwmax > h THEN upwmax -= h ELSE upwmax = 0 FI
      IF upw > upwmax THEN upw = upwmax FI
    ELSE
      MsgD(#"Magical energies course through your body.")
      IF upwmax < 240 THEN upwmax += h FI
      upw = upwmax
    FI
  ELSEIF t == O_SLEEPING THEN
    Know(t)
    IF Wearing(O_RFREEACTION) THEN
      Msg("You yawn.")
    ELSE
      MsgD(#"You suddenly fall asleep.")
      upara = Roll(10 - 4 * s)
    FI
  ELSEIF t == O_SICKNESS THEN
    Know(t)
    MsgD(#"Yecch! This stuff tastes like poison.")
    IF Wearing(O_RPOISONRES) THEN
      MsgD(#"(But in fact it was mildly stale fruit juice.)")
    ELSE
      HurtSelf(Roll(10 - 5 * s))
    FI
  ELSEIF t == O_FRUITJUICE THEN
    MsgD(#"This tastes like slime mold juice.")
  ELSE
    Know(t)
    IF s > 0 THEN
      MsgD(#"You feel full of awe.")
    ELSEIF s < 0 THEN
      MsgD(#"This burns!")
      HurtSelf(Roll(6))
    ELSE
      MsgD(#"This tastes like water.")
    FI
  FI
  EndTurn()
RETURN

PROC IdentifyOne(BYTE k)
  known(it(k)) = 1
  ifl(k) = ifl(k) | OF_BKNOWN | OF_EKNOWN
RETURN

; a random piece of armour worn, or 255
FUNC BYTE RandomWorn()
  BYTE s, n
  s = Rnd(6)
  FOR n = 1 TO 6 DO
    s = (s % 6) + 1
    IF worn(s) <> 255 THEN RETURN (worn(s)) FI
  OD
RETURN (255)

; a scroll, as NetHack's seffects() has it, cut to these eight
PROC Read()
  BYTE k, t, f, j, ev
  INT s
  CARD c
  k = Menu(Str(#"What do you want to read?"), 8, 0)
  IF k == 255 THEN RETURN FI
  t = it(k)
  f = ifl(k)
  s = Sign(f)
  IF f & OF_UNPAID AND ShkOk() THEN Owe(Price(t, f, ie(k), 0)) FI
  InvDel(k, 1)
  IF t == O_IDENTIFY THEN
    Know(t)
    IF s > 0 AND Rnd(5) == 0 THEN
      FOR j = 0 TO MAXINV - 1 DO
        IF it(j) <> 255 THEN IdentifyOne(j) FI
      OD
      MsgD(#"You identify everything you carry.")
    ELSE
      j = Menu(Str(#"This is an identify scroll. Identify what?"), $7F, 0)
      IF j <> 255 THEN
        IdentifyOne(j)
        mbl = 0
        MsgC('a' + j)
        MsgS(" - ")
        InvName(j)
        MsgC('.')
        MsgEnd()
      FI
    FI
  ELSEIF t == O_ENCHANTWEAPON THEN
    IF uwep == 255 THEN
      MsgD(#"Your hands twitch.")
    ELSE
      Know(t)
      ev = 0
      mbl = 0
      MsgS("Your ")
      Name(it(uwep), 1, 0, 0, 0)
      IF s < 0 THEN
        MsgSD(#" glows black for a moment.")
        ie(uwep) = ie(uwep) - 1
      ELSEIF Signed(ie(uwep)) > 5 AND Rnd(3) THEN
        MsgSD(#" violently glows blue, then evaporates.")
        ev = 1
      ELSE
        MsgSD(#" glows blue for a moment.")
        ie(uwep) = ie(uwep) + 1
        IF s > 0 THEN ie(uwep) = ie(uwep) + Rnd(2) FI
        ifl(uwep) = ifl(uwep) & (255 ^ OF_CURSE)
      FI
      MsgEnd()
      IF ev THEN InvDel(uwep, iq(uwep)) FI
    FI
  ELSEIF t == O_ENCHANTARMOR THEN
    j = RandomWorn()
    IF j == 255 THEN
      MsgD(#"Your skin glows then fades.")
    ELSE
      Know(t)
      ev = 0
      mbl = 0
      MsgS("Your ")
      Name(it(j), 1, 0, 0, 0)
      IF s < 0 THEN
        MsgSD(#" glows black for a moment.")
        ie(j) = ie(j) - 1
      ELSEIF Signed(ie(j)) > 3 AND Rnd(3) THEN
        MsgSD(#" violently glows silver, then evaporates.")
        ev = 1
      ELSE
        MsgSD(#" glows silver for a moment.")
        ie(j) = ie(j) + 1
        IF s > 0 THEN ie(j) = ie(j) + Rnd(2) FI
        ifl(j) = ifl(j) & (255 ^ OF_CURSE)
      FI
      MsgEnd()
      IF ev THEN InvDel(j, 1) FI
      CalcAC()
    FI
  ELSEIF t == O_REMOVECURSE THEN
    IF s < 0 THEN
      MsgD(#"You feel like you need some help.")
    ELSE
      MsgD(#"You feel like someone is helping you.")
      FOR j = 0 TO MAXINV - 1 DO
        IF it(j) <> 255 THEN
          IF s > 0 OR IsWorn(j) OR uwep == j THEN ifl(j) = ifl(j) & (255 ^ OF_CURSE) FI
        FI
      OD
    FI
  ELSEIF t == O_TELEPORT THEN
    Know(t)
    IF s < 0 AND Below() AND lvl < L_SOKO1 THEN
      MsgD(#"You feel very disoriented for a moment.")
      GoLevel(Below(), 2)
    ELSE
      Teleport()
      MsgD(#"You feel disoriented for a moment.")
    FI
  ELSEIF t == O_MAGICMAPPING THEN
    IF s < 0 THEN
      MsgD(#"Unfortunately, you can't grasp the details.")
    ELSE
      Know(t)
      FOR c = 0 TO NCELL - 1 DO
        j = lv(c) & 15
        IF j == K_SCORR THEN
          lv(c) = lv(c) & 240 | K_CORR
          j = K_CORR
        FI
        IF j <> K_ROCK THEN lv(c) = lv(c) | F_SEEN FI
      OD
      DrawView()
      MsgD(#"A map coalesces in your mind!")
    FI
  ELSEIF t == O_LIGHT THEN
    Know(t)
    IF s < 0 THEN LightRoom(0) ELSE LightRoom(1) FI
  ELSE
    Know(t)
    MsgD(#"The scroll erupts in a tower of flame!")
    FOR j = 0 TO MAXMON - 1 DO
      IF mstat(j) THEN
        IF mstat(j) & S_PET == 0 AND Dist(mx(j), my(j), px, py) <= 1 THEN
          mbl = 0
          MsgMon(j, 1)
          MsgSD(#" is burnt!")
          MsgEnd()
          ev = HurtMon(j, Dice(3 + s, 4))
        FI
      FI
    OD
    IF s <= 0 THEN
      MsgD(#"The flames burn you.")
      HurtSelf(Roll(4))
    FI
  FI
  EndTurn()
RETURN

; a wand, as NetHack's zap.c has it for these six: light and create
; monster need no direction; striking hits the first monster along it,
; magic missile and sleep every one in eight cells; digging bores through
; rock and walls, or down through the floor to the level below
PROC Zap()
  BYTE k, t, d, n, x, y, m, kind, r
  k = Menu(Str(#"What do you want to zap?"), 16, 0)
  IF k == 255 THEN RETURN FI
  t = it(k)
  IF ie(k) == 0 THEN
    MsgD(#"Nothing happens.")
    EndTurn()
    RETURN
  FI
  ie(k) = ie(k) - 1
  Sfx(SX_MAGIC)
  IF ifl(k) & OF_UNPAID AND ShkOk() THEN Owe(o_cost(t) / 5) FI
  d = 0
  IF o_slot(t) <> D_NODIR THEN
    MsgD(#"In what direction?")
    d = AskDir()
    IF d == 0 THEN RETURN FI
  FI
  IF t == O_WLIGHT THEN
    Know(t)
    LightRoom(1)
  ELSEIF t == O_WCREATE THEN
    n = FreeNear(px, py)
    IF n THEN
      Know(t)
      Spawn(px + dir_dx(n), py + dir_dy(n))
      See()
    FI
  ELSEIF d > 8 THEN
    IF t <> O_WDIGGING THEN
      MsgD(#"The bugs on the floor stop moving!")
    ELSEIF d == 10 THEN
      Know(t)
      MsgD(#"You loosen a rock from the ceiling. It falls on your head!")
      HurtSelf(Roll(6))
    ELSEIF Below() == 0 OR lvl >= L_SOKO1 THEN
      MsgD(#"The floor here is too hard to dig in.")
    ELSE
      Know(t)
      MsgD(#"You dig a hole through the floor. You fall through...")
      GoLevel(Below(), 2)
    FI
  ELSE
    x = px
    y = py
    FOR n = 1 TO 8 DO
      x += dir_dx(d)
      y += dir_dy(d)
      IF x >= LW OR y >= LH THEN EXIT FI
      IF t == O_WDIGGING AND lvl < L_SOKO1 THEN
        kind = Kind(x, y)
        IF kind == K_WALL OR kind == K_ROCK OR kind == K_SCORR THEN
          SetKind(x, y, K_CORR)
        ELSEIF kind == K_DOORC OR kind == K_DOORO OR kind == K_SDOOR THEN
          SetKind(x, y, K_DOORWAY)
        FI
        lv(Idx(x, y)) = lv(Idx(x, y)) | F_SEEN
      ELSE
        IF Open(Kind(x, y)) == 0 THEN EXIT FI
        m = MonAt(x, y)
        IF m THEN
          m -= 1
          Know(t)
          mbl = 0
          IF t == O_WSTRIKING THEN
            MsgSD(#"The wand hits ")
          ELSEIF t == O_WMISSILE THEN
            MsgSD(#"The magic missile hits ")
          ELSE
            MsgSD(#"The sleep ray hits ")
          FI
          MsgMon(m, 0)
          MsgC('.')
          MsgEnd()
          IF t == O_WSLEEP THEN
            msl(m) = Dice(2, 25)
          ELSEIF t == O_WSTRIKING THEN
            r = HurtMon(m, Dice(2, 12))
            EXIT
          ELSE
            r = HurtMon(m, Dice(2, 6))
          FI
        FI
      FI
    OD
    IF t == O_WDIGGING THEN
      See()
      DrawView()
      IF lvl >= L_SOKO1 THEN
        MsgD(#"The walls here are too hard to dig in.")
      ELSE
        Know(t)
        MsgD(#"You dig through the rock.")
      FI
    FI
  FI
  EndTurn()
RETURN

; a thrown thing's flight: along d for up to eight cells, drawn as it
; goes, into the first monster -- NetHack's to-hit, and a dagger's +2 --
; and down where it stops
PROC Fly(BYTE k, BYTE d)
  BYTE t, f, e, x, y, n, m, lx, ly, sides, r
  INT tmp, dmg
  t = it(k)
  f = ifl(k)
  e = ie(k)
  InvDel(k, 1)
  x = px
  y = py
  lx = px
  ly = py
  FOR n = 1 TO 8 DO
    x += dir_dx(d)
    y += dir_dy(d)
    IF x >= LW OR y >= LH THEN EXIT FI
    IF Open(Kind(x, y)) == 0 OR Diagonal(lx, ly, x, y) == 0 OR BoulderAt(x, y) <> 255 THEN EXIT FI
    lx = x
    ly = y
    IF x >= vx AND x < vx + VW AND y >= vy AND y < vy + VH THEN
      Pic((x - vx) << 1, VTOP + ((y - vy) << 1), (o_pic(t) + ap(t)) << 2, 16)
      Tick()
      Tick()
      DrawCell(x, y)
    FI
    m = MonAt(x, y)
    IF m THEN
      m -= 1
      sides = 2
      IF o_class(t) == C_WEAPON THEN sides = o_arg(t) FI
      tmp = m_ac(mtype(m))
      tmp = tmp - 10 + 1 + r_abon(role) + ulev + Signed(e)
      IF t == O_DAGGER THEN tmp += 2 FI
      mbl = 0
      MsgS("The ")
      Name(t, 1, 0, 0, 0)
      IF tmp > Roll(20) THEN
        MsgS(" hits ")
        MsgMon(m, 0)
        MsgC('.')
        MsgEnd()
        dmg = Roll(sides) + Signed(e) + RingEnch(O_RDAMAGE)
        IF dmg < 1 THEN dmg = 1 FI
        r = HurtMon(m, dmg)
      ELSE
        MsgS(" misses ")
        MsgMon(m, 0)
        MsgC('.')
        MsgEnd()
      FI
      EXIT
    FI
  OD
  IF ShkOk() THEN
    IF f & OF_UNPAID THEN
      IF InShop(lx, ly) == 0 THEN Owe(Price(t, f, e, 0)) FI
    ELSEIF InShop(lx, ly) THEN
      f = f | OF_NOCHG
    FI
    f = f & (255 ^ OF_UNPAID)
  FI
  IF PutObj(t, 1, f, e, lx, ly) <> 255 THEN DrawCell(lx, ly) FI
RETURN

PROC Throw()
  BYTE k, d
  WipeEngr(px, py, 2)
  k = Menu(Str(#"What do you want to throw?"), $7F, 1)
  IF k == 255 THEN RETURN FI
  IF uwep == k AND ifl(k) & OF_CURSE THEN
    Welded(k)
    RETURN
  FI
  MsgD(#"In what direction?")
  d = AskDir()
  IF d == 0 OR d > 8 THEN RETURN FI
  Fly(k, d)
  EndTurn()
RETURN

FUNC BYTE FindDagger()
  BYTE k
  FOR k = 0 TO MAXINV - 1 DO
    IF it(k) == O_DAGGER AND uwep <> k THEN RETURN (k) FI
  OD
RETURN (255)

; f: the daggers not in hand, as NetHack's fire command with a quiver of
; them; the Rogue throws up to three at once, its multishot
PROC Fire()
  BYTE k, d, n, shots
  IF FindDagger() == 255 THEN
    MsgD(#"You have no daggers to fire.")
    RETURN
  FI
  MsgD(#"In what direction?")
  d = AskDir()
  IF d == 0 OR d > 8 THEN RETURN FI
  shots = 1
  IF role == 2 THEN shots = 1 + Rnd(3) FI
  FOR n = 1 TO shots DO
    k = FindDagger()
    IF k <> 255 THEN Fly(k, d) FI
  OD
  EndTurn()
RETURN

; ------------------------------------------------------ a hero's things
PROC Shuffle(BYTE first, BYTE n)
  BYTE i, j, v
  FOR i = 0 TO n - 1 DO ap(first + i) = i OD
  i = n
  WHILE i > 1 DO
    i -= 1
    j = Rnd(i + 1)
    v = ap(first + i)
    ap(first + i) = ap(first + j)
    ap(first + j) = v
  OD
RETURN

; a starting thing: into the pack, its kind, blessing and enchantment
; known, as NetHack's starting inventory is
FUNC BYTE Give(BYTE t, BYTE q, BYTE f, BYTE e)
  known(t) = 1
RETURN (InvAdd(t, q, f | OF_BKNOWN | OF_EKNOWN, e))

; the appearances shuffled, and each hero's things from NetHack's
; u_init.c: the Valkyrie a +1 long sword, a dagger and a +3 small shield;
; the Wizard a blessed +1 quarterstaff, a cloak, a wand, two rings, two
; potions and two scrolls; the Rogue a short sword, a stack of daggers,
; +1 leather armour and a potion of sickness
PROC InitHero()
  BYTE i, k
  FOR i = 0 TO N_OBJ - 1 DO
    known(i) = 0
    ap(i) = 0
    IF o_class(i) <= C_ARMOR OR i == O_GOLD THEN known(i) = 1 FI
  OD
  Shuffle(O_HEALING, 7)
  ap(O_WATER) = 7
  Shuffle(O_IDENTIFY, 8)
  Shuffle(O_WLIGHT, 6)
  Shuffle(O_RPROTECTION, 6)
  FOR i = 0 TO MAXINV - 1 DO it(i) = 255 OD
  FOR i = 0 TO 6 DO worn(i) = 255 OD
  uwep = 255
  uleft = 255
  uright = 255
  uamul = 255
  ugold = 0
  IF role == 0 THEN
    uwep = Give(O_LONGSWORD, 1, 0, 1)
    k = Give(O_DAGGER, 1, 0, 0)
    worn(SLOT_SHIELD) = Give(O_SMALLSHIELD, 1, 0, 3)
  ELSEIF role == 1 THEN
    uwep = Give(O_QUARTERSTAFF, 1, OF_BLESS, 1)
    worn(SLOT_CLOAK) = Give(O_CLOAK, 1, 0, 0)
    k = Give(O_WSTRIKING + Rnd(4), 1, 0, 4 + Rnd(5))
    k = O_RPROTECTION + Rnd(5)
    i = Give(k, 1, 0, Roll(3))
    i = O_RPROTECTION + (k - O_RPROTECTION + 1 + Rnd(4)) % 5   ; a second ring, of another kind
    i = Give(i, 1, 0, Roll(3))
    FOR i = 1 TO 2 DO
      k = Give(PickKind(C_POTION), 1, 0, 0)
      k = Give(PickKind(C_SCROLL), 1, 0, 0)
    OD
  ELSE
    uwep = Give(O_SHORTSWORD, 1, 0, 0)
    k = Give(O_DAGGER, 6 + Rnd(10), 0, 0)
    worn(SLOT_BODY) = Give(O_LEATHERARMOR, 1, 0, 1)
    k = Give(O_SICKNESS, 1, 0, 0)
  FI
  CalcAC()
RETURN

; ---------------------------------------------------------------- magic
; the Wizard's force bolt, NetHack's: five power, two twelve-sided dice
; to the first monster along the direction within eight cells
PROC Cast()
  BYTE d, x, y, n, m
  IF role <> 1 THEN
    MsgD(#"You don't know any spells.")
    RETURN
  FI
  IF upw < 5 THEN
    MsgD(#"You don't have enough energy.")
    RETURN
  FI
  MsgD(#"In what direction?")
  d = AskDir()
  IF d == 0 THEN RETURN FI
  upw -= 5
  Sfx(SX_MAGIC)
  x = px
  y = py
  FOR n = 1 TO 8 DO
    x += dir_dx(d)
    y += dir_dy(d)
    IF Open(Kind(x, y)) == 0 THEN EXIT FI
    m = MonAt(x, y)
    IF m THEN
      mbl = 0
      MsgSD(#"The force bolt hits ")
      MsgMon(m - 1, 0)
      MsgC('.')
      MsgEnd()
      m = HurtMon(m - 1, Dice(2, 12))
      EndTurn()
      RETURN
    FI
  OD
  MsgD(#"The force bolt fizzles.")
  EndTurn()
RETURN

; ---------------------------------------------------------------- prayer
PROC GodName(BYTE g)
  MsgS(NameRec(NAME_GOD + role * 3 + g))
RETURN

; the altar the hero stands on, as 0 lawful 1 neutral 2 chaotic, or 255
FUNC BYTE OnAltar()
  BYTE k
  k = Kind(px, py)
  IF k >= K_ALTAR THEN RETURN (k - K_ALTAR) FI
RETURN (255)

; NetHack's in_trouble() for what the game has: hit points low (major),
; a cursed weapon welded with no hand free (major), anything cursed worn
; (minor)
CONST TROUBLE_HIT = 7
CONST TROUBLE_HANDS = 2
CONST TROUBLE_CURSED = 254           ; -2, as a byte

FUNC BYTE CursedIn(BYTE k)
  IF k == 255 THEN RETURN (0) FI
RETURN (ifl(k) & OF_CURSE)

; worst_cursed_item(): the weapon if a ring is on the right hand or it
; needs both, then gloves, shield, cloak, armour, helm, boots, the amulet,
; the rings, the weapon; 255 for none
FUNC BYTE WorstCursed()
  IF CursedIn(uwep) AND (uright <> 255 OR it(uwep) == O_TWOHANDED) THEN RETURN (uwep) FI
  IF CursedIn(worn(SLOT_GLOVES)) THEN RETURN (worn(SLOT_GLOVES)) FI
  IF CursedIn(worn(SLOT_SHIELD)) THEN RETURN (worn(SLOT_SHIELD)) FI
  IF CursedIn(worn(SLOT_CLOAK)) THEN RETURN (worn(SLOT_CLOAK)) FI
  IF CursedIn(worn(SLOT_BODY)) THEN RETURN (worn(SLOT_BODY)) FI
  IF CursedIn(worn(SLOT_HELM)) THEN RETURN (worn(SLOT_HELM)) FI
  IF CursedIn(worn(SLOT_BOOTS)) THEN RETURN (worn(SLOT_BOOTS)) FI
  IF CursedIn(uamul) THEN RETURN (uamul) FI
  IF CursedIn(uleft) THEN RETURN (uleft) FI
  IF CursedIn(uright) THEN RETURN (uright) FI
  IF CursedIn(uwep) THEN RETURN (uwep) FI
RETURN (255)

FUNC BYTE Trouble()
  CARD lim, h
  BYTE div
  h = uhpmax
  lim = ulev
  lim = lim * 15
  IF h > lim THEN h = lim FI
  div = 5
  IF ulev >= 6 THEN div = 6 FI
  lim = uhp
  IF uhp <= 5 OR lim * div <= h THEN RETURN (TROUBLE_HIT) FI
  IF CursedIn(uwep) AND (it(uwep) == O_TWOHANDED OR CursedIn(worn(SLOT_SHIELD))) THEN RETURN (TROUBLE_HANDS) FI
  IF WorstCursed() <> 255 THEN RETURN (TROUBLE_CURSED) FI
RETURN (0)

; "Your long sword softly glows amber.", and it is uncursed
PROC Glows(BYTE k)
  mbl = 0
  IF k == uleft THEN
    MsgSD(#"Your left ring")
  ELSEIF k == uright THEN
    MsgSD(#"Your right ring")
  ELSE
    MsgS("Your ")
    Name(it(k), 1, 0, 0, 0)
  FI
  MsgSD(#" softly glows amber.")
  MsgEnd()
  ifl(k) = (ifl(k) & (255 ^ OF_CURSE)) | OF_BKNOWN
RETURN

; fix_worst_trouble()
PROC FixTrouble(BYTE tr)
  IF tr == TROUBLE_HIT THEN
    MsgD(#"You feel much better.")
    IF uhpmax < ulev * 5 + 11 THEN uhpmax += Roll(5) FI
    IF uhpmax <= 5 THEN uhpmax = 6 FI
    uhp = uhpmax
  ELSEIF tr == TROUBLE_HANDS THEN
    Glows(uwep)
  ELSEIF tr == TROUBLE_CURSED THEN
    Glows(WorstCursed())
  FI
RETURN

; NetHack's rnz(): a timeout around i, spread wide both ways
FUNC CARD Rnz(CARD i)
  CARD t
  BYTE n
  t = 1000 + Rnd(1000)
  n = 1
  WHILE n < 5 AND Rnd(4) == 0 DO n += 1 OD
  t = t * n
  IF Rnd(2) THEN RETURN (i * (t / 100) / 10) FI
RETURN (i * 100 / (t / 10))

PROC GodVoice(BYTE g)
  BYTE v
  mbl = 0
  MsgSD(#"The voice of ")
  GodName(g)
  v = Rnd(4)
  IF v == 0 THEN
    MsgSD(#" booms out:")
  ELSEIF v == 1 THEN
    MsgSD(#" thunders:")
  ELSEIF v == 2 THEN
    MsgSD(#" rings out:")
  ELSE
    MsgS(" booms:")
  FI
  MsgEnd()
RETURN

PROC Displeased(BYTE g)
  mbl = 0
  MsgSD(#"You feel that ")
  GodName(g)
  MsgSD(#" is displeased.")
  MsgEnd()
RETURN

; NetHack's rndcurse(): a few things in the pack cursed, or unblessed
PROC CurseSome()
  BYTE i, k
  FOR i = 1 TO Roll(6) DO
    k = Rnd(MAXINV)
    IF it(k) <> 255 THEN
      IF ifl(k) & OF_BLESS THEN ifl(k) = ifl(k) & (255 ^ OF_BLESS) ELSE ifl(k) = ifl(k) | OF_CURSE FI
    FI
  OD
RETURN

; NetHack's angrygods()
PROC AngryGods(BYTE g)
  INT anger, l
  BYTE r, k, i, d
  l = -uluck
  IF g <> ualign THEN
    IF uluck > 0 THEN l = -uluck / 3 FI
    anger = urec / 2 + l
  ELSE
    IF uluck > 0 OR urec >= 4 THEN l = -uluck / 3 FI
    anger = 3 * ugangr + l
  FI
  IF anger < 1 THEN anger = 1 FI
  IF anger > 15 THEN anger = 15 FI
  r = Rnd(anger)
  IF r < 2 THEN
    Displeased(g)
  ELSEIF r < 4 THEN
    GodVoice(g)
    IF urec < 0 AND g == ualign THEN
      Msg(Str(#"\"Thou hast strayed from the path, mortal.\""))
    ELSE
      Msg(Str(#"\"Thou art arrogant, mortal.\""))
    FI
    Msg(Str(#"\"Thou must relearn thy lessons!\""))
    LoseLevel()
  ELSEIF r < 7 THEN
    GodVoice(g)
    Msg(Str(#"\"Thou hast angered me.\""))
    MsgD(#"A black glow surrounds you.")
    CurseSome()
  ELSEIF r < 9 THEN
    GodVoice(g)
    Msg(Str(#"\"Thou durst call upon me?\""))
    Msg(Str(#"\"Then die, mortal!\""))
    d = FreeNear(px, py)
    IF d THEN
      i = NewMon(M_WATERDEMON, px + dir_dx(d), py + dir_dy(d))
      DrawCell(px + dir_dx(d), py + dir_dy(d))
    FI
  ELSE
    GodVoice(g)
    Msg(Str(#"\"Thou hast angered me.\""))
    MsgD(#"Suddenly, a bolt of lightning strikes you!")
    MsgD(#"You fry to a crisp.")
    killgod = g
    HurtHero(255, KD_WRATH)
  FI
  ublesscnt = Rnz(300)
RETURN

PROC GodsUpset(BYTE g)
  IF g == ualign THEN
    ugangr += 1
  ELSEIF ugangr THEN
    ugangr -= 1
  FI
  AngryGods(g)
RETURN

; NetHack's pleased()
PROC Pleased(BYTE g, BYTE ptrouble)
  BYTE tr, pat, act, n, k
  INT pl
  tr = Trouble()
  pat = 0
  mbl = 0
  MsgSD(#"You feel that ")
  GodName(g)
  IF urec >= 14 THEN
    MsgSD(#" is well-pleased.")
  ELSEIF urec >= 4 THEN
    MsgSD(#" is pleased.")
  ELSE
    MsgSD(#" is satisfied.")
  FI
  MsgEnd()
  IF OnAltar() <> 255 AND g <> ualign THEN
    urec -= 1
    RETURN
  FI
  IF urec < 2 AND (tr == 0 OR tr == TROUBLE_CURSED) THEN urec += 1 FI
  IF tr == 0 AND urec >= 14 THEN
    IF ptrouble == 0 THEN pat = 1 FI
  ELSE
    pl = uluck
    IF pl < -1 THEN pl = -1 FI
    IF OnAltar() <> 255 THEN pl = pl + 3 ELSE pl = pl + 2 FI
    act = Rnd(pl) + 1
    IF OnAltar() == 255 AND act > 3 THEN act = 3 FI
    IF urec < 4 THEN
      act = 0
      IF urec > 0 OR Rnl(2) == 0 THEN act = 1 FI
    FI
    IF act >= 5 THEN pat = 1 FI
    IF act >= 4 THEN
      n = 0
      WHILE tr <> 0 AND n < 10 DO
        FixTrouble(tr)
        tr = Trouble()
        n += 1
      OD
    ELSEIF act >= 2 THEN
      IF act == 3 THEN
        FixTrouble(tr)
        tr = Trouble()
      FI
      n = 0
      WHILE (tr == TROUBLE_HIT OR tr == TROUBLE_HANDS) AND n < 10 DO
        FixTrouble(tr)
        tr = Trouble()
        n += 1
      OD
    ELSEIF act == 1 AND (tr == TROUBLE_HIT OR tr == TROUBLE_HANDS) THEN
      FixTrouble(tr)
    FI
  FI
  IF pat THEN
    n = Rnd((uluck + 6) >> 1)
    IF n == 1 AND uwep <> 255 THEN
      IF ifl(uwep) & OF_CURSE THEN
        Glows(uwep)
      ELSEIF ifl(uwep) & OF_BLESS == 0 THEN
        mbl = 0
        MsgS("Your ")
        Name(it(uwep), 1, 0, 0, 0)
        MsgSD(#" softly glows with a light blue aura.")
        MsgEnd()
        ifl(uwep) = ifl(uwep) | OF_BLESS | OF_BKNOWN
      FI
    ELSEIF n == 2 THEN
      MsgD(#"You are surrounded by a golden glow.")
      IF uhpmax < 245 THEN uhpmax += 5 FI
      uhp = uhpmax
      IF uluck < 0 THEN uluck = 0 FI
    ELSEIF n == 4 THEN
      MsgD(#"You are surrounded by a light blue aura.")
      FOR k = 0 TO MAXINV - 1 DO
        IF CursedIn(k) AND it(k) <> 255 THEN Glows(k) FI
      OD
    FI
  FI
  ublesscnt = Rnz(350)
  IF udemi THEN ublesscnt = ublesscnt + Rnz(1000) FI
RETURN

; #pray: NetHack's can_pray(), three turns of prayer -- in which a god who
; is pleased keeps every monster's blow off -- and prayer_done()
PROC Pray()
  BYTE g, tr, al
  INT a
  IF YesNo(Str(#"Are you sure you want to pray? [yn] (n)")) == 0 THEN
    MsgClear()
    RETURN
  FI
  g = OnAltar()
  al = g
  IF g == 255 THEN g = ualign FI
  tr = Trouble()
  mbl = 0
  MsgSD(#"You begin praying to ")
  GodName(g)
  MsgC('.')
  MsgEnd()
  a = urec
  IF ualign <> g THEN
    IF ualign <> 1 AND ualign + g == 2 THEN a = -urec ELSE a = urec / 2 FI
  FI
  IF (tr == TROUBLE_HIT OR tr == TROUBLE_HANDS) AND ublesscnt > 200 THEN
    ptype = 0
  ELSEIF tr == TROUBLE_CURSED AND ublesscnt > 100 THEN
    ptype = 0
  ELSEIF tr == 0 AND ublesscnt > 0 THEN
    ptype = 0
  ELSEIF uluck < 0 OR ugangr OR a < 0 THEN
    ptype = 1
  ELSEIF al <> 255 AND al <> ualign THEN
    ptype = 2
  ELSE
    ptype = 3
    MsgD(#"You are surrounded by a shimmering light.")
  FI
  upray = 3
  WHILE upray AND dead == 0 DO
    EndTurn()
    upray -= 1
  OD
  IF dead THEN RETURN FI
  Sfx(SX_PRAY)
  MsgD(#"You finish your prayer.")
  IF ptype == 0 THEN
    ublesscnt += Rnz(250)
    Luck(-3)
    GodsUpset(ualign)
  ELSEIF ptype == 1 THEN
    AngryGods(ualign)
  ELSE
    Pleased(g, tr)
  FI
  Status()
RETURN

; E: NetHack's engraving, with the finger in the dust -- added to what is
; there, or wiping it out first
PROC Engrave()
  BYTE k, e, i, n
  CARD at
  k = Kind(px, py)
  IF k >= K_ALTAR THEN
    MsgD(#"You make a motion towards the altar with your fingers.")
    RETURN
  FI
  IF k <> K_FLOOR AND k <> K_CORR AND k <> K_DOORWAY THEN
    MsgD(#"You can't write on the floor here.")
    RETURN
  FI
  MsgD(#"You write in the dust with your fingertip.")
  e = EngrAt(px, py)
  IF e <> 255 THEN
    IF YesNo(Str(#"Do you want to add to the current engraving? [yn]")) == 0 THEN
      MsgD(#"You wipe out the message that was written in the dust here.")
      ex(e) = 255
      e = 255
    FI
  FI
  IF GetLine(Str(#"What do you want to write in the dust here?"), 16) == 0 THEN RETURN FI
  IF lb(0) == 0 THEN RETURN FI
  IF e == 255 THEN
    e = 0
    FOR i = 0 TO MAXENGR - 1 DO
      IF ex(i) == 255 THEN e = i FI
    OD
    etx(e * 17) = 0
  FI
  at = e * 17
  ex(e) = px
  ey(e) = py
  FOR i = 1 TO lb(0) DO
    n = etx(at)
    IF n < 16 THEN
      etx(at + n + 1) = lb(i)
      etx(at) = n + 1
    FI
  OD
  IF EngrIs(e, platino) THEN            ; DawnLike's Platino, hidden as his author asks
    FOR i = 0 TO MAXMON - 1 DO
      IF mstat(i) AND mtype(i) == M_PLATINO THEN n = 1 FI
    OD
    IF n <> 1 AND SpawnNear(M_PLATINO) THEN MsgD(#"Platino pops up beside you!") FI
  FI
  EndTurn()
RETURN

; NetHack's intervene(): once the Amulet has been lifted, every 50 to 250
; turns the Wizard's malice -- nerves, a curse, the level woken, a nasty
; beside the hero, or the Wizard himself back
BYTE ARRAY nasty(4) = [M_ETTIN M_TROLL M_OWLBEAR M_VAMPIRELORD]

PROC Intervene()
  BYTE r, i
  r = Rnd(6)
  IF r < 2 THEN
    MsgD(#"You feel vaguely nervous.")
  ELSEIF r == 2 THEN
    MsgD(#"You notice a black glow surrounding you.")
    CurseSome()
  ELSEIF r == 3 THEN
    FOR i = 0 TO MAXMON - 1 DO msl(i) = 0 OD
  ELSEIF r == 4 THEN
    i = SpawnNear(nasty(Rnd(4)))
  ELSE
    FOR i = 0 TO MAXMON - 1 DO
      IF mstat(i) AND mtype(i) == M_WIZARDOFMOTT THEN RETURN FI
    OD
    IF SpawnNear(M_WIZARDOFMOTT) THEN
      MsgD(#"A voice booms out...")
      Msg(Str(#"\"So thou thought thou couldst elude me, fool.\""))
    FI
  FI
RETURN

; ---------------------------------------------------------------- death
PROC Centre(BYTE row, BYTE bank)
  BYTE i, col
  CARD a
  col = (40 - mbl) / 2
  a = row
  VRAM_ADDR = (a << 7) + (col << 1)
  VRAM_STEP = 1
  FOR i = 1 TO mbl DO
    VRAM_DATA = mb(i - 1) - FONT_FIRST
    VRAM_DATA = bank
  OD
  mbl = 0
RETURN

; the grave: who, what did it, where, and how long it took
PROC Die()
  BYTE ch, k
  BYTE POINTER n, q
  IF won THEN MusicStart(TU_VICTORY) ELSE MusicStart(TU_DEATH) FI
  IF won THEN
    MsgD(#"You climb out into the sunlight, the Amulet of Mott in your hands!")
  ELSE
    MsgD(#"You die...")
  FI
  More()
  phase = 2
  ClearScreen()
  mbl = 0
  IF won THEN
    Pic(19, 5, role << 2, 32)
    MsgSD(#"INTO THE SUN")
  ELSE
    Pic(19, 5, T_GRAVE, B_VIEW)
    MsgSD(#"REST IN PEACE")
  FI
  Centre(9, B_WHITE)
  IF role == 0 THEN
    MsgS("Valkyrie")
  ELSEIF role == 1 THEN
    MsgS("Wizard")
  ELSE
    MsgS("Rogue")
  FI
  Centre(11, B_YELLOW)
  IF won THEN
    MsgSD(#"escaped with the Amulet of Mott")
    Centre(13, B_WHITE)
  ELSEIF killer >= KD_FIRST THEN
    MsgS(NameRec(NAME_DEATH + killer - KD_FIRST))
    IF killer == KD_WRATH THEN
      MsgC(' ')
      MsgS(NameRec(NAME_GOD + killgod))
    FI
  ELSE
    MsgSD(#"killed by ")
    IF killer == M_ORACLE OR killer == M_WIZARDOFMOTT THEN
      MsgS("the ")
      MsgS(MonName(killer))
    ELSE
      MsgA(MonName(killer))
    FI
  FI
  IF won == 0 THEN
    Centre(13, B_WHITE)
    MsgSD(#"on dungeon level ")
    MsgN(depth)
    Centre(14, B_WHITE)
  FI
  MsgSD(#"at experience level ")
  MsgN(ulev)
  Centre(16, B_GREY)
  MsgS("after ")
  MsgN(turns)
  MsgS(" turns")
  Centre(17, B_GREY)
  MsgS("with ")
  MsgN(ugold)
  MsgSD(#" pieces of gold")
  Centre(18, B_GREY)
  Text(9, 24, Str(#"Enter: back to the title"), B_GREY)
  k = KeyHit(KEY_ENTER)
  DO
    Tick()
  UNTIL KeyHit(KEY_ENTER) OR KeyHit(KEY_SPACE) OR esc OD
  esc = 0
RETURN

; a page of MPAGES.DAT over the map, its title in the message rows, until
; a key: NetHack's ? page of keys, and the Oracle's words
PROC ShowPage(BYTE POINTER title, BYTE page)
  BYTE r, c, d
  CARD a
  MsgClear()
  FOR r = VTOP TO VTOP + 25 DO ClearRow(r) OD
  Msg(title)
  IF DiskFind(MDRIVE, help_file) THEN
    a = page
    FOpen(disk_page, a * PAGE_LINES * 40)
    FOR r = 0 TO PAGE_LINES - 1 DO
      a = r + VTOP + 1                 ; a shift keeps its left side's width: widen first
      VRAM_ADDR = a << 7
      VRAM_STEP = 1
      FOR c = 1 TO 40 DO
        VRAM_DATA = FlashByte() - FONT_FIRST
        VRAM_DATA = B_WHITE
      OD
    OD
    FlashClose()
  FI
  d = KeyHit(KEY_SPACE)
  esc = 0
  DO
    Tick()
  UNTIL KeyHit(KEY_SPACE) OR KeyHit(KEY_ENTER) OR esc OD
  esc = 0
  FOR r = VTOP TO VTOP + 25 DO ClearRow(r) OD
  MsgClear()
  DrawView()
RETURN

PROC Help()
  ShowPage(Str(#"MOTT -- the keys"), 0)
RETURN

; a number typed at the keyboard, as NetHack asks for one; 0 for none
FUNC CARD AskNumber(BYTE POINTER prompt)
  BYTE i
  CARD v
  v = 0
  IF GetLine(prompt, 5) == 0 THEN RETURN (0) FI
  FOR i = 1 TO lb(0) DO
    IF lb(i) >= '0' AND lb(i) <= '9' THEN v = v * 10 + lb(i) - '0' FI
  OD
RETURN (v)

; NetHack's doconsult(): fifty for a rumour, 500 and fifty a level for an
; oracularity -- less, and the Oracle scorns it -- and the first of each
; worth experience
PROC Consult()
  CARD cost, pay
  IF ugold == 0 THEN
    MsgD(#"You have no money.")
    RETURN
  FI
  IF YesNo(Str(#"\"Wilt thou settle for a minor consultation?\" (50 zorkmids) [yn]")) THEN
    IF ugold < 50 THEN
      MsgD(#"You don't even have enough money for that!")
      RETURN
    FI
    ugold -= 50
    mbl = 0
    MsgSD(#"True to her word, the Oracle ")
    pay = Rnd(4)
    IF pay == 0 THEN MsgSD(#"offhandedly ") ELSEIF pay == 1 THEN MsgS("casually ") FI
    MsgS("says:")
    MsgEnd()
    mbl = 0
    MsgC('"')
    MsgS(NameRec(NAME_RUMOR + Rnd(N_RUMOR)))
    MsgC('"')
    MsgEnd()
    IF uoracle & 1 == 0 THEN
      IF uoracle & 2 THEN GainXP(2) ELSE GainXP(5) FI
    FI
    uoracle = uoracle | 1
    RETURN
  FI
  IF aesc OR ugold <= 50 THEN RETURN FI
  MsgClear()
  cost = ulev
  cost = 500 + cost * 50
  mbl = 0
  MsgS(Str(#"\"Then dost thou desire a major one?\" ("))
  MsgN(cost)
  MsgS(" zorkmids) [yn]")
  MsgEnd()
  IF Answer() == 0 THEN RETURN FI
  pay = cost
  IF ugold < cost THEN pay = ugold FI
  ugold -= pay
  IF pay < cost THEN
    ShowPage(Str(#"The Oracle scornfully takes all your money and says:"), PAGE_CHEAP)
  ELSE
    ShowPage(Str(#"The Oracle meditates for a moment and then intones:"), PAGE_ORACLE + Rnd(N_ORACLE))
    IF uoracle & 2 == 0 THEN
      IF uoracle & 1 THEN GainXP(pay / 25) ELSE GainXP(pay / 10) FI
    FI
    uoracle = uoracle | 2
  FI
RETURN

; NetHack's priest_talk(): with no gold, poverty preached; a gift under 200
; a level thanked, under 400 a blessing, under 600 protection off the
; armour class, and more than that gratitude
PROC PriestTalk()
  CARD offer, lim
  mbl = 0
  MsgMon(tpri, 1)
  IF ugold == 0 THEN
    IF talign == ualign AND urec >= 0 THEN
      MsgSD(#" preaches the virtues of poverty.")
    ELSE
      MsgSD(#" is not interested.")
    FI
    MsgEnd()
    RETURN
  FI
  MsgSD(#" asks you for a contribution for the temple.")
  MsgEnd()
  More()
  offer = AskNumber(Str(#"How much will you offer?"))
  IF offer == 0 THEN
    MsgD(#"You refuse.")
    Msg(Str(#"\"Thou shalt regret thine action!\""))
    IF talign == ualign THEN urec -= 1 FI
    RETURN
  FI
  IF offer > ugold THEN offer = ugold FI
  ugold -= offer
  mbl = 0
  MsgS("You give ")
  MsgMon(tpri, 0)
  MsgC(' ')
  MsgN(offer)
  MsgSD(#" gold pieces.")
  MsgEnd()
  lim = ulev
  lim = lim * 200
  IF offer < lim THEN
    IF ugold > offer * 2 THEN
      Msg(Str(#"\"Cheapskate.\""))
    ELSE
      Msg(Str(#"\"I thank thee for thy contribution.\""))
    FI
  ELSEIF offer < lim * 2 THEN
    Msg(Str(#"\"Thou art indeed a pious individual.\""))
    IF ugold < offer * 2 THEN
      IF talign == ualign AND urec <= -4 THEN urec += 1 FI
      Msg(Str(#"\"I bestow upon thee a blessing.\""))
    FI
  ELSEIF offer < lim * 3 AND (uprot == 0 OR (uprot < 20 AND (uprot < 9 OR Rnd(uprot) == 0))) THEN
    Msg(Str(#"\"Thou hast been rewarded for thy devotion.\""))
    IF uprot == 0 THEN uprot = 2 + Rnd(3) ELSE uprot += 1 FI
    CalcAC()
  ELSE
    Msg(Str(#"\"Thy selfless generosity is deeply appreciated.\""))
    IF ugold < offer * 2 AND talign == ualign THEN urec += 2 FI
  FI
RETURN

; #chat: NetHack's dotalk() to the monster in a direction -- the Oracle
; consulted, the priest in his temple asked a gift, the shopkeeper on the
; bill, and the rest take no notice
PROC Chat()
  BYTE d, m
  MsgD(#"Talk to whom? (in what direction)")
  d = AskDir()
  IF d == 0 OR d > 8 THEN RETURN FI
  MsgClear()
  m = MonAt(px + dir_dx(d), py + dir_dy(d))
  IF m == 0 THEN
    MsgD(#"There is nobody there to talk to.")
    RETURN
  FI
  m -= 1
  mbl = 0
  IF mtype(m) == M_ORACLE AND Peaceful(m) THEN
    Consult()
  ELSEIF m == tpri AND troom <> 255 AND mtype(m) == M_PRIEST AND Peaceful(m) THEN
    PriestTalk()
  ELSEIF m == shk AND ShkOk() THEN
    ShkName()
    IF mstat(m) & S_HOSTILE THEN
      MsgSD(#" mentions how much he dislikes non-paying customers.")
    ELSEIF Bill() THEN
      MsgSD(#" says that your bill comes to ")
      MsgN(Bill())
      MsgS(" zorkmids.")
    ELSE
      MsgSD(#" says that business is good.")
    FI
    MsgEnd()
  ELSE
    MsgMon(m, 1)
    MsgSD(#" seems not to notice you.")
    MsgEnd()
  FI
  Status()
  EndTurn()
RETURN

; # and a long command, as NetHack's extended commands: #pray, #chat
PROC Extended()
  IF GetLine("#", 12) == 0 THEN RETURN FI
  IF Typed("pray") THEN
    Pray()
  ELSEIF Typed("chat") THEN
    Chat()
  ELSE
    mbl = 0
    MsgS(lb)
    MsgSD(#": unknown extended command.")
    MsgEnd()
  FI
RETURN

; p: NetHack's dopay() -- each unpaid thing bought while the gold lasts,
; the debt first; an angry keeper paid what was stolen, or a thousand
PROC Pay()
  BYTE k
  CARD c
  IF ShkOk() == 0 OR InShop(px, py) == 0 THEN
    MsgD(#"There appears to be no shopkeeper here to receive your payment.")
    RETURN
  FI
  mbl = 0
  IF mstat(shk) & S_HOSTILE THEN
    IF shrob THEN
      IF ugold < shrob / 2 THEN
        MsgSD(#"Unfortunately, ")
        ShkName()
        MsgSD(#" doesn't look satisfied.")
      ELSE
        c = shrob
        IF ugold < c THEN c = ugold FI
        ugold = ugold - c
        shgold = shgold + c
        MsgSD(#"You compensate ")
        ShkName()
        MsgSD(#" for the losses, and are forgiven.")
        shrob = 0
        mstat(shk) = mstat(shk) & (255 ^ S_HOSTILE)
      FI
    ELSE
      ShkName()
      MsgSD(#" is after blood, not money!")
      MsgEnd()
      IF ugold < 1000 THEN
        MsgSD(#"Besides, you don't have enough to interest ")
        ShkName()
        MsgC('.')
      ELSE
        ugold = ugold - 1000
        shgold = shgold + 1000
        MsgSD(#"You try to appease ")
        ShkName()
        MsgSD(#" by giving 1000 gold pieces.")
        MsgEnd()
        IF Rnd(3) THEN
          ShkName()
          MsgSD(#" calms down.")
          mstat(shk) = mstat(shk) & (255 ^ S_HOSTILE)
        ELSE
          MsgS("But ")
          ShkName()
          MsgSD(#" is as angry as ever.")
        FI
      FI
    FI
    MsgEnd()
    Status()
    RETURN
  FI
  IF Bill() == 0 THEN
    MsgSD(#"You do not owe ")
    ShkName()
    MsgS(" anything.")
    MsgEnd()
    RETURN
  FI
  IF shdebt THEN
    IF ugold < shdebt THEN
      MsgD(#"You don't have gold enough to pay what you owe.")
      RETURN
    FI
    ugold = ugold - shdebt
    shgold = shgold + shdebt
    MsgS("You pay ")
    MsgN(shdebt)
    MsgSD(#" gold pieces for what you used.")
    MsgEnd()
    shdebt = 0
  FI
  FOR k = 0 TO MAXINV - 1 DO
    IF it(k) <> 255 AND ifl(k) & OF_UNPAID THEN
      c = Price(it(k), ifl(k), ie(k), 0) * iq(k)
      mbl = 0
      IF ugold < c THEN
        MsgSD(#"You don't have gold enough to pay for ")
        Name(it(k), iq(k), ifl(k), ie(k), 1)
        MsgC('.')
        MsgEnd()
        Status()
        RETURN
      FI
      ugold = ugold - c
      shgold = shgold + c
      ifl(k) = ifl(k) & (255 ^ (OF_UNPAID | OF_DEAR))
      MsgS("You bought ")
      Name(it(k), iq(k), ifl(k), ie(k), 1)
      MsgS(" for ")
      MsgN(c)
      MsgSD(#" gold pieces.")
      MsgEnd()
    FI
  OD
  mbl = 0
  MsgS(Str(#"\"Thank you for shopping in "))
  ShopWord()
  MsgS("!\"")
  MsgEnd()
  Status()
RETURN

; ------------------------------------------------------------- the play
FUNC BYTE Quit()
  IF YesNo(Str(#"Really quit? [yn] (n)")) THEN RETURN (1) FI
  MsgClear()
RETURN (0)

; ------------------------------------------------------------ saving
; MOTT.SAV: 32 KB on drive 9, starting on a sector, erased and written
; again in place. A state byte, then the length of the run saved and a
; byte of where it ends -- the stamp of the build that wrote it -- then
; the run from save_from to save_end, then the VRAM slot of every level
; made. Every byte is kept inverted, so the zeros most of a level is are
; erased flash and never programmed, a request a byte on the board. The
; state is written last, 1, and cleared to 0 when the game is played on
; from it: NetHack's rule, a save gone once it is restored
PROC FlashPut()                      ; fn bytes from fp, or VRAM's port, to fh:fa
  ASM
        LDW  Y,[v_fp]
        LDW  X,[v_fa]
        LD   R2,[v_fn]
        LD   R3,[v_fn+1]
.l:     MOV  R0,R2
        OR   R0,R3
        BEQ  .x
        LD   R0,[v_fv]
        TST  R0
        BEQ  .m
        LD   R0,[v_VRAM_DATA]
        BRA  .c
.m:     LD   R0,[Y]
        INCW Y
.c:     NOT  R0
        CMP  R0,#$FF
        BEQ  .s
        MOV  R1,XL
        ST   [v_FLS_ADDR_L],R1
        MOV  R1,XH
        ST   [v_FLS_ADDR_M],R1
        LD   R1,[v_fh]
        ST   [v_FLS_ADDR_H],R1
        ST   [v_FLS_WDATA],R0
        MOV  R1,#1
        ST   [v_FLS_WCTRL],R1
.w:     LD   R1,[v_FLS_WCTRL]
        BTST R1,#$01
        BNE  .w
.s:     INCW X
        BNE  .d
        LD   R1,[v_fh]
        ADD  R1,#1
        ST   [v_fh],R1
.d:     SUB  R2,#1
        BCS  .l
        SUB  R3,#1
        BRA  .l
.x:     STW  [v_fa],X
  ENDASM
RETURN

PROC FlashGet()                      ; fn bytes of the open stream, inverted back, to fp or VRAM's port
  ASM
        LDW  Y,[v_fp]
        LDW  X,[v_fn]
.l:     LD   R0,[v_FLS_DATA]
        NOT  R0
        LD   R1,[v_fv]
        TST  R1
        BEQ  .m
        ST   [v_VRAM_DATA],R0
        BRA  .d
.m:     ST   [Y],R0
        INCW Y
.d:     DECW X
        BNE  .l
  ENDASM
RETURN

; the file, on a sector and big enough, or 0
FUNC BYTE SaveFile()
  IF DiskFind(MDRIVE, save_file) == 0 THEN RETURN (0) FI
  IF disk_page & 15 OR disk_len < SAVE_LEN THEN RETURN (0) FI
  sv_lo = disk_page & 255
  sv_lo = sv_lo << 8
  sv_hi = $10 + MDRIVE * 7 + (disk_page >> 8)
  fh = sv_hi
RETURN (1)

PROC Stamp()
  CARD n
  n = &save_end - &save_from
  svh(1) = n
  svh(2) = n >> 8
  svh(3) = &save_end
RETURN

; a save this build wrote and nobody has played on from
FUNC BYTE SaveOk()
  BYTE s, a, b, c
  IF SaveFile() == 0 THEN RETURN (0) FI
  FlashOpen(sv_lo, sv_hi)
  fp = svh
  fn = 4
  fv = 0
  FlashGet()
  FlashClose()
  s = svh(0)
  a = svh(1)
  b = svh(2)
  c = svh(3)
  Stamp()
  IF s == 1 AND a == svh(1) AND b == svh(2) AND c == svh(3) THEN RETURN (1) FI
RETURN (0)

; S: NetHack's dosave(), asked first; the level parked, the file erased and
; written, and back to the title
FUNC BYTE SaveGame()
  BYTE k, n, l
  CARD a
  IF YesNo(Str(#"Really save? [yn] (n)")) == 0 THEN
    MsgClear()
    RETURN (0)
  FI
  MsgClear()
  IF SaveFile() == 0 THEN
    MsgD(#"There is no save file on drive 9.")
    RETURN (0)
  FI
  FlashClose()
  MusicOff()
  Park()
  MsgD(#"Saving...")
  FOR k = 0 TO 7 DO
    a = k
    a = sv_lo + (a << 12)
    FLS_ADDR_L = 0
    FLS_ADDR_M = a >> 8
    l = sv_hi
    IF a < sv_lo THEN l += 1 FI
    FLS_ADDR_H = l
    FLS_WCTRL = 2
    WHILE FLS_WCTRL & 1 DO OD
  OD
  Stamp()
  fa = sv_lo + 1
  fp = svh + 1
  fn = 3
  fv = 0
  FlashPut()
  fp = &save_from
  fn = &save_end - &save_from
  FlashPut()
  n = 0
  FOR l = 1 TO NLEVEL DO n += made(l) OD
  k = 0
  FOR l = 1 TO NLEVEL DO
    IF made(l) THEN
      k += 1
      mbl = 0
      msgrow = 0
      MsgSD(#"Saving... level ")
      MsgN(k)
      MsgSD(#" of ")
      MsgN(n)
      MsgEnd()
      VRAM_ADDR = Slot(l)
      VRAM_STEP = 1
      fv = 1
      fn = NCELL + (&park_end - rx1)
      FlashPut()
    FI
  OD
  fa = sv_lo
  fh = sv_hi
  fp = svh
  svh(0) = 1
  fn = 1
  fv = 0
  FlashPut()
  MsgD(#"Be seeing you...")
  More()
RETURN (1)

; the title's C: the run and the levels read back, the save used, and the
; level the hero stood on entered where the hero stood
PROC LoadGame()
  BYTE l
  FlashOpen(sv_lo + 4, sv_hi)
  fp = &save_from
  fn = &save_end - &save_from
  fv = 0
  FlashGet()
  FOR l = 1 TO NLEVEL DO
    IF made(l) THEN
      VRAM_ADDR = Slot(l)
      VRAM_STEP = 1
      fv = 1
      fn = NCELL + (&park_end - rx1)
      FlashGet()
    FI
  OD
  FlashClose()
  fa = sv_lo
  fh = sv_hi
  fp = svh
  svh(0) = 255
  fn = 1
  fv = 0
  FlashPut()
  phase = 1
  esc = 0
  theme = 255
  mtune = 255
  MsgClear()
  EnterLevel(4)
  mbl = 0
  MsgSD(#"Hello ")
  RoleWord()
  MsgSD(#", welcome back to MOTT!")
  MsgEnd()
RETURN

PROC Play()
  BYTE d, i
  ClearScreen()
  IF restoring THEN
    LoadGame()
  ELSE
  FOR i = 0 TO NLEVEL DO made(i) = 0 OD
  rseed = (TMR_L * 256 + TMR_M) | 1
  depth = 1
  lvl = 1
  mines_at = 2 + Rnd(2)
  oracle_at = 5 + Rnd(3)
  uprot = 0
  uoracle = 0
  turns = 0
  anim = 0
  animt = 24
  esc = 0
  dead = 0
  phase = 1
  ulev = 1
  uxp = 0
  uhp = r_hp(role)
  uhpmax = uhp
  upw = r_pw(role)
  upwmax = upw
  upara = 0
  ualign = r_align(role)
  urec = 10
  uluck = 0
  ublesscnt = 300
  ugangr = 0
  upray = 0
  utrap = 0
  carry(0) = 255
  msgrow = 0
  mbl = 0
  wantport = 0
  udemi = 0
  wantint = 0
  won = 0
  InitHero()
  EnterLevel(1)
  d = FreeNear(px, py)
  IF d THEN
    i = NewMon(r_pet(role), px + dir_dx(d), py + dir_dy(d))
    IF i <> 255 THEN mstat(i) = S_LIVE | S_PET FI
    DrawCell(px + dir_dx(d), py + dir_dy(d))
  FI
  MsgD(#"Welcome to the Dungeons of Mott!")
  FI
  DO
    Tick()
    loops += 1
    IF dead THEN
      Die()
      RETURN
    FI
    IF esc THEN
      esc = 0
      IF Quit() THEN RETURN FI
    FI
    IF animt == 0 THEN
      animt = 24
      Animate()
    FI
    d = Walk()
    IF d THEN
      MsgClear()
      Stride(d)
    FI
    IF KeyHit(KEY_DOT) THEN
      MsgClear()
      IF Shifted() THEN
        Descend()
      ELSE
        EndTurn()
      FI
    FI
    IF KeyHit(KEY_COMMA) THEN
      MsgClear()
      IF Shifted() THEN Ascend() ELSE PickUp() FI
    FI
    IF KeyHit(KEY_S) OR KeyHit(KP5) THEN
      MsgClear()
      IF Shifted() THEN
        IF SaveGame() THEN RETURN FI
      ELSE
        Search()
        EndTurn()
      FI
    FI
    IF KeyHit(KEY_Z) THEN
      MsgClear()
      IF Shifted() THEN Cast() ELSE Zap() FI
    FI
    IF KeyHit(KEY_R) THEN
      IF KeyHeld(KEY_CTRL) THEN
        DrawView()
        Status()
      ELSE
        MsgClear()
        IF Shifted() THEN TakeRing() ELSE Read() FI
      FI
    FI
    IF KeyHit(KEY_I) THEN
      d = Menu("Inventory", $7F, 0)
    FI
    IF KeyHit(KEY_D) THEN
      MsgClear()
      Drop()
    FI
    IF KeyHit(KEY_W) THEN
      MsgClear()
      IF Shifted() THEN Wear() ELSE Wield() FI
    FI
    IF KeyHit(KEY_T) THEN
      MsgClear()
      IF Shifted() THEN TakeOff() ELSE Throw() FI
    FI
    IF KeyHit(KEY_P) THEN
      MsgClear()
      IF Shifted() THEN PutOn() ELSE Pay() FI
    FI
    IF KeyHit(KEY_3) AND Shifted() THEN Extended() FI
    IF KeyHit(KEY_E) AND Shifted() THEN
      MsgClear()
      Engrave()
    FI
    IF KeyHit(KEY_SLASH) AND Shifted() THEN Help() FI
    IF KeyHit(KEY_Q) THEN
      MsgClear()
      Quaff()
    FI
    IF KeyHit(KEY_F) THEN
      MsgClear()
      Fire()
    FI
    IF KeyHit(KEY_SEMI) AND Shifted() THEN
      MsgClear()
      LookHere()
    FI
    IF KeyHit(KEY_BSLASH) THEN Discoveries() FI
    IF wantint AND dead == 0 THEN
      wantint = 0
      udg = 50 + Rnd(200)
      MsgClear()
      Intervene()
    FI
    IF wantport AND dead == 0 THEN
      wantport = 0
      MsgClear()
      MsgD(#"You feel a wrenching sensation.")
      Teleport()
    FI
    IF KeyHit(KEY_ENTER) THEN
      MsgClear()
      IF Kind(px, py) == K_DOWN THEN
        Descend()
      ELSEIF Kind(px, py) == K_UP THEN
        Ascend()
      FI
    FI
  OD
RETURN

; ------------------------------------------------------------ the title
PROC TitleRoles(BYTE sel)
  BYTE r, bank
  FOR r = 0 TO 2 DO
    bank = B_WHITE
    IF r == sel THEN bank = B_YELLOW FI
    Pic(14, 9 + r * 3, r << 2, (2 + anim) << 4)
    RoleName(18, 10 + r * 3, r, bank)
    IF r == sel THEN Text(11, 10 + r * 3, ">", B_YELLOW) ELSE Text(11, 10 + r * 3, " ", B_WHITE) FI
  OD
RETURN

PROC Title()
  BYTE go, d, cont
  phase = 0
  esc = 0
  restoring = 0
  ClearScreen()
  go = 1
  IF theme <> 0 THEN go = LoadTheme(0) FI
  IF DiskFind(MDRIVE, names_file) THEN names_page = disk_page ELSE go = 0 FI
  IF DiskFind(MDRIVE, str_file) THEN str_page = disk_page ELSE go = 0 FI
  IF DiskFind(MDRIVE, levels_file) THEN levels_page = disk_page ELSE go = 0 FI
  IF DiskFind(MDRIVE, music_file) THEN
    mus_lo = disk_page & 255
    mus_lo = mus_lo << 8
    mus_hi = $10 + MDRIVE * 7 + (disk_page >> 8)
  ELSE
    go = 0
  FI
  IF go == 0 THEN
    Text(1, 14, "MOTT's files are not all on drive 9.", B_RED)
    DO
      Tick()
    UNTIL esc OD
    RETURN
  FI
  MusicStart(TU_TITLE)
  mrep = 255
  Text(18, 3, "MOTT", B_YELLOW)
  Text(1, 5, Str(#"The Amulet of Mott lies twelve levels"), B_GREY)
  Text(1, 6, Str(#"down. Fetch it, and climb back to the"), B_GREY)
  Text(1, 7, "sun.", B_GREY)
  Text(5, 20, Str(#"up, down: choose   Enter: begin"), B_GREY)
  cont = SaveOk()
  IF cont THEN Text(6, 22, Str(#"C: continue your saved game"), B_YELLOW) FI
  TitleRoles(role)
  go = KeyHit(KEY_C)
  go = KeyHit(KEY_ENTER)
  go = KeyHit(KEY_SPACE)
  go = 0
  DO
    Tick()
    IF esc THEN EXIT FI
    IF animt == 0 THEN
      animt = 24
      anim = anim ^ 1
      TitleRoles(role)
    FI
    d = Walk()
    IF d == 1 THEN
      role = (role + 2) % 3
      TitleRoles(role)
    ELSEIF d == 5 THEN
      role = (role + 1) % 3
      TitleRoles(role)
    FI
    IF KeyHit(KEY_ENTER) OR KeyHit(KEY_SPACE) THEN go = 1 FI
    IF cont AND KeyHit(KEY_C) THEN
      restoring = 1
      go = 1
    FI
  UNTIL go OD
RETURN

BYTE save_end                        ; the end of what a save holds: every global is above it

PROC Main()
  Graphics(2)
  Cursor(0)
  VID_BORDER = 0
  VID_PAT = PAT_BASE
  SpritesOff()
  Palette()
  theme = 255
  role = 0
  DO
    Title()
    IF esc THEN EXIT FI
    Play()
  OD
  SpritesOff()
  Reset()
RETURN
