CONST KP7 = $6C
CONST KP8 = $75
CONST KP9 = $7D
CONST KEY_H = $33
CONST KEY_J = $3B
CONST KEY_K = $42
CONST KEY_L = $4B
CONST KEY_Y = $35
CONST KEY_U = $3C
CONST KEY_B = $32
CONST KEY_N = $31
CONST KEY_R = $2D
CONST KEY_S = $1B
CONST KEY_Z = $1A
CONST KEY_DOT = $49
CONST KEY_COMMA = $41
CONST KEY_LSHIFT = $12
CONST KEY_RSHIFT = $59
CONST KEY_CTRL = $14
CONST KEY_SPACE = $29
CONST KEY_ENTER = $5A
CONST KEY_ESC = $76
CONST KEY_A = $1C
CONST KEY_D = $23
CONST KEY_F = $2B
CONST KEY_I = $43
CONST KEY_P = $4D
CONST KEY_Q = $15
CONST KEY_T = $2C
CONST KEY_W = $1D
CONST KEY_SEMI = $4C
CONST KEY_BSLASH = $5D
CONST KEY_3 = $26
CONST KEY_SLASH = $4A
