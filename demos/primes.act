; Sieve of Eratosthenes Benchmark in CoolAction!
; Computes primes up to 1000

BYTE ARRAY flags(1001)

BYTE uart_tx = $FF71

PROC PutC(BYTE c)
  uart_tx = c
RETURN

PROC PrintNum(CARD val)
  CARD q
  BYTE rem
  IF val >= 10 THEN
    q = val / 10
    rem = val % 10
    PrintNum(q)
    PutC(48 + rem)
  ELSE
    PutC(48 + val)
  FI
RETURN

PROC Main()
  CARD i
  CARD k
  CARD count

  ; Initialize all flags to 1 (prime candidate)
  i = 0
  WHILE i <= 1000 DO
    flags(i) = 1
    i += 1
  OD

  count = 0
  i = 2
  WHILE i <= 1000 DO
    IF flags(i) == 1 THEN
      count += 1
      k = i + i
      WHILE k <= 1000 DO
        flags(k) = 0
        k += i
      OD
    FI
    i += 1
  OD

  ; Print number of primes found: Primes: 168
  PutC(80) ; 'P'
  PutC(114); 'r'
  PutC(105); 'i'
  PutC(109); 'm'
  PutC(101); 'e'
  PutC(115); 's'
  PutC(58) ; ':'
  PutC(32) ; ' '
  PrintNum(count)
  PutC(10) ; '\n'
RETURN
