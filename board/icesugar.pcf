# icesugar.pcf — iCESugar v1.5, Lattice iCE40UP5K-SG48.
#
# Only what cool8_top actually has a port for. The full board map, with
# the two traps that constrain it, is docs/05-board.md section 3; audio
# and the buttons are added to both as their milestones
# arrive, because nextpnr rejects a constraint for a port that does not
# exist.
#
#   yosys ... -p 'synth_ice40 -top cool8_top -json cool8.json'
#   nextpnr-ice40 --up5k --package sg48 --pcf board/icesugar.pcf ...
#
# tools/mkbit.py runs the whole thing.

# 12 MHz from the iCELink debugger. It goes to the PLL, which makes both
# clocks: the part cannot give the fabric this pin and run the PLL from
# it at the same time — docs/01-decisions.md D32.
set_io clk       35

# iCELink USB CDC serial. This is the console *and* the hardware loader,
# which is why PMOD1 can never be used as a whole PMOD: pins 4 and 6 are
# two of its eight signals. Named from the FPGA's point of view — it
# receives on 4 and transmits on 6. If nothing answers a PING and the
# board is otherwise alive, try them the other way round.
set_io uart_rx    4
set_io uart_tx    6

# RGB LED. Common anode, so cool8_top drives these low to light them.
set_io led_r     40
set_io led_g     41
set_io led_b     39

# VGA — MuseLab PMOD-VGA on PMOD2 + PMOD3, twelve bits plus two syncs.
# The full map and the reason PMOD1 can never be a whole PMOD are in
# docs/05-board.md section 3. Bit 0 of each channel is the assumption to
# check first if the colours come out inverted or shuffled: the PMOD's
# silkscreen names its signals R, R1, R2, R3 and this takes 45, 32 and 46
# to be the least significant of each.
set_io vga_r[3]  36
set_io vga_r[2]  38
set_io vga_r[1]  43
set_io vga_r[0]  45
set_io vga_g[3]  23
set_io vga_g[2]  26
set_io vga_g[1]  28
set_io vga_g[0]  32
set_io vga_b[3]  37
set_io vga_b[2]  42
set_io vga_b[1]  44
set_io vga_b[0]  46
set_io vga_hs    34
set_io vga_vs    31

# PS/2 keyboard on the two PMOD3 signals the VGA does not want, through
# the level shifter of docs/05-board.md section 4.1. Both are open drain
# and both need the shifter's pull-up to 5 V; the FPGA never drives high.
set_io ps2_clk   27
set_io ps2_dat   25

# The configuration flash, reused as storage once CDONE goes high. Not on
# any header, and free — docs/05-board.md section 2.
#
# **These two were swapped and put back**, and the experiment is worth
# recording so nobody repeats it. `src/advanced/icicle` in Muse Lab's
# own repo runs code from this flash on this board and constrains
# `flash_io0` to 14 as an output and `flash_io1` to 17 as an input,
# which says MOSI is 14 and MISO is 17 -- the opposite of this. Swapping
# them to match changed nothing: the CPU still read $FF at every
# address, on the same board, in the working jumper position. So
# whatever stops user logic reaching this flash (05-board.md, Trap 0) is
# not the pin assignment, and these stay as they were.
set_io flash_cs  16
set_io flash_sck 15
set_io flash_mosi 17
set_io flash_miso 14

# audio — sigma-delta out, P1_3, into the RC low-pass
set_io audio      3

# SW[0] — the break button, NMI. P4_4
#
# **The pull-up is not optional.** Nothing on the board holds this pin,
# and an iCE40 input left floating oscillates — which is an NMI storm,
# not a quiet nothing. cool8_top's counter is the second half of the
# same defence.
set_io -pullup yes sw0 18
